{
  "name": "morning-reading-backend",
  "version": "1.0.0",
  "description": "七个习惯晨读营后端服务",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "init:dev": "NODE_ENV=development node scripts/init-all.js",
    "init:prod": "NODE_ENV=production node scripts/init-production.js",
    "init:indexes": "node scripts/init-indexes.js",
    "init:mongodb": "NODE_ENV=development node scripts/init-mongodb.js",
    "init:mysql": "node scripts/init-mysql.js",
    "check:openid": "node scripts/check-openid-health.js",
    "report:daily": "node scripts/daily-log-report.js",
    "report:diagnose": "node scripts/diagnose-daily-report.js",
    "lint": "eslint 'src/**/*.js'",
    "lint:tests": "eslint 'tests/**/*.js'",
    "test": "NODE_ENV=test node tests/run-mocha.js 'tests/**/*.test.js'",
    "test:unit": "SKIP_MOCHA_REQUIRE=1 NODE_ENV=test node tests/run-mocha.js 'tests/unit/**/*.test.js'",
    "test:integration": "NODE_ENV=test node tests/run-mocha.js 'tests/integration/**/*.test.js'",
    "test:coverage": "NODE_ENV=test c8 --reporter=text --reporter=lcov node tests/run-mocha.js 'tests/**/*.test.js'",
    "test:watch": "NODE_ENV=test mocha 'tests/**/*.test.js' --watch",
    "test:load": "node tests/load-test.js",
    "coverage:report": "c8 report --reporter=html && open coverage/index.html"
  },
  "keywords": [
    "morning-reading",
    "wechat-miniprogram",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "joi": "17.13.9",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.7",
    "morgan": "^1.10.0",
    "multer": "2.5.0",
    "mysql2": "^3.6.5",
    "node-cron": "^4.6.0",
    "nodemailer": "10.3.1",
    "redis": "^4.6.11",
    "winston": "^3.11.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "c8": "^12.0.0",
    "chai": "^4.5.0",
    "chai-http": "^4.4.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "mocha": "^12.0.3",
    "mongodb-memory-server": "^9.5.0",
    "nock": "^14.0.10",
    "prettier": "^3.7.4",
    "proxyquire": "^2.1.3",
    "sinon": "^17.0.1",
    "supertest": "^6.3.4"
  },
  "overrides": {
    "glob": "^14.0.4",
    "serialize-javascript": "^7.1.4",
    "minimatch": "^11.0.5",
    "eslint": {
      "minimatch": "^3.1.5"
    },
    "@eslint/eslintrc": {
      "minimatch": "^3.1.5"
    },
    "@humanwhocodes/config-array": {
      "minimatch": "^3.1.5"
    },
    "eslint-plugin-import": {
      "minimatch": "^3.1.5"
    },
    "eslint-plugin-node": {
      "minimatch": "^3.1.5"
    }
  }
}
