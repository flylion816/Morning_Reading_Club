<view wx:if="{{visible}}" class="qn-mask" catchtap="close" catchtouchmove="noop">
  <view class="qn-sheet" style="bottom: {{keyboardHeight}}px" catchtap="noop">
    <view class="qn-grip"></view>
    <view class="qn-head">
      <view class="qn-seal">喜</view>
      <text class="qn-head-title">记一句随喜</text>
      <text class="qn-private">仅自己可见</text>
    </view>
    <input
      class="qn-title"
      value="{{title}}"
      maxlength="40"
      disabled="{{saving}}"
      adjust-position="{{false}}"
      confirm-type="next"
      placeholder="标题（可选）"
      placeholder-class="qn-placeholder"
      bindinput="onTitleInput"
    />
    <rich-input
      class="qn-input"
      value="{{content}}"
      html="{{html}}"
      maxlength="{{contentMax}}"
      height="{{220}}"
      focus="{{focus}}"
      disabled="{{saving}}"
      placeholder="{{placeholder}}"
      bind:input="onInput"
      bind:keyboardheight="onKeyboardHeight"
    />
    <view class="qn-foot">
      <view wx:if="{{periodId && source}}" class="qn-chip {{assocOn ? '' : 'qn-chip-off'}}" bindtap="toggleAssociation">
        <text class="qn-chip-text">{{assocOn ? source : '已取消关联，点这里恢复'}}</text>
        <text wx:if="{{assocOn}}" class="qn-chip-x">×</text>
      </view>
      <view wx:else class="qn-chip-space"></view>
      <button class="qn-save" bindtap="save" disabled="{{saving || !content}}">{{saving ? '正在记下…' : '记下来'}}</button>
    </view>
  </view>
</view>

<view wx:if="{{toastVisible}}" class="qn-toast">
  <text>✓ 记下了</text>
  <text class="qn-toast-again" bindtap="again">再记一句</text>
</view>
