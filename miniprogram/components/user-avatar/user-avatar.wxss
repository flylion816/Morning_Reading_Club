.user-avatar {
  position: relative;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx solid rgba(255, 253, 248, 0.86);
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx var(--theme-primary-alpha-12, rgba(61, 111, 166, 0.12));
}

.user-avatar-circle {
  border-radius: 50%;
}

.user-avatar-rounded {
  border-radius: 18rpx;
}

.user-avatar-square {
  border-radius: 8rpx;
}

.user-avatar-image {
  display: block;
  width: 100%;
  height: 100%;
}

.user-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 0 4rpx;
  box-sizing: border-box;
  color: #fffdf8;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1;
  text-align: center;
  word-break: keep-all;
}

.user-avatar-interactive:active {
  transform: translateY(1rpx) scale(0.96);
  opacity: 0.9;
}
