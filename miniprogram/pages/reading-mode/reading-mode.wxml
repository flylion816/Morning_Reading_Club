<view class="page-reading-mode paper-{{paperTheme}}">
  <view class="reading-topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="reading-back" bindtap="handleBack">‹</view>
    <view class="reading-title-wrap">
      <view class="reading-title-row">
        <text class="reading-title">{{course.title || '读一读'}}</text><text class="reading-progress">　{{readingProgress}}%</text>
      </view>
      <view class="reading-progress-bar-wrap">
        <view class="reading-progress-bar-track">
          <view class="reading-progress-bar-fill" style="width: {{readingProgress}}%;"></view>
        </view>
      </view>
    </view>
  </view>

  <scroll-view
    class="reader-scroll"
    scroll-y
    enhanced="true"
    show-scrollbar="{{false}}"
    scroll-top="{{restoreScrollTop}}"
    lower-threshold="24"
    bindscroll="handleReaderScroll"
    bindscrolltolower="handleScrollToLower">
    <view class="reader-content reader-font-{{fontSizeLevel}} {{fontFamily === 'serif' ? 'reader-family-serif' : ''}}" style="padding-top: {{topbarHeight}}px;">
      <view class="reader-meta">
        <view class="reader-period">{{periodName || brandName}}</view>
        <view class="reader-heading">每天晨读内容</view>
      </view>

      <view
        wx:for="{{paragraphs}}"
        wx:key="id"
        id="para-{{index}}"
        data-index="{{index}}"
        bindlongpress="handleParagraphLongPress"
        class="reader-paragraph {{index === currentParagraphIndex ? 'reader-paragraph-active' : ''}} {{item.mine ? 'reader-paragraph-mine' : ''}} {{item.popularCount ? 'reader-paragraph-popular' : ''}}">
        <image wx:if="{{item.type === 'image'}}" src="{{item.src}}" mode="widthFix" class="reader-image" />
        <text wx:else>{{item.text}}</text>
        <view wx:if="{{item.popularCount}}" class="reader-popular-note">{{item.popularCount}} 位书友也摘了这句</view>
      </view>

      <view wx:if="{{completionVisible}}" class="reading-completion-card">
        <view class="completion-dawn"><view class="completion-sun"></view></view>
        <view class="completion-kicker">已完成本次晨读</view>
        <view class="completion-title">{{completionTitle}}</view>
        <view class="completion-text">
          本次阅读用时 <text class="completion-num">{{completionDurationText}}</text>。能耐心读到这里，就是今天很扎实的一步。
        </view>
        <view wx:if="{{completionRank}}" class="completion-rank">你是今天第 <text class="completion-rank-num">{{completionRank}}</text> 位读完的书友</view>
        <view wx:if="{{fireworksVisible}}" class="completion-fireworks-ring">
          <view class="firework firework-1">
            <view class="spark spark-a"></view>
            <view class="spark spark-b"></view>
            <view class="spark spark-c"></view>
            <view class="spark spark-d"></view>
          </view>
          <view class="firework firework-2">
            <view class="spark spark-a"></view>
            <view class="spark spark-b"></view>
            <view class="spark spark-c"></view>
            <view class="spark spark-d"></view>
          </view>
          <view class="firework firework-3">
            <view class="spark spark-a"></view>
            <view class="spark spark-b"></view>
            <view class="spark spark-c"></view>
            <view class="spark spark-d"></view>
          </view>
          <view class="firework firework-4">
            <view class="spark spark-a"></view>
            <view class="spark spark-b"></view>
            <view class="spark spark-c"></view>
            <view class="spark spark-d"></view>
          </view>
          <view class="firework firework-5">
            <view class="spark spark-a"></view>
            <view class="spark spark-b"></view>
            <view class="spark spark-c"></view>
            <view class="spark spark-d"></view>
          </view>
          <view class="firework firework-6">
            <view class="spark spark-a"></view>
            <view class="spark spark-b"></view>
            <view class="spark spark-c"></view>
            <view class="spark spark-d"></view>
          </view>
          <view class="firework firework-7">
            <view class="spark spark-a"></view>
            <view class="spark spark-b"></view>
            <view class="spark spark-c"></view>
            <view class="spark spark-d"></view>
          </view>
          <view class="firework firework-8">
            <view class="spark spark-a"></view>
            <view class="spark spark-b"></view>
            <view class="spark spark-c"></view>
            <view class="spark spark-d"></view>
          </view>
        </view>
      </view>

      <view wx:if="{{paragraphs.length === 0}}" class="reader-empty">
        暂无可朗读内容
      </view>
    </view>
  </scroll-view>

  <view class="reading-toolbar">
    <view class="toolbar-btn" bindtap="openSettingsPanel">Aa</view>
    <view class="toolbar-btn toolbar-btn-primary" bindtap="handleShareMoment">
      {{posterGenerating ? '生成中' : '分享此刻'}}
    </view>
    <view class="toolbar-btn toolbar-btn-secondary" bindtap="handleBack">
      退出
    </view>
  </view>

  <view wx:if="{{settingsPanelVisible}}" class="settings-mask" bindtap="closeSettingsPanel">
    <view class="settings-panel" catchtap="noop">
      <view class="settings-row">
        <view class="settings-label">字号</view>
        <view class="settings-options">
          <view class="settings-option {{fontSizeLevel === 'standard' ? 'settings-option-on' : ''}}" data-value="standard" bindtap="handleSelectFontSize">标准</view>
          <view class="settings-option {{fontSizeLevel === 'large' ? 'settings-option-on' : ''}}" data-value="large" bindtap="handleSelectFontSize">大</view>
          <view class="settings-option {{fontSizeLevel === 'xlarge' ? 'settings-option-on' : ''}}" data-value="xlarge" bindtap="handleSelectFontSize">特大</view>
        </view>
      </view>
      <view class="settings-row">
        <view class="settings-label">字体</view>
        <view class="settings-options">
          <view class="settings-option {{fontFamily === 'sans' ? 'settings-option-on' : ''}}" data-value="sans" bindtap="handleSelectFontFamily">黑体</view>
          <view class="settings-option settings-option-serif {{fontFamily === 'serif' ? 'settings-option-on' : ''}}" data-value="serif" bindtap="handleSelectFontFamily">宋体</view>
        </view>
      </view>
      <view class="settings-row">
        <view class="settings-label">纸色</view>
        <view class="settings-options">
          <view class="settings-option {{paperTheme === 'warm' ? 'settings-option-on' : ''}}" data-value="warm" bindtap="handleSelectPaperTheme"><view class="settings-swatch settings-swatch-warm"></view>暖白</view>
          <view class="settings-option {{paperTheme === 'cream' ? 'settings-option-on' : ''}}" data-value="cream" bindtap="handleSelectPaperTheme"><view class="settings-swatch settings-swatch-cream"></view>米黄</view>
          <view class="settings-option {{paperTheme === 'night' ? 'settings-option-on' : ''}}" data-value="night" bindtap="handleSelectPaperTheme"><view class="settings-swatch settings-swatch-night"></view>夜间</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{highlightSelectionVisible}}" class="highlight-selection-mask" bindtap="closeHighlightSelection">
    <view class="highlight-selection-panel" catchtap="noop">
      <view class="highlight-selection-header">
        <view>
          <view class="highlight-selection-title">精确选择</view>
          <view class="highlight-selection-subtitle">勾下想留住的句子，会按原文顺序摘进摘抄本</view>
        </view>
        <view class="highlight-selection-close" bindtap="closeHighlightSelection">×</view>
      </view>

      <scroll-view class="highlight-selection-scroll" scroll-y enhanced="true" show-scrollbar="{{false}}">
        <view
          wx:for="{{highlightSelectionUnits}}"
          wx:key="index"
          class="highlight-unit {{highlightSelectionSelected[index] ? 'highlight-unit-on' : ''}}"
          data-index="{{index}}"
          bindtap="handleToggleHighlightUnit">
          <view class="highlight-unit-check">{{highlightSelectionSelected[index] ? '✓' : ''}}</view>
          <text class="highlight-unit-text">{{item}}</text>
        </view>
      </scroll-view>

      <view class="highlight-selection-preview">
        <text wx:if="{{highlightSelectionText}}">{{highlightSelectionText}}</text>
        <text wx:else class="highlight-selection-placeholder">还没有选择内容</text>
      </view>
      <view class="highlight-selection-foot">
        <text class="highlight-selection-count {{highlightSelectionText && !highlightSelectionValid ? 'highlight-selection-count-warn' : ''}}">
          {{highlightSelectionLength ? '已选 ' + highlightSelectionLength + ' 字' : '最多 500 字'}}
        </text>
        <button
          class="highlight-selection-confirm"
          disabled="{{!highlightSelectionValid}}"
          bindtap="handleConfirmHighlightSelection">摘下来</button>
      </view>
    </view>
  </view>

  <view wx:if="{{posterPanelVisible}}" class="poster-panel-mask" bindtap="closePosterPanel">
    <view class="poster-panel" catchtap="noop">
      <view class="poster-panel-header">
        <view>
          <view class="poster-panel-title">分享此刻</view>
          <view class="poster-panel-subtitle">当前读到的内容已放大呈现</view>
        </view>
        <view class="poster-panel-close" bindtap="closePosterPanel">×</view>
      </view>
      <view class="poster-preview-wrap">
        <image class="poster-preview" src="{{posterTempFilePath}}" mode="aspectFit" />
      </view>
      <view class="poster-actions">
        <button class="poster-btn poster-btn-plain" bindtap="handleSavePoster">保存</button>
        <button class="poster-btn poster-btn-ghost" bindtap="handlePreviewPoster">预览</button>
        <button class="poster-btn" bindtap="handleSharePoster">微信好友</button>
      </view>
    </view>
  </view>

  <canvas
    id="readingMomentCanvas"
    canvas-id="readingMomentCanvas"
    type="2d"
    class="reading-poster-canvas"></canvas>

  <view wx:if="{{!contentReady}}" class="reader-init-mask"></view>
</view>

<podcast-player-bar bottom-offset="120" />
