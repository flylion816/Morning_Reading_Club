.page-reading-mode {
  min-height: 100vh;
  background: var(--app-paper);
  color: var(--app-text);
}

.reader-init-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--app-paper);
  z-index: 999;
}

.reading-topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  min-height: 112rpx;
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  padding-right: 24rpx;
  box-sizing: content-box;
  background: rgba(255, 253, 248, 0.94);
  backdrop-filter: blur(16rpx);
  border-bottom: 1rpx solid var(--app-border);
}

.reading-back {
  width: 72rpx;
  height: 72rpx;
  line-height: 66rpx;
  text-align: center;
  font-size: 64rpx;
  color: var(--app-text-soft);
  flex-shrink: 0;
}

.reading-title-wrap {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

.reading-title-row {
  display: block;
}

.reading-title {
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  color: var(--app-text);
}

.reading-progress {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--theme-primary);
  font-weight: 700;
}

.reading-progress-bar-wrap {
  margin-top: 10rpx;
}

.reading-progress-bar-track {
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-alpha-15);
  overflow: hidden;
}

.reading-progress-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  transition: width 0.3s ease;
}

.reader-scroll {
  height: 100vh;
}

.reader-content {
  padding-left: 48rpx;
  padding-right: 48rpx;
  padding-bottom: calc(54vh + 180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.reader-meta {
  padding: 48rpx 0 36rpx;
}

.reader-period {
  display: inline-flex;
  max-width: 100%;
  margin-left: -18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-tint);
  color: var(--theme-primary-dark);
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.reader-heading {
  margin-top: 28rpx;
  color: #e85d6a;
  font-size: 32rpx;
  font-weight: 800;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.reader-paragraph {
  position: relative;
  margin: 0 0 34rpx;
  padding: 0 0 0 22rpx;
  color: rgba(86, 96, 109, 0.56);
  font-size: 36rpx;
  line-height: 2.05;
  letter-spacing: 0;
  font-weight: 500;
  transition:
    color 0.42s ease,
    opacity 0.42s ease,
    background-color 0.42s ease;
}

.reader-paragraph::before {
  content: "";
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: transparent;
  opacity: 0;
  transition: background-color 0.42s ease, opacity 0.42s ease;
}

.reader-paragraph-active {
  color: var(--app-text);
  font-weight: 700;
  opacity: 1;
}

.reader-paragraph-active::before {
  background: var(--theme-primary);
  opacity: 1;
}

.reader-font-large .reader-paragraph {
  font-size: 40rpx;
}

.reader-font-xlarge .reader-paragraph {
  font-size: 44rpx;
}

.reader-empty {
  padding: 160rpx 0;
  text-align: center;
  color: var(--app-text-muted);
  font-size: 28rpx;
}

.reading-toolbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 30;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx;
  border: 1rpx solid var(--theme-primary-alpha-12);
  border-radius: 32rpx;
  background: rgba(255, 253, 248, 0.96);
  box-shadow: 0 18rpx 50rpx rgba(60, 42, 20, 0.12);
  box-sizing: border-box;
  backdrop-filter: blur(18rpx);
}

.toolbar-btn {
  height: 72rpx;
  min-width: 88rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-text-soft);
  font-size: 26rpx;
  font-weight: 700;
  background: var(--app-page-bg);
  box-sizing: border-box;
}

.toolbar-btn-primary {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  box-shadow: 0 10rpx 24rpx var(--theme-primary-alpha-24);
}

.toolbar-btn-secondary {
  flex: 1;
  min-width: 0;
  padding: 0;
  color: var(--theme-primary-dark);
  background: var(--theme-primary-tint);
}

.poster-panel-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(8, 15, 30, 0.76);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
}

.poster-panel {
  width: 100%;
  max-height: 92vh;
  border-radius: 36rpx 36rpx 0 0;
  background: var(--app-paper);
  padding: 28rpx;
  box-sizing: border-box;
}

.poster-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.poster-panel-title {
  color: var(--app-text);
  font-size: 32rpx;
  font-weight: 800;
}

.poster-panel-subtitle {
  margin-top: 6rpx;
  color: var(--app-text-muted);
  font-size: 22rpx;
}

.poster-panel-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--app-surface-muted);
  color: var(--app-text-muted);
  font-size: 34rpx;
  line-height: 56rpx;
  text-align: center;
}

.poster-preview-wrap {
  height: 760rpx;
  border-radius: 24rpx;
  background: var(--app-surface-muted);
  overflow: hidden;
  box-shadow: inset 0 0 0 1rpx var(--app-border);
}

.poster-preview {
  width: 100%;
  height: 100%;
}

.poster-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.poster-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: var(--theme-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.poster-btn::after {
  border: none;
}

.poster-btn-plain {
  background: var(--app-page-bg);
  color: var(--app-text-soft);
}

.poster-btn-ghost {
  background: var(--theme-primary-tint);
  color: var(--theme-primary-dark);
}

.reading-poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 900px;
  height: 1800px;
  opacity: 0;
  pointer-events: none;
}


.reader-image {
  width: 100%;
  border-radius: 8rpx;
  display: block;
}

.reading-completion-card {
  position: relative;
  margin: 54rpx 0 28rpx;
  padding: 34rpx 32rpx 48rpx;
  border: 1rpx solid rgba(16, 185, 129, 0.22);
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f1fbf5 0%, var(--app-paper) 100%);
  box-shadow: 0 14rpx 34rpx rgba(16, 185, 129, 0.1);
  overflow: visible;
}

.completion-kicker {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(16, 185, 129, 0.12);
  color: #047857;
  font-size: 22rpx;
  font-weight: 700;
}

.completion-title {
  margin-top: 18rpx;
  color: var(--app-text);
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 800;
}

.completion-text {
  margin-top: 12rpx;
  color: var(--app-text-soft);
  font-size: 27rpx;
  line-height: 1.8;
  font-weight: 500;
}

.completion-fireworks-ring {
  position: absolute;
  left: -18rpx;
  right: -18rpx;
  top: -18rpx;
  bottom: -18rpx;
  pointer-events: none;
  opacity: 0;
  animation: fireworksFade 5s ease-out forwards;
}

.firework {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  transform: scale(0.2);
  opacity: 0;
  animation: fireworkBloom 1.08s ease-out forwards;
}

.firework-1 {
  left: 2%;
  top: 8rpx;
  animation-delay: 0.05s;
}

.firework-2 {
  left: 36%;
  top: -6rpx;
  animation-delay: 0.18s;
}

.firework-3 {
  right: 6%;
  top: 8rpx;
  animation-delay: 0.1s;
}

.firework-4 {
  right: -6rpx;
  top: 42%;
  animation-delay: 0.26s;
}

.firework-5 {
  right: 8%;
  bottom: -6rpx;
  animation-delay: 0.15s;
}

.firework-6 {
  left: 44%;
  bottom: -12rpx;
  animation-delay: 0.32s;
}

.firework-7 {
  left: 8%;
  bottom: -6rpx;
  animation-delay: 0.21s;
}

.firework-8 {
  left: -6rpx;
  top: 44%;
  animation-delay: 0.38s;
}

.spark {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 7rpx;
  height: 22rpx;
  margin-left: -3.5rpx;
  margin-top: -11rpx;
  border-radius: 999rpx;
  background: #f5b841;
  transform-origin: 50% 86%;
}

.spark-b {
  background: #10b981;
  transform: rotate(90deg);
}

.spark-c {
  background: var(--theme-primary);
  transform: rotate(45deg);
}

.spark-d {
  background: #f28ca2;
  transform: rotate(135deg);
}

@keyframes fireworksFade {
  0% {
    opacity: 0;
  }

  12% {
    opacity: 1;
  }

  76% {
    opacity: 1;
  }

  100% {
    opacity: 0;
  }
}

@keyframes fireworkBloom {
  0% {
    opacity: 0;
    transform: translateY(24rpx) scale(0.2);
  }

  38% {
    opacity: 1;
    transform: translateY(-12rpx) scale(1);
  }

  100% {
    opacity: 0;
    transform: translateY(-42rpx) scale(1.08);
  }
}

/* Version 1 core-journey polish: a quieter paper reading room. */
.page-reading-mode {
  background:
    radial-gradient(circle at 86% 4%, var(--theme-primary-alpha-05) 0, rgba(255, 255, 255, 0) 300rpx),
    linear-gradient(180deg, var(--app-paper) 0%, var(--app-paper-muted) 100%);
  color: var(--app-text);
}

.reader-init-mask {
  background: var(--app-paper);
}

.reading-topbar {
  padding-bottom: 12rpx;
  background: rgba(255, 253, 248, 0.9);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 8rpx 24rpx rgba(84, 60, 30, 0.04);
}

.reading-back {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: var(--app-text-soft);
  background: rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 0 0 1rpx var(--app-border);
}

.reading-back:active {
  transform: translateY(2rpx) scale(0.97);
}

.reading-title {
  font-size: 28rpx;
  font-weight: 650;
  letter-spacing: -0.3rpx;
}

.reader-content {
  padding-left: 52rpx;
  padding-right: 52rpx;
}

.reader-meta {
  padding: 44rpx 0 30rpx;
}

.reader-period {
  margin-left: 0;
  border-radius: 999rpx;
  font-weight: 650;
}

.reader-heading {
  color: var(--app-text);
  font-size: 46rpx;
  font-weight: 750;
  letter-spacing: -1.4rpx;
  text-decoration: none;
}

.reader-paragraph {
  margin-bottom: 32rpx;
  padding-left: 24rpx;
  color: rgba(60, 71, 64, 0.68);
  font-size: 35rpx;
  line-height: 2;
}

.reader-paragraph-active {
  color: var(--app-text);
}

.reading-toolbar {
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 20rpx 44rpx rgba(84, 60, 30, 0.12);
}

/* Version 3 dawn: 沉浸阅读标题使用衬线体 */
.reading-title {
  font-family: var(--app-font-serif);
}

/* Version 3 dawn: 读完提示与打卡成功同一套晨光画面（小号） */
.reading-completion-card {
  border-color: rgba(138, 75, 18, 0.18);
  background: linear-gradient(180deg, #fbe6c9 0%, #fdf3e3 38%, var(--app-paper) 100%);
  box-shadow: 0 14rpx 34rpx rgba(184, 99, 31, 0.1);
}
.completion-dawn {
  position: relative;
  height: 96rpx;
  margin: -34rpx -32rpx 0;
  overflow: hidden;
  border-radius: 24rpx 24rpx 0 0;
}
.completion-sun {
  position: absolute;
  left: 50%;
  top: 28rpx;
  width: 120rpx;
  height: 120rpx;
  margin-left: -60rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #ffd08a 0%, #f6a94f 62%, #ee9b45 100%);
  box-shadow: 0 0 0 16rpx rgba(255, 200, 130, 0.28), 0 0 0 36rpx rgba(255, 200, 130, 0.14);
  animation: completion-sunrise 1s cubic-bezier(0.22, 0.8, 0.3, 1) both;
}
@keyframes completion-sunrise {
  from { transform: translateY(100rpx); opacity: 0.4; }
  to   { transform: translateY(0); opacity: 1; }
}
.completion-kicker {
  background: var(--app-dawn-soft);
  color: var(--app-dawn-ink);
}
.completion-title {
  font-family: var(--app-font-serif);
  font-weight: 700;
}
.completion-num {
  font-family: var(--app-font-num);
  font-size: 40rpx;
  color: var(--app-dawn-ink);
}
@media (prefers-reduced-motion: reduce) {
  .completion-sun {
    animation: none;
  }
}

/* Version 3 dawn: 阅读设置面板（字号 / 字体 / 纸色） */
.reader-family-serif .reader-paragraph { font-family: var(--app-font-serif); }

.settings-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  background: rgba(40, 28, 12, 0.32);
}

.settings-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + 96rpx + 20rpx + env(safe-area-inset-bottom));
  padding: 12rpx 28rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--app-border);
  border-radius: 32rpx;
  background: var(--app-paper);
  box-shadow: 0 18rpx 50rpx rgba(60, 42, 20, 0.18);
}

.settings-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
}

.settings-row + .settings-row { border-top: 1rpx solid var(--app-border); }

.settings-label {
  flex: 0 0 auto;
  width: 80rpx;
  color: var(--app-text-soft);
  font-size: 26rpx;
  font-weight: 700;
}

.settings-options {
  flex: 1;
  display: flex;
  gap: 14rpx;
}

.settings-option {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--app-border);
  border-radius: 20rpx;
  color: var(--app-text-soft);
  font-size: 26rpx;
}

.settings-option-serif { font-family: var(--app-font-serif); }

.settings-option-on {
  border-color: var(--app-dawn);
  background: var(--app-dawn-soft);
  color: var(--app-dawn-ink);
  font-weight: 700;
}

.settings-swatch {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(92, 70, 44, 0.3);
}
.settings-swatch-warm { background: #fffdf8; }
.settings-swatch-cream { background: #f5ecd7; }
.settings-swatch-night { background: #1f1d1a; }

/* 纸色：用变量覆盖，顶部、底部栏、面板都跟着变 */
.page-reading-mode.paper-cream,
.page-reading-mode.paper-night {
  background: var(--app-paper);
}

.page-reading-mode.paper-cream {
  --app-paper: #f5ecd7;
  --app-paper-muted: #efe3c6;
  --app-page-bg: #efe3c6;
}

.page-reading-mode.paper-cream .reading-topbar,
.page-reading-mode.paper-cream .reading-toolbar {
  background: rgba(245, 236, 215, 0.94);
}

.page-reading-mode.paper-cream .reading-back { background: rgba(255, 253, 248, 0.5); }
.page-reading-mode.paper-cream .reader-paragraph { color: rgba(60, 50, 34, 0.6); }
.page-reading-mode.paper-cream .reader-paragraph-active { color: var(--app-text); }
.page-reading-mode.paper-cream .reading-completion-card { background: linear-gradient(180deg, #f1ead0 0%, var(--app-paper) 100%); }

.page-reading-mode.paper-night {
  --app-paper: #1f1d1a;
  --app-paper-muted: #1f1d1a;
  --app-page-bg: #2a2723;
  --app-text: #d9d2c5;
  --app-text-soft: #b8b0a2;
  --app-text-muted: #8f887b;
  --app-border: rgba(217, 210, 197, 0.16);
  --app-dawn-soft: rgba(238, 155, 69, 0.18);
  --app-dawn-ink: #f0c48a;
  --theme-primary-tint: rgba(217, 210, 197, 0.1);
  --theme-primary-dark: #e0b36e;
  color: #d9d2c5;
}

.page-reading-mode.paper-night .reading-topbar,
.page-reading-mode.paper-night .reading-toolbar {
  background: rgba(31, 29, 26, 0.94);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
}

.page-reading-mode.paper-night .reading-back { background: rgba(217, 210, 197, 0.08); }
.page-reading-mode.paper-night .reader-paragraph { color: rgba(217, 210, 197, 0.45); }
.page-reading-mode.paper-night .reader-paragraph-active { color: #d9d2c5; }
.page-reading-mode.paper-night .reader-paragraph-active::before { background: var(--app-dawn); }
.page-reading-mode.paper-night .reading-progress-bar-track { background: rgba(217, 210, 197, 0.16); }
.page-reading-mode.paper-night .reading-progress { color: #b8b0a2; }
.page-reading-mode.paper-night .reader-image { opacity: 0.85; }
.page-reading-mode.paper-night .reading-completion-card {
  border-color: rgba(217, 210, 197, 0.16);
  background: linear-gradient(180deg, #2a2723 0%, #1f1d1a 100%);
  box-shadow: none;
}
.page-reading-mode.paper-night .completion-kicker {
  background: rgba(238, 155, 69, 0.18);
  color: #f0c48a;
}
.page-reading-mode.paper-night .completion-title,
.page-reading-mode.paper-night .completion-text { color: #d9d2c5; }
.page-reading-mode.paper-night .poster-panel { background: #1f1d1a; }
.page-reading-mode.paper-night .poster-panel-title,
.page-reading-mode.paper-night .poster-panel-subtitle,
.page-reading-mode.paper-night .poster-panel-close { color: #d9d2c5; }
.page-reading-mode.paper-night .settings-mask { background: rgba(0, 0, 0, 0.5); }

/* Features: 同行感名次与摘抄标记 */
.completion-rank {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--app-text-secondary, #8a7a66);
  text-align: center;
}
.completion-rank-num {
  font-family: var(--app-font-num);
  color: var(--app-dawn);
}
.reader-paragraph-mine::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 18rpx;
  bottom: 18rpx;
  width: 3rpx;
  border-radius: 999rpx;
  background: var(--app-dawn);
}
.reader-paragraph-popular text {
  text-decoration: underline dashed;
  text-decoration-color: rgba(184, 99, 31, 0.3);
  text-underline-offset: 10rpx;
}
.reader-popular-note {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.6;
  font-weight: 400;
  color: rgba(138, 122, 102, 0.8);
}
.page-reading-mode.paper-night .reader-popular-note { color: rgba(217, 210, 197, 0.6); }
.page-reading-mode.paper-night .reader-paragraph-popular text { text-decoration-color: rgba(240, 190, 120, 0.5); }
.page-reading-mode.paper-night .completion-rank { color: #b8b0a2; }
