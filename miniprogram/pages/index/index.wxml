<!--首页页面-->
<view wx:if="{{showLoginEntryTransition}}" class="login-entry-bridge">
  <view class="login-entry-bridge-glow"></view>
  <view class="login-entry-bridge-line"></view>
</view>
<activity-popup
  show="{{showActivityPopup}}"
  activity="{{popupActivity}}"
  bind:close="handlePopupClose"
  bind:viewdetail="handlePopupViewDetail"
/>
<view class="page-profile">
  <!-- 已登录状态 - 显示主页内容 -->
  <view class="user-content" wx:if="{{isLogin}}">
    <!-- 晨光问候区 -->
    <view class="dawn-hero dawn-hero-{{daypart}}" wx:if="{{!(loading && !userStats)}}">
      <view class="dawn-hello">
        <view class="dawn-hello-text">
          <text class="dawn-greeting">{{greeting}}，{{userInfo.nickname || userInfo.name || '书友'}}</text>
          <text class="dawn-date">{{dateText}}{{periodDayText ? ' · ' + periodDayText : ''}}</text>
        </view>
        <view class="dawn-hello-actions">
          <view class="task-notification-entry dawn-bell" bindtap="navigateToNotifications">
            <view class="dawn-bell-icon app-icon app-icon-bell"></view>
            <text
              wx:if="{{unreadNotificationCount > 0}}"
              class="task-notification-badge dawn-bell-badge"
            >{{unreadNotificationCount > 99 ? '99+' : unreadNotificationCount}}</text>
          </view>
          <view class="dawn-avatar" style="background: {{userInfo.avatarColor || themePrimaryColor}}" bindtap="openEditProfile">
            <user-avatar
              size="68"
              avatar-url="{{userInfo.avatarUrl}}"
              avatar-text="{{userInfo.avatarText || '用'}}"
              avatar-color="{{userInfo.avatarColor || themePrimaryColor}}"
            />
          </view>
        </view>
      </view>

      <!-- 旅程进度：一条地平线，每天一个刻度 -->
      <view class="dawn-journey">
        <!-- 天空：太阳或月亮按现在几点停在弧线上，进来时从最左端升上来 -->
        <view class="sky sky-{{skyBody}} sky-{{skyPhase}} {{skyReady ? 'sky-ready' : ''}}">
          <view class="sky-orbit"></view>
          <view class="sky-star sky-star-1"></view>
          <view class="sky-star sky-star-2"></view>
          <view class="sky-star sky-star-3"></view>
          <view class="sky-arm" style="transform: rotate({{skyAngle}}deg);">
            <view class="sky-body-wrap" style="transform: rotate({{-skyAngle}}deg);">
              <view class="sky-rays"></view>
              <view class="sky-body"></view>
            </view>
          </view>
        </view>
        <view class="dawn-horizon" wx:if="{{journeyTicks.length > 0}}">
          <view wx:for="{{journeyTicks}}" wx:key="index" class="dawn-tick dawn-tick-{{item.state}}">
            <view class="dawn-tick-dot"></view>
          </view>
        </view>
        <text class="dawn-presence" wx:if="{{presenceText}}">{{presenceText}}</text>
        <text class="dawn-journey-text"><text wx:if="{{userStats.currentStreak > 0}}">连续晨读 <text class="dawn-num">{{userStats.currentStreak}}</text> 天 · </text>写下 <text class="dawn-num">{{userStats.totalCheckinDays || 0}}</text> 天</text>
      </view>
    </view>

    <!-- 首页加载骨架 -->
    <view class="dawn-skeleton" wx:if="{{loading && !userStats}}">
      <view class="app-skeleton dawn-skeleton-hero"></view>
      <view class="app-skeleton dawn-skeleton-card"></view>
      <view class="app-skeleton dawn-skeleton-card"></view>
    </view>

    <!-- 内容区域 -->
    <view class="content-area app-stagger app-stagger-2" wx:if="{{!(loading && !userStats)}}">
      <block wx:for="{{homeSections}}" wx:key="key">
      <!-- 近期活动 -->
      <view class="activity-section" wx:if="{{item.key === 'recentActivities' && upcomingActivities.length > 0 && canUsePaidFeatures}}">
        <view class="section-header">
          <view class="section-header-left">
            <view class="app-seal app-seal-dawn app-seal-sm">聚</view>
            <text class="section-header-title">近期活动</text>
          </view>
          <view class="section-header-right" bindtap="handleMoreActivities">
            <text class="more-text">查看更多</text>
          </view>
        </view>
        <view class="activity-cards">
          <view
            class="activity-card"
            wx:for="{{upcomingActivities}}"
            wx:key="_id"
            data-id="{{item._id}}"
            bindtap="handleActivityCardTap"
          >
            <text class="activity-card-type">{{item.type === 'witness' ? '见证会' : item.type === 'chat' ? '聊天局' : item.type === 'cooking' ? '料理人生' : '活动局'}}</text>
            <text class="activity-card-title">{{item.title}}</text>
            <text class="activity-card-time">{{item.startDateText}}</text>
          </view>
        </view>
      </view>

      <!-- 凡人生活 -->
      <view class="zaichang-section" wx:if="{{item.key === 'zaichang' && canUsePaidFeatures}}">
        <view class="section-header">
          <view class="section-header-left">
            <view class="app-seal app-seal-dawn app-seal-sm">在</view>
            <text class="section-header-title">凡人生活</text>
          </view>
          <view class="section-header-right" bindtap="navigateToZaichangPublish">
            <text class="more-text zaichang-publish-text">留下印记</text>
          </view>
        </view>

        <scroll-view
          wx:if="{{zaichangImprints.length > 0}}"
          scroll-x
          class="checkins-scroll"
          show-scrollbar="{{false}}"
          enhanced="true">
          <view class="checkins-scroll-track">
            <view
              wx:for="{{zaichangImprints}}"
              wx:key="_id"
              class="zaichang-card"
              bindtap="onTapZaichangCard"
              data-id="{{item._id}}"
            >
              <view class="zaichang-card-cover">
                <video
                  wx:if="{{item.coverUrl && item.coverType === 'video'}}"
                  class="zaichang-card-img zaichang-card-video"
                  src="{{item.coverUrl}}"
                  object-fit="cover"
                  controls="{{false}}"
                  show-play-btn="{{false}}"
                  show-center-play-btn="{{false}}"
                  enable-play-gesture="{{false}}"
                  autoplay="{{false}}"
                  muted
                />
                <image wx:elif="{{item.coverUrl}}" class="zaichang-card-img" src="{{item.coverUrl}}" mode="aspectFill" lazy-load/>
                <view wx:else class="zaichang-card-img-placeholder"><view class="app-seal">在</view></view>
                <view wx:if="{{item.coverUrl && item.coverType === 'video'}}" class="zaichang-card-video-badge"><view class="app-icon app-icon-play"></view></view>
              </view>
              <view class="zaichang-card-title">{{item.title}}</view>
              <view class="zaichang-card-meta">{{item.authorName}}{{item.dateStr ? ' · ' + item.dateStr : ''}}</view>
            </view>

            <view class="checkin-diary-more-card zaichang-more-card" bindtap="navigateToZaichang">
              <view class="checkin-diary-more-icon">→</view>
              <text class="checkin-diary-more-title">进入在场</text>
              <view class="checkin-diary-more-desc">
                <view>查看更多</view>
                <view>聚会印记</view>
              </view>
            </view>
          </view>
        </scroll-view>

        <view wx:else class="checkins-empty">
          <text class="checkins-empty-text">还没有印记，去留下第一个吧</text>
          <view class="checkins-empty-link" bindtap="navigateToZaichang">
            <text>进入在场</text>
            <text class="more-arrow">→</text>
          </view>
        </view>
      </view>

      <!-- 今日晨读 -->
      <view class="dawn-task" wx:if="{{item.key === 'todayTask' && todaySection}}">
        <!-- 慢递邮局：开营头几天提醒写信，信到了提醒拆信 -->
        <view
          wx:if="{{homeLetterNote && currentPeriodCommunityState === 'enabled'}}"
          class="home-letter home-letter-{{homeLetterNote.kind}}"
          hover-class="home-letter-hover"
          catchtap="handleHomeLetterTap">
          <view class="home-letter-env">
            <view class="home-letter-env-flap"></view>
            <view class="home-letter-env-stamp">{{homeLetterNote.kind === 'arrived' ? '到' : (homeLetterNote.kind === 'sealed' ? '寄' : '邮')}}</view>
            <view class="home-letter-env-wax" wx:if="{{homeLetterNote.kind === 'arrived'}}"></view>
          </view>
          <view class="home-letter-body">
            <text class="home-letter-kicker">慢递邮局</text>
            <text class="home-letter-title">{{homeLetterNote.title}}</text>
            <text class="home-letter-sub">{{homeLetterNote.sub}}</text>
          </view>
          <view class="home-letter-cta">{{homeLetterNote.cta}}</view>
        </view>
        <view class="dawn-card dawn-card-task" wx:if="{{todaySection}}" catchtap="handleTodaySectionClick">
          <view class="dawn-card-head">
            <view class="app-seal app-seal-dawn app-seal-sm">晨</view>
            <text class="dawn-card-title">今日晨读</text>
            <text class="dawn-card-day">{{todaySection.dayDisplay}}</text>
          </view>
          <view class="dawn-welcome-back" wx:if="{{welcomeBackText}}">{{welcomeBackText}}</view>
          <view class="dawn-title-area">
            <image class="dawn-bamboo" src="/assets/images/today-bamboo.png" mode="aspectFit"></image>
            <view class="dawn-title-text">
              <view class="dawn-course-title">{{todaySection.title}}</view>
              <image class="dawn-title-brush" src="/assets/images/today-brush.png" mode="aspectFit"></image>
            </view>
          </view>
          <view class="dawn-moment">{{todayCard.message}}</view>
          <view class="dawn-extract" wx:if="{{todaySection.extractText}}">{{todaySection.extractText}}</view>
          <view class="dawn-meta" wx:if="{{currentPeriodCommunityState === 'enabled' && todaySection.checkinCount > 0}}">
            <view wx:for="{{todaySection.visibleCheckinUsers}}" wx:key="index" wx:if="{{currentPeriodCommunityState === 'enabled'}}" class="mini-avatar" style="z-index: {{99 - index}}">
              <user-avatar
                size="38"
                avatar-url="{{item.avatarUrl}}"
                avatar-text="{{item.avatarText || '用'}}"
                avatar-color="{{item.avatarColor || themePrimaryColor}}"
                user-id="{{item.userId || item._id}}"
                interactive="true"
                bind:avatarTap="handleMiniAvatarClick"
              />
            </view>
            <text class="dawn-meta-text">{{todaySection.checkinCount}}人已打卡</text>
          </view>
          <button wx:if="{{todayCard.primary.type === 'read'}}" class="dawn-btn dawn-btn-task" catchtap="handleJoinMeeting">
            <text>{{todayCard.primary.text}}</text>
          </button>
          <button wx:else class="dawn-btn dawn-btn-task" catchtap="handleCreateCheckin">
            <text>{{todayCard.primary.text}}</text>
          </button>
          <view class="dawn-links" wx:if="{{todayCard.showDailyCard || todayCard.showDirectCheckin || todayCard.showStudy || todayCard.showReadingLink || todaySection.podcastUrl || (todaySection.canShowReportShortcut && currentPeriodReport && currentPeriodReport.hasReport)}}">
            <text class="dawn-link" wx:if="{{todayCard.showDailyCard}}" catchtap="handleDailyCardTap">生成晨读卡片</text>
            <text class="dawn-link" wx:if="{{todaySection.podcastUrl}}" catchtap="handleTodayPodcastBtnTap">听播客</text>
            <text class="dawn-link" wx:if="{{todaySection.canShowReportShortcut && currentPeriodReport && currentPeriodReport.hasReport}}" catchtap="handleTodayReportBtnTap">看实录</text>
            <text class="dawn-link" wx:if="{{todayCard.showDirectCheckin}}" catchtap="handleCreateCheckin">直接去打卡</text>
            <text class="dawn-link" wx:if="{{todayCard.showStudy}}" catchtap="handleCreateCheckin">去学习</text>
            <text class="dawn-link" wx:if="{{todayCard.showReadingLink}}" catchtap="handleJoinMeeting">{{todayCard.readingLinkText}}</text>
          </view>
        </view>
      </view>


      <view class="camp-corner-section" wx:if="{{item.key === 'campCorner' && currentPeriodCommunityState === 'enabled' && currentPeriod && campCornerStatus !== 'idle'}}">
        <view class="section-header">
          <view class="section-header-left">
            <view class="app-seal app-seal-dawn app-seal-sm">营</view>
            <text class="section-header-title">营地角落</text>
          </view>
        </view>
        <view wx:if="{{campCornerStatus === 'loading'}}" class="camp-corner-state">
          <view class="app-skeleton camp-corner-skeleton"></view>
          <text class="camp-corner-state-text">营地角落正在打开…</text>
        </view>
        <view wx:elif="{{campCornerStatus === 'error'}}" class="camp-corner-state camp-corner-state-error" bindtap="retryCampCorner">
          <text class="camp-corner-state-text">角落暂时没打开，点这里再试一次</text>
        </view>
        <view wx:elif="{{campCornerCards.length > 0}}" class="camp-corner-row">
          <view wx:for="{{campCornerCards}}" wx:key="key" class="camp-corner-card" bindtap="handleCampCornerTap" data-kind="{{item.kind}}">
            <view class="camp-corner-head">
              <view class="camp-corner-icon"><view class="app-icon app-icon-{{item.kind === 'letter' ? 'mail' : (item.kind === 'practice' ? 'flag' : 'users')}}"></view></view>
              <text class="camp-corner-kicker">{{item.kind === 'letter' ? '慢递邮局' : (item.kind === 'practice' ? '实修' : '读伴')}}</text>
            </view>
            <view wx:if="{{item.paired}}" class="camp-corner-paired">
              <text class="camp-corner-title">{{item.title}}</text>
              <view class="camp-corner-dots">
                <text class="camp-corner-dot-label">读</text>
                <view class="camp-corner-dot {{item.read ? 'camp-corner-dot-on' : ''}}"></view>
                <text class="camp-corner-dot-label">记</text>
                <view class="camp-corner-dot {{item.checked ? 'camp-corner-dot-on' : ''}}"></view>
              </view>
            </view>
            <block wx:else>
              <text class="camp-corner-title {{item.single ? 'camp-corner-title-single' : ''}}">{{item.title}}</text>
              <text wx:if="{{item.sub}}" class="camp-corner-sub">{{item.sub}}</text>
            </block>
          </view>
        </view>
        <view wx:else class="camp-corner-state">
          <text class="camp-corner-state-text">今天先读书，角落里没有新安排</text>
        </view>
      </view>

      <view class="checkins-section" wx:if="{{item.key === 'myCheckins' && canUsePaidFeatures}}">
        <view class="section-header">
          <view class="section-header-left">
            <view class="app-seal app-seal-dawn app-seal-sm">记</view>
            <text class="section-header-title">我的打卡</text>
          </view>
          <view class="section-header-right">
            <text class="leaf-all" bindtap="navigateToCheckinRecords">全部 ›</text>
            <button class="checkin-create-button" bindtap="navigateToNewCheckin" aria-label="新建打卡">
              <view class="checkin-create-icon app-icon app-icon-plus"></view>
            </button>
          </view>
        </view>

        <view wx:if="{{recentCheckins.length > 0}}" class="leafs">
          <view
            wx:for="{{recentCheckins}}"
            wx:key="id"
            wx:if="{{index < 3}}"
            class="leaf"
            bindtap="handleRecentCheckinTap"
            data-checkin-id="{{item.id}}"
            data-section-id="{{item.sectionId}}"
            data-period-id="{{item.periodId}}">
            <view class="leaf-date">
              <text class="leaf-day">{{item.dayNum}}</text>
              <text class="leaf-month">{{item.monthLabel}}</text>
            </view>
            <view class="leaf-body">
              <view class="leaf-title">{{item.sectionTitle}}</view>
              <view class="leaf-preview">{{item.preview}}</view>
            </view>
          </view>
        </view>

        <view wx:else class="checkins-empty">
          <text class="checkins-empty-text">最近还没有打卡日记</text>
          <view class="checkins-empty-link" bindtap="navigateToCheckinRecords">
            <text>去看看我的打卡日记</text>
            <text class="more-arrow">→</text>
          </view>
        </view>
      </view>

      <!-- 小凡看见：一封信 -->
      <view class="insights-section" wx:if="{{item.key === 'xiaofanInsights' && canUsePaidFeatures}}">
        <view
          wx:if="{{recentInsights.length > 0}}"
          class="insight-env"
          data-id="{{recentInsights[0].id}}"
          catchtap="handleInsightClick">
          <view class="insight-env-flap"></view>
          <view class="insight-env-stamp"><text class="insight-env-stamp-word">见</text></view>
          <view class="insight-env-postmark" wx:if="{{recentInsights[0].dateLabel}}">{{recentInsights[0].dateLabel}}</view>
          <view class="insight-env-wax {{recentInsights[0].unread ? '' : 'insight-env-wax-read'}}">凡</view>
          <view class="insight-env-body">
            <text class="insight-env-to">{{userInfo.nickname || userInfo.name || '书友'}} 收</text>
            <text class="insight-env-title">{{recentInsights[0].unread ? '小凡给你留了一封信' : '小凡写给你的信'}}</text>
            <text class="insight-env-sub">{{recentInsights[0].courseTitle}}</text>
          </view>
        </view>
        <view wx:else class="insight-env insight-env-empty" catchtap="navigateToInsights">
          <view class="insight-env-flap"></view>
          <view class="insight-env-wax insight-env-wax-empty">凡</view>
          <view class="insight-env-body">
            <text class="insight-env-title">小凡的信还在路上</text>
            <text class="insight-env-sub">本期还没有小凡看见的记录</text>
          </view>
        </view>
        <view class="insights-more" catchtap="navigateToInsights">
          <text class="more-text">{{recentInsights.length > 1 ? '信箱里还有 ' + (recentInsights.length - 1) + ' 封' : '打开信箱'}}</text>
          <text class="more-arrow">→</text>
        </view>
      </view>

      <!-- 请求看见 -->
      <view class="requests-section" wx:if="{{item.key === 'insightRequests' && canUsePaidFeatures}}">
        <view class="section-header">
          <view class="section-header-left">
            <view class="app-seal app-seal-dawn app-seal-sm">请</view>
            <text class="section-header-title">请求看见</text>
          </view>
        </view>
        <view class="request-direction-tabs">
          <view
            wx:for="{{requestDirectionTabs}}"
            wx:key="value"
            class="request-direction-tab {{activeInsightRequestDirection === item.value ? 'request-direction-tab-active' : ''}}"
            bindtap="handleInsightRequestDirectionTap"
            data-direction="{{item.value}}">
            <text>{{item.label}}</text>
          </view>
        </view>
        <view class="requests-content">
          <view
            wx:for="{{insightRequests}}"
            wx:key="id"
            id="request-{{item.id}}"
            class="request-item {{highlightRequestId === item.id ? 'request-item-focused' : ''}}"
            bindtap="handleInsightRequestTap"
            data-request="{{item}}">
            <view class="request-item-left">
              <view class="request-user-avatar">
                <user-avatar
                  size="68"
                  avatar-url="{{item.displayUserAvatarUrl}}"
                  avatar-text="{{item.displayUserAvatarText}}"
                  avatar-color="{{item.avatarColor || themePrimaryColor}}"
                  user-id="{{item.displayUserId}}"
                  event-data="{{item}}"
                  interactive="true"
                  bind:avatarTap="handleRequestAvatarClick"
                />
              </view>
              <view class="request-info">
                <view class="request-top-row">
                  <text class="request-user-role">{{item.displayUserRoleText}}</text>
                  <text class="request-user-name">{{item.displayUserName}}</text>
                </view>
                <text class="request-meta">{{item.requestMeta}}</text>
                <text class="request-time">{{item.time}}</text>
              </view>
            </view>
            <view class="request-side">
              <text class="request-status request-status-{{item.statusClass}}">{{item.statusText}}</text>
              <view class="request-actions" wx:if="{{item.canApprove || item.canReject}}">
                <view class="request-btn approve-btn" catchtap="handleApproveRequest" data-request="{{item}}">
                  <text>同意</text>
                </view>
                <view class="request-btn reject-btn" catchtap="handleRejectRequest" data-request="{{item}}">
                  <text>拒绝</text>
                </view>
              </view>
            </view>
          </view>
          <view class="requests-empty" wx:if="{{insightRequests.length === 0}}">
            {{insightRequestEmptyText}}
          </view>
        </view>
        <view class="requests-more" wx:if="{{insightRequestTotal > 3}}" catchtap="navigateToInsightRequests">
          <text class="more-text">查看更多</text>
          <text class="more-arrow">→</text>
        </view>
      </view>
      </block>
    </view>
  </view>

  <!-- 未登录且加载中：骨架屏，避免白屏 -->
  <view class="dawn-skeleton" wx:if="{{!isLogin && loading}}">
    <view class="app-skeleton dawn-skeleton-hero"></view>
    <view class="app-skeleton dawn-skeleton-card"></view>
    <view class="app-skeleton dawn-skeleton-card"></view>
  </view>

  <!-- 未登录状态 - 应用介绍页 -->
  <view class="guest-content" wx:if="{{!isLogin && !loading}}">
    <view class="guest-banner guest-banner-dawn">
      <view class="app-seal app-seal-lg app-seal-dawn guest-seal">晨</view>
      <text class="guest-title">{{brandName}}</text>
      <text class="guest-subtitle">每日晨读，遇见更好的自己</text>
    </view>

    <!-- 功能亮点 -->
    <view class="guest-features">
      <view class="guest-feature-item">
        <view class="feature-icon-wrap">
          <view class="app-seal">读</view>
        </view>
        <view class="feature-text">
          <text class="feature-title">每日晨读</text>
          <text class="feature-desc">每天 15 分钟</text>
        </view>
      </view>
      <view class="guest-feature-item">
        <view class="feature-icon-wrap">
          <view class="app-seal">记</view>
        </view>
        <view class="feature-text">
          <text class="feature-title">学习进度</text>
          <text class="feature-desc">看见自己的节奏</text>
        </view>
      </view>
      <view class="guest-feature-item">
        <view class="feature-icon-wrap">
          <view class="app-seal">问</view>
        </view>
        <view class="feature-text">
          <text class="feature-title">课程引导</text>
          <text class="feature-desc">问题与行动练习</text>
        </view>
      </view>
      <view class="guest-feature-item">
        <view class="feature-icon-wrap">
          <view class="app-seal">律</view>
        </view>
        <view class="feature-text">
          <text class="feature-title">晨读节奏</text>
          <text class="feature-desc">稳步积累习惯</text>
        </view>
      </view>
    </view>

    <!-- 底部登录提示 -->
    <view class="guest-next-card">
      <view class="guest-next-copy">
        <text class="guest-next-title">可以先看看课</text>
        <text class="guest-next-desc">浏览课程不需要登录，想留下学习记录时再登录</text>
      </view>
      <view class="guest-next-actions">
        <view class="guest-next-primary" bindtap="handleBackHome">浏览课程</view>
        <view class="guest-next-secondary" bindtap="goToLogin">登录看数据</view>
      </view>
    </view>
  </view>

  <!-- 编辑个人信息模态框 -->
  <view class="edit-profile-modal" wx:if="{{showEditProfile}}" catchtap="closeEditProfile">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">编辑个人信息</text>
        <text class="modal-close" bindtap="closeEditProfile">×</text>
      </view>

      <!-- 头像 -->
      <view class="modal-section">
        <text class="section-label">头像</text>
        <view class="avatar-picker-panel">
          <view class="avatar-preview" style="background: {{editForm.avatarColor || themePrimaryColor}}">
            <user-avatar
              size="116"
              avatar-url="{{editForm.avatarUrl}}"
              avatar-text="{{editForm.avatarText || '用'}}"
              avatar-color="{{editForm.avatarColor || themePrimaryColor}}"
            />
          </view>
          <view class="avatar-picker-info">
            <text class="avatar-picker-title">使用你的微信头像</text>
            <text class="avatar-picker-desc">头像仅用于晨读营内展示</text>
          </view>
          <button class="avatar-action-button primary" open-type="chooseAvatar" bindchooseavatar="handleChooseWechatAvatar">
            更换微信头像
          </button>
        </view>
      </view>

      <!-- 昵称输入 -->
      <view class="modal-section">
        <text class="section-label">昵称</text>
        <input
          class="modal-input"
          type="text"
          placeholder="请输入你的昵称"
          placeholder-class="input-placeholder"
          value="{{editForm.nickname}}"
          bindinput="onNicknameInput"
          maxlength="20"
        />
        <text class="input-count">{{editForm.nickname.length}}/20</text>
      <view wx:if="{{nicknameError}}" class="nickname-error">{{nicknameError}}</view>
      <view wx:if="{{profileSaveHint}}" class="profile-save-hint">{{profileSaveHint}}</view>
      </view>

      <!-- 个人签名输入 -->
      <view class="modal-section">
        <text class="section-label">个人签名</text>
        <textarea
          class="modal-textarea"
          placeholder="选填，分享你的座右铭或想法"
          placeholder-class="input-placeholder"
          value="{{editForm.signature}}"
          bindinput="onSignatureInput"
          maxlength="200"
          show-confirm-bar="false"
          fixed="false"
        ></textarea>
        <text class="input-count">{{editForm.signature.length}}/200</text>
      </view>

      <!-- 操作按钮 -->
      <view class="modal-actions">
        <view class="btn btn-cancel" bindtap="closeEditProfile">取消</view>
        <view class="btn btn-submit {{isSavingProfile ? 'loading' : ''}}" bindtap="saveUserProfile">
          {{isSavingProfile ? '保存中...' : '保存'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 晨读时间确认弹窗 -->
  <view class="morning-read-modal" wx:if="{{showMorningReadPrompt}}" catchtap="handleMorningReadPromptCancel">
    <view class="morning-read-card" catchtap="stopPropagation">
      <view class="morning-read-visual">
        <view class="morning-read-sun"></view>
        <view class="morning-read-book"><view class="app-icon app-icon-book"></view></view>
      </view>
      <view class="morning-read-title">今天的晨读时间到了</view>
      <view class="morning-read-desc">
        <text>趁早上安静的 10 分钟，</text>
        <text>咱们一起读完今天这一课。</text>
      </view>
      <view class="morning-read-actions">
        <view class="morning-read-btn morning-read-btn-cancel" bindtap="handleMorningReadPromptCancel">取消</view>
        <view class="morning-read-btn morning-read-btn-primary" bindtap="handleMorningReadPromptGo">
          <text>去晨读</text>
          <text class="morning-read-arrow">→</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 拆信转场：点首页的信封后，信封打开、信纸抽出、铺满成纸，再进到信里 -->
  <view class="envopen" wx:if="{{envOpening}}" catchtap="stopPropagation" catchtouchmove="stopPropagation">
    <view class="envopen-env">
      <view class="envopen-back"></view>
      <view class="envopen-flap"></view>
      <view class="envopen-letter">
        <view class="envopen-line envopen-line-1"></view>
        <view class="envopen-line"></view>
        <view class="envopen-line"></view>
        <view class="envopen-line envopen-line-4"></view>
        <text class="envopen-sign">小凡</text>
      </view>
      <view class="envopen-front"></view>
      <view class="envopen-wax">凡</view>
    </view>
    <view class="envopen-paper"></view>
  </view>
</view>

<podcast-player-bar has-tabbar="{{true}}" ignore-safe-area="{{true}}" />
