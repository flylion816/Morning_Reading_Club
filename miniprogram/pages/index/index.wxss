    radial-gradient(circle at 20% 0%, var(--theme-primary-alpha-08) 0, rgba(255,255,255,0) 280rpx),
    var(--app-page-bg);
  padding-bottom: 120rpx;
}

.guest-banner {
  background:
    radial-gradient(circle at 78% 4%, rgba(255,255,255,0.22) 0, rgba(255,255,255,0) 220rpx),
