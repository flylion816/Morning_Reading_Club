}

.zaichang-card-video-badge {
  position: absolute;
  left: 12rpx;
  bottom: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 28rpx;
  pointer-events: none;
}

.zaichang-card-img-placeholder {
