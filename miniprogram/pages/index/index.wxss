  display: flex;
  align-items: center;
  justify-content: center;
}

.morning-read-book .app-icon {
  width: 44rpx;
  height: 44rpx;
  color: var(--theme-primary-dark);
}

.guest-seal {
  margin-bottom: 20rpx;
  background: var(--app-paper);
  color: var(--theme-primary-dark);
}

.feature-icon-wrap {
  background: transparent;
}

.user-name,
.period-title-new,
.today-task-empty-title {
  font-family: var(--app-font-serif);
}

.user-streak .streak-number {
  font-family: var(--app-font-num);
}

/* Version 3 dawn: 首屏与今日晨读 */
.page-profile {
  background: var(--app-page-bg);
}

.dawn-hero {
  position: relative;
  overflow: hidden;
  padding: 24rpx 36rpx 36rpx;
  color: var(--app-text);
}

.dawn-hero-dawn {
  background: linear-gradient(180deg, #fbe3c3 0%, #fdf0dd 62%, var(--app-page-bg) 100%);
}

.dawn-hero-dawn::before {
  content: "";
  position: absolute;
  right: -60rpx;
  bottom: -50rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--app-dawn-glow) 0%, rgba(255, 196, 120, 0) 70%);
}

.dawn-hero-day {
  background: linear-gradient(180deg, var(--app-paper) 0%, var(--app-page-bg) 100%);
}

.dawn-hero-day::before {
  content: "";
  position: absolute;
  right: -80rpx;
  top: -60rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--theme-primary-alpha-08) 0%, rgba(255, 255, 255, 0) 70%);
}

.dawn-hero-dusk {
  background: linear-gradient(180deg, #f3c7b2 0%, #fbe4d2 62%, var(--app-page-bg) 100%);
}

.dawn-hero-night {
  /* 深色一直延伸到 92%，最后一小段才过渡到纸色，保证所有浅色文字都落在深底上 */
  background: linear-gradient(180deg, #1f2a44 0%, #34425f 92%, var(--app-page-bg) 100%);
  padding-bottom: 56rpx;
  color: #f4ead9;
}

/* 一弯月亮：纯 CSS，大圆减去偏移的小圆 */
.dawn-hero-night::before {
  content: "";
  position: absolute;
  right: 150rpx;
  top: 30rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: transparent;
  box-shadow: 10rpx 6rpx 0 0 #f4ead9;
  opacity: 0.9;
}

.dawn-hello {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.dawn-hello-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.dawn-greeting {
  font-family: var(--app-font-serif);
  font-size: 58rpx;
  line-height: 1.3;
  letter-spacing: 0.02em;
  color: inherit;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dawn-date {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--app-text-soft);
}

.dawn-hero-night .dawn-date,
.dawn-hero-night .dawn-journey-text {
  color: rgba(244, 234, 217, 0.78);
}

.dawn-hello-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.dawn-bell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
  color: var(--app-text-soft);
}

.dawn-hero-night .dawn-bell {
  background: rgba(255, 255, 255, 0.14);
  color: #f4ead9;
}

.dawn-bell-icon {
  width: 36rpx;
  height: 36rpx;
}

.dawn-bell-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
}

.dawn-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, 0.8);
  box-sizing: border-box;
}

.dawn-avatar-img {
  width: 100%;
  height: 100%;
}

.dawn-avatar-text {
  font-size: 30rpx;
  color: #fff;
}

/* 旅程：地平线 */
.dawn-journey {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
}

.dawn-horizon {
  position: relative;
  display: flex;
  align-items: center;
  height: 44rpx;
}

.dawn-horizon::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 2rpx;
  background: rgba(92, 70, 44, 0.18);
}

.dawn-hero-night .dawn-horizon::before {
  background: rgba(244, 234, 217, 0.28);
}

.dawn-tick {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.dawn-tick-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  box-sizing: border-box;
}

.dawn-tick-past .dawn-tick-dot {
  background: var(--app-dawn);
}

.dawn-tick-future .dawn-tick-dot {
  border: 2rpx solid rgba(92, 70, 44, 0.4);
  background: var(--app-page-bg);
}

.dawn-hero-night .dawn-tick-future .dawn-tick-dot {
  border-color: rgba(244, 234, 217, 0.55);
  background: #2a3652;
}

.dawn-tick-today .dawn-tick-dot {
  width: 30rpx;
  height: 30rpx;
  background: radial-gradient(circle, #ffd08a 0%, #f6a94f 62%, var(--app-dawn) 100%);
  box-shadow: 0 0 0 8rpx rgba(255, 200, 130, 0.32), 0 0 0 18rpx rgba(255, 200, 130, 0.16);
}

.dawn-journey-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--app-text-soft);
}

.dawn-num {
  font-family: var(--app-font-num);
  font-size: 30rpx;
  color: var(--app-dawn-ink);
}

.dawn-hero-night .dawn-num {
  color: #ffd08a;
}

/* 骨架屏 */
.dawn-skeleton {
  padding: 24rpx 24rpx 0;
}

.dawn-skeleton-hero {
  height: 260rpx;
  border-radius: var(--app-radius-lg);
  margin-bottom: 24rpx;
}

.dawn-skeleton-card {
  height: 300rpx;
  border-radius: var(--app-radius-lg);
  margin-bottom: 24rpx;
}

/* 今日晨读卡 */
.dawn-task {
  margin-bottom: 24rpx;
}

.dawn-card {
  padding: 32rpx;
  background: var(--app-paper);
  border-radius: 40rpx;
  border: 1rpx solid rgba(92, 70, 44, 0.06);
  box-shadow: 0 12rpx 34rpx rgba(84, 60, 30, 0.06);
}

.dawn-card-task {
  position: relative;
  overflow: hidden;
  padding: 36rpx 32rpx 24rpx;
  text-align: center;
}

.dawn-card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.dawn-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--app-text);
}

.dawn-card-day {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--app-text-muted);
}

.dawn-title-area {
  position: relative;
  margin: 30rpx 0 4rpx;
}

.dawn-title-text {
  position: relative;
  z-index: 1;
  padding: 0 16rpx;
  text-align: center;
}

.dawn-bamboo {
  position: absolute;
  top: -4rpx;
  right: -36rpx;
  width: 240rpx;
  height: 120rpx;
  opacity: 0.82;
  pointer-events: none;
}

.dawn-course-title {
  font-family: var(--app-font-serif);
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 0.03em;
  color: var(--app-text);
}

.dawn-card-task .dawn-course-title {
  font-size: 38rpx;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dawn-title-brush {
  display: block;
  width: 220rpx;
  height: 38rpx;
  margin: -8rpx auto 0;
}

.dawn-moment {
  margin: 0 0 26rpx;
  color: var(--app-text-soft);
  font-size: 28rpx;
  line-height: 1.6;
}

.dawn-extract {
  margin: 16rpx 0 20rpx;
  padding-left: 20rpx;
  border-left: 5rpx solid var(--app-dawn);
  font-family: var(--app-font-serif);
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--app-text-soft);
}

.dawn-meta {
  display: flex;
  align-items: center;
  margin: 18rpx 0 24rpx;
  font-size: 24rpx;
  color: var(--app-text-muted);
}

.dawn-meta-text {
  margin-left: 14rpx;
}

.dawn-meta .mini-avatar:first-child + .dawn-meta-text,
.dawn-meta > .dawn-meta-text:first-child {
  margin-left: 0;
}

.dawn-steps {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  font-size: 24rpx;
  color: var(--app-text-muted);
}

.dawn-step {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dawn-step-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 3rpx solid rgba(92, 70, 44, 0.25);
  font-family: var(--app-font-serif);
  font-size: 22rpx;
}

.dawn-step-done {
  color: var(--app-text-soft);
}

.dawn-step-done .dawn-step-dot {
  border-color: var(--app-dawn-deep);
  color: var(--app-dawn-deep);
  background: var(--app-dawn-soft);
}

.dawn-step-current {
  color: var(--app-text);
  font-weight: 600;
}

.dawn-step-current .dawn-step-dot {
  border-color: var(--app-dawn);
  background: var(--app-dawn);
  color: #fff;
}

.dawn-step-line {
  flex: 1;
  min-width: 20rpx;
  margin: 0 12rpx;
  border-top: 2rpx dashed rgba(92, 70, 44, 0.25);
}

/* 主按钮：行动色仍是租户主色，晨光色只用于时间与进度 */
.dawn-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 14rpx 30rpx var(--theme-primary-alpha-24);
}

.dawn-btn:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.dawn-card-task .dawn-btn-task {
  display: inline-flex;
  width: auto;
  min-width: 260rpx;
  height: 76rpx;
  margin: 0;
  padding: 0 54rpx;
  border: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1.4;
  box-shadow: 0 8rpx 18rpx var(--theme-primary-alpha-24);
}

.dawn-card-task .dawn-btn-task::after {
  border: 0;
}

.dawn-btn-done {
  background: var(--app-success-soft);
  color: var(--app-success);
  box-shadow: none;
}

.dawn-links {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 16rpx 40rpx;
  margin-top: 22rpx;
}

.dawn-link {
  font-size: 26rpx;
  color: var(--app-text-muted);
  padding: 6rpx 8rpx;
}

.dawn-card-task .dawn-link {
  display: inline-flex;
  min-height: 76rpx;
  align-items: center;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.dawn-card-empty .dawn-empty-body {
  margin-bottom: 28rpx;
}

.dawn-empty-mark {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.dawn-empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--app-text-soft);
}

/* 未登录介绍页：与问候区同一套晨光背景 */
.guest-banner-dawn {
  background: linear-gradient(180deg, #fbe3c3 0%, #fdf0dd 62%, var(--app-page-bg) 100%);
}

.guest-banner-dawn .guest-title {
  color: var(--app-text);
  font-family: var(--app-font-serif);
}

.guest-banner-dawn .guest-subtitle {
  color: var(--app-text-soft);
}

/* 晨读时间提醒：太阳改用晨光色 */
.morning-read-sun {
  background: radial-gradient(circle, #ffd08a 0%, #f6a94f 62%, var(--app-dawn) 100%);
  box-shadow: 0 0 0 14rpx rgba(255, 200, 130, 0.28), 0 10rpx 28rpx var(--app-dawn-glow);
}

/* 小凡看见：首页小号信封（与小凡看见列表页同一种视觉） */
.insight-item {
  padding: 46rpx 20rpx 20rpx 22rpx;
  border: 1rpx solid rgba(92, 70, 44, 0.12);
  border-left: 1rpx solid rgba(92, 70, 44, 0.12);
  border-radius: 12rpx;
  background: var(--app-paper) !important;
}

.insight-item + .insight-item {
  margin-top: 14rpx;
}

.insight-flap {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 24rpx;
  pointer-events: none;
  background:
    linear-gradient(to bottom right, transparent calc(50% - 1rpx), rgba(92, 70, 44, 0.16) 50%, transparent calc(50% + 1rpx)) left top / 50% 100% no-repeat,
    linear-gradient(to bottom left, transparent calc(50% - 1rpx), rgba(92, 70, 44, 0.16) 50%, transparent calc(50% + 1rpx)) right top / 50% 100% no-repeat;
}

.insight-period-tag {
  font-family: var(--app-font-serif);
}

/* Features: 同行感、营地角落 */
.dawn-presence {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--app-text-soft);
}

.camp-corner-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.camp-corner-card {
  flex: 1;
  min-width: 0;
  min-height: 128rpx;
  padding: 20rpx 18rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: var(--app-surface, #fffaf2);
  border: 1rpx solid var(--app-line, rgba(0, 0, 0, 0.06));
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.camp-corner-title {
  font-family: var(--app-font-serif);
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--app-text);
}

.camp-corner-title-single {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.camp-corner-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--app-text-soft);
}

.camp-corner-paired {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
}

.camp-corner-dots {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 12rpx;
}

.camp-corner-dot-label {
  font-size: 22rpx;
  color: var(--app-text-soft);
  margin-right: 6rpx;
}

.camp-corner-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  background: transparent;
  border: 2rpx solid var(--app-text-soft);
  box-sizing: border-box;
}

.camp-corner-dot-on {
  background: var(--app-dawn, #d98a4a);
  border-color: var(--app-dawn, #d98a4a);
}

/* Preview parity: 地平线上方的太阳与弧线、我的打卡日期页签、小凡看见信封卡。 */
.dawn-horizon {
  height: 92rpx;
  align-items: flex-end;
  padding-bottom: 6rpx;
}
.dawn-horizon::before {
  top: auto;
  bottom: 12rpx;
}
.dawn-horizon::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 12rpx;
  height: 76rpx;
  border-top: 2rpx dashed rgba(138, 75, 18, 0.2);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
  pointer-events: none;
}
.dawn-hero-night .dawn-horizon::after {
  border-top-color: rgba(244, 234, 217, 0.22);
}
.dawn-tick {
  height: 12rpx;
  z-index: 1;
}
.dawn-tick-today .dawn-tick-dot {
  position: absolute;
  left: 50%;
  bottom: 30rpx;
  margin-left: -15rpx;
}
.dawn-tick-today::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  height: 20rpx;
  border-left: 2rpx dashed rgba(138, 75, 18, 0.32);
}
.dawn-hero-night .dawn-tick-today::after {
  border-left-color: rgba(244, 234, 217, 0.4);
}

.section-header-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.leaf-all {
  font-size: 24rpx;
  color: var(--app-text-muted);
  padding: 8rpx 0;
}
.leafs {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.leaf {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(92, 70, 44, 0.08);
}
.leaf:first-child {
  padding-top: 0;
  border-top: none;
}
.leaf:active {
  opacity: 0.7;
}
.leaf-date {
  flex-shrink: 0;
  width: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 10rpx;
  border-radius: 14rpx;
  background: var(--app-dawn-soft);
  color: var(--app-dawn-ink);
}
.leaf-day {
  font-family: var(--app-font-num);
  font-size: 40rpx;
  line-height: 1.1;
}
.leaf-month {
  font-size: 20rpx;
  line-height: 1.3;
}
.leaf-body {
  flex: 1;
  min-width: 0;
}
.leaf-title {
  font-family: var(--app-font-serif);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--app-text);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.leaf-preview {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--app-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.insight-env {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 4rpx 0 20rpx;
}
.insight-env:active {
  opacity: 0.8;
}
.insight-env-wax {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #c9614a, #9c3b28);
  color: #fff3e6;
  font-family: var(--app-font-serif);
  font-size: 34rpx;
  line-height: 76rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(120, 40, 20, 0.3);
}
.insight-env-wax-empty {
  background: none;
  color: var(--app-text-soft);
  border: 2rpx dashed rgba(92, 70, 44, 0.3);
  box-shadow: none;
  line-height: 72rpx;
}
.insight-env-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.insight-env-title {
  font-family: var(--app-font-serif);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--app-text);
  line-height: 1.5;
}
.insight-env-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--app-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.insight-env-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: var(--app-text-soft);
}

/* 小凡看见：一只信封（封口折线、邮票、邮戳、火漆）。 */
.insights-section .insight-env {
  position: relative;
  display: block;
  overflow: hidden;
  padding: 0;
  min-height: 300rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  background: linear-gradient(180deg, #fbf3e2 0%, #f6ead3 100%);
  border: 1rpx solid rgba(92, 70, 44, 0.16);
  box-shadow: 0 10rpx 26rpx rgba(84, 60, 30, 0.12);
}
/* 封口：一个转了 45° 的方形，只露出下面的尖角 */
.insight-env-flap {
  position: absolute;
  left: 50%;
  top: -449rpx;
  width: 480rpx;
  height: 480rpx;
  margin-left: -240rpx;
  transform: scaleX(2.5) rotate(45deg);
  background: #fffaf0;
  border-right: 1rpx solid rgba(92, 70, 44, 0.2);
  border-bottom: 1rpx solid rgba(92, 70, 44, 0.2);
  box-shadow: 6rpx 6rpx 14rpx rgba(84, 60, 30, 0.08);
}
.insight-env-stamp {
  position: absolute;
  right: 24rpx;
  top: 22rpx;
  width: 64rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--app-paper);
  border: 2rpx dashed rgba(184, 99, 31, 0.55);
  border-radius: 4rpx;
  transform: rotate(4deg);
}
.insight-env-stamp-word {
  font-family: var(--app-font-serif);
  font-size: 30rpx;
  color: var(--app-dawn-deep);
}
.insight-env-postmark {
  position: absolute;
  right: 66rpx;
  top: 62rpx;
  width: 84rpx;
  height: 84rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid rgba(138, 75, 18, 0.4);
  color: rgba(138, 75, 18, 0.62);
  font-family: var(--app-font-num);
  font-size: 22rpx;
  transform: rotate(-14deg);
}
.insights-section .insight-env-wax {
  position: absolute;
  left: 50%;
  top: 92rpx;
  margin-left: -38rpx;
}
.insights-section .insight-env-body {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 184rpx 32rpx 30rpx;
  text-align: center;
}
.insight-env-to {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--app-text-muted);
}
.insights-section .insight-env-title {
  margin-top: 6rpx;
  font-size: 32rpx;
}
.insights-section .insight-env-sub {
  max-width: 100%;
}
.insight-env-empty .insight-env-flap {
  box-shadow: none;
}

/* 营地角落：每张卡一个图标和栏目名，下面才是一句话。 */
.camp-corner-card {
  min-height: 188rpx;
  padding: 22rpx 20rpx 20rpx;
  background: var(--app-paper);
  border-color: rgba(92, 70, 44, 0.1);
}
.camp-corner-card:active {
  opacity: 0.75;
}
.camp-corner-state {
  min-height: 132rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--app-radius-md);
  background: var(--app-paper);
  color: var(--app-text-muted);
  text-align: center;
}
.camp-corner-state-error {
  color: var(--app-dawn-ink);
  background: var(--app-dawn-soft);
}
.camp-corner-state-text {
  font-size: 24rpx;
}
.camp-corner-skeleton {
  width: 72%;
  height: 28rpx;
  min-height: 28rpx;
  margin: 0;
}
.camp-corner-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.camp-corner-icon {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--app-dawn-soft);
  color: var(--app-dawn-deep);
}
.camp-corner-icon .app-icon {
  width: 30rpx;
  height: 30rpx;
}
.camp-corner-kicker {
  font-size: 22rpx;
  color: var(--app-dawn-ink);
  white-space: nowrap;
}
.camp-corner-title {
  font-size: 26rpx;
  color: var(--app-text);
}

/* 夜间：角落里的月亮会压在通知铃上，去掉；改为地平线上「今天」的位置挂一弯月亮。 */
.dawn-hero-night::before {
  display: none;
}
.dawn-hero-night .dawn-tick-today .dawn-tick-dot {
  background: #f4ead9;
  box-shadow: inset -10rpx -3rpx 0 0 #2e3b58, 0 0 0 10rpx rgba(244, 234, 217, 0.1);
}

/* Features: 隔了几天回来时，今日卡片上的一句话 */
.dawn-welcome-back {
  margin: 4rpx 0 20rpx;
  padding: 16rpx 22rpx;
  text-align: left;
  border-radius: 16rpx;
  background: var(--app-dawn-soft);
  color: var(--app-dawn-ink);
  font-size: 25rpx;
  line-height: 1.6;
}

/* Features: 小凡的信读过之后，火漆换成拆开的样子（空心） */
.insights-section .insight-env-wax-read {
  background: var(--app-paper);
  color: #9c3b28;
  border: 2rpx solid rgba(156, 59, 40, 0.45);
  box-shadow: none;
  line-height: 72rpx;
}

/* Features: 首页天空。太阳或月亮按现在几点停在弧线上；弧线是一段圆弧（弦 600rpx、拱高 76rpx、半径 630rpx），
   摆臂绕圆心转一个角度，天体就沿着弧线走。地平线是 .sky 的下边，天体落到地平线以下的部分被裁掉。 */
.sky {
  position: relative;
  height: 124rpx;
  overflow: hidden;
  border-bottom: 2rpx solid rgba(92, 70, 44, 0.18);
}
.dawn-hero-night .sky {
  border-bottom-color: rgba(244, 234, 217, 0.28);
}
.sky-orbit {
  position: absolute;
  left: 50%;
  top: 48rpx;
  width: 1260rpx;
  height: 1260rpx;
  margin-left: -630rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 2rpx dashed rgba(138, 75, 18, 0.2);
}
.dawn-hero-night .sky-orbit {
  border-color: rgba(244, 234, 217, 0.22);
}
.sky-arm {
  position: absolute;
  left: 50%;
  top: 48rpx;
  width: 0;
  height: 630rpx;
  transform-origin: 0 630rpx;
}
.sky-body-wrap {
  position: absolute;
  left: -40rpx;
  top: -40rpx;
  width: 80rpx;
  height: 80rpx;
  opacity: 0.35;
}
/* 进来时的那一段：摆臂从最左端转到现在的位置，天体自己反着转回来，保持正着 */
.sky-ready .sky-arm,
.sky-ready .sky-body-wrap {
  transition: transform 5.5s cubic-bezier(0.3, 0.6, 0.3, 1), opacity 1.6s ease;
}
.sky-ready .sky-body-wrap {
  opacity: 1;
}
.sky-body {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  margin: -22rpx 0 0 -22rpx;
  border-radius: 50%;
  box-sizing: border-box;
  transition: background 0.6s ease, box-shadow 0.6s ease;
}
.sky-rays {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  opacity: 0;
}
.sky-star {
  display: none;
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #f4ead9;
  animation: skyTwinkle 3.2s ease-in-out infinite;
}
.sky-star-1 { left: 22%; top: 30rpx; }
.sky-star-2 { left: 47%; top: 14rpx; animation-delay: 1.1s; }
.sky-star-3 { left: 71%; top: 40rpx; animation-delay: 2s; }
@keyframes skyTwinkle {
  0%, 100% { opacity: 0.25; }
  50% { opacity: 0.95; }
}

/* 日出：刚露头，橙红，没有光晕外圈 */
.sky-sunrise .sky-body {
  background: radial-gradient(circle, #ffb873 0%, #f08a4b 70%, #e5703a 100%);
  box-shadow: 0 0 0 10rpx rgba(240, 138, 75, 0.2);
}
/* 上午：金色，一圈柔光 */
.sky-morning .sky-body {
  background: radial-gradient(circle, #ffd89a 0%, #f6a94f 65%, var(--app-dawn) 100%);
  box-shadow: 0 0 0 8rpx rgba(255, 200, 130, 0.32), 0 0 0 18rpx rgba(255, 200, 130, 0.16);
}
/* 正午：最亮，大一号，外面一圈慢慢转的光芒 */
.sky-noon .sky-body {
  width: 50rpx;
  height: 50rpx;
  margin: -25rpx 0 0 -25rpx;
  background: radial-gradient(circle, #fff1c9 0%, #ffcf73 55%, #f6a94f 100%);
  box-shadow: 0 0 0 8rpx rgba(255, 207, 115, 0.4), 0 0 26rpx 12rpx rgba(255, 207, 115, 0.45);
}
.sky-noon .sky-rays {
  width: 116rpx;
  height: 116rpx;
  margin: -58rpx 0 0 -58rpx;
  opacity: 1;
  background: repeating-conic-gradient(rgba(246, 169, 79, 0.7) 0deg 5deg, rgba(246, 169, 79, 0) 5deg 30deg);
  -webkit-mask-image: radial-gradient(circle, rgba(0, 0, 0, 0) 0, rgba(0, 0, 0, 0) 36rpx, #000 38rpx, rgba(0, 0, 0, 0) 58rpx);
  animation: skyRaysSpin 24s linear infinite;
}
@keyframes skyRaysSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
/* 下午：暖金，光晕收一点 */
.sky-afternoon .sky-body {
  background: radial-gradient(circle, #ffd08a 0%, #f39f48 70%, #ea8f3c 100%);
  box-shadow: 0 0 0 8rpx rgba(243, 159, 72, 0.26), 0 0 0 16rpx rgba(243, 159, 72, 0.12);
}
/* 日落：橙红，落到地平线只剩半个 */
.sky-sunset .sky-body {
  background: radial-gradient(circle, #ffa56b 0%, #ec7545 70%, #d95c35 100%);
  box-shadow: 0 0 0 10rpx rgba(236, 117, 69, 0.22), 0 0 0 22rpx rgba(236, 117, 69, 0.1);
}

/* 月亮：用内阴影画月相，圆本身是透明的 */
.sky-moon .sky-body {
  width: 40rpx;
  height: 40rpx;
  margin: -20rpx 0 0 -20rpx;
  background: transparent;
}
.sky-moon-crescent .sky-body {
  box-shadow: inset -11rpx -4rpx 0 0 #f4ead9;
}
.sky-moon-gibbous .sky-body {
  box-shadow: inset -27rpx -3rpx 0 0 #f4ead9, 0 0 0 10rpx rgba(244, 234, 217, 0.08);
}
.sky-moon-late .sky-body {
  box-shadow: inset -9rpx -3rpx 0 0 #f4ead9;
}
/* 傍晚天还亮着（18:00–19:30 底色是黄昏）：月亮用深一点的金色，才看得见 */
.dawn-hero-dusk .sky-moon .sky-body,
.dawn-hero-day .sky-moon .sky-body,
.dawn-hero-dawn .sky-moon .sky-body {
  box-shadow: inset -11rpx -4rpx 0 0 #b98a4e;
}
.dawn-hero-night .sky-moon .sky-star {
  display: block;
}

/* 天空接管了太阳和月亮：下面这排只标「营期第几天」，今天是一个空心圆点 */
.dawn-horizon {
  height: 14rpx;
  margin-top: -8rpx;
  padding-bottom: 0;
  align-items: center;
}
.dawn-horizon::before,
.dawn-horizon::after,
.dawn-tick-today::after {
  display: none;
}
.dawn-tick-today .dawn-tick-dot,
.dawn-hero-night .dawn-tick-today .dawn-tick-dot {
  position: static;
  width: 18rpx;
  height: 18rpx;
  margin-left: 0;
  background: var(--app-paper);
  border: 4rpx solid var(--app-dawn);
  box-shadow: none;
}
.dawn-hero-night .dawn-tick-today .dawn-tick-dot {
  background: #2a3652;
}

@media (prefers-reduced-motion: reduce) {
  .sky-ready .sky-arm,
  .sky-ready .sky-body-wrap {
    transition: none;
  }
  .sky-noon .sky-rays,
  .sky-star {
    animation: none;
  }
}

/* Features: 拆信转场（约 2.9 秒，时长要和 index.js 的 ENVELOPE_OPEN_MS 对上）。
   0–0.5s 信封浮上来 → 0.5–1.1s 火漆裂开 → 0.9–1.7s 封盖翻开 → 1.5–2.4s 信纸抽出 → 2.2–2.9s 铺满成一张纸。 */
.envopen {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 950;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(43, 38, 34, 0.5);
  animation: envFade 0.4s ease both;
}
.envopen-env {
  position: relative;
  width: 520rpx;
  height: 340rpx;
  margin-top: 120rpx;
  animation: envRise 0.5s cubic-bezier(0.22, 0.8, 0.3, 1) both;
}
.envopen-back,
.envopen-front {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 14rpx;
}
.envopen-back {
  top: 0;
  background: #ead9bd;
  box-shadow: 0 24rpx 60rpx rgba(43, 30, 12, 0.35);
}
/* 信封正面：下半截的口袋，左右两片斜着压上来 */
.envopen-front {
  top: 0;
  z-index: 3;
  background: linear-gradient(180deg, #f6ead4 0%, #f1e2c6 100%);
  clip-path: polygon(0 0, 50% 52%, 100% 0, 100% 100%, 0 100%);
}
/* 封盖：一个朝下的三角，绕上边翻开 */
.envopen-flap {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 190rpx;
  z-index: 4;
  background: linear-gradient(180deg, #f3e4c8 0%, #e9d6b4 100%);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  transform-origin: 50% 0;
  animation: envFlap 0.8s ease-in-out 0.9s both;
}
.envopen-wax {
  position: absolute;
  left: 50%;
  top: 150rpx;
  z-index: 5;
  width: 76rpx;
  height: 76rpx;
  margin-left: -38rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #c9614a, #9c3b28);
  color: #fff3e6;
  font-family: var(--app-font-serif);
  font-size: 34rpx;
  line-height: 76rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(120, 40, 20, 0.3);
  animation: envWax 0.6s ease-in 0.5s both;
}
.envopen-letter {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  top: 24rpx;
  height: 300rpx;
  z-index: 2;
  box-sizing: border-box;
  padding: 44rpx 40rpx 0;
  border-radius: 8rpx;
  background: var(--app-paper);
  box-shadow: 0 6rpx 18rpx rgba(84, 60, 30, 0.16);
  animation: envLetter 0.9s cubic-bezier(0.3, 0.7, 0.3, 1) 1.5s both, envLetterGrow 0.7s ease-in 2.2s forwards;
}
.envopen-line {
  height: 4rpx;
  margin-bottom: 30rpx;
  border-radius: 4rpx;
  background: rgba(138, 75, 18, 0.2);
}
.envopen-line-1 { width: 46%; background: rgba(138, 75, 18, 0.34); }
.envopen-line-4 { width: 62%; }
.envopen-sign {
  position: absolute;
  right: 40rpx;
  bottom: 30rpx;
  font-family: var(--app-font-serif);
  font-size: 26rpx;
  color: var(--app-dawn-ink);
}
/* 最后铺满的那张纸：和信的页面同色，跳过去时接得上 */
.envopen-paper {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9;
  background: var(--app-paper);
  opacity: 0;
  animation: envFade 0.6s ease-in 2.3s both;
}
@keyframes envFade {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes envRise {
  from { transform: translateY(80rpx) scale(0.86); opacity: 0; }
  to { transform: translateY(0) scale(1); opacity: 1; }
}
@keyframes envWax {
  0% { transform: scale(1); opacity: 1; }
  45% { transform: scale(1.18); opacity: 1; }
  100% { transform: scale(1.5); opacity: 0; }
}
@keyframes envFlap {
  0% { transform: rotateX(0deg); z-index: 4; }
  50% { transform: rotateX(90deg); z-index: 4; }
  51% { z-index: 1; }
  100% { transform: rotateX(180deg); z-index: 1; }
}
@keyframes envLetter {
  from { transform: translateY(0); }
  to { transform: translateY(-250rpx); }
}
@keyframes envLetterGrow {
  from { transform: translateY(-250rpx) scale(1); }
  to { transform: translateY(-250rpx) scale(1.5); }
}
@media (prefers-reduced-motion: reduce) {
  .envopen-env,
  .envopen-flap,
  .envopen-wax,
  .envopen-letter {
    animation: none;
  }
}

/* Features: 今日晨读上方的慢递邮局提醒。像一张压在桌上的信封便签：左边一只小信封，右边一句话和一个按钮。 */
.home-letter {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
  padding: 26rpx 26rpx 26rpx 24rpx;
  border-radius: 24rpx;
  background:
    repeating-linear-gradient(135deg, rgba(184, 71, 47, 0.55) 0 10rpx, rgba(255, 253, 248, 0) 10rpx 20rpx, rgba(61, 111, 166, 0.5) 20rpx 30rpx, rgba(255, 253, 248, 0) 30rpx 40rpx) top / 100% 6rpx no-repeat,
    var(--app-paper);
  border: 1rpx solid rgba(138, 75, 18, 0.14);
  box-shadow: 0 10rpx 28rpx rgba(84, 60, 30, 0.08);
  overflow: hidden;
}
.home-letter-hover {
  opacity: 0.9;
}
.home-letter-arrived {
  background:
    repeating-linear-gradient(135deg, rgba(184, 71, 47, 0.55) 0 10rpx, rgba(255, 253, 248, 0) 10rpx 20rpx, rgba(61, 111, 166, 0.5) 20rpx 30rpx, rgba(255, 253, 248, 0) 30rpx 40rpx) top / 100% 6rpx no-repeat,
    linear-gradient(120deg, var(--app-dawn-soft) 0%, var(--app-paper) 70%);
}
/* 小信封 */
.home-letter-env {
  position: relative;
  flex-shrink: 0;
  width: 112rpx;
  height: 78rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #f6ead4 0%, #eedcbc 100%);
  box-shadow: 0 4rpx 10rpx rgba(84, 60, 30, 0.14);
  transform: rotate(-4deg);
}
.home-letter-env-flap {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 44rpx;
  background: #e8d4b0;
  clip-path: polygon(0 0, 100% 0, 50% 100%);
}
.home-letter-env-stamp {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 26rpx;
  height: 30rpx;
  border: 2rpx dashed rgba(138, 75, 18, 0.45);
  border-radius: 3rpx;
  background: var(--app-paper);
  color: var(--app-dawn-ink);
  font-family: var(--app-font-serif);
  font-size: 16rpx;
  line-height: 28rpx;
  text-align: center;
}
.home-letter-env-wax {
  position: absolute;
  left: 50%;
  top: 30rpx;
  width: 26rpx;
  height: 26rpx;
  margin-left: -13rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #c9614a, #9c3b28);
  box-shadow: 0 2rpx 6rpx rgba(120, 40, 20, 0.35);
  animation: homeLetterWax 2.4s ease-in-out infinite;
}
@keyframes homeLetterWax {
  0%, 100% { box-shadow: 0 2rpx 6rpx rgba(120, 40, 20, 0.35), 0 0 0 0 rgba(201, 97, 74, 0.35); }
  50% { box-shadow: 0 2rpx 6rpx rgba(120, 40, 20, 0.35), 0 0 0 10rpx rgba(201, 97, 74, 0); }
}
.home-letter-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.home-letter-kicker {
  font-size: 21rpx;
  letter-spacing: 0.2em;
  color: var(--app-dawn-ink);
}
.home-letter-title {
  margin-top: 6rpx;
  font-family: var(--app-font-serif);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--app-text);
}
.home-letter-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--app-text-muted);
}
.home-letter-cta {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-dark);
  color: var(--theme-on-primary, #fff);
  font-size: 24rpx;
  font-weight: 600;
}
.home-letter-arrived .home-letter-cta {
  background: #a8452f;
}
@media (prefers-reduced-motion: reduce) {
  .home-letter-env-wax { animation: none; }
}


/* 慢递邮局提醒和今日晨读之间留出间距，各是一张完整的卡片 */
.home-letter {
  margin-bottom: 24rpx;
}
