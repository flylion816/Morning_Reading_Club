}

.zaichang-more-card {
  height: 260rpx;
}

.nickname-error { color: #c23b32; font-size: 26rpx; line-height: 1.5; margin-top: 12rpx; }
.profile-save-hint { color: var(--app-text-soft); font-size: 24rpx; line-height: 1.5; margin-top: 6rpx; }

/* Version 1 core-journey polish: keep the warm paper language and quiet the page. */
