}

/* 今日播客卡片 */
.podcast-today-section {
  background: var(--app-surface);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.section-icon-podcast {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: var(--theme-primary-tint);
  color: var(--theme-primary-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.podcast-today-card {
  display: flex;
  align-items: center;
  background: var(--app-surface-muted);
  border-radius: 18rpx;
  padding: 24rpx 24rpx;
  margin-top: 4rpx;
}

.podcast-today-card-info {
  flex: 1;
  overflow: hidden;
  margin-right: 20rpx;
}

.podcast-today-card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--app-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.podcast-today-play-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx var(--theme-primary-alpha-26);
}

.podcast-today-play-btn.playing {
  background: var(--app-text);
}

.podcast-today-play-icon {
  font-size: 28rpx;
  color: #fff;
  line-height: 1;
  margin-left: 4rpx;
}

/* 近期活动区块 */
.section-icon-calendar {
  width: auto;
  height: auto;
  min-width: 34rpx;
  border-radius: 0;
  background: transparent;
  border: none;
  color: inherit;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 400;
  margin-right: 6rpx;
  box-shadow: none;
  text-shadow: none;
}

.activity-cards {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.activity-card {
  background:
    linear-gradient(180deg, var(--app-paper) 0%, var(--app-surface-muted) 100%);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid rgba(92, 70, 44, 0.08);
  transition: transform 0.18s ease, background 0.18s ease;
}

.activity-card:active {
  transform: translateY(2rpx) scale(0.99);
  background: var(--app-surface-muted);
}

.activity-card-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.activity-card-left {
  flex: 1;
  min-width: 0;
}

.activity-card-type {
  display: inline-block;
  background: var(--app-surface-muted);
  color: var(--theme-primary);
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  white-space: nowrap;
  border: 1rpx solid var(--theme-primary-alpha-12);
}

.activity-card-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--app-text);
}

.activity-card-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.activity-card-time {
  font-size: 24rpx;
  color: var(--app-text-muted);
  flex-shrink: 0;
  white-space: nowrap;
}

/* 凡人生活区块 */
.section-icon-zaichang {
  width: auto;
  height: auto;
  min-width: 34rpx;
  border-radius: 0;
  background: transparent;
  border: none;
  color: inherit;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 400;
  box-shadow: none;
