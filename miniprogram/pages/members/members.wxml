<!--成员列表页面-->
<view class="page-members" wx:if="{{socialAccessGranted}}">
  <!-- 成员统计 -->
  <view class="members-header">
    <view class="total-count">
      <text class="count-label">共</text>
      <text class="count-number">{{totalMembers}}</text>
      <text class="count-label">人</text>
    </view>
  </view>

  <!-- 成员列表 -->
  <view class="members-list">
    <view
      wx:for="{{members}}"
      wx:key="userId"
      class="member-item"
      bindtap="handleAvatarClick"
      data-user-id="{{item.userId}}">
      <user-avatar
        size="88"
        avatar-url="{{item.avatarUrl}}"
        avatar-text="{{item.avatarText}}"
        avatar-color="{{item.avatarColor}}"
        user-id="{{item.userId}}"
        interactive="true"
        bind:avatarTap="handleAvatarClick"
      />
      <view class="member-info">
        <view class="member-name">{{item.nickname}}</view>
        <view class="member-join-date">加入时间：{{item.enrolledAt}}</view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{members.length === 0}}" class="app-empty">
      <view class="app-empty-art app-empty-art-sprout"></view>
      <text class="app-empty-title">还没有书友加入</text>
    </view>
  </view>
</view>

<podcast-player-bar />
