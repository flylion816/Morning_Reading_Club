.page-insight-requests {
  min-height: 100vh;
  background: var(--app-page-bg);
  padding: 24rpx;
}

.requests-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notification-reminder {
  background: #fff8e8;
  border: 2rpx solid #f7d48b;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: #8a5a00;
}

.notification-reminder-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.6;
}

.notification-reminder-link {
  flex-shrink: 0;
  color: var(--theme-primary-dark);
  font-size: 22rpx;
  font-weight: 600;
}

.request-direction-tabs {
  display: flex;
  align-items: center;
  padding: 6rpx;
  margin-bottom: 16rpx;
  background: var(--app-surface-muted);
  border-radius: 14rpx;
}

.request-direction-tab {
  flex: 1;
  height: 56rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--app-text-soft);
  font-weight: 600;
}

.request-direction-tab-active {
  color: var(--app-text);
  background: var(--app-paper);
  box-shadow: 0 4rpx 12rpx rgba(60, 42, 20, 0.08);
}

.requests-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  font-size: 26rpx;
  color: var(--app-text-muted);
}

.request-item {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  padding: 16rpx 14rpx;
  background: var(--app-surface-muted);
  border-radius: 12rpx;
  border: none;
  transition: transform 0.2s ease, background 0.2s ease;
}

.request-item:active {
  background: var(--app-paper-muted);
  transform: scale(0.99);
}

.request-item-left {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.request-user-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx var(--theme-primary-alpha-16);
  overflow: hidden;
}

.request-avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.request-avatar-text {
  font-size: 28rpx;
  color: white;
  font-weight: 600;
}

.request-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  flex: 1;
  min-width: 0;
}

.request-top-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.request-user-role {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--app-text-muted);
}

.request-user-name {
  min-width: 0;
  font-size: 26rpx;
  color: var(--app-text);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.request-status {
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  align-self: flex-end;
}

.request-status-pending {
  background: var(--app-paper-muted);
  color: var(--theme-primary);
}

.request-status-approved {
  background: #e8f8ef;
  color: #1f9d55;
}

.request-status-rejected {
  background: #fff1f0;
  color: #d94841;
}

.request-status-revoked {
  background: var(--app-surface-muted);
  color: var(--app-text-soft);
}

.request-meta {
  font-size: 24rpx;
  color: var(--app-text-soft);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.request-time {
  font-size: 20rpx;
  color: var(--app-text-muted);
}

.request-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  margin-left: 12rpx;
  flex-shrink: 0;
  min-width: 168rpx;
}

.request-actions {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: nowrap;
  margin-top: auto;
}

.request-btn {
  min-width: 76rpx;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  transition: all 0.3s;
}

.approve-btn {
  background: var(--theme-primary);
  color: #ffffff;
}

.reject-btn {
  background: var(--app-surface-muted);
  color: var(--app-text-soft);
}

.approve-btn:active,
.reject-btn:active {
  transform: scale(0.96);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 180rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--app-text-muted);
}

/* Version 2 consistency polish: request cards and status chips. */
.page-insight-requests {
  min-height: 100vh;
  background:
    radial-gradient(circle at 90% 0%, var(--theme-primary-alpha-08) 0, rgba(255, 255, 255, 0) 300rpx),
    linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}
.request-direction-tabs {
  border-radius: 999rpx;
  background: var(--app-paper);
  box-shadow: var(--app-shadow-soft);
}
.request-item {
  border-radius: var(--app-radius-lg);
  border-color: rgba(92, 70, 44, 0.07);
  box-shadow: var(--app-shadow-soft);
}
.request-status {
  border-radius: 999rpx;
}
.request-item:active,
.request-direction-tab:active {
  transform: translateY(2rpx) scale(0.99);
}


/* Version 3 dawn: 空态图标。 */
.app-empty { margin: 80rpx 24rpx 0; }

.dawn-skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0;
  box-sizing: border-box;
  width: 100%;
}

.dawn-skeleton-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 28rpx;
  border-radius: var(--app-radius-md);
  background: var(--app-paper);
}

.dawn-sk-w60 { width: 60%; }
.dawn-sk-w90 { width: 90%; }
.dawn-sk-w40 { width: 40%; }
.requests-loading { display: block; padding: 0; }
