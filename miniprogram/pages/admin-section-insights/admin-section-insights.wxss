/* Version 3 dawn */
.page-admin-insights {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(circle at 92% 0%, var(--theme-primary-alpha-08) 0, rgba(255, 255, 255, 0) 300rpx),
    linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}

/* 课节标题保留主题蓝作为识别色，主体回到晨读营的暖纸色。 */
.page-header {
  position: relative;
  flex-shrink: 0;
  overflow: hidden;
  margin: 20rpx 24rpx 0;
  padding: 30rpx 32rpx 24rpx;
  border: 1rpx solid var(--app-border);
  border-radius: var(--app-radius-lg);
  background: linear-gradient(135deg, var(--app-paper) 0%, var(--app-paper-muted) 100%);
  box-shadow: var(--app-shadow-soft);
}

.page-header::before {
  position: absolute;
  top: 0;
  left: 32rpx;
  width: 84rpx;
  height: 6rpx;
  border-radius: 0 0 6rpx 6rpx;
  background: var(--theme-primary);
  content: '';
}

.page-header::after {
  position: absolute;
  top: -72rpx;
  right: -56rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: var(--theme-primary-alpha-05);
  content: '';
}

.header-title,
.header-count {
  position: relative;
  z-index: 1;
}

.header-title {
  color: var(--app-text);
  font-family: var(--app-font-serif);
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
  line-height: 1.4;
}

.header-count {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  margin-top: 14rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: var(--app-dawn-soft);
  color: var(--app-dawn-ink);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.loading-wrap {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--theme-primary-alpha-12);
  border-top-color: var(--theme-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: var(--app-text-muted);
  font-size: 26rpx;
}

.empty-state {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 20rpx 24rpx 0;
  padding: 96rpx 24rpx;
  border-radius: var(--app-radius-lg);
  background: var(--app-paper);
  box-shadow: var(--app-shadow-soft);
}

.empty-icon.app-icon {
  width: 84rpx;
  height: 84rpx;
  color: var(--theme-primary);
  opacity: 0.58;
}

.empty-text {
  margin-top: 20rpx;
  color: var(--app-text-muted);
  font-size: 28rpx;
}

.insights-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 18rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.insight-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  padding: 28rpx 28rpx 22rpx;
  border: 1rpx solid var(--app-border);
  border-left: 5rpx solid var(--theme-primary-alpha-20);
  border-radius: var(--app-radius-lg);
  background: linear-gradient(180deg, var(--app-paper) 0%, var(--app-paper-muted) 100%);
  box-shadow: var(--app-shadow-soft);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.insight-card:active {
  transform: translateY(2rpx) scale(0.99);
  box-shadow: var(--app-press-shadow);
}

.card-user {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.user-avatar {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx solid rgba(255, 253, 248, 0.86);
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx var(--theme-primary-alpha-12);
}

.avatar-img {
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-text {
  color: #fffdf8;
  font-size: 28rpx;
  font-weight: 650;
}

.user-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: var(--app-text);
  font-size: 30rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.share-tag {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.share-tag.shared {
  border-color: var(--theme-primary-alpha-12);
  background: var(--theme-primary-tint);
  color: var(--theme-primary-dark);
}

.share-tag.unshared {
  border-color: var(--app-border);
  background: var(--app-surface-muted);
  color: var(--app-text-muted);
}

.card-image-wrap {
  overflow: hidden;
  margin-bottom: 18rpx;
  border: 1rpx solid var(--app-border);
  border-radius: var(--app-radius-md);
  background: var(--theme-primary-tint);
}

.card-image {
  display: block;
  width: 100%;
  height: 300rpx;
}

.card-preview {
  display: -webkit-box;
  overflow: hidden;
  margin-bottom: 18rpx;
  color: var(--app-text-soft);
  font-family: var(--app-font-serif);
  font-size: 28rpx;
  line-height: 1.72;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
}

.card-footer {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--app-rule);
}

.like-count,
.danmaku-count {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: var(--app-text-muted);
  font-size: 24rpx;
}

.count-icon {
  width: 28rpx;
  height: 28rpx;
  color: var(--app-text-muted);
  opacity: 0.82;
  vertical-align: -4rpx;
}

.card-arrow {
  margin-left: auto;
  color: var(--theme-primary-light);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1;
}
