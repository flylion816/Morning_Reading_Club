/* Version 3 dawn: 随喜记沿用暖纸、晨光印章和租户主色。 */
.joy-page {
  min-height: 100vh;
  padding: 38rpx 28rpx 90rpx;
  background: var(--app-page-bg);
  box-sizing: border-box;
}

.joy-heading {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 8rpx 12rpx 32rpx;
}

.joy-heading-seal {
  flex-shrink: 0;
}

.joy-heading-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.joy-heading-title,
.joy-list-title,
.joy-sheet-title {
  color: var(--app-text);
  font-family: var(--app-font-serif);
  font-weight: 600;
}

.joy-heading-title {
  font-size: 36rpx;
}

.joy-heading-sub {
  color: var(--app-text-muted);
  font-size: 24rpx;
}

.joy-compose {
  padding: 24rpx;
  border: 1rpx solid var(--app-border);
  border-radius: var(--app-radius-lg);
  background: var(--app-paper);
  box-shadow: var(--app-shadow-soft);
}

.joy-compose-label,
.joy-note-head,
.joy-compose-bottom,
.joy-list-heading,
.joy-sheet-heading,
.joy-sheet-period,
.joy-sheet-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.joy-compose-label {
  margin: 0 0 12rpx;
  color: var(--app-text-soft);
  font-size: 24rpx;
}

.joy-cancel-edit,
.joy-retry {
  color: var(--theme-primary);
}

/* 输入区：原来 184rpx 一会儿就写满，放大到两倍多，长内容在框里可以滚动 */
.joy-input {
  width: 100%;
  height: 420rpx;
  padding: 10rpx 4rpx;
  box-sizing: border-box;
  color: var(--app-text);
  font-family: var(--app-font-serif);
  font-size: 30rpx;
  line-height: 1.65;
}

.joy-placeholder {
  color: #a79b8b;
}

.joy-compose-bottom {
  gap: 16rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--app-border);
}

.joy-association {
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 64rpx;
  color: var(--theme-primary);
  font-size: 23rpx;
}

.joy-association-plus {
  flex-shrink: 0;
  margin-right: 6rpx;
  font-size: 31rpx;
}

.joy-association-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.joy-save {
  flex-shrink: 0;
  min-height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  font-size: 25rpx;
}

button::after {
  border: 0;
}

.joy-save[disabled],
.joy-sheet-done[disabled] {
  background: #ddd8cf;
  color: #8b8174;
  box-shadow: none;
}

.joy-list-heading {
  margin: 46rpx 10rpx 22rpx;
}

.joy-list-title {
  font-size: 32rpx;
}

.joy-filter {
  max-width: 260rpx;
  overflow: hidden;
  padding: 9rpx 18rpx;
  border: 1rpx solid var(--app-border);
  border-radius: 999rpx;
  background: var(--app-paper);
  color: var(--app-text-soft);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.joy-filter-arrow {
  margin-left: 5rpx;
  color: var(--app-text-muted);
}

.joy-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.joy-note {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx 28rpx 24rpx 32rpx;
  border: 1rpx solid var(--app-border);
  border-left: 6rpx solid var(--app-dawn, #ee9b45);
  border-radius: 8rpx var(--app-radius-md) var(--app-radius-md) 8rpx;
  background: var(--app-paper);
}

.joy-note-date,
.joy-note-source {
  color: var(--app-text-muted);
  font-size: 23rpx;
}

.joy-note-content {
  color: var(--app-text);
  font-family: var(--app-font-serif);
  font-size: 29rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.joy-note-actions {
  display: flex;
  gap: 24rpx;
}

.joy-note-action {
  padding: 4rpx 0;
  color: var(--theme-primary);
  font-size: 22rpx;
}

.joy-state,
.joy-more,
.joy-sheet-status {
  color: var(--app-text-muted);
  font-size: 25rpx;
  text-align: center;
}

.joy-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 65rpx 20rpx;
}

.joy-empty-seal {
  opacity: 0.7;
}

.joy-more {
  padding: 22rpx 0;
}

.joy-skeleton {
  height: 150rpx;
  margin-bottom: 16rpx;
}

.joy-login-btn {
  margin-top: 24rpx;
}

.joy-sheet-mask {
  position: fixed;
  z-index: 900;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: var(--app-overlay);
}

.joy-sheet {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 78vh;
  padding: 36rpx 32rpx calc(26rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: var(--app-paper);
  box-sizing: border-box;
}

.joy-sheet-heading {
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.joy-sheet-title,
.joy-sheet-hint {
  display: block;
}

.joy-sheet-title {
  font-size: 34rpx;
}

.joy-sheet-hint {
  margin-top: 6rpx;
  color: var(--app-text-muted);
  font-size: 24rpx;
}

.joy-sheet-close {
  padding: 0 8rpx;
  color: var(--app-text-soft);
  font-size: 42rpx;
  line-height: 1;
}

.joy-sheet-period {
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--app-border);
}

.joy-sheet-label {
  color: var(--app-text);
  font-size: 27rpx;
  font-weight: 600;
}

.joy-sheet-value {
  color: var(--app-text-soft);
  font-size: 26rpx;
}

.joy-section-title {
  display: block;
  margin: 28rpx 0 12rpx;
}

.joy-sheet-options {
  height: 320rpx;
}

.joy-sheet-option {
  gap: 20rpx;
  min-height: 80rpx;
  border-bottom: 1rpx solid var(--app-border);
  color: var(--app-text-soft);
  font-size: 26rpx;
}

.joy-radio {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #c8bfb1;
  border-radius: 50%;
  color: #fff;
  font-size: 23rpx;
}

.joy-radio-selected {
  border-color: var(--theme-primary);
  background: var(--theme-primary);
}

.joy-sheet-status,
.joy-sheet-empty {
  display: block;
  padding: 24rpx 0;
}

.joy-sheet-empty {
  color: var(--app-text-muted);
  font-size: 24rpx;
}

.joy-sheet-done {
  width: 100%;
  margin: 30rpx 0 0;
}

/* 体验优化：折叠长文、字数提示、沿用上次关联 */
.joy-note-folded {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.joy-note-more {
  align-self: flex-start;
  padding: 4rpx 0;
  color: var(--theme-primary);
  font-size: 24rpx;
}

.joy-note-action-quiet {
  color: var(--app-text-muted);
}

.joy-counter {
  display: block;
  margin-top: 8rpx;
  text-align: right;
  color: var(--app-text-muted);
  font-size: 22rpx;
}

.joy-counter-over {
  color: var(--app-danger);
}

.joy-last {
  align-self: flex-start;
  margin-top: 12rpx;
  padding: 8rpx 22rpx;
  border-radius: 99rpx;
  background: var(--app-dawn-soft);
  color: var(--app-dawn-ink);
  font-size: 24rpx;
}

/* 搜索 */
.joy-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.joy-search-input {
  flex: 1;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: var(--app-radius-sm);
  border: 1rpx solid var(--app-border);
  background: var(--app-paper);
  font-size: var(--app-font-md);
}

.joy-search-btn {
  color: var(--theme-primary);
  font-size: var(--app-font-md);
  font-weight: 600;
}

.joy-search-clear {
  color: var(--app-text-muted);
  font-size: var(--app-font-sm);
}

/* 觉察日记：随喜写在输入框里，觉察要推开一扇深色的门 */
.joy-compose-kind {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.joy-compose-kind-text {
  color: var(--app-dawn-ink, #8a4b12);
  font-size: 24rpx;
  font-weight: 600;
}

.joy-door {
  position: relative;
  margin-top: 26rpx;
  padding: 32rpx 32rpx 28rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: linear-gradient(180deg, #1c1815 0%, #2a211a 58%, #6a4322 100%);
  box-shadow: 0 16rpx 40rpx rgba(43, 30, 18, 0.22);
  color: #f3e9da;
}

/* 门下面透出的一线晨光 */
.joy-door::after {
  content: '';
  position: absolute;
  left: -10%;
  right: -10%;
  bottom: -96rpx;
  height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(240, 168, 90, 0.6), rgba(240, 168, 90, 0) 70%);
  pointer-events: none;
}

.joy-door-hover {
  opacity: 0.92;
}

.joy-door-k {
  display: block;
  color: #f0a85a;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.14em;
}

.joy-door-q {
  position: relative;
  z-index: 1;
  display: block;
  margin: 14rpx 0 26rpx;
  font-family: var(--app-font-serif);
  font-size: 33rpx;
  line-height: 1.55;
}

.joy-door-cta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #e8dccb;
  font-size: 24rpx;
}

.joy-door-btn {
  padding: 10rpx 28rpx;
  border: 1rpx solid rgba(240, 168, 90, 0.55);
  border-radius: 30rpx;
  background: rgba(240, 168, 90, 0.2);
  color: #ffd9a8;
  font-weight: 600;
}

/* 页签 */
.joy-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.joy-tab {
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.7);
  color: var(--app-text-soft);
  font-size: 24rpx;
}

.joy-tab-on {
  background: var(--app-text);
  color: #ffffff;
}

/* 列表卡片 */
.joy-note-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.joy-more-btn {
  margin-left: auto;
  padding: 0 8rpx;
  color: var(--app-text-muted);
  font-size: 34rpx;
  line-height: 1;
}

.joy-note-hover {
  opacity: 0.9;
}

.joy-tag {
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 600;
}

.joy-tag-checkin {
  background: var(--app-dawn-soft);
  color: var(--app-dawn-ink);
}

.joy-private {
  margin-left: auto;
  color: var(--app-text-muted);
  font-size: 21rpx;
}

.joy-note-checkin {
  border-left-color: var(--app-rule, rgba(92, 70, 44, 0.3));
}

.joy-acard {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx 28rpx 22rpx 36rpx;
  overflow: hidden;
  border: 1rpx solid var(--app-border);
  border-radius: var(--app-radius-md);
  background: var(--app-paper);
}

/* 左边一条「夜到晨」的色带，在列表里一眼认得出觉察 */
.joy-acard::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 10rpx;
  background: linear-gradient(180deg, #1c1815 0%, #6a4322 55%, #ee9b45 100%);
}

.joy-feeling {
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  background: #efe9dd;
  color: var(--app-text-soft);
  font-size: 21rpx;
}

.joy-acard-facts {
  color: var(--app-text-soft);
  font-size: 25rpx;
  line-height: 1.6;
}

.joy-acard-key {
  color: var(--app-text);
  font-family: var(--app-font-serif);
  font-size: 28rpx;
  line-height: 1.6;
}

.joy-acard-choice {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: var(--app-dawn-soft);
  color: var(--app-dawn-ink);
}

.joy-sun {
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--app-dawn, #ee9b45);
  box-shadow: 0 0 0 6rpx rgba(238, 155, 69, 0.25);
}

.joy-acard-choice-text {
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.6;
}

.joy-acard-foot {
  color: var(--app-dawn-deep, #b8631f);
  font-size: 22rpx;
}

/* 标题：选填的一行细输入；列表里有标题的以标题打头 */
.joy-title-input {
  width: 100%;
  height: 76rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--app-border);
  color: var(--app-text);
  font-family: var(--app-font-serif);
  font-size: 32rpx;
  font-weight: 600;
}

.joy-input {
  display: block;
  margin-top: 8rpx;
}

.joy-note-title,
.joy-acard-title {
  display: block;
  color: var(--app-text);
  font-family: var(--app-font-serif);
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.5;
}

/* 带格式的随喜用 rich-text 展示，字号和行高沿用纸条里的正文 */
.joy-note-rich {
  display: block;
}
