<!-- 我的页面 -->
<view class="page-my">

  <!-- 已登录状态 -->
  <view wx:if="{{isLogin}}" class="logged-in-content">

    <!-- 页头 -->
    <view class="user-card app-stagger">
      <view class="user-avatar-wrap" style="background: {{userInfo.avatarColor || themePrimaryColor}}">
        <image wx:if="{{userInfo.avatarUrl}}" class="user-avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <text wx:else class="user-avatar-emoji">{{userInfo.avatarText || '用'}}</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickname || userInfo.name || '用户'}}</text>
        <text class="user-signature {{userInfo.signature ? '' : 'user-signature-empty'}}" bindtap="goToEditProfile">{{userInfo.signature || '写一句给自己的话'}}</text>
        <text class="user-phone">{{hasPhone ? phoneMasked : '未绑定手机号'}}</text>
      </view>
    </view>

    <!-- 三个数字 -->
    <view class="journal-nums">
      <view class="journal-num">
        <text class="journal-num-value">{{stats.totalCheckinDays || 0}}</text>
        <text class="journal-num-label">累计晨读 · 天</text>
      </view>
      <view class="journal-num">
        <text class="journal-num-value">{{stats.currentStreak || 0}}</text>
        <text class="journal-num-label">连续 · 天</text>
      </view>
      <view class="journal-num">
        <text class="journal-num-value">{{stats.maxStreak || 0}}</text>
        <text class="journal-num-label">最长连续 · 天</text>
      </view>
    </view>

    <!-- 晨读日历 -->
    <view wx:if="{{canUsePaidFeatures}}" class="journal-card">
      <view class="journal-card-head">
        <view class="app-seal app-seal-dawn app-seal-sm">历</view>
        <text class="journal-card-title">晨读日历</text>
        <view class="journal-month">
          <view class="journal-month-btn journal-month-prev" bindtap="goPrevMonth"><view class="app-icon app-icon-chevron"></view></view>
          <text class="journal-month-text">{{calendarYear}} 年 {{calendarMonth}} 月</text>
          <view class="journal-month-btn {{canGoNextMonth ? '' : 'journal-month-btn-off'}}" bindtap="goNextMonth"><view class="app-icon app-icon-chevron"></view></view>
        </view>
      </view>
      <view class="cal-grid">
        <text class="cal-week" wx:for="{{weekLabels}}" wx:key="*this">{{item}}</text>
        <view class="cal-cell" wx:for="{{calendarCells}}" wx:key="key">
          <text wx:if="{{item.state !== 'blank'}}" class="cal-day cal-day-{{item.state}} {{item.state === 'today' && item.checked ? 'cal-day-today-checked' : ''}}">{{item.day}}</text>
          <text wx:if="{{item.mood}}" class="cal-mood cal-mood-{{item.mood}}">{{item.moodName}}</text>
        </view>
      </view>
      <view wx:if="{{moodLegend.length}}" class="cal-legend">
        <text class="cal-legend-item" wx:for="{{moodLegend}}" wx:key="value"><text class="cal-mood cal-mood-{{item.value}} cal-legend-mark">{{item.mark}}</text> {{item.name}}</text>
      </view>
      <view wx:if="{{calendarError}}" class="cal-error" bindtap="retryCalendar">日历没加载出来，点这里重试</view>
    </view>

    <!-- 共读足迹 -->
    <view wx:if="{{canUsePaidFeatures && footprints.total > 0}}" class="journal-card">
      <view class="journal-card-head">
        <view class="app-seal app-seal-dawn app-seal-sm">迹</view>
        <text class="journal-card-title">共读足迹</text>
        <text class="journal-card-meta">{{footprints.total}} 期</text>
      </view>
      <view class="stamps">
        <view class="stamp {{item.ended ? '' : 'stamp-current'}}" wx:for="{{footprints.stamps}}" wx:key="key" data-period-id="{{item.periodId}}" bindtap="goToKeepsake">{{item.char}}</view>
        <text wx:if="{{footprints.moreCount}}" class="stamps-more">等 {{footprints.moreCount}} 期</text>
      </view>
      <text wx:if="{{footprints.currentName}}" class="stamps-note">{{footprints.currentName}} 进行中</text>
      <text class="stamps-hint">点印章，翻开那一期的纪念册</text>
    </view>

    <!-- 账号资料 -->
    <view class="group-title">账号</view>
    <view class="settings-group">
      <view wx:if="{{canUsePaidFeatures && !hasPhone}}" class="settings-cell">
        <view class="cell-left">
          <view class="app-icon app-icon-edit ln-ico"></view>
          <text class="cell-label">绑定手机号</text>
        </view>
        <button
          class="cell-phone-btn"
          open-type="getPhoneNumber"
          bindgetphonenumber="handleGetPhoneNumber"
        >立即绑定</button>
      </view>
      <view wx:elif="{{canUsePaidFeatures}}" class="settings-cell">
        <view class="cell-left">
          <view class="app-icon app-icon-edit ln-ico"></view>
          <text class="cell-label">手机号管理</text>
        </view>
        <view class="cell-right">
          <text class="cell-value">{{phoneMasked}}</text>
          <button
            class="cell-rebind-btn"
            open-type="getPhoneNumber"
            bindgetphonenumber="handleGetPhoneNumber"
          >换绑</button>
        </view>
      </view>

      <view class="settings-cell" bindtap="goToEditProfile">
        <view class="cell-left">
          <view class="app-icon app-icon-edit ln-ico"></view>
          <text class="cell-label">编辑资料</text>
        </view>
        <view class="cell-right">
          <view class="app-icon app-icon-chevron cell-arrow"></view>
        </view>
      </view>
    </view>

    <view class="settings-divider"></view>

    <!-- 消息 -->
    <view class="group-title">消息</view>
    <view class="settings-group">
      <view class="settings-cell" bindtap="goToNotifications">
        <view class="cell-left">
          <view class="app-icon app-icon-bell ln-ico"></view>
          <text class="cell-label">消息通知</text>
        </view>
        <view class="cell-right">
          <view wx:if="{{unreadNotificationCount > 0}}" class="cell-badge">
            {{unreadNotificationCount > 99 ? '99+' : unreadNotificationCount}}
          </view>
          <view class="app-icon app-icon-chevron cell-arrow"></view>
        </view>
      </view>

      <view wx:if="{{canUsePaidFeatures}}" class="settings-cell" bindtap="goToNotificationSettings">
        <view class="cell-left">
          <view class="app-icon app-icon-clock ln-ico"></view>
          <text class="cell-label">消息提醒设置</text>
        </view>
        <view class="cell-right">
          <view class="app-icon app-icon-chevron cell-arrow"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{canUsePaidFeatures}}" class="settings-divider"></view>

    <!-- 我的内容 -->
    <view wx:if="{{canUsePaidFeatures}}" class="group-title">我的内容</view>
    <view wx:if="{{canUsePaidFeatures}}" class="settings-group">
      <view wx:if="{{canUsePaidFeatures}}" class="settings-cell" bindtap="goToMyActivities">
        <view class="cell-left">
          <view class="app-icon app-icon-calendar ln-ico"></view>
          <text class="cell-label">我的活动</text>
        </view>
        <view class="cell-right">
          <view class="app-icon app-icon-chevron cell-arrow"></view>
        </view>
      </view>

      <view wx:if="{{canUsePaidFeatures}}" class="settings-cell" bindtap="goToMyCheckinRecords">
        <view class="cell-left">
          <view class="app-icon app-icon-note ln-ico"></view>
          <text class="cell-label">我的打卡日记</text>
        </view>
        <view class="cell-right">
          <view class="app-icon app-icon-chevron cell-arrow"></view>
        </view>
      </view>

      <view wx:if="{{canUsePaidFeatures}}" class="settings-cell" bindtap="goToCompletionReports">
        <view class="cell-left">
          <view class="app-icon app-icon-doc ln-ico"></view>
          <text class="cell-label">我的实录报告</text>
        </view>
        <view class="cell-right">
          <view class="app-icon app-icon-chevron cell-arrow"></view>
        </view>
      </view>

      <view wx:if="{{canUsePaidFeatures}}" class="settings-cell" bindtap="goToMyHighlights">
        <view class="cell-left">
          <view class="app-icon app-icon-book ln-ico"></view>
          <text class="cell-label">我的摘抄本</text>
        </view>
        <view class="cell-right">
          <view class="app-icon app-icon-chevron cell-arrow"></view>
        </view>
      </view>

      <view wx:if="{{canUsePaidFeatures}}" class="settings-cell" bindtap="goToSeenReceived">
        <view class="cell-left">
          <view class="app-icon app-icon-heart ln-ico"></view>
          <text class="cell-label">被看见</text>
        </view>
        <view class="cell-right">
          <view class="app-icon app-icon-chevron cell-arrow"></view>
        </view>
      </view>

      <view wx:if="{{canUsePaidFeatures && footprints.slowMailPeriodId}}" class="settings-cell" bindtap="goToSlowMail">
        <view class="cell-left">
          <view class="app-icon app-icon-note ln-ico"></view>
          <text class="cell-label">慢递邮局</text>
        </view>
        <view class="cell-right">
          <view class="app-icon app-icon-chevron cell-arrow"></view>
        </view>
      </view>

      <view wx:if="{{canUsePaidFeatures}}" class="settings-cell" bindtap="goToMyCoupons">
        <view class="cell-left">
          <view class="app-icon app-icon-pin ln-ico"></view>
          <text class="cell-label">我的优惠券</text>
        </view>
        <view class="cell-right">
          <view class="app-icon app-icon-chevron cell-arrow"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{isAdmin}}" class="settings-divider"></view>

    <!-- 管理员 -->
    <view wx:if="{{isAdmin}}" class="group-title">管理</view>
    <view wx:if="{{isAdmin}}" class="settings-group">
      <view class="settings-cell" bindtap="goToAdminWorkbench">
        <view class="cell-left">
          <view class="app-icon app-icon-book ln-ico"></view>
          <text class="cell-label">管理工作台</text>
        </view>
        <view class="cell-right">
          <view class="app-icon app-icon-chevron cell-arrow"></view>
        </view>
      </view>
      <view class="settings-cell" bindtap="goToAdminAnalytics">
        <view class="cell-left">
          <view class="app-icon app-icon-doc ln-ico"></view>
          <text class="cell-label">数据分析</text>
        </view>
        <view class="cell-right">
          <view class="app-icon app-icon-chevron cell-arrow"></view>
        </view>
      </view>
    </view>

    <view class="settings-divider"></view>

    <!-- 协议 -->
    <view class="group-title">协议</view>
    <view class="settings-group">
      <view class="settings-cell" bindtap="goToPrivacy">
        <view class="cell-left">
          <view class="app-icon app-icon-lock ln-ico"></view>
          <text class="cell-label">隐私政策</text>
        </view>
        <view class="cell-right">
          <view class="app-icon app-icon-chevron cell-arrow"></view>
        </view>
      </view>
      <view class="settings-cell" bindtap="goToAgreement">
        <view class="cell-left">
          <view class="app-icon app-icon-doc ln-ico"></view>
          <text class="cell-label">用户协议</text>
        </view>
        <view class="cell-right">
          <view class="app-icon app-icon-chevron cell-arrow"></view>
        </view>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-wrap">
      <view class="logout-btn" bindtap="handleLogout">退出登录</view>
    </view>
  </view>

  <!-- 未登录状态 -->
  <view wx:if="{{!isLogin}}" class="guest-content">
    <view class="guest-banner">
      <view class="app-seal app-seal-lg guest-seal">晨</view>
      <text class="guest-tip">登录后查看个人信息</text>
    </view>
    <view class="guest-login-btn" bindtap="goToLogin">立即登录</view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="profile-skeleton">
    <view class="app-skeleton profile-skeleton-card"></view>
    <view class="profile-skeleton-group">
      <view class="app-skeleton-line profile-skeleton-row" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this"></view>
    </view>
  </view>

</view>

<podcast-player-bar has-tabbar="{{true}}" ignore-safe-area="{{true}}" />
