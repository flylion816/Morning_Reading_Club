/* 我的页面样式 */
.page-my {
  min-height: 100vh;
  background:
    radial-gradient(circle at 18% 0%, var(--theme-primary-alpha-08) 0, rgba(255,255,255,0) 280rpx),
    linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg) 100%);
  padding: 24rpx 24rpx 140rpx;
  box-sizing: border-box;
}

/* 用户信息卡 */
.user-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  background:
    radial-gradient(circle at 80% 0%, var(--theme-primary-alpha-08) 0, rgba(255,255,255,0) 190rpx),
    linear-gradient(180deg, var(--app-paper) 0%, var(--app-paper) 100%);
  padding: 32rpx;
  margin-bottom: 22rpx;
  border-radius: 24rpx;
  box-shadow: var(--app-shadow-soft);
  border: 1rpx solid rgba(92, 70, 44, 0.08);
  position: relative;
  overflow: hidden;
}

.user-card-glow {
  position: absolute;
  right: -64rpx;
  top: -80rpx;
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  border: 2rpx solid var(--theme-primary-alpha-12);
  pointer-events: none;
}

.user-card-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
}

.user-avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 22rpx;
  background: var(--app-surface-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.28);
}

.user-avatar-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 22rpx;
}

.user-avatar-emoji {
  font-size: 52rpx;
  line-height: 1;
  color: #fff;
  font-weight: 600;
}

.user-info {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 400;
  color: var(--app-text);
  line-height: 1.25;
}

.user-phone {
  font-size: 26rpx;
  color: var(--app-text-muted);
}

.user-streak {
  font-size: 24rpx;
  color: var(--app-text-soft);
}

.streak-num {
  color: var(--theme-primary);
  font-weight: 600;
}

.user-stat-pill {
  position: relative;
  z-index: 1;
  min-width: 118rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: var(--app-surface-muted);
  border: 1rpx solid var(--theme-primary-alpha-12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-pill-number {
  color: var(--theme-primary-dark);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1;
}

.stat-pill-label {
  margin-top: 8rpx;
  color: var(--theme-primary);
  font-size: 20rpx;
  font-weight: 400;
}

/* 设置分组 */
.settings-group {
  background: linear-gradient(180deg, var(--app-paper) 0%, var(--app-paper) 100%);
  margin-bottom: 0;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: var(--app-shadow-soft);
  border: 1rpx solid rgba(92, 70, 44, 0.08);
}

.group-title {
  margin: 24rpx 8rpx 12rpx;
  color: var(--app-text-muted);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.settings-divider {
  height: 18rpx;
  background: transparent;
}

/* 设置 cell */
.settings-cell {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  height: 104rpx;
  border-bottom: 1rpx solid rgba(92, 70, 44, 0.07);
  background: transparent;
  transition: background 0.18s ease, transform 0.18s ease;
}

.settings-cell:active {
  background: var(--app-surface-muted);
  transform: translateY(1rpx);
}

.settings-cell:last-child {
  border-bottom: none;
}

.cell-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.cell-icon {
  width: 48rpx;
  height: 48rpx;
  background: transparent;
  font-size: 30rpx;
  text-align: center;
  line-height: 48rpx;
  box-shadow: none;
  text-shadow: none;
  filter: none;
}

.cell-label {
  font-size: 30rpx;
  color: var(--app-text);
  font-weight: 400;
}

.cell-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.cell-value {
  font-size: 28rpx;
  color: var(--app-text-muted);
}

.cell-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #e85f5c;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cell-arrow {
  font-size: 36rpx;
  color: var(--app-disabled);
  font-weight: 300;
}

/* 手机号绑定按钮 */
.cell-phone-btn,
.cell-rebind-btn {
  font-size: 26rpx;
  color: var(--theme-primary);
  background: var(--theme-primary-tint);
  border: none;
  padding: 10rpx 16rpx;
  margin: 0;
  line-height: 1;
  min-height: auto;
  border-radius: 12rpx;
  font-weight: 500;
  transition: opacity 0.18s ease, transform 0.18s ease;
}

.cell-phone-btn::after,
.cell-rebind-btn::after {
  border: none;
}

.cell-phone-btn:active,
.cell-rebind-btn:active {
  opacity: 0.76;
  transform: scale(0.98);
}

/* 退出登录 */
.logout-wrap {
  margin-top: 34rpx;
  padding: 0;
}

.logout-btn {
  text-align: center;
  color: #c94740;
  font-size: 30rpx;
  padding: 28rpx 0;
  background: var(--app-paper);
  border-radius: 20rpx;
  box-shadow: var(--app-shadow-soft);
  border: 1rpx solid rgba(92, 70, 44, 0.08);
  transition: background 0.18s ease, transform 0.18s ease;
}

.logout-btn:active {
  background: #fff5f3;
  transform: translateY(1rpx);
}

/* 未登录 */
.guest-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
  gap: 48rpx;
}

.guest-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.guest-emoji {
  font-size: 88rpx;
}

.guest-tip {
  font-size: 30rpx;
  color: var(--app-text-soft);
}

.guest-login-btn {
  width: 400rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: #ffffff;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 12rpx 26rpx var(--theme-primary-alpha-24);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.guest-login-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 加载遮罩 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--app-border);
  border-top-color: var(--theme-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Version 1 core-journey polish: turn the account page into a calm dashboard. */
.page-my {
  background:
    radial-gradient(circle at 90% 0%, var(--theme-primary-alpha-08) 0, rgba(255, 255, 255, 0) 310rpx),
    linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
  padding: 24rpx 22rpx calc(160rpx + env(safe-area-inset-bottom));
}

.user-card {
  gap: 24rpx;
  padding: 34rpx;
  border-radius: var(--app-radius-lg);
  border-color: rgba(92, 70, 44, 0.07);
}

.user-avatar-wrap,
.user-avatar-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 30rpx;
}

.user-avatar-wrap {
  background: linear-gradient(145deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  box-shadow: 0 14rpx 26rpx var(--theme-primary-alpha-20), inset 0 0 0 1rpx rgba(255, 255, 255, 0.2);
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
}

.user-phone {
  letter-spacing: 0.4rpx;
}

.user-stat-pill {
  min-width: 132rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: var(--theme-primary-tint);
}

.stat-pill-number {
  font-size: 42rpx;
  font-weight: 750;
}

.settings-group {
  border-radius: var(--app-radius-md);
  border-color: rgba(92, 70, 44, 0.07);
}

.settings-cell {
  min-height: 108rpx;
  height: auto;
  padding: 20rpx 26rpx;
}

.cell-label {
  font-size: 29rpx;
  letter-spacing: -0.2rpx;
}

/* Version 3 dawn: 统计数字使用数字衬线体，未登录印章 */
.stat-pill-number {
  font-family: var(--app-font-num);
}

.guest-seal {
  margin-bottom: 16rpx;
}

/* Version 3 dawn: 个人签名与骨架屏。 */
.user-info {
  flex: 1;
  min-width: 0;
}

.user-signature {
  overflow: hidden;
  color: var(--app-text-soft);
  font-size: 26rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-signature-empty {
  color: var(--app-text-muted);
  opacity: 0.7;
}

.profile-skeleton {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  padding: 24rpx 22rpx;
  background: var(--app-page-bg);
}

.profile-skeleton-card {
  height: 200rpx;
  border-radius: var(--app-radius-lg);
}

.profile-skeleton-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 40rpx;
  padding: 32rpx;
  border-radius: var(--app-radius-lg);
  background: var(--app-paper);
}

.profile-skeleton-row {
  width: 100%;
  height: 40rpx;
}

.profile-skeleton-row:nth-child(2) { width: 85%; }
.profile-skeleton-row:nth-child(3) { width: 92%; }
.profile-skeleton-row:nth-child(4) { width: 70%; }

/* Version 3 dawn: 晨读手账 */
.user-card {
  justify-content: flex-start;
  padding: 28rpx 20rpx 8rpx;
  background: transparent;
  box-shadow: none;
  border: none;
  overflow: visible;
}

.user-avatar-wrap,
.user-avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.user-avatar-wrap {
  box-shadow: 0 0 0 6rpx var(--app-dawn-soft);
}

.user-name {
  font-family: var(--app-font-serif);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.user-phone {
  font-size: 22rpx;
}

.journal-nums {
  display: flex;
  flex-direction: row;
  margin: 24rpx 0;
  background: var(--app-paper);
  border-radius: 32rpx;
  border: 1rpx solid rgba(92, 70, 44, 0.06);
  box-shadow: 0 12rpx 34rpx rgba(84, 60, 30, 0.05);
}

.journal-num {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 0;
  border-right: 1rpx solid rgba(92, 70, 44, 0.08);
}

.journal-num:last-child {
  border-right: none;
}

.journal-num-value {
  font-family: var(--app-font-num);
  font-size: 60rpx;
  font-weight: 400;
  line-height: 1.15;
  color: var(--app-text);
}

.journal-num-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--app-text-muted);
}
.journal-num-hint {
  display: block;
  margin: -12rpx 32rpx 24rpx;
  color: var(--app-text-muted);
  font-size: 22rpx;
  line-height: 1.55;
  text-align: center;
}

.journal-card {
  margin-bottom: 24rpx;
  padding: 28rpx 26rpx;
  background: var(--app-paper);
  border-radius: 32rpx;
  border: 1rpx solid rgba(92, 70, 44, 0.06);
  box-shadow: 0 12rpx 34rpx rgba(84, 60, 30, 0.05);
}

.journal-card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.journal-card-title {
  flex: 1;
  font-family: var(--app-font-serif);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--app-text);
}

.journal-card-meta {
  font-size: 24rpx;
  color: var(--app-text-muted);
}

.journal-month {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
}

.journal-month-text {
  min-width: 150rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--app-text-soft);
}

.journal-month-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  color: var(--app-text-soft);
}

.journal-month-btn .app-icon {
  width: 28rpx;
  height: 28rpx;
}

.journal-month-prev .app-icon {
  transform: rotate(180deg);
}

.journal-month-btn-off {
  opacity: 0.25;
}

.cal-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.cal-week {
  width: 14.2857%;
  height: 44rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--app-text-muted);
}

.cal-cell {
  width: 14.2857%;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-day {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 24rpx;
  color: var(--app-text-soft);
}

.cal-day-checked {
  background: var(--theme-primary-alpha-12);
  color: var(--theme-primary-dark);
  font-weight: 600;
}

.cal-day-today {
  box-sizing: border-box;
  border: 3rpx solid var(--app-dawn);
  background: transparent;
  color: var(--app-dawn-deep);
  font-weight: 700;
  line-height: 46rpx;
}

.cal-day-today-checked {
  background: var(--app-dawn);
  color: #ffffff;
  box-shadow: 0 0 0 6rpx var(--app-dawn-glow);
}

.cal-day-future {
  color: var(--app-text-muted);
  opacity: 0.45;
}

.cal-error {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--app-text-muted);
}

.stamps {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 22rpx;
}

.stamp {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 3rpx solid #a5462f;
  border-radius: 22rpx;
  background: rgba(165, 70, 47, 0.05);
  color: #a5462f;
  font-family: var(--app-font-serif);
  font-size: 42rpx;
  font-weight: 700;
  transform: rotate(-4deg);
}

.stamp:nth-child(even) {
  transform: rotate(3deg);
}

.stamp-current {
  border-style: dashed;
  border-color: rgba(92, 70, 44, 0.4);
  background: transparent;
  color: var(--app-text-muted);
}

.stamps-more,
.stamps-note {
  font-size: 22rpx;
  color: var(--app-text-muted);
}

.stamps-note {
  display: block;
  margin-top: 16rpx;
}

.settings-group {
  background: var(--app-paper);
  border-radius: 32rpx;
  border: 1rpx solid rgba(92, 70, 44, 0.06);
  box-shadow: 0 12rpx 34rpx rgba(84, 60, 30, 0.05);
}

.ln-ico {
  width: 36rpx;
  height: 36rpx;
  color: var(--app-text-soft);
}

.cell-arrow {
  width: 28rpx;
  height: 28rpx;
  color: var(--app-disabled);
}

/* Features: 日历心情天气标记、图例，印章可点提示 */
.cal-cell {
  position: relative;
  height: 76rpx;
}

.cal-mood {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  font-size: 16rpx;
  line-height: 16rpx;
  color: var(--app-text-muted);
}

.cal-mood-happy { color: #d99a2b; }
.cal-mood-calm { color: #8a97a6; }
.cal-mood-thoughtful { color: #5f9b8e; }
.cal-mood-inspired { color: var(--app-dawn-deep); }
.cal-mood-low { color: #6f86a8; }
.cal-mood-other { color: #a39a8c; }

.cal-legend {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8rpx 24rpx;
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--app-text-muted);
}

.cal-legend-mark {
  position: static;
  transform: none;
  font-size: 20rpx;
  line-height: 20rpx;
}

.stamps-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--app-text-muted);
  opacity: 0.7;
}
