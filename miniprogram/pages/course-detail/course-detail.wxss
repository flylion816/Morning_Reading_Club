page {
  background: var(--app-page-bg);
}

.page-course-detail {
  min-height: 100vh;
  background:
    radial-gradient(circle at 18% 0%, var(--theme-primary-alpha-08) 0, rgba(255,255,255,0) 270rpx),
    var(--app-page-bg);
  padding: 24rpx;
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.page-course-detail.page-course-detail-detail {
  background: var(--app-page-bg);
  padding-bottom: calc(176rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.course-detail-loading {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 90;
  min-height: 100vh;
  background: var(--app-page-bg);
}

.long-image-canvas,
.checkin-share-cover-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  opacity: 0;
  pointer-events: none;
}

.long-image-canvas {
  width: 1040px;
  height: 1600px;
}

.checkin-share-cover-canvas {
  width: 500px;
  height: 400px;
}

.poster-gallery-overlay {
  position: fixed;
  inset: 0;
  z-index: 260;
  background: rgba(8, 15, 30, 0.72);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
}

.poster-gallery-shell {
  width: 100%;
  max-height: 92vh;
  background: linear-gradient(180deg, var(--app-paper) 0%, var(--app-paper-muted) 100%);
  border-radius: 32rpx;
  padding: 28rpx 28rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 72rpx rgba(60, 42, 20, 0.22);
}

.poster-gallery-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.poster-gallery-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--app-text);
}

.poster-gallery-subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--app-text-muted);
}

.poster-gallery-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--app-surface-muted);
  color: var(--app-text-muted);
  font-size: 34rpx;
  line-height: 56rpx;
  text-align: center;
}

.poster-gallery-preview-wrap {
  position: relative;
  height: 620rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, var(--app-surface-muted) 0%, var(--app-paper-muted) 100%);
  overflow: hidden;
}

.poster-gallery-preview {
  width: 100%;
  height: 100%;
}

.poster-gallery-preview-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  box-sizing: border-box;
}

.poster-preview-mock {
  width: 320rpx;
  height: 500rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 32rpx rgba(58, 90, 132, 0.12);
  padding: 28rpx 26rpx;
  box-sizing: border-box;
}

.poster-preview-mock-title,
.poster-preview-mock-subtitle,
.poster-preview-mock-line {
  border-radius: 999rpx;
}

.poster-preview-mock-title {
  width: 180rpx;
  height: 18rpx;
  background: rgba(47, 111, 228, 0.55);
}

.poster-preview-mock-subtitle {
  width: 120rpx;
  height: 12rpx;
  margin-top: 14rpx;
  background: rgba(96, 112, 137, 0.28);
}

.poster-preview-mock-card {
  margin-top: 38rpx;
  padding: 24rpx 18rpx;
  border-radius: 16rpx;
  background: var(--app-paper);
}

.poster-preview-mock-line {
  height: 10rpx;
  margin-top: 16rpx;
  background: rgba(88, 101, 121, 0.22);
}

.poster-preview-mock-line-strong {
  width: 62%;
  margin-top: 0;
  background: rgba(60, 42, 20, 0.35);
}

.poster-preview-mock-line-short {
  width: 72%;
}

.poster-gallery-index {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  min-width: 88rpx;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(60, 42, 20, 0.6);
  color: #ffffff;
  font-size: 22rpx;
  text-align: center;
  box-sizing: border-box;
}

.poster-gallery-scroll {
  margin-top: 22rpx;
  white-space: nowrap;
}

.poster-gallery-list {
  display: flex;
  gap: 16rpx;
  padding-bottom: 10rpx;
}

.poster-gallery-thumb {
  width: 136rpx;
  flex-shrink: 0;
}

.poster-gallery-thumb-image {
  width: 136rpx;
  height: 176rpx;
  border-radius: 20rpx;
  background: var(--app-surface-muted);
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.poster-gallery-thumb-placeholder {
  position: relative;
  padding: 12rpx 10rpx;
  overflow: hidden;
}

.poster-template-aurora {
  background: linear-gradient(145deg, #dcfbef 0%, #effffb 58%, #ffffff 100%);
}

.poster-template-lilac {
  background: linear-gradient(145deg, #f5ebff 0%, #f7f0ff 58%, #ffffff 100%);
}

.poster-template-sky {
  background: linear-gradient(145deg, #dff2ff 0%, #eff7ff 58%, #ffffff 100%);
}

.poster-template-paper {
  background: linear-gradient(145deg, #fffdf8 0%, #f5f7fb 58%, #ffffff 100%);
}

.poster-thumb-mock-head,
.poster-thumb-mock-footer {
  display: flex;
  align-items: center;
}

.poster-thumb-mock-avatar {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--theme-primary-alpha-55);
}

.poster-thumb-mock-name {
  width: 42rpx;
  height: 8rpx;
  margin-left: 8rpx;
  border-radius: 999rpx;
  background: rgba(47, 111, 228, 0.48);
}

.poster-thumb-mock-line {
  height: 5rpx;
  margin-top: 9rpx;
  border-radius: 999rpx;
  background: rgba(86, 100, 121, 0.28);
}

.poster-thumb-mock-line-title {
  width: 72%;
  margin-top: 14rpx;
  background: rgba(60, 42, 20, 0.34);
}

.poster-thumb-mock-line-short {
  width: 64%;
}

.poster-thumb-mock-footer {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  bottom: 12rpx;
  justify-content: space-between;
}

.poster-thumb-mock-chip {
  width: 38rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(47, 111, 228, 0.22);
}

.poster-thumb-mock-qr {
  width: 18rpx;
  height: 18rpx;
  border-radius: 4rpx;
  background: rgba(60, 42, 20, 0.18);
}

.poster-gallery-thumb-active .poster-gallery-thumb-image {
  border-color: var(--theme-primary);
  box-shadow: 0 14rpx 28rpx var(--theme-primary-alpha-22);
}

.poster-gallery-thumb-name {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--app-text-soft);
  text-align: center;
}

.poster-gallery-thumb-active .poster-gallery-thumb-name {
  color: var(--theme-primary-dark);
  font-weight: 600;
}

.poster-gallery-actions {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.poster-gallery-btn {
  flex: 1;
  border: none;
  border-radius: 999rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: #ffffff;
  font-size: 28rpx;
  text-align: center;
  padding: 0 24rpx;
}

.poster-gallery-btn::after {
  border: none;
}

.poster-gallery-btn-plain {
  background: var(--app-surface-muted);
  color: var(--app-text-soft);
}

.poster-gallery-btn-ghost {
  background: var(--app-paper);
  color: var(--theme-primary-dark);
  border: 2rpx solid var(--theme-primary-alpha-20);
}

.course-header {
  background:
    radial-gradient(circle at 78% 4%, rgba(255,255,255,0.22) 0, rgba(255,255,255,0) 190rpx),
    linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: white;
  padding: 44rpx 34rpx;
  border-radius: 26rpx;
  margin-bottom: 24rpx;
  text-align: left;
  box-shadow: 0 18rpx 38rpx var(--theme-primary-alpha-18);
}

.notification-reminder {
  background: #fff8e8;
  border: 2rpx solid #f7d48b;
  color: #8a5a00;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.notification-reminder-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
}

.notification-reminder-link {
  flex-shrink: 0;
  color: var(--theme-primary-dark);
  font-size: 24rpx;
  font-weight: 600;
}

.course-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.course-period {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.course-date {
  font-size: 24rpx;
  opacity: 0.8;
}

.calendar-section {
  background: var(--app-paper);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.calendar-title {
  font-weight: bold;
  font-size: 28rpx;
  color: var(--app-text);
  margin-bottom: 24rpx;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 16rpx;
}

.calendar-day {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--app-surface-muted);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.calendar-day.checked {
  background: var(--theme-primary-tint);
  border-color: var(--theme-primary);
}

.calendar-day.pending {
  background: var(--app-page-bg);
}

.day-number {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--app-text-soft);
}

.calendar-day.checked .day-number {
  color: var(--theme-primary);
}

.day-status {
  font-size: 20rpx;
  color: var(--theme-primary);
  margin-top: 4rpx;
}

/* 内容模块样式 */
.content-section {
  background: var(--app-paper);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--app-shadow-soft);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--app-text);
  margin-bottom: 24rpx;
}

.section-title-with-action {
  justify-content: space-between;
  gap: 24rpx;
}

.section-title-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.immersive-entry {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: auto;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: var(--theme-primary-tint);
  color: var(--theme-primary-dark);
  font-size: 24rpx;
  font-weight: 600;
}

.immersive-entry-icon {
  font-size: 24rpx;
  line-height: 1;
}

.tts-entry {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: var(--app-surface-muted);
  color: var(--theme-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.tts-entry-active {
  background: var(--theme-primary-tint);
  color: var(--theme-primary-dark);
}

.tts-entry-icon {
  font-size: 26rpx;
  line-height: 1;
}

.podcast-share-entry,
.closing-video-share-entry {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: auto;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: var(--theme-primary-tint);
  color: var(--theme-primary-dark);
  font-size: 24rpx;
  font-weight: 600;
  /* 重置 button 默认样式 */
  border: none;
  line-height: 56rpx;
  min-height: unset;
  box-sizing: border-box;
}

.podcast-share-entry::after {
  border: none;
}

.closing-video-share-entry {
  background: var(--app-surface-muted);
  color: var(--app-text-soft);
}

.closing-video-share-entry::after {
  border: none;
}

.podcast-share-entry-icon,
.closing-video-share-entry-icon {
  font-size: 26rpx;
  line-height: 1;
}

.section-title-text {
  flex: 1;
}

.section-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: white;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.section-icon.calm,
.section-icon.question,
.section-icon.read,
.section-icon.think,
.section-icon.write,
.section-icon.extract,
.section-icon.share,
.section-icon.learn {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
}

.section-icon.podcast {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
}

.section-icon.closing-video {
  background: linear-gradient(135deg, var(--app-text-soft) 0%, var(--app-text) 100%);
}

.section-icon.look {
  background: linear-gradient(135deg, var(--theme-primary-light) 0%, var(--theme-primary) 100%);
}

.look-image-wrap {
  position: relative;
  width: 100%;
  border-radius: 12rpx;
  overflow: hidden;
}

.look-image {
  width: 100%;
  display: block;
  border-radius: 12rpx;
}

.look-image-zoom-hint {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.section-content {
  font-size: 32rpx;
  color: var(--app-text-soft);
  line-height: 2.2;
  text-align: justify;
  width: 100%;
  box-sizing: border-box;
  overflow: visible;
  letter-spacing: 1px;
}

/* 富文本内容样式 */
.section-content rich-text {
  font-size: 32rpx;
  line-height: 2.2;
  color: var(--app-text-soft);
  width: 100%;
  display: block;
  letter-spacing: 1px;
}

/* 富文本段落样式 */
.section-content /deep/ p {
  margin: 24rpx 0;
  line-height: 1.8;
}

/* 富文本空段落样式 - 确保空行可见 */
.section-content /deep/ p:empty {
  min-height: 1em;
  display: block;
  margin: 24rpx 0;
}

/* 富文本粗体样式 */
.section-content /deep/ strong {
  font-weight: bold;
  color: var(--app-text);
}

/* 富文本缩进样式 */
.section-content /deep/ p[style*="margin-left"] {
  margin-left: 2em;
}

/* 富文本图片样式 */
.section-content /deep/ img {
  max-width: 100%;
  height: auto;
  border-radius: 50%;
  margin: 16rpx 0;
  display: block;
}

/* 富文本链接样式 */
.section-content /deep/ a {
  color: var(--theme-primary);
  text-decoration: underline;
}

/* 富文本列表样式 */
.section-content /deep/ ol,
.section-content /deep/ ul {
  margin: 24rpx 0;
  padding-left: 32rpx;
}

.section-content /deep/ li {
  margin: 16rpx 0;
  line-height: 1.8;
}

/* 底部固定按钮 */
.fixed-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.96);
  padding: 20rpx 24rpx calc(20rpx + constant(safe-area-inset-bottom));
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -8rpx 24rpx rgba(84, 60, 30, 0.08);
  z-index: 100;
}

.fixed-buttons.single-action {
  gap: 0;
}

.btn-back {
  flex: 1;
  background: var(--app-surface-muted);
  color: var(--app-text-soft);
  border: none;
  border-radius: 18rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

.btn-back.full-width {
  flex: 1 1 100%;
  width: 100%;
}

.btn-back::after {
  border: none;
}

.btn-checkin,
.btn-enroll {
  flex: 2;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: white;
  border: none;
  border-radius: 18rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-checkin::after,
.btn-enroll::after {
  border: none;
}

/* 已打卡状态 */
.btn-checkin.disabled {
  background: var(--app-disabled-soft) !important;
  color: var(--app-text-soft);
  opacity: 1;
  border: 2rpx solid var(--app-border);
}

.btn-checkin:disabled {
  background: var(--app-disabled-soft) !important;
  color: var(--app-text-soft);
  opacity: 1;
  border: 2rpx solid var(--app-border);
}

/* 社群互动评论 */
.comments-section {
  background: var(--app-paper);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--app-shadow-soft);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
}

.comments-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--app-border);
}

.comments-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.comments-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--app-text);
}

.comments-count {
  font-size: 24rpx;
  color: var(--app-text-muted);
  margin-left: 8rpx;
}

.comments-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.comment-item {
  display: flex;
  gap: 16rpx;
}

.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  /* background 通过 inline style 设置 */
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar-text {
  font-size: 28rpx;
  color: white;
  font-weight: bold;
}

.avatar-image {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: block;
}

.avatar-image-small {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: block;
}

.avatar-image-tiny {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: block;
}

.comment-content {
  flex: 1;
  min-width: 0;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.comment-user {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--app-text);
  letter-spacing: 1px;
}

.comment-time {
  font-size: 22rpx;
  color: var(--app-text-muted);
}

.comment-text {
  font-size: 30rpx;
  color: var(--app-text-soft);
  line-height: 2.2;
  margin-bottom: 12rpx;
  word-break: break-word;
  white-space: pre-wrap;
  letter-spacing: 1px;
}

.comment-text rich-text,
.dynamic-detail-content rich-text {
  display: block;
  font-size: inherit;
  color: inherit;
  line-height: inherit;
  letter-spacing: inherit;
}

.comment-text /deep/ p,
.dynamic-detail-content /deep/ p {
  margin: 0 0 18rpx;
  line-height: inherit;
}

.comment-text /deep/ ul,
.comment-text /deep/ ol,
.dynamic-detail-content /deep/ ul,
.dynamic-detail-content /deep/ ol {
  margin: 12rpx 0 18rpx 1.3em;
  padding: 0;
}

.comment-text /deep/ li,
.dynamic-detail-content /deep/ li {
  margin: 8rpx 0;
  line-height: inherit;
}

.comment-text /deep/ strong,
.comment-text /deep/ b,
.dynamic-detail-content /deep/ strong,
.dynamic-detail-content /deep/ b {
  font-weight: 700;
}

.comment-text-clamped {
  max-height: 396rpx;
  overflow: hidden;
}

.checkin-content-toggle {
  display: inline-flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: var(--theme-primary);
  font-weight: 500;
}

.checkin-images {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.checkin-images-feed {
  margin: 4rpx 0 14rpx;
}

.checkin-images-detail {
  margin-top: 24rpx;
}

.checkin-image-frame {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 100%;
  border-radius: 12rpx;
  background: var(--app-surface-muted);
  overflow: hidden;
}

.checkin-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.checkin-image-frame-detail,
.checkin-image-detail {
  border-radius: 16rpx;
}

.checkin-image-frame-feed,
.checkin-image-feed {
  border-radius: 10rpx;
}

.comment-footer {
  display: flex;
  gap: 32rpx;
  align-items: center;
  min-height: 56rpx;
}

.comment-like,
.comment-reply {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--app-text-muted);
  padding: 8rpx 0;
}

.like-icon,
.reply-icon {
  font-size: 24rpx;
}

.like-icon.liked {
  color: #ff6b6b;
}

.like-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.like-count-bracket,
.like-count-number {
  display: inline-block;
  line-height: 1;
}

.like-count-number {
  min-width: 12rpx;
  text-align: center;
  padding: 0 2rpx;
}

/* 查看评论按钮 */
.comment-toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--theme-primary);
  padding: 8rpx 0;
}

.toggle-icon {
  font-size: 24rpx;
}

.toggle-text {
  font-size: 24rpx;
}

.toggle-text.loading {
  color: var(--app-text-muted);
}

/* 回复列表 */
.replies-list {
  margin-top: 16rpx;
  margin-left: 24rpx;
}

.reply-item {
  display: flex;
  gap: 0;
  margin-bottom: 16rpx;
  position: relative;
}

.reply-left-line {
  width: 4rpx;
  background: linear-gradient(180deg, #d0e7ff 0%, var(--theme-primary-tint) 100%);
  border-radius: 2rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.reply-main {
  flex: 1;
  display: flex;
  gap: 12rpx;
  min-width: 0;
}

.reply-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.reply-avatar .avatar-text {
  font-size: 24rpx;
  color: white;
  font-weight: bold;
}

.reply-content {
  flex: 1;
  min-width: 0;
}

.reply-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.reply-user {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--app-text);
  letter-spacing: 1px;
}

.reply-text {
  font-size: 30rpx;
  color: var(--app-text-soft);
  line-height: 2.2;
  margin-bottom: 12rpx;
  word-break: break-word;
  white-space: pre-wrap;
  letter-spacing: 1px;
}

.reply-time {
  font-size: 22rpx;
  color: var(--app-text-muted);
}

.reply-footer {
  display: flex;
  gap: 32rpx;
  align-items: center;
  min-height: 56rpx;
}

.reply-like,
.reply-reply,
.reply-delete {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--app-text-muted);
  padding: 8rpx 0;
}

.reply-delete {
  color: #d93025;
}

/* 嵌套回复的样式（回复的回复） */
.nested-replies-list {
  margin-top: 16rpx;
  padding-left: 20rpx;
  border-left: 2rpx solid var(--app-border);
}

.nested-reply-item {
  display: flex;
  gap: 0;
  margin-bottom: 12rpx;
  position: relative;
}

.nested-reply-left-line {
  width: 2rpx;
  background: linear-gradient(180deg, var(--theme-primary-tint) 0%, #f5faff 100%);
  border-radius: 1rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.nested-reply-main {
  flex: 1;
  display: flex;
  gap: 10rpx;
  min-width: 0;
}

.nested-reply-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.nested-reply-avatar .avatar-text {
  font-size: 20rpx;
  color: white;
  font-weight: bold;
}

.nested-reply-content {
  flex: 1;
  min-width: 0;
}

.nested-reply-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.nested-reply-user {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--app-text);
  letter-spacing: 1px;
}

.nested-reply-text {
  font-size: 26rpx;
  color: var(--app-text-soft);
  line-height: 2;
  margin-bottom: 8rpx;
  word-break: break-word;
  white-space: pre-wrap;
  letter-spacing: 1px;
}

.nested-reply-time {
  font-size: 20rpx;
  color: var(--app-disabled);
}

.nested-reply-footer {
  display: flex;
  gap: 24rpx;
  align-items: center;
  min-height: 56rpx;
}

.nested-reply-like {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: var(--app-disabled);
  padding: 6rpx 0;
}

.comment-item-focus,
.reply-item-focus,
.nested-reply-item-focus {
  animation: focusFlash 2.6s ease;
}

@keyframes focusFlash {
  0% {
    background: var(--theme-primary-alpha-12);
    box-shadow: 0 0 0 0 var(--theme-primary-alpha-26);
  }
  100% {
    background: transparent;
    box-shadow: 0 0 0 0 transparent;
  }
}

.dynamic-detail-card {
  background: linear-gradient(180deg, var(--app-paper) 0%, var(--app-paper-muted) 100%);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: var(--app-shadow-soft);
  border: 1rpx solid rgba(92, 70, 44, 0.08);
}

.dynamic-author-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 28rpx;
}

.dynamic-author-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.dynamic-author-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--app-text);
}

.dynamic-author-meta {
  font-size: 24rpx;
  color: var(--app-text-muted);
}

.dynamic-detail-content {
  font-size: 34rpx;
  line-height: 2;
  color: var(--app-text);
  white-space: pre-wrap;
  word-break: break-word;
  letter-spacing: 1rpx;
}

.dynamic-detail-content-clamped {
  max-height: 408rpx;
  overflow: hidden;
}

.dynamic-content-toggle {
  margin-top: 16rpx;
  margin-bottom: 0;
}

.dynamic-hashtag {
  margin-top: 28rpx;
  font-size: 28rpx;
  color: var(--theme-primary);
}

.dynamic-period-chip {
  margin-top: 20rpx;
  display: inline-flex;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-tint);
  color: var(--theme-primary);
  font-size: 24rpx;
}

.dynamic-date {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--app-text-muted);
}

.dynamic-like-strip {
  margin-top: 20rpx;
  padding: 0 12rpx 20rpx;
  border-bottom: 2rpx solid var(--app-border);
}

.dynamic-like-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 0;
  color: var(--app-text-soft);
  font-size: 26rpx;
  min-height: 76rpx;
}

.dynamic-like-pill-icon,
.dynamic-bottom-action-icon {
  font-size: 30rpx;
  color: var(--app-text-muted);
}

.dynamic-like-pill-icon.liked,
.dynamic-bottom-action-icon.liked {
  color: #ff6b6b;
}

.dynamic-comments-block {
  margin-top: 28rpx;
  background: var(--app-paper);
  border-radius: 28rpx;
  padding: 28rpx;
}

.dynamic-comments-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--app-text);
  margin-bottom: 12rpx;
}

.dynamic-replies-list {
  margin-left: 0;
  margin-top: 8rpx;
}

.dynamic-comments-empty {
  padding: 72rpx 0 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  color: var(--app-disabled);
}

.dynamic-comments-empty-art {
  font-size: 68rpx;
}

.dynamic-comments-empty-text {
  font-size: 26rpx;
}

.dynamic-comments-locked {
  padding: 72rpx 0 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  color: var(--app-disabled);
}

.dynamic-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + constant(safe-area-inset-bottom));
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--app-paper);
  box-shadow: 0 -4rpx 16rpx rgba(60, 42, 20, 0.08);
}

.dynamic-input-trigger {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 36rpx;
  background: var(--app-surface-muted);
  color: var(--app-text-muted);
  font-size: 28rpx;
}

.dynamic-input-trigger-disabled {
  opacity: 0.7;
}

.dynamic-bottom-action {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--app-surface-muted);
  color: var(--app-text-soft);
  font-size: 28rpx;
  border: none;
  box-sizing: border-box;
}

.dynamic-bottom-delete {
  background: #fff0f0;
  color: #e74c3c;
}

.dynamic-bottom-like {
  background: #fff7f7;
  color: #e05252;
}

.dynamic-bottom-liked {
  background: #ffe8e8;
  color: #c0392b;
}

.dynamic-bottom-share-menu {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: #ffffff;
}

.checkin-share-popover-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: transparent;
  z-index: 130;
}

.checkin-share-popover {
  position: fixed;
  right: 24rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  width: 164rpx;
  background: var(--app-paper);
  border: 1rpx solid var(--theme-primary-alpha-20);
  border-radius: 18rpx;
  overflow: visible;
  box-shadow: 0 10rpx 32rpx rgba(35, 88, 150, 0.18);
  z-index: 131;
}

.checkin-share-popover::after {
  content: '';
  position: absolute;
  right: 44rpx;
  bottom: -10rpx;
  width: 20rpx;
  height: 20rpx;
  background: var(--app-paper);
  border-right: 1rpx solid var(--theme-primary-alpha-20);
  border-bottom: 1rpx solid var(--theme-primary-alpha-20);
  transform: rotate(45deg);
}

.checkin-share-popover-item {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--theme-primary);
  background: var(--app-paper);
  border-bottom: 1rpx solid var(--theme-primary-alpha-12);
  box-sizing: border-box;
}

.checkin-share-popover-item:last-child {
  border-bottom: none;
}

.checkin-share-popover-item:active {
  background: var(--theme-primary-tint);
}

.checkin-share-popover-button {
  width: 100%;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 0;
}

.checkin-share-popover-button::after {
  border: none;
}

/* 允许长按选择文字 */
.section-content,
.dynamic-detail-content,
.comment-text,
.reply-text,
.nested-reply-text {
  user-select: text;
}

.checkin-load-more {
  padding: 24rpx 32rpx;
  text-align: center;
}

.checkin-load-more-btn {
  display: inline-block;
  padding: 16rpx 40rpx;
  border-radius: 32rpx;
  background: var(--theme-primary-tint);
  color: var(--theme-primary);
  font-size: 26rpx;
}

.checkin-load-more-text {
  color: var(--app-text-muted);
  font-size: 26rpx;
}

/* 点赞头像样式 */
.like-avatars {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  background: var(--app-surface-muted);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 4rpx;
  margin-right: 0rpx;
}

.like-avatar-img {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: block;
}

.like-avatar-text {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: white;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  line-height: 40rpx;
  text-align: center;
}

.dynamic-like-strip .like-avatars {
  margin-left: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
}

.dynamic-like-strip .like-avatar-img,
.dynamic-like-strip .like-avatar-text {
  width: 52rpx;
  height: 52rpx;
  font-size: 24rpx;
  border-radius: 50%;
}

.comment-actions-right {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-left: auto;
}

.like-avatar-more {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--app-rule);
  color: var(--app-text-soft);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.dynamic-like-strip .like-avatar-more {
  width: 52rpx;
  height: 52rpx;
  font-size: 28rpx;
}

/* 读一读 收起/展开 */
.reading-outer-wrap {
  position: relative;
}

.reading-content-wrap {
  position: relative;
}

.reading-content-collapsed {
  max-height: 352rpx;
  overflow: hidden;
}

.reading-fade-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 80rpx;
  background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(255,255,255,0.95) 100%);
}

.reading-toggle-row {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 44rpx;
  margin-top: 14rpx;
}

.reading-chevron-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  transition: transform 0.25s ease;
}

.reading-chevron-group-up {
  transform: rotate(180deg);
}

.reading-chevron {
  width: 20rpx;
  height: 20rpx;
  border-right: 3rpx solid var(--theme-primary);
  border-bottom: 3rpx solid var(--theme-primary);
  transform: rotate(45deg);
}

/* 结营视频 */
.closing-video-section {
  overflow: hidden;
}

.closing-video-shell {
  position: relative;
  width: 100%;
  height: 388rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #111827;
}

.closing-video-player,
.closing-video-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.closing-video-cover {
  position: relative;
  border-radius: 18rpx;
  overflow: hidden;
}

.closing-video-cover-image,
.closing-video-cover-placeholder {
  width: 100%;
  height: 100%;
  display: block;
  background: #111827;
}

.closing-video-cover-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 130rpx;
  background: linear-gradient(180deg, rgba(17, 24, 39, 0) 0%, rgba(17, 24, 39, 0.68) 100%);
}

.closing-video-cover-play {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  transform: translate(-50%, -50%);
  background: rgba(17, 24, 39, 0.45);
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

.closing-video-cover-play-triangle {
  width: 0;
  height: 0;
  margin-left: 8rpx;
  border-top: 24rpx solid transparent;
  border-bottom: 24rpx solid transparent;
  border-left: 34rpx solid #fff;
}

.closing-video-cover-duration {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 1;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}

/* 播一播 */
.podcast-player-card {
  background: linear-gradient(135deg, var(--theme-primary-tint) 0%, #ffffff 100%);
  border-radius: 20rpx;
  padding: 28rpx 24rpx 0;
  border: 1rpx solid var(--theme-primary-alpha-18);
  overflow: hidden;
}

.podcast-player-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
}

.podcast-info {
  flex: 1;
  margin-right: 24rpx;
  overflow: hidden;
}

.podcast-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--app-text);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.podcast-duration {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--theme-primary-dark);
}

.podcast-play-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx var(--theme-primary-alpha-26);
}

.podcast-play-btn.playing {
  background: var(--app-text);
  box-shadow: 0 8rpx 20rpx rgba(23, 34, 27, 0.16);
}

.podcast-pause-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.podcast-pause-bar {
  width: 6rpx;
  height: 28rpx;
  background: #fff;
  border-radius: 3rpx;
}

.podcast-loading-ring {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: podcast-spin 0.8s linear infinite;
}

@keyframes podcast-spin {
  to { transform: rotate(360deg); }
}

.podcast-play-icon {
  font-size: 32rpx;
  color: #fff;
  line-height: 1;
  margin-left: 4rpx;
}

.podcast-progress-bar {
  height: 6rpx;
  background: var(--theme-primary-alpha-15);
  border-radius: 3rpx;
  margin: 0 -24rpx;
  overflow: hidden;
}

.podcast-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--theme-primary), var(--theme-primary-dark));
  border-radius: 3rpx;
  transition: width 0.5s linear;
}

.podcast-desc-wrap {
  margin-top: 14rpx;
  padding: 22rpx 24rpx;
  background: var(--app-surface-muted);
  border: 1rpx solid var(--app-border);
  border-radius: 16rpx;
}

.podcast-desc-heading {
  position: relative;
  padding-left: 18rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--theme-primary-dark);
}

.podcast-desc-heading::before {
  content: '';
  position: absolute;
  left: 0;
  top: 7rpx;
  width: 6rpx;
  height: 24rpx;
  border-radius: 3rpx;
  background: var(--theme-primary);
}

.podcast-desc {
  font-size: 28rpx;
  color: var(--app-text-soft);
  line-height: 1.85;
}

.podcast-desc-collapsed {
  display: -webkit-box;
  -webkit-line-clamp: 6;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.podcast-desc-toggle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--theme-primary);
}

.search-keyword-bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #fffbeb;
  border: 1rpx solid #fcd34d;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  flex-wrap: wrap;
}

.search-keyword-label {
  color: #92400e;
  font-weight: 500;
}

.search-keyword-text {
  color: #b45309;
  font-weight: 700;
}

.search-keyword-hint {
  color: #a16207;
  font-size: 24rpx;
}

.course-module-image { display: block; width: 100%; border-radius: 12rpx; margin: 12rpx 0; }

/* Version 1 core-journey polish: calmer editorial reading hierarchy. */
.page-course-detail {
  padding: 22rpx;
  background:
    radial-gradient(circle at 88% 0%, var(--theme-primary-alpha-08) 0, rgba(255, 255, 255, 0) 310rpx),
    linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}

.course-header {
  padding: 42rpx 32rpx;
  border-radius: var(--app-radius-xl);
  box-shadow: 0 22rpx 44rpx var(--theme-primary-alpha-18);
}

.course-title {
  font-size: 46rpx;
  line-height: 1.2;
  letter-spacing: -1.2rpx;
}

.content-section,
.calendar-section,
.comments-section {
  border-radius: var(--app-radius-lg);
  border-color: rgba(92, 70, 44, 0.07);
  box-shadow: var(--app-shadow-soft);
}

.content-section {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  margin-bottom: 18rpx;
}

.section-icon {
  width: 50rpx;
  height: 50rpx;
  border-radius: 16rpx;
  font-size: 23rpx;
  margin-right: 14rpx;
}

.section-content,
.section-content rich-text {
  font-size: 31rpx;
  line-height: 1.95;
  letter-spacing: 0.3rpx;
  text-align: left;
}

.section-content /deep/ img {
  border-radius: var(--app-radius-sm);
}

.immersive-entry,
.tts-entry,
.podcast-share-entry,
.closing-video-share-entry {
  border-radius: 999rpx;
}

.fixed-buttons {
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 253, 248, 0.94);
  backdrop-filter: blur(16rpx);
  border-top: 1rpx solid var(--app-border);
  box-shadow: 0 -12rpx 30rpx rgba(84, 60, 30, 0.08);
}

.btn-back,
.btn-checkin,
.btn-enroll {
  border-radius: var(--app-radius-md);
  font-weight: 650;
}

.btn-checkin,
.btn-enroll {
  box-shadow: 0 14rpx 26rpx var(--theme-primary-alpha-20);
}

/* Version 3 dawn: seal-style module icons, serif title, line icons replacing emoji. */
.section-icon,
.section-icon.calm,
.section-icon.question,
.section-icon.read,
.section-icon.think,
.section-icon.write,
.section-icon.extract,
.section-icon.share,
.section-icon.learn,
.section-icon.podcast,
.section-icon.closing-video,
.section-icon.look {
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 12rpx;
  background: var(--theme-primary-alpha-05);
  color: var(--theme-primary-dark);
  font-family: var(--app-font-serif);
  font-weight: 700;
  line-height: 1;
  transform: rotate(-3deg);
}

.course-title { font-family: var(--app-font-serif); }

.comments-icon.app-seal {
  width: 36rpx;
  height: 36rpx;
  font-size: 20rpx;
}

.dynamic-comments-empty-art {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-disabled);
}
.dynamic-comments-empty-art .app-icon { width: 68rpx; height: 68rpx; }

.reply-icon.app-icon,
.toggle-icon.app-icon { width: 26rpx; height: 26rpx; }
.tts-entry-icon.app-icon,
.podcast-share-entry-icon.app-icon,
.closing-video-share-entry-icon.app-icon { width: 28rpx; height: 28rpx; }


/* Version 3 dawn: 点赞图标改为线性图标，点赞瞬间弹一下 */
.like-icon.app-icon {
  width: 30rpx;
  height: 30rpx;
}
.dynamic-like-pill-icon.app-icon {
  width: 36rpx;
  height: 36rpx;
}
.dynamic-bottom-like-icon.app-icon {
  width: 32rpx;
  height: 32rpx;
}


/* Version 3 dawn: 九步进度条、精简底部栏 */
/* 吸顶需要祖先不是滚动容器：overflow-x 先写 hidden 兜底，再用 clip 覆盖 */
.page-course-detail { overflow-x: clip; }
.page-course-detail.page-course-detail-nobar {
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 固定底部“去打卡”栏需要额外滚动空间，避免最后一条内容被遮住。 */
.page-course-detail:not(.page-course-detail-nobar) {
  padding-bottom: calc(280rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
}

.page-course-detail.page-course-detail-detail {
  padding-bottom: calc(220rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.nine-steps {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin: 16rpx -22rpx 20rpx;
  padding: 14rpx 28rpx;
  background: rgba(255, 253, 248, 0.88);
  backdrop-filter: blur(12rpx);
  border-bottom: 1rpx solid var(--app-border);
}

.nine-step {
  box-sizing: border-box;
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid var(--app-disabled);
  border-radius: 12rpx;
  color: var(--app-disabled);
  font-family: var(--app-font-serif);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  transform: rotate(-3deg);
  transition: background 220ms ease, color 220ms ease, border-color 220ms ease;
}

.nine-step-done {
  border-color: var(--theme-primary-dark);
  color: var(--theme-primary-dark);
}

.nine-step-current {
  border-color: var(--app-dawn);
  background: var(--app-dawn);
  color: #fff;
}

.fixed-buttons {
  align-items: center;
  gap: 16rpx;
}

.fixed-buttons .btn-checkin {
  flex: 1;
  width: 100%;
  margin: 0;
}

.btn-podcast {
  flex: 0 0 auto;
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--app-border);
  border-radius: 50%;
  background: var(--app-dawn-soft);
  color: var(--app-dawn-ink);
  line-height: 1;
}

.btn-podcast::after { border: none; }
.btn-podcast .app-icon { width: 40rpx; height: 40rpx; }

/* Features: 心情匿名汇总与看见卡 */
.mood-summary-line {
  padding: 0 4rpx 12rpx;
  font-size: 24rpx;
  color: var(--app-text-secondary, #8a8478);
  letter-spacing: 1rpx;
}

.seen-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 24rpx;
  padding: 4rpx 4rpx;
}

.seen-btn-seal {
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  font-family: var(--app-font-serif);
  font-size: 22rpx;
  color: var(--app-dawn-ink);
  border: 2rpx solid var(--app-dawn-ink);
  border-radius: 8rpx;
  box-sizing: border-box;
}

.seen-btn-mine .seen-btn-seal {
  background: var(--app-dawn-ink);
  color: #fff;
}

.seen-btn-count {
  font-family: var(--app-font-num);
  font-size: 24rpx;
  color: var(--app-dawn-ink);
}

.dynamic-like-strip {
  display: flex;
  align-items: center;
}

.seen-panel-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1200;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: flex-end;
}

.seen-panel {
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--app-surface, #fffdf8);
  border-radius: 28rpx 28rpx 0 0;
}

.seen-panel-title {
  margin-bottom: 16rpx;
  font-family: var(--app-font-serif);
  font-size: 30rpx;
  color: var(--app-dawn-ink);
}

.seen-phrase {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
}

.seen-phrase-on {
  background: var(--app-dawn-soft);
}

.seen-phrase-seal {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  font-family: var(--app-font-serif);
  font-size: 26rpx;
  color: var(--app-dawn-ink);
  border: 2rpx solid var(--app-dawn-ink);
  border-radius: 10rpx;
  box-sizing: border-box;
}

.seen-phrase-text {
  font-size: 28rpx;
  color: var(--app-text, #333);
}

.seen-panel-error {
  padding: 12rpx 16rpx 0;
  font-size: 24rpx;
  color: var(--app-text-secondary, #8a8478);
}

/* 打卡下方的操作条：点赞、看见、回复、查看评论统一成线性图标 + 小字。 */
.comment-footer .comment-like,
.comment-footer .seen-btn,
.comment-footer .comment-reply,
.comment-footer .comment-toggle,
.dynamic-like-strip .seen-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
  font-size: 24rpx;
  line-height: 1;
  color: var(--app-text-muted);
  background: transparent;
  border: none;
}
.comment-footer .toggle-text,
.comment-footer .comment-reply text,
.seen-btn-label,
.seen-btn-count {
  font-size: 24rpx;
  color: inherit;
  font-family: inherit;
}
.seen-btn-count,
.comment-footer .like-count-number {
  font-family: var(--app-font-num);
  font-size: 24rpx;
}
.comment-footer .like-icon.app-icon,
.comment-footer .reply-icon.app-icon,
.comment-footer .toggle-icon.app-icon,
.reply-icon.app-icon,
.seen-btn-icon.app-icon {
  width: 32rpx;
  height: 32rpx;
  margin: 0;
  font-size: 0;
  color: inherit;
}
.comment-footer .like-icon.app-icon.liked {
  color: #e0645c;
}
.comment-footer .seen-btn {
  margin-left: 32rpx;
}
.seen-btn-mine,
.comment-footer .seen-btn.seen-btn-mine {
  color: var(--app-dawn-deep);
}
.comment-actions-right {
  gap: 32rpx;
}
.dynamic-comments-empty-art .app-icon {
  width: 56rpx;
  height: 56rpx;
  color: var(--app-text-muted);
}
.comments-icon.app-seal {
  background: transparent;
  font-size: 22rpx;
}
.tts-entry-icon.app-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 打卡下方的操作条收成一行：头像叠成一排，文字缩成 见 / 回 / 查。 */
.comment-footer {
  flex-wrap: nowrap;
  gap: 24rpx;
}
.comment-footer .comment-like {
  flex: 0 1 auto;
  min-width: 0;
}
.comment-footer .seen-btn,
.comment-footer .comment-actions-right,
.comment-footer .comment-reply,
.comment-footer .comment-toggle,
.comment-footer .like-icon,
.comment-footer .like-count {
  flex-shrink: 0;
  white-space: nowrap;
}
.comment-footer .seen-btn {
  margin-left: 0;
}
.comment-footer .comment-actions-right {
  gap: 24rpx;
}
.comment-footer .like-avatars,
.dynamic-like-strip .like-avatars {
  flex-wrap: nowrap;
  gap: 0;
  min-width: 0;
  overflow: hidden;
  background: transparent;
  padding: 0;
  border-radius: 0;
}
.comment-footer .like-avatar-img,
.comment-footer .like-avatar-text,
.comment-footer .like-avatar-more,
.dynamic-like-strip .like-avatar-img,
.dynamic-like-strip .like-avatar-text,
.dynamic-like-strip .like-avatar-more {
  flex-shrink: 0;
  box-sizing: border-box;
  border: 3rpx solid var(--app-paper, #fffdf8);
  margin-left: -12rpx;
}
.comment-footer .like-avatars > .like-avatar-img:first-child,
.comment-footer .like-avatars > .like-avatar-text:first-child,
.dynamic-like-strip .like-avatars > .like-avatar-img:first-child,
.dynamic-like-strip .like-avatars > .like-avatar-text:first-child {
  margin-left: 0;
}

/* 操作条对齐：这一排每一项都是 48rpx 高的盒子，图标、数字、文字、头像各自在盒子里垂直居中，共用一条中心线。 */
.comment-footer {
  align-items: center;
  height: 48rpx;
  min-height: 48rpx;
}
.comment-footer .comment-like,
.comment-footer .seen-btn,
.comment-footer .comment-actions-right,
.comment-footer .comment-reply,
.comment-footer .comment-toggle,
.comment-footer .like-count,
.comment-footer .like-avatars {
  display: flex;
  align-items: center;
  height: 48rpx;
  padding-top: 0;
  padding-bottom: 0;
  margin-top: 0;
  margin-bottom: 0;
  box-sizing: border-box;
}
.comment-footer .like-icon.app-icon,
.comment-footer .seen-btn-icon.app-icon,
.comment-footer .reply-icon.app-icon,
.comment-footer .toggle-icon.app-icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  margin: 0;
  vertical-align: middle;
}
/* 心形在画框里比其它图标略低，往上提一点，和眼睛、气泡的中心对齐 */
.comment-footer .like-icon.app-icon {
  -webkit-mask-position: center 35%;
}
.comment-footer .like-count-number,
.comment-footer .seen-btn-label,
.comment-footer .seen-btn-count,
.comment-footer .comment-reply text,
.comment-footer .toggle-text {
  display: block;
  height: 48rpx;
  line-height: 48rpx;
  font-size: 24rpx;
  padding-top: 0;
  padding-bottom: 0;
}
.comment-footer .like-avatar-img,
.comment-footer .like-avatar-text,
.comment-footer .like-avatar-more {
  width: 40rpx;
  height: 40rpx;
  line-height: 34rpx;
}
