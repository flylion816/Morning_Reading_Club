/* 支付页面样式 */

.page-payment {
  background: var(--app-page-bg);
  min-height: 100vh;
  padding: 0;
}

/* 加载中 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: var(--app-page-bg);
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid var(--theme-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading text {
  font-size: 28rpx;
  color: var(--app-text-soft);
}

/* 页面容器 */
.payment-container {
  padding: 0;
  padding-bottom: 180rpx;
}

/* 页面头部 */
.payment-header {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: white;
  padding: 40rpx 30rpx;
  text-align: center;
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  display: block;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
}

.header-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
  display: block;
}

/* 订单信息卡片 */
.order-card {
  background: white;
  margin: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.order-card .section {
  padding: 24rpx 20rpx;
}

.section-title {
  font-size: 24rpx;
  color: var(--app-text-muted);
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

/* 课程信息 */
.course-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.course-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--app-text);
  display: block;
}

.course-subtitle {
  font-size: 24rpx;
  color: var(--app-text-muted);
  display: block;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: #e8e8e8;
  margin: 0 20rpx;
}

.divider-light {
  height: 1rpx;
  background: var(--app-surface-muted);
  margin: 12rpx 0;
}

/* 价格信息 */
.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.price-row.total {
  margin-bottom: 0;
}

.price-label {
  font-size: 26rpx;
  color: var(--app-text-soft);
}

.price-value {
  font-size: 28rpx;
  color: var(--app-text);
  font-weight: 500;
}

.price-discount {
  font-size: 26rpx;
  color: #ff6b6b;
  font-weight: 500;
}

.price-total {
  font-size: 36rpx;
  color: var(--theme-primary);
  font-weight: bold;
}

/* 支付说明 */
.payment-tips {
  padding: 16rpx 20rpx;
  background: var(--theme-primary-tint);
  border-radius: 8rpx;
  margin-top: 16rpx;
  display: flex;
  gap: 8rpx;
  align-items: flex-start;
}

.tip-icon {
  font-size: 24rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.tip-text {
  font-size: 24rpx;
  color: var(--theme-primary);
  line-height: 1.6;
}

/* 支付方式选择 */
.payment-methods {
  padding: 20rpx;
}

.methods-heading {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 16rpx;
}

.methods-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--app-text);
  display: block;
}

.methods-caption {
  font-size: 22rpx;
  color: #8a94a6;
  line-height: 1.5;
  display: block;
}

.method-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 20rpx;
  background: white;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.method-item-wechat {
  box-shadow: 0 8rpx 22rpx rgba(8, 23, 54, 0.06);
}

.method-item.active {
  transform: translateY(-1rpx);
}

.method-item-wechat.active {
  border-color: #07c160;
  background: linear-gradient(180deg, #ffffff 0%, #f4fcf7 100%);
  box-shadow: 0 12rpx 28rpx rgba(7, 193, 96, 0.12);
}

.method-item-mock {
  background: #fafbfc;
  border-style: dashed;
}

.method-item-mock.active {
  border-color: #f59e0b;
  background: #fffaf0;
}

.method-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.method-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.method-icon.wechat {
  background: linear-gradient(135deg, #07c160 0%, #05a650 100%);
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.24);
}

.method-icon-image {
  width: 42rpx;
  height: 42rpx;
}

.method-dev-badge {
  min-width: 72rpx;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #fff3d6;
  color: #b66a00;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.method-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.method-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.method-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--app-text);
  display: block;
}

.method-tag {
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #eaf8ef;
  color: #07c160;
  font-size: 18rpx;
  line-height: 1.4;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.method-desc {
  font-size: 22rpx;
  color: var(--app-text-muted);
  display: block;
}

.method-check {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #d8d8d8;
  border-radius: 50%;
  flex-shrink: 0;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.method-check.checked {
  border-color: #07c160;
  background: #07c160;
  position: relative;
  box-shadow: 0 6rpx 14rpx rgba(7, 193, 96, 0.22);
}

.method-check.checked::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 14rpx;
  border: 3rpx solid white;
  border-left: none;
  border-top: none;
  left: 10rpx;
  top: 5rpx;
  transform: rotate(45deg);
}

/* 按钮组 */
.payment-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: white;
  border-top: 1rpx solid #e8e8e8;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.btn {
  flex: 1;
  padding: 16rpx 20rpx;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  text-align: center;
}

.btn-primary {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: white;
}

.btn-primary:active:not([disabled]) {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-primary[disabled] {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn-secondary {
  background: var(--app-surface-muted);
  color: var(--app-text);
  border: 1rpx solid #e8e8e8;
}

.btn-secondary:active {
  background: #efefef;
  border-color: #d8d8d8;
}

/* 支付结果弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.modal-content {
  width: 100%;
  background: white;
  border-radius: 16rpx 16rpx 0 0;
  padding: 40rpx 30rpx;
  text-align: center;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.result-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin: 0 auto 20rpx;
}

.result-icon.success {
  background: #e8f5e9;
  color: #4caf50;
}

.result-icon.failed {
  background: #ffebee;
  color: #f44336;
}

.result-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--app-text);
  display: block;
  margin-bottom: 8rpx;
}

.result-message {
  font-size: 24rpx;
  color: var(--app-text-muted);
  display: block;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.modal-actions {
  display: flex;
  gap: 12rpx;
}

.modal-actions .btn {
  flex: 1;
  padding: 16rpx 20rpx;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  text-align: center;
}

.modal-actions .btn-primary {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: white;
}

.modal-actions .btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.modal-actions .btn-secondary {
  background: var(--app-surface-muted);
  color: var(--app-text);
  border: 1rpx solid #e8e8e8;
}

.modal-actions .btn-secondary:active {
  background: #efefef;
}

/* 响应式调整 */
@media (max-width: 360px) {
  .order-card {
    margin: 10rpx;
  }

  .payment-methods {
    padding: 16rpx;
  }

  .payment-actions {
    gap: 8rpx;
    padding: 12rpx 16rpx;
  }
}

/* Version 1 core-journey polish: receipt-style order review. */
.page-payment,
.loading {
  background:
    radial-gradient(circle at 90% 2%, var(--theme-primary-alpha-08) 0, rgba(255, 255, 255, 0) 300rpx),
    linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}

.payment-container {
  padding: 20rpx 20rpx calc(190rpx + env(safe-area-inset-bottom));
}

.payment-header {
  margin-bottom: 20rpx;
  padding: 42rpx 32rpx;
  border-radius: var(--app-radius-xl);
  box-shadow: 0 24rpx 46rpx var(--theme-primary-alpha-18);
}

.header-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 18rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.18);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.24);
  font-size: 48rpx;
  font-weight: 750;
}

.header-title {
  font-size: 42rpx;
  font-weight: 750;
  letter-spacing: -1rpx;
}

.order-card,
.payment-methods {
  border-radius: var(--app-radius-lg);
  box-shadow: var(--app-shadow);
}

.order-card {
  margin: 0;
  overflow: hidden;
  background: linear-gradient(180deg, var(--app-paper) 0%, #ffffff 100%);
}

.order-card .section {
  padding: 28rpx;
}

.section-title {
  margin-bottom: 14rpx;
  color: var(--app-text-muted);
  font-size: var(--app-font-xs);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.course-title {
  font-size: 38rpx;
  letter-spacing: -1rpx;
}

.divider {
  margin: 0 28rpx;
  background: var(--app-border);
}

.price-row {
  min-height: 52rpx;
  margin-bottom: 10rpx;
}

.price-label {
  color: var(--app-text-soft);
}

.price-value,
.price-discount,
.price-total {
  font-variant-numeric: tabular-nums;
}

.price-total {
  font-size: 46rpx;
  font-weight: 750;
  letter-spacing: -1rpx;
}

.payment-methods {
  margin-top: 20rpx;
  padding: 26rpx;
  background: linear-gradient(180deg, var(--app-paper) 0%, #ffffff 100%);
}

.method-item {
  border-radius: var(--app-radius-md);
  border-color: var(--app-border);
  box-shadow: none;
}

.method-item:active {
  transform: translateY(2rpx) scale(0.99);
}

.payment-actions {
  padding: 18rpx 22rpx calc(18rpx + constant(safe-area-inset-bottom));
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--app-border);
  background: rgba(255, 253, 248, 0.94);
  backdrop-filter: blur(16rpx);
}

.btn {
  border-radius: var(--app-radius-md);
  font-weight: 650;
}

/* Version 3 focused payment redesign: calmer receipt hierarchy. */
.payment-container {
  padding: 24rpx 24rpx calc(148rpx + env(safe-area-inset-bottom));
}
.pay-summary {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 224rpx;
  padding: 34rpx 32rpx;
  border-radius: var(--app-radius-xl);
  overflow: hidden;
  color: #fff;
  background:
    radial-gradient(circle at 88% 12%, rgba(255,255,255,.18), rgba(255,255,255,0) 180rpx),
    linear-gradient(140deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  box-shadow: 0 22rpx 42rpx var(--theme-primary-alpha-18);
}
.pay-summary::after {
  content: '';
  position: absolute;
  right: -92rpx;
  bottom: -128rpx;
  width: 280rpx;
  height: 280rpx;
  border: 1rpx solid rgba(255,255,255,.22);
  border-radius: 50%;
}
.pay-summary-copy {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}
.pay-summary-kicker {
  display: block;
  color: rgba(255,255,255,.72);
  font-size: 19rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}
.pay-summary-title {
  display: block;
  margin-top: 13rpx;
  color: #fff;
  font-size: 36rpx;
  font-weight: 750;
  line-height: 1.28;
  letter-spacing: -1rpx;
}
.pay-summary-date {
  display: block;
  margin-top: 9rpx;
  color: rgba(255,255,255,.78);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}
.pay-summary-amount {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  text-align: right;
}
.pay-summary-amount-label {
  display: block;
  color: rgba(255,255,255,.72);
  font-size: 20rpx;
}
.pay-summary-amount-value {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}
.amount-currency { font-size: 24rpx; font-weight: 700; }
.amount-integer { font-size: 56rpx; font-weight: 760; letter-spacing: -2rpx; line-height: 1; }
.amount-decimal { font-size: 27rpx; font-weight: 680; }
.pay-card {
  margin-top: 18rpx;
  padding: 8rpx 28rpx 26rpx;
  border-radius: var(--app-radius-lg);
  background: linear-gradient(180deg, var(--app-paper) 0%, #ffffff 100%);
  box-shadow: var(--app-shadow-soft);
}
.pay-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 68rpx;
  border-bottom: 1rpx solid var(--app-border);
}
.pay-line:last-of-type { border-bottom: 0; }
.pay-line-label { color: var(--app-text-soft); font-size: var(--app-font-sm); }
.pay-line-value { color: var(--app-text); font-size: var(--app-font-sm); font-weight: 600; font-variant-numeric: tabular-nums; }
.pay-line-discount { color: var(--app-text-muted); }
.pay-line-strong { min-height: 78rpx; }
.pay-total-value {
  display: flex;
  align-items: baseline;
  color: var(--theme-primary-dark);
  font-variant-numeric: tabular-nums;
}
.pay-total-currency { font-size: 22rpx; font-weight: 700; }
.pay-total-number { font-size: 36rpx; font-weight: 750; letter-spacing: -1rpx; }
.pay-note {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 15rpx 18rpx;
  border-radius: var(--app-radius-sm);
  background: var(--theme-primary-tint);
  color: var(--theme-primary-dark);
  font-size: 21rpx;
}
.pay-note-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: currentColor; flex: 0 0 auto; }
.pay-method-card { padding-top: 26rpx; }
.pay-card-heading { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18rpx; }
.pay-card-title { color: var(--app-text); font-size: var(--app-font-md); font-weight: 700; }
.pay-card-caption { color: var(--app-text-muted); font-size: 20rpx; }
.pay-method {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx;
  border: 2rpx solid var(--app-border);
  border-radius: var(--app-radius-md);
  background: #fff;
  transition: border-color .2s ease, background .2s ease, transform .2s ease;
}
.pay-method:active { transform: translateY(2rpx) scale(.99); }
.pay-method.selected {
  border-color: var(--theme-primary);
  background: var(--theme-primary-tint);
}
.pay-method-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 19rpx;
  background: linear-gradient(145deg, #17b26a 0%, #078b4f 100%);
  box-shadow: 0 8rpx 18rpx rgba(7, 139, 79, .20);
  flex: 0 0 auto;
}
.pay-method-logo { width: 38rpx; height: 38rpx; }
.pay-method-brand-dev {
  background: var(--app-warning-soft);
  color: var(--app-warning);
  font-size: 18rpx;
  font-weight: 750;
}
.pay-method-copy { flex: 1; min-width: 0; }
.pay-method-title-row { display: flex; align-items: center; gap: 10rpx; }
.pay-method-title { color: var(--app-text); font-size: var(--app-font-sm); font-weight: 680; }
.pay-method-badge {
  padding: 3rpx 9rpx;
  border-radius: 7rpx;
  background: #eaf8ef;
  color: #067647;
  font-size: 18rpx;
  font-weight: 700;
}
.pay-method-desc { display: block; margin-top: 5rpx; color: var(--app-text-muted); font-size: 20rpx; }
.pay-method-radio {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid var(--app-border);
  border-radius: 50%;
  flex: 0 0 auto;
}
.pay-method-radio.checked { border-color: var(--theme-primary); background: var(--theme-primary); box-shadow: inset 0 0 0 6rpx #fff; }
.payment-actions {
  gap: 14rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255,253,248,.96);
}
.pay-cancel,
.pay-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-height: 82rpx;
  margin: 0;
  border: 0;
  border-radius: var(--app-radius-md);
  font-size: var(--app-font-sm);
  font-weight: 700;
  line-height: 82rpx;
}
.pay-cancel {
  flex: 0 0 148rpx;
  background: #fff;
  color: var(--app-text-soft);
  box-shadow: inset 0 0 0 2rpx var(--app-border);
}
.pay-submit {
  gap: 4rpx;
  color: #fff;
  background: linear-gradient(135deg, var(--theme-primary), var(--theme-primary-dark));
  box-shadow: 0 14rpx 26rpx var(--theme-primary-alpha-18);
}
.pay-submit-currency { font-size: 21rpx; }
.pay-submit-action { margin-left: 7rpx; }
.pay-submit.is-paying { opacity: .78; }
.pay-submit[disabled] { opacity: .78; color: #fff; background: linear-gradient(135deg, var(--theme-primary), var(--theme-primary-dark)); }
