<!-- 支付页面：订单复核优先，减少装饰性符号和夸张字号 -->
<view class="page-payment">
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <view wx:else class="payment-container">
    <view class="pay-summary">
      <view class="pay-summary-copy">
        <text class="pay-summary-kicker">ORDER REVIEW</text>
        <text class="pay-summary-title">{{enrollmentData.periodTitle}}</text>
        <text class="pay-summary-date">{{enrollmentData.startDate}} 至 {{enrollmentData.endDate}}</text>
      </view>
      <view class="pay-summary-amount">
        <text class="pay-summary-amount-label">应付</text>
        <view class="pay-summary-amount-value">
          <text class="amount-currency">¥</text>
          <text class="amount-integer">{{finalAmountParts.integer}}</text>
          <text class="amount-decimal">{{finalAmountParts.decimal}}</text>
        </view>
      </view>
    </view>

    <view class="pay-card">
      <view class="pay-line">
        <text class="pay-line-label">课程费用</text>
        <text class="pay-line-value">¥{{paymentAmountDisplay}}</text>
      </view>
      <view class="pay-line">
        <text class="pay-line-label">优惠金额</text>
        <text class="pay-line-value pay-line-discount">-¥{{discountAmountDisplay}}</text>
      </view>
      <view class="pay-line pay-line-strong">
        <text class="pay-line-label">实际支付</text>
        <view class="pay-total-value">
          <text class="pay-total-currency">¥</text>
          <text class="pay-total-number">{{finalAmountDisplay}}</text>
        </view>
      </view>
      <view class="pay-note">
        <view class="pay-note-dot"></view>
        <text>支付成功后自动进入课程</text>
      </view>
    </view>

    <view class="pay-card pay-method-card">
      <view class="pay-card-heading">
        <text class="pay-card-title">支付方式</text>
        <text class="pay-card-caption">微信官方收银台</text>
      </view>

      <view
        class="pay-method {{paymentMethod === 'wechat' ? 'selected' : ''}}"
        catchtap="selectPaymentMethod"
        data-method="wechat">
        <view class="pay-method-brand">
          <image class="pay-method-logo" src="/assets/icons/wechat-pay.svg" mode="aspectFit" />
        </view>
        <view class="pay-method-copy">
          <view class="pay-method-title-row">
            <text class="pay-method-title">微信支付</text>
            <text class="pay-method-badge">官方</text>
          </view>
          <text class="pay-method-desc">零钱 / 银行卡 / 微信钱包</text>
        </view>
        <view class="pay-method-radio {{paymentMethod === 'wechat' ? 'checked' : ''}}"></view>
      </view>

      <view
        wx:if="{{isDevelopment}}"
        class="pay-method pay-method-mock {{paymentMethod === 'mock' ? 'selected' : ''}}"
        catchtap="selectPaymentMethod"
        data-method="mock">
        <view class="pay-method-brand pay-method-brand-dev">DEV</view>
        <view class="pay-method-copy">
          <text class="pay-method-title">模拟支付</text>
          <text class="pay-method-desc">仅开发调试使用</text>
        </view>
        <view class="pay-method-radio {{paymentMethod === 'mock' ? 'checked' : ''}}"></view>
      </view>
    </view>

    <view class="payment-actions">
      <button class="pay-cancel" catchtap="handleCancel">取消</button>
      <button class="pay-submit {{paying ? 'is-paying' : ''}}" catchtap="handlePayment" disabled="{{!paymentMethod || paying}}">
        <block wx:if="{{paying}}">支付中...</block>
        <block wx:else>
          <text class="pay-submit-currency">¥</text>
          <text>{{finalAmountDisplay}}</text>
          <text class="pay-submit-action">立即支付</text>
        </block>
      </button>
    </view>

    <view wx:if="{{showPaymentResult}}" class="modal-mask" catchtap="closeModal">
      <view class="modal-content" catchtap="preventClose">
        <view class="result-icon {{paymentResult.success ? 'success' : 'failed'}}">
          {{paymentResult.success ? '✓' : '✕'}}
        </view>
        <text class="result-title">{{paymentResult.title}}</text>
        <text class="result-message">{{paymentResult.message}}</text>
        <view class="modal-actions">
          <button wx:if="{{!paymentResult.success}}" class="pay-cancel" catchtap="closeModal">返回重试</button>
          <button wx:if="{{paymentResult.success}}" class="pay-submit" catchtap="handleSuccess">进入课程</button>
        </view>
      </view>
    </view>
  </view>
</view>

<podcast-player-bar bottom-offset="112" />
