page {
  background: var(--app-surface-muted);
  height: 100%;
}

.page-insight-edit {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--app-page-bg);
  box-sizing: border-box;
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--app-text-muted);
}

.header-card {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: white;
  padding: 32rpx 24rpx;
  flex-shrink: 0;
}

.header-title {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
}

.header-period {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
  display: block;
}

/* 编辑区域撑满剩余空间 */
.editor-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  margin: 16rpx 24rpx 0;
  background: var(--app-paper);
  border-radius: 16rpx;
}

.toolbar {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--app-border);
  flex-shrink: 0;
}

.tool-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: var(--app-page-bg);
}

.tool-btn:active {
  background: #e0eaff;
}

.tool-icon {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--app-text);
  line-height: 1;
}

.tool-italic {
  font-style: italic;
}

.rich-editor {
  flex: 1;
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--app-text);
  overflow-y: auto;
}

/* 操作栏贴底 */
.action-row {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--app-paper);
  border-top: 1rpx solid var(--app-border);
  flex-shrink: 0;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin: 0;
  line-height: 88rpx;
}

.btn::after {
  border: none;
}

.btn-cancel {
  background: var(--app-surface-muted);
  color: var(--app-text-soft);
}

.btn-cancel:active {
  background: var(--app-border);
}

.btn-save {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: white;
}

.btn-save:active {
  opacity: 0.85;
}

.btn-saving {
  opacity: 0.6;
}

/* Version 2 consistency polish: insight editor. */
.page-insight-edit {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}
.header-card,
.editor-wrapper {
  border-radius: var(--app-radius-lg);
  border-color: rgba(92, 70, 44, 0.07);
  box-shadow: var(--app-shadow-soft);
}
.toolbar,
.tool-btn {
  border-radius: var(--app-radius-sm);
}
.btn {
  border-radius: var(--app-radius-md);
}
.tool-btn:active,
.btn:active {
  transform: translateY(2rpx) scale(0.98);
}
