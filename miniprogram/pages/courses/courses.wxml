<!--课节列表页：自定义导航 + 课程工作台-->
<view class="page-courses page-courses-v3">
  <view class="course-header" style="padding-top: {{statusBarHeight}}px">
    <view class="course-nav-row">
      <view class="course-back" hover-class="course-back-hover" bindtap="handleBack">
        <view class="course-back-icon"></view>
      </view>
      <view class="course-title-group">
        <text class="course-header-title">{{periodName}}</text>
        <text class="course-header-date">{{periodDate}}</text>
      </view>
    </view>
  </view>

  <view class="payment-banner" wx:if="{{paymentPending}}" bindtap="navigateToPayment">
    <view class="payment-banner-content">
      <text class="payment-banner-text">待支付 ¥{{periodPriceDisplay}}</text>
      <text class="payment-banner-caption">点击继续完成报名</text>
    </view>
    <text class="payment-banner-arrow">›</text>
  </view>

  <view class="quick-board" wx:if="{{sections.length > 0 && communityAccessState === 'enabled'}}">
    <view class="quick-item" hover-class="quick-item-hover" bindtap="handleRanking">
      <view class="quick-icon"><text>榜</text></view>
      <view class="quick-copy">
        <text class="quick-title">排行榜</text>
        <text class="quick-caption">精选榜</text>
      </view>
    </view>
    <view class="quick-item" hover-class="quick-item-hover" bindtap="handleCheckinRecords">
      <view class="quick-icon"><text>记</text></view>
      <view class="quick-copy">
        <text class="quick-title">打卡记录</text>
        <text class="quick-caption">每日留痕</text>
      </view>
    </view>
    <view class="quick-item" hover-class="quick-item-hover" bindtap="handleMembers">
      <view class="quick-icon"><text>友</text></view>
      <view class="quick-copy">
        <text class="quick-title">同修</text>
        <text class="quick-caption">成员名录</text>
      </view>
    </view>
  </view>

  <view class="course-toolbar" wx:if="{{sections.length > 0 && communityAccessState === 'enabled'}}">
    <view class="course-search-bar">
      <view class="course-search-input-wrap">
        <input
          class="course-search-input"
          placeholder="搜索标题或内容"
          placeholder-class="course-search-placeholder"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchSubmit"
          confirm-type="search"
        />
        <view class="course-search-clear" wx:if="{{searchKeyword}}" catchtap="onSearchClear">×</view>
      </view>
      <view class="course-search-btn" catchtap="onSearchSubmit">搜索</view>
    </view>

    <view class="segment-tabs">
      <view class="segment-tab {{currentTab === 'tasks' ? 'active' : ''}}" bindtap="handleTabChange" data-tab="tasks">任务</view>
      <view class="segment-tab {{currentTab === 'dynamics' ? 'active' : ''}}" bindtap="handleTabChange" data-tab="dynamics">动态</view>
    </view>
  </view>

  <scroll-view scroll-y class="content-scroll" scroll-top="{{scrollTop}}" scroll-with-animation bindscroll="onContentScroll">
    <view id="tasks-section" class="section-wrapper">
      <view class="sections-container">
        <view
          wx:for="{{isSearchMode ? filteredSections : sections}}"
          wx:key="id"
          class="section-card"
          bindtap="handleSectionClick"
          data-section="{{item}}">
          <view class="section-card-top">
            <view class="section-title-copy">
              <view class="section-title">{{item.title}}</view>
              <view class="section-time" wx:if="{{item.startTime && item.endTime}}">
                {{item.startTime.split('T')[0]}} 至 {{item.endTime.split('T')[0]}}
              </view>
            </view>
            <view wx:if="{{item.readingCompleted}}" class="reading-complete-inline">已晨读</view>
          </view>

          <view class="section-footer">
            <text class="checkin-info">{{item.checkinCount || 0}}人{{communityAccessState === 'enabled' ? '已打卡' : '已学习'}}</text>
            <view class="section-btns">
              <view wx:if="{{isAdmin}}" class="btn-admin-insights" catchtap="handleAdminInsightsClick" data-section="{{item}}">小凡看见</view>
              <view class="btn-action" catchtap="handleCheckinClick" data-section="{{item}}">
                {{communityAccessState === 'enabled' ? '去打卡' : '去学习'}}
              </view>
            </view>
          </view>
        </view>

        <reading-loader wx:if="{{loading && sections.length === 0}}" text="正在整理今日晨读..." />

        <view wx:if="{{!loading && sections.length === 0}}" class="course-empty">
          <text>暂无课程</text>
        </view>
      </view>
    </view>

    <view id="dynamics-section" class="section-wrapper" wx:if="{{sections.length > 0 && communityAccessState === 'enabled'}}">
      <view class="all-checkins-section" wx:if="{{allCheckins.length > 0 || checkinTotal > 0}}">
        <view class="checkins-header">
          <text class="checkins-title">每日打卡</text>
          <text class="checkins-count" wx:if="{{checkinTotal > 0}}">{{checkinTotal}} 条</text>
        </view>

        <view class="checkins-list">
          <view class="checkin-item" wx:for="{{isSearchMode ? searchCheckins : allCheckins}}" wx:key="id" bindtap="handleCheckinItemTap" data-checkin-id="{{item.id}}" data-section-id="{{item.sectionId}}">
            <view class="checkin-avatar" style="background: {{item.avatarColor || themePrimaryColor}}" catchtap="handleAvatarClick" data-user-id="{{item.userId}}">
              <image wx:if="{{item.avatarUrl}}" class="avatar-image" src="{{item.avatarUrl}}" mode="aspectFill" />
              <text wx:else class="avatar-text">{{item.avatarText || item.userName}}</text>
            </view>
            <view class="checkin-main">
              <view class="checkin-top">
                <view class="checkin-user-section">
                  <text class="checkin-user" catchtap="handleAvatarClick" data-user-id="{{item.userId}}">{{item.userName}}</text>
                  <text class="section-tag">第{{item.sectionDay}}课</text>
                </view>
                <text class="checkin-time">{{item.createTime}}</text>
              </view>
              <view class="checkin-content {{item.canExpandContent && !item.contentExpanded ? 'checkin-content-clamped' : ''}}">{{item.content}}</view>
              <view wx:if="{{item.canExpandContent || item.imageCount}}" class="checkin-content-footer">
                <view wx:if="{{item.canExpandContent}}" class="checkin-content-toggle" catchtap="toggleCheckinContent" data-checkin-id="{{item.id}}">{{item.contentExpanded ? '收起' : '展开更多'}}</view>
                <view wx:if="{{item.imageCount}}" class="checkin-image-count">{{item.imageCount}}张图片</view>
              </view>
            </view>
          </view>
        </view>

        <view class="checkin-load-more" wx:if="{{checkinHasMore && !isSearchMode}}">
          <button class="checkin-load-more-btn" bindtap="handleLoadMoreCheckins" loading="{{checkinLoadingMore}}">加载更多</button>
        </view>
        <view class="checkin-no-more" wx:if="{{!checkinHasMore && allCheckins.length > 0 && !isSearchMode}}">
          <text>没有更多打卡记录了</text>
        </view>
      </view>

      <view wx:if="{{(isSearchMode ? searchCheckins.length === 0 : allCheckins.length === 0)}}" class="course-empty course-empty-inner">
        <text>暂无打卡记录</text>
      </view>
    </view>
  </scroll-view>
</view>

<podcast-player-bar />
