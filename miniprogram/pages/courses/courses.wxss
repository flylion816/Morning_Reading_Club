/* 课节列表页样式 */

.page-courses {
  height: 100vh;
  background: var(--app-page-bg);
  display: flex;
  flex-direction: column;
}

/* 待支付提醒横幅 */
.payment-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fff7ed 0%, #fef3c7 100%);
  padding: 20rpx 32rpx;
  border-bottom: 2rpx solid #fde68a;
}

.payment-banner-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.payment-banner-icon {
  font-size: 32rpx;
}

.payment-banner-text {
  font-size: 26rpx;
  color: #92400e;
  font-weight: 500;
}

.payment-banner-arrow {
  font-size: 36rpx;
  color: #d97706;
  font-weight: bold;
}

/* 头部区域 */
.page-header {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: white;
  padding: 20rpx 32rpx;
  max-height: 200rpx;
  overflow: hidden;
  transition: max-height 0.3s ease, padding 0.3s ease;
}

.page-header.collapsed {
  max-height: 0;
  padding-top: 0;
  padding-bottom: 0;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.period-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.period-date {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 功能按钮区（紧凑横排） */
.action-buttons {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  background: var(--app-paper);
  padding: 20rpx 24rpx 18rpx;
  margin-bottom: 0;
  max-height: 200rpx;
  overflow: hidden;
  transition: max-height 0.3s ease, padding 0.3s ease;
}

.action-buttons.collapsed {
  max-height: 0;
  padding-top: 0;
  padding-bottom: 0;
}

.action-btn {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 10rpx 8rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.46);
  transition: opacity 0.2s ease, transform 0.2s ease, background 0.2s ease;
}

.action-btn-hover {
  opacity: 0.86;
  transform: translateY(1rpx);
  background: var(--theme-primary-tint);
}

.btn-icon-mark {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.btn-icon {
  font-size: 32rpx;
  line-height: 1;
}

.btn-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  line-height: 1.25;
}

.btn-text {
  font-size: 25rpx;
  color: var(--app-text);
  font-weight: 500;
  white-space: nowrap;
}

.btn-subtext {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--app-text-muted);
  white-space: nowrap;
}

/* Tab切换区域 */
.tabs-container {
  background: var(--app-paper);
  border-bottom: 2rpx solid var(--app-border);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tabs {
  display: flex;
  padding: 0 32rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  position: relative;
  font-size: 28rpx;
  color: var(--app-text-soft);
}

.tab-item.active {
  color: var(--theme-primary);
  font-weight: bold;
}

.tab-underline {
  position: absolute;
  bottom: 0;
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  border-radius: 3rpx;
}

/* 滚动内容区 */
.content-scroll {
  flex: 1;
  height: 0; /* 使用flex布局时，设置height为0让其自动计算 */
}

.section-wrapper {
  padding-bottom: 40rpx;
  background: var(--app-page-bg);
}

/* 补打卡信息 */
.makeup-info {
  background: var(--app-paper);
  padding: 32rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  color: var(--app-text);
}

.makeup-text {
  color: var(--app-text-soft);
}

.makeup-count {
  color: var(--theme-primary);
  font-weight: bold;
  font-size: 32rpx;
}

/* 课节列表容器 */
.sections-container {
  padding: 0 24rpx;
}

/* 课节卡片 */
.section-card {
  background: var(--app-paper);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid var(--theme-primary);
  box-shadow: 0 4rpx 12rpx rgba(60, 42, 20, 0.05);
}

.section-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.section-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--app-text);
  line-height: 1.45;
}

.section-status-line {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.reading-complete-inline {
  color: #059669;
  font-size: 24rpx;
  font-weight: 700;
}

.section-time {
  font-size: 24rpx;
  color: var(--app-text-muted);
  margin-bottom: 24rpx;
  line-height: 1.5;
}

/* 底部信息 */
.section-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.checkin-info {
  font-size: 26rpx;
  color: var(--app-text-soft);
}

.btn-action {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: white;
  border-radius: 32rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  line-height: 1.5;
  flex-shrink: 0;
  white-space: nowrap;
  text-align: center;
}

.section-btns {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.btn-admin-insights {
  background: var(--theme-primary-tint);
  border: 1rpx solid var(--theme-primary-alpha-18);
  border-radius: 32rpx;
  box-shadow: 0 6rpx 14rpx var(--theme-primary-alpha-08);
  color: var(--theme-primary-dark);
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
  white-space: nowrap;
  text-align: center;
  transition: background 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
}

.btn-admin-insights:active {
  background: var(--theme-primary-alpha-12);
  box-shadow: var(--app-press-shadow);
  transform: translateY(1rpx) scale(0.98);
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--theme-primary-alpha-20);
  border-top-color: var(--theme-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--app-text-muted);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state-icon {
  font-size: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-state-text {
  font-size: 28rpx;
  color: var(--app-text-muted);
}


/* 所有打卡记录区域 */
.all-checkins-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.checkins-header {
  display: flex;
  align-items: center;
  padding: 32rpx 0 24rpx;
}

.checkins-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--app-text);
}

.checkins-count {
  font-size: 24rpx;
  color: var(--app-text-muted);
  margin-left: 8rpx;
}

.checkins-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.checkin-item {
  display: flex;
  gap: 16rpx;
  background: var(--app-paper);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(60, 42, 20, 0.05);
}

.checkin-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.checkin-avatar .avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.checkin-avatar .avatar-text {
  font-size: 28rpx;
  color: white;
  font-weight: bold;
}

.checkin-main {
  flex: 1;
  min-width: 0;
}

.checkin-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.checkin-user-section {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.checkin-user {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--app-text);
}

.checkin-time {
  font-size: 22rpx;
  color: var(--app-text-muted);
  flex-shrink: 0;
}

.section-tag {
  font-size: 22rpx;
  color: var(--theme-primary);
  background: var(--theme-primary-tint);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.checkin-section-title {
  font-size: 24rpx;
  color: var(--app-text-soft);
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.checkin-content {
  font-size: 26rpx;
  color: var(--app-text-soft);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.checkin-content-clamped {
  max-height: 288rpx;
  overflow: hidden;
}

.checkin-content-footer {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.checkin-image-count {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-tint);
  color: var(--theme-primary);
  font-size: 22rpx;
  line-height: 1.4;
}

.checkin-content-toggle {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--theme-primary);
  font-weight: 500;
}

.checkin-load-more {
  padding: 24rpx 0 8rpx;
  display: flex;
  justify-content: center;
}

.checkin-load-more-btn {
  font-size: 28rpx;
  color: var(--theme-primary);
  background: var(--theme-primary-tint);
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 64rpx;
  line-height: 1.5;
}

.checkin-load-more-btn::after {
  border: none;
}

.checkin-no-more {
  padding: 24rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--app-disabled);
}

.course-search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  margin-bottom: 16rpx;
  padding: 0 24rpx;
}

.course-search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--app-paper);
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.course-search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--app-text);
  height: 72rpx;
  line-height: 72rpx;
}

.course-search-clear {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--app-disabled);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 1;
}

.course-search-btn {
  background: var(--theme-primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 40rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* Version 2 consistency polish: course list follows the camp card language. */
.page-courses {
  height: 100vh;
  background:
    radial-gradient(circle at 88% 0%, var(--theme-primary-alpha-08) 0, rgba(255, 255, 255, 0) 300rpx),
    linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}
.page-header {
  border-radius: 0 0 var(--app-radius-xl) var(--app-radius-xl);
  box-shadow: 0 18rpx 40rpx var(--theme-primary-alpha-18);
}
.action-btn {
  border-radius: var(--app-radius-md);
  background: var(--app-paper);
  border: 1rpx solid var(--app-border);
  box-shadow: var(--app-shadow-soft);
}
.action-btn-hover {
  transform: translateY(2rpx) scale(0.985);
  background: var(--theme-primary-tint);
}
.tabs-container {
  background: rgba(255, 253, 248, 0.94);
  backdrop-filter: blur(14rpx);
}
.tab-item.active {
  color: var(--theme-primary-dark);
}
.course-search-input-wrap,
.course-search-btn {
  border-radius: 999rpx;
}
.course-search-btn {
  background: linear-gradient(135deg, var(--theme-primary), var(--theme-primary-dark));
  box-shadow: 0 10rpx 20rpx var(--theme-primary-alpha-18);
}
.course-search-btn:active {
  transform: translateY(2rpx) scale(0.98);
}

/* Version 3 course workspace redesign. */
.page-courses-v3 {
  min-height: 100vh;
  background:
    radial-gradient(circle at 88% 0%, var(--theme-primary-alpha-08) 0, rgba(255,255,255,0) 320rpx),
    linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}
.course-header {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: #fff;
}
.course-nav-row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 16rpx 24rpx 20rpx;
}
.course-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-left: -14rpx;
  background: transparent;
  color: #fff;
}
.course-back-hover { opacity: .72; }
.course-back-icon {
  width: 19rpx;
  height: 19rpx;
  margin-left: 12rpx;
  border-top: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  transform: rotate(-45deg);
}
.course-title-group {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 520rpx;
  text-align: center;
}
.course-header-title {
  max-width: 100%;
  overflow: hidden;
  color: #fff;
  font-size: 33rpx;
  font-weight: 740;
  line-height: 1.28;
  letter-spacing: -1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.course-header-date {
  margin-top: 8rpx;
  color: rgba(255,255,255,.80);
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
}
.payment-banner {
  align-items: center;
  padding: 18rpx 30rpx;
  background: var(--app-paper);
  border-bottom: 1rpx solid var(--app-border);
}
.payment-banner-content { display: flex; align-items: baseline; gap: 10rpx; min-width: 0; }
.payment-banner-text { color: var(--app-text); font-size: var(--app-font-sm); font-weight: 750; font-variant-numeric: tabular-nums; }
.payment-banner-caption { color: var(--app-text-muted); font-size: 20rpx; }
.payment-banner-arrow { color: var(--theme-primary); font-size: 34rpx; font-weight: 400; }
.quick-board {
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 24rpx 8rpx;
  overflow: hidden;
  white-space: nowrap;
}
.quick-board-track {
  display: inline-flex;
  gap: 12rpx;
  min-width: 100%;
}
.quick-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 154rpx;
  min-width: 154rpx;
  box-sizing: border-box;
  padding: 16rpx 10rpx;
  border-radius: var(--app-radius-md);
  background: rgba(255,255,255,.88);
  box-shadow: var(--app-shadow-soft);
}
.quick-item-hover { transform: translateY(2rpx) scale(.985); background: var(--theme-primary-tint); }
.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border-radius: 16rpx;
  background: var(--theme-primary-tint);
  color: var(--theme-primary-dark);
  font-size: 21rpx;
  font-weight: 750;
  flex: 0 0 auto;
}
.quick-icon-search {
  color: var(--theme-primary-dark);
}
.quick-icon-search .app-icon {
  width: 28rpx;
  height: 28rpx;
}
.quick-copy { min-width: 0; display: flex; flex-direction: column; }
.quick-title { overflow: hidden; color: var(--app-text); font-size: 22rpx; font-weight: 700; white-space: nowrap; }
.quick-caption { overflow: hidden; margin-top: 3rpx; color: var(--app-text-muted); font-size: 18rpx; white-space: nowrap; }
.course-toolbar {
  padding: 14rpx 24rpx 18rpx;
}
.course-search-bar { margin: 0; padding: 0; }
.course-search-input-wrap { height: 68rpx; background: var(--app-surface); border-radius: 18rpx; box-shadow: none; }
.course-search-input { height: 68rpx; line-height: 68rpx; font-size: var(--app-font-sm); }
.course-search-placeholder { color: var(--app-text-muted); }
.course-search-btn { height: 68rpx; line-height: 68rpx; border-radius: 18rpx; font-size: var(--app-font-sm); }
.segment-tabs {
  display: flex;
  gap: 6rpx;
  margin-top: 16rpx;
  padding: 5rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,.76);
  box-shadow: inset 0 0 0 1rpx var(--app-border);
}
.segment-tab {
  flex: 1;
  height: 58rpx;
  border-radius: 14rpx;
  color: var(--app-text-soft);
  font-size: var(--app-font-sm);
  font-weight: 650;
  line-height: 58rpx;
  text-align: center;
}
.segment-tab.active {
  background: linear-gradient(135deg, var(--theme-primary), var(--theme-primary-dark));
  color: #fff;
  box-shadow: 0 8rpx 18rpx var(--theme-primary-alpha-16);
}
.section-card {
  padding: 26rpx;
  border-left: 0;
  border-radius: var(--app-radius-lg);
  background: linear-gradient(180deg, var(--app-paper), var(--app-paper-muted));
  box-shadow: var(--app-shadow-soft);
}
.section-card-top { display: flex; align-items: flex-start; gap: 17rpx; }
.section-title-copy { flex: 1; min-width: 0; }
.section-card .section-title { margin-bottom: 5rpx; font-size: 30rpx; font-weight: 700; line-height: 1.38; }
.section-card .section-time { margin-bottom: 20rpx; font-size: 20rpx; }
.reading-complete-inline {
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  background: var(--app-success-soft);
  color: var(--app-success);
  font-size: 18rpx;
  font-weight: 700;
}
.course-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
  margin: 24rpx;
  border-radius: var(--app-radius-lg);
  background: rgba(255,255,255,.72);
  color: var(--app-text-muted);
  font-size: var(--app-font-sm);
  font-weight: 600;
}
.course-empty-inner { min-height: 180rpx; margin: 0; background: transparent; }

/* Version 3 dawn: warm paper tones, serif titles, seal-style entry icons. */
.payment-banner {
  background: linear-gradient(135deg, var(--app-dawn-soft) 0%, var(--app-dawn-sky) 100%);
  border-bottom-color: var(--app-rule);
}
.payment-banner-text { color: var(--app-dawn-ink); }
.payment-banner-arrow { color: var(--app-dawn-deep); }
.course-header-title,
.section-card .section-title { font-family: var(--app-font-serif); }
.quick-icon {
  width: 50rpx;
  height: 50rpx;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 12rpx;
  background: var(--theme-primary-alpha-05);
  color: var(--theme-primary-dark);
  font-family: var(--app-font-serif);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  transform: rotate(-3deg);
}

.app-empty { background: transparent; }
.app-empty-inner { margin: 0; min-height: 180rpx; }
.app-empty .app-empty-art { order: -1; }

/* Features: 期次来处小字与四宫快捷入口自适应换行 */
.course-header-origins {
  display: block;
  margin-top: 4rpx;
  color: var(--app-text-muted);
  font-size: 20rpx;
}
.quick-board {
  overflow: hidden;
}

/* 页眉并入纸色（右上角胶囊随之变浅，与其他内容页一致）；快捷入口横向滑动。 */
.course-header {
  background: var(--app-paper);
  color: var(--app-text);
  border-bottom: 1rpx solid rgba(92, 70, 44, 0.08);
}
.course-back {
  color: var(--app-text);
}
.course-header-title {
  color: var(--app-text);
}
.course-header-date {
  color: var(--app-text-muted);
}
.course-title-group {
  width: 400rpx;
}
.quick-board {
  gap: 0;
}
.quick-item {
  flex-direction: column;
  gap: 10rpx;
  padding: 20rpx 8rpx 16rpx;
  text-align: center;
}
.quick-copy {
  align-items: center;
}
.quick-title {
  font-size: 24rpx;
}
.quick-caption {
  display: none;
}

/* Features: 入营欢迎卡 */
.welcome-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  background: rgba(43, 38, 34, 0.46);
}
.welcome-card {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  padding: 150rpx 48rpx 44rpx;
  border-radius: 32rpx;
  background: var(--app-paper);
  text-align: center;
  box-shadow: 0 24rpx 60rpx rgba(84, 60, 30, 0.22);
}
.welcome-sun {
  position: absolute;
  left: 50%;
  top: -150rpx;
  width: 300rpx;
  height: 300rpx;
  margin-left: -150rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--app-dawn) 0, var(--app-dawn) 34%, var(--app-dawn-soft) 35%, rgba(253, 240, 220, 0) 70%);
}
.welcome-seal {
  position: relative;
  margin: 0 auto 20rpx;
}
.welcome-title {
  display: block;
  font-family: var(--app-font-serif);
  font-size: 44rpx;
  font-weight: 700;
  color: var(--app-text);
}
.welcome-period {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--app-dawn-ink);
}
.welcome-text {
  display: block;
  margin: 28rpx 0 40rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--app-text-soft);
}
.welcome-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 22rpx;
  background: var(--theme-primary-dark);
  color: var(--theme-on-primary, #fff);
  font-size: 30rpx;
  font-weight: 600;
}
.welcome-btn-hover {
  opacity: 0.86;
}
.welcome-link {
  margin-top: 24rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--app-text-muted);
}
