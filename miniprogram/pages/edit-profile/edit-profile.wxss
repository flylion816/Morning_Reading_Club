.page-edit-profile {
  min-height: 100vh;
  background: var(--app-surface-muted);
  padding: 24rpx 24rpx 168rpx;
  box-sizing: border-box;
}

/* Section */
.section {
  background: var(--app-paper);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: var(--app-text-soft);
  margin-bottom: 20rpx;
  font-weight: 600;
}

/* Avatar */
.avatar-picker-panel {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #f7fbff 0%, #eef6ff 100%);
  border: 1rpx solid #dbeafe;
  border-radius: 20rpx;
}

.avatar-preview {
  width: 116rpx;
  height: 116rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--app-paper);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx var(--theme-primary-alpha-18);
  overflow: hidden;
}

.avatar-preview-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-preview-emoji {
  font-size: 62rpx;
  line-height: 1;
  color: #fff;
  font-weight: 600;
}

.avatar-picker-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.avatar-picker-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text);
  line-height: 1.3;
}

.avatar-picker-desc {
  font-size: 23rpx;
  color: var(--app-text-soft);
  line-height: 1.4;
}

.avatar-action-button {
  width: 220rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

button.avatar-action-button {
  margin: 0;
  padding: 0;
  line-height: 64rpx;
  border: none;
}

button.avatar-action-button::after {
  border: none;
}

.avatar-action-button.primary {
  color: #fff;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  box-shadow: 0 8rpx 18rpx var(--theme-primary-alpha-22);
}

/* Input field */
.input-wrap {
  position: relative;
}

.field-input {
  width: 100%;
  height: 76rpx;
  padding: 0 100rpx 0 0;
  font-size: 30rpx;
  color: var(--app-text);
  border-bottom: 1rpx solid var(--app-border);
  box-sizing: border-box;
}

.field-input:focus {
  border-bottom-color: var(--theme-primary);
}

/* Textarea */
.textarea-wrap {
  position: relative;
}

.field-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 0 100rpx 0 0;
  font-size: 30rpx;
  color: var(--app-text);
  line-height: 1.6;
  border-bottom: 1rpx solid var(--app-border);
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
}

.field-textarea:focus {
  border-bottom-color: var(--theme-primary);
}

/* Placeholder */
.field-placeholder {
  color: var(--app-disabled);
  font-size: 30rpx;
}

/* Char count */
.char-count {
  position: absolute;
  right: 0;
  bottom: 8rpx;
  font-size: 24rpx;
  color: var(--app-disabled);
}

/* Save bar fixed at bottom */
.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--app-paper);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.save-btn:active:not(.loading) {
  opacity: 0.85;
  transform: scale(0.98);
}

.save-btn.loading {
  opacity: 0.65;
  pointer-events: none;
}

.nickname-error { color: #c23b32; font-size: 26rpx; line-height: 1.5; margin-top: 12rpx; }
.profile-save-hint { color: var(--app-text-soft); font-size: 24rpx; line-height: 1.5; margin-top: 6rpx; }

/* Version 2 consistency polish: profile edit form. */
.page-edit-profile {
  min-height: 100vh;
  background:
    radial-gradient(circle at 88% 0%, var(--theme-primary-alpha-08) 0, rgba(255, 255, 255, 0) 300rpx),
    linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}
.section {
  border-radius: var(--app-radius-lg);
  border-color: rgba(92, 70, 44, 0.07);
  box-shadow: var(--app-shadow-soft);
}
.field-input,
.field-textarea {
  border-radius: var(--app-radius-sm);
}
.avatar-action-button,
.save-btn {
  border-radius: var(--app-radius-md);
}
.avatar-action-button:active,
.save-btn:active {
  transform: translateY(2rpx) scale(0.98);
}
