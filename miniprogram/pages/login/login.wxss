/* 登录页面样式 */

.page-login-wrapper {
  min-height: 100vh;
  position: relative;
}

.page-login {
  min-height: 100vh;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
  position: relative;
}

/* 头部 */
.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
  animation: fadeInDown 0.8s ease;
}

.logo {
  font-size: 160rpx;
  margin-bottom: 32rpx;
  text-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.app-title {
  font-size: 40rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 8rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  line-height: 1.3;
}

.app-title-second {
  font-size: 56rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.app-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 16rpx;
}

/* 登录卡片 */
.login-card {
  width: 100%;
  background: white;
  border-radius: 32rpx;
  padding: 60rpx 48rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  animation: fadeInUp 0.8s ease;
}

.card-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--app-text);
  text-align: center;
  margin-bottom: 16rpx;
}

.card-desc {
  font-size: 26rpx;
  color: var(--app-text-muted);
  text-align: center;
  margin-bottom: 60rpx;
}

/* 微信登录按钮 */
.wechat-login-btn {
  width: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, #07c160 0%, #05a650 100%);
  color: white;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s;
  margin-bottom: 32rpx;
}

.wechat-login-btn::after {
  border: none;
}

.wechat-login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.wechat-login-btn.loading {
  opacity: 0.7;
  background: linear-gradient(135deg, #9ca3af 0%, #6b7280 100%);
}

/* 开发环境快速登录 */
.dev-quick-login {
  margin-top: 40rpx;
  padding-top: 40rpx;
  border-top: 2rpx solid var(--app-border);
}

.dev-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #ff6b6b;
  text-align: center;
  margin-bottom: 24rpx;
}

.test-users {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.test-user-btn {
  padding: 14rpx 12rpx;
  background: var(--app-surface-muted);
  color: var(--app-text-soft);
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  border: 2rpx solid var(--app-rule);
  transition: all 0.3s;
}

.test-user-btn::after {
  border: none;
}

.test-user-btn:active {
  background: var(--app-border);
  transform: scale(0.96);
}

.test-user-btn.disabled {
  opacity: 0.6;
}

/* 用户协议 - 新样式 */
.agreement-section {
  margin-top: 40rpx;
  padding: 32rpx 24rpx;
  background: var(--app-surface-muted);
  border-radius: 12rpx;
  border: 1rpx solid var(--app-border);
  min-height: 100rpx;
}

.agreement-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  min-height: 44rpx;
}

.checkbox-touch-target {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox-item {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  border: 2rpx solid var(--app-rule);
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.checkbox-item.checked {
  background: var(--theme-primary);
  border-color: var(--theme-primary);
}

.checkbox-tick {
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.agreement-consent-text {
  margin-left: 8rpx;
  color: var(--app-text-soft);
  font-size: 26rpx;
  line-height: 1.6;
}

.agreement-text {
  color: var(--app-text-soft);
  font-size: 26rpx;
  line-height: 1.6;
}

.agreement-links {
  display: flex;
  flex-wrap: wrap;
  font-size: 24rpx;
  color: var(--app-text-soft);
  margin-left: 52rpx;
  margin-bottom: 4rpx;
  line-height: 1.6;
}

.agreement-link {
  color: var(--theme-primary);
  margin: 0 6rpx;
  font-weight: 500;
  text-decoration: underline;
}

/* 同意并登录按钮 */
.login-agree-btn {
  width: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: white;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx var(--theme-primary-shadow);
  transition: all 0.3s;
  margin-top: 24rpx;
}

.login-agree-btn::after {
  border: none;
}

.login-agree-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx var(--theme-primary-shadow);
}

.login-agree-btn.disabled {
  opacity: 0.5;
  background: linear-gradient(135deg, #d1d5db 0%, #9ca3af 100%);
  box-shadow: none;
}

/* 稍后登录按钮 - 提供用户选择，符合审核要求 */
.login-skip-btn {
  width: 100%;
  padding: 20rpx;
  background: transparent;
  color: var(--theme-primary);
  border: 2rpx solid var(--theme-primary);
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.3s;
  margin-top: 16rpx;
}

.login-skip-btn::after {
  border: none;
}

.login-skip-btn:active {
  background: var(--theme-primary-tint);
  transform: scale(0.98);
}

.login-skip-btn:disabled {
  opacity: 0.6;
  color: var(--app-text-muted);
  border-color: #9ca3af;
}

/* 旧的 wechat-login-btn 保留（用于微信登录） */
.wechat-login-btn {
  width: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, #07c160 0%, #05a650 100%);
  color: white;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s;
  margin-bottom: 32rpx;
}

.wechat-login-btn::after {
  border: none;
}

.wechat-login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.wechat-login-btn.loading {
  opacity: 0.7;
  background: linear-gradient(135deg, #9ca3af 0%, #6b7280 100%);
}

/* 返回按钮 */
.back-home {
  margin-top: 60rpx;
  padding: 20rpx 40rpx;
  color: white;
  font-size: 28rpx;
  opacity: 0.8;
  animation: fadeIn 1s ease;
}

/* 动画 */
@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 错误信息显示 */
.error-info {
  width: 100%;
  background: #fee;
  border: 2rpx solid #fcc;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  animation: shake 0.3s ease;
}

.error-title {
  font-size: 26rpx;
  color: #c33;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.error-details {
  font-size: 20rpx;
  color: var(--app-text-soft);
  line-height: 1.6;
  word-break: break-all;
  font-family: monospace;
}

/* 调试信息显示 */
.debug-info {
  width: 100%;
  background: var(--theme-primary-tint);
  border: 1rpx solid var(--theme-primary-alpha-24);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 16rpx;
  font-size: 18rpx;
  color: var(--theme-primary);
}

.debug-title {
  font-weight: 600;
  margin-bottom: 8rpx;
  font-size: 20rpx;
}

.debug-text {
  font-size: 18rpx;
  line-height: 1.4;
  word-break: break-all;
  font-family: monospace;
  color: var(--theme-primary);
  margin-bottom: 4rpx;
}

/* 手机号绑定弹窗 */
.phone-bind-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 600rpx;
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--app-text);
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: var(--app-text-muted);
  text-align: center;
  margin-bottom: 48rpx;
  line-height: 1.6;
}

.bind-btn {
  width: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: white;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx var(--theme-primary-shadow);
  margin-bottom: 24rpx;
}

.bind-btn::after {
  border: none;
}

.bind-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx var(--theme-primary-shadow);
}

.skip-btn {
  font-size: 26rpx;
  color: var(--app-text-muted);
  padding: 16rpx 40rpx;
}

.skip-btn:active {
  color: var(--app-text-soft);
}

/* shake 动画 */
@keyframes shake {
  0%, 100% {
    transform: translateX(0);
  }
  10%, 30%, 50%, 70%, 90% {
    transform: translateX(-4rpx);
  }
  20%, 40%, 60%, 80% {
    transform: translateX(4rpx);
  }
}

/* Version 2 consistency polish: quieter authentication shell. */
.page-login-wrapper {
  min-height: 100vh;
  background: var(--app-page-bg);
}
.page-login {
  min-height: 100vh;
  background:
    radial-gradient(circle at 82% 8%, rgba(255, 255, 255, 0.18) 0, rgba(255, 255, 255, 0) 280rpx),
    linear-gradient(145deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
}
.login-card {
  border-radius: var(--app-radius-xl);
  box-shadow: var(--app-shadow);
}
.wechat-login-btn,
.dev-quick-login {
  border-radius: var(--app-radius-md);
}
.wechat-login-btn:active,
.dev-quick-login:active,
.test-user-btn:active {
  transform: translateY(2rpx) scale(0.98);
}

/* Version 3 dawn: 破晓登录 */
.page-login-wrapper {
  background: var(--app-paper);
}
.page-login {
  min-height: 100vh;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  background: var(--app-paper);
  overflow: hidden;
}

.login-sky {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  min-height: 56vh;
  padding: calc(env(safe-area-inset-top) + 96rpx) 48rpx 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(
    180deg,
    var(--theme-primary-dark) 0%,
    var(--theme-primary) 50%,
    var(--theme-primary-light) 74%,
    var(--theme-primary-tint) 89%,
    var(--app-dawn-sky) 97%,
    #fdf0dd 100%
  );
}

.login-header {
  margin-bottom: 0;
  animation: fadeIn 0.8s ease;
}

.login-emblem {
  width: 120rpx;
  height: 92rpx;
  margin-bottom: 20rpx;
  background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 60 46' fill='none' stroke='%23fff' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M18 24a12 12 0 0 1 24 0'/><path d='M30 4v4M15.5 9.5l2.8 2.8M44.5 9.5l-2.8 2.8'/><path d='M30 30C24 26 14 26 6 28v14c8-2 18-2 24 2M30 30c6-4 16-4 24-2v14c-8-2-18-2-24 2M30 30v14'/></svg>") no-repeat center / contain;
}

.login-header .app-title {
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 0.06em;
  color: rgba(255, 255, 255, 0.85);
  text-shadow: none;
  margin-bottom: 4rpx;
}
.login-header .app-title-second {
  font-family: var(--app-font-serif);
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-indent: 0.16em;
  color: #fff;
  text-shadow: none;
  margin: 4rpx 0 8rpx;
}
.login-header .app-slogan {
  font-size: 24rpx;
  letter-spacing: 0.08em;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: none;
  margin-bottom: 0;
}

.login-glow {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 720rpx;
  height: 720rpx;
  margin-left: -360rpx;
  margin-bottom: -360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--app-dawn-glow) 0, rgba(255, 206, 140, 0.3) 32%, rgba(255, 214, 160, 0) 66%);
  pointer-events: none;
}
.login-sun {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 224rpx;
  height: 224rpx;
  margin-left: -112rpx;
  margin-bottom: -112rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #ffe2ad 0, var(--app-dawn) 60%, var(--app-dawn) 100%);
  pointer-events: none;
  animation: sunRise 1.2s ease-out both;
}
@keyframes sunRise {
  from {
    transform: translateY(130rpx);
    opacity: 0.4;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}
@media (prefers-reduced-motion: reduce) {
  .login-sun,
  .login-header,
  .login-card {
    animation: none;
  }
}

.login-ground {
  position: relative;
  z-index: 2;
  flex: 1;
  box-sizing: border-box;
  background: var(--app-paper);
  border-top: 2rpx solid rgba(138, 75, 18, 0.16);
  padding: 56rpx 52rpx calc(48rpx + env(safe-area-inset-bottom));
}
.login-card {
  width: 100%;
  background: transparent;
  border-radius: 0;
  padding: 0;
  box-shadow: none;
  animation: fadeIn 0.8s ease;
}

.card-title {
  font-family: var(--app-font-serif);
  font-size: 36rpx;
  letter-spacing: 0.08em;
  color: var(--app-text);
  margin-bottom: 8rpx;
}
.card-desc {
  font-size: 24rpx;
  color: var(--app-text-muted);
  margin-bottom: 36rpx;
}

/* 协议勾选：一行居中 */
.agreement-section {
  margin-top: 0;
  padding: 0;
  background: transparent;
  border: none;
  min-height: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.agreement-row {
  margin-bottom: 0;
}
.agreement-links {
  margin-left: 0;
  margin-bottom: 0;
  align-items: center;
}
.checkbox-item {
  background: var(--app-paper);
  border-color: var(--theme-primary-dark);
}
.checkbox-item.checked {
  background: var(--theme-primary-dark);
  border-color: var(--theme-primary-dark);
}
.agreement-consent-text,
.agreement-text {
  font-size: 22rpx;
}
.agreement-link {
  color: var(--theme-primary-dark);
  font-size: 22rpx;
  margin: 0 2rpx;
  text-decoration: none;
  border-bottom: 2rpx solid var(--theme-primary-alpha-40);
}

/* 按钮 */
.login-agree-btn,
.bind-btn {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  border-radius: var(--app-radius-md);
  box-shadow: 0 8rpx 24rpx var(--theme-primary-shadow);
}
.login-agree-btn {
  margin-top: 20rpx;
}
.login-agree-btn.disabled,
.login-agree-btn[disabled] {
  opacity: 1;
  background: var(--app-disabled-soft);
  color: var(--app-disabled);
  box-shadow: none;
}
.login-skip-btn {
  background: var(--app-paper);
  color: var(--app-text-soft);
  border: 2rpx solid var(--app-rule);
  border-radius: var(--app-radius-md);
  margin-top: 18rpx;
}
.login-skip-btn:active {
  background: var(--app-paper-muted);
}
.login-skip-btn:disabled {
  color: var(--app-disabled);
  border-color: var(--app-border);
}

/* 开发环境 / 错误 / 调试：暖纸体系 */
.dev-quick-login {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid var(--app-border);
}
.dev-label {
  color: var(--app-dawn-deep);
}
.test-user-btn {
  background: var(--app-paper-muted);
  color: var(--app-text-soft);
  border-color: var(--app-rule);
}
.error-info {
  background: var(--app-dawn-soft);
  border-color: rgba(184, 99, 31, 0.3);
}
.error-title {
  color: var(--app-dawn-deep);
}
.debug-info {
  background: var(--app-paper-muted);
  border-color: var(--app-border);
  color: var(--app-text-soft);
}
.debug-text {
  color: var(--app-text-soft);
}

/* 手机号绑定弹窗 */
.modal-mask {
  background: rgba(43, 38, 34, 0.5);
}
.modal-content {
  background: var(--app-paper);
  border-radius: var(--app-radius-md);
  box-shadow: 0 16rpx 48rpx rgba(43, 38, 34, 0.18);
}
.modal-title {
  font-family: var(--app-font-serif);
  letter-spacing: 0.06em;
}

/* 小屏：压缩天空，整页可滚动 */
@media (max-height: 640px) {
  .login-sky {
    min-height: 50vh;
    padding: calc(env(safe-area-inset-top) + 56rpx) 48rpx 220rpx;
  }
  .login-emblem {
    width: 88rpx;
    height: 68rpx;
    margin-bottom: 8rpx;
  }
  .login-header .app-title-second {
    font-size: 52rpx;
  }
  .login-sun {
    width: 176rpx;
    height: 176rpx;
    margin-left: -88rpx;
    margin-bottom: -88rpx;
  }
  .login-ground {
    padding-top: 40rpx;
  }
}

/* 登录入营转场：3 秒内完成晨光、连续纸页与首页交接。 */
.login-entry-transition {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 200;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 65%, rgba(255, 211, 145, 0.28) 0, rgba(255, 211, 145, 0) 42%),
    linear-gradient(180deg, var(--theme-primary-dark) 0%, var(--theme-primary) 62%, var(--theme-primary-light) 100%);
  animation: entryTransitionIn 0.45s ease-out both;
}

.login-entry-transition::before {
  content: '';
  position: absolute;
  top: 0;
  right: -18%;
  width: 72%;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0));
  transform: translateX(-120vw);
  animation: entryLightSweep 2.6s cubic-bezier(0.3, 0.7, 0.2, 1) 0.15s both;
}

.entry-transition-sun {
  position: absolute;
  left: 50%;
  bottom: 18%;
  width: 440rpx;
  height: 440rpx;
  margin: 0 0 -220rpx -220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #ffe8bd 0, var(--app-dawn) 42%, rgba(255, 184, 99, 0) 72%);
  opacity: 0;
  transform: translateY(120rpx) scale(0.7);
  animation: entrySunSpread 1.45s cubic-bezier(0.2, 0.8, 0.25, 1) 0.1s both;
}

.entry-transition-horizon {
  position: absolute;
  left: 50%;
  bottom: 31%;
  width: 100%;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(255, 230, 190, 0), rgba(255, 230, 190, 0.68), rgba(255, 230, 190, 0));
  opacity: 0;
  transform: scaleX(0.2);
  animation: entryHorizonReveal 1.1s ease-out 0.65s both;
}

/* 书页共用一张纸面：两页在中间重叠，书脊只用暖色柔影表示。 */
.entry-transition-book {
  position: relative;
  z-index: 1;
  width: 328rpx;
  height: 194rpx;
  margin-top: -80rpx;
  perspective: 900rpx;
  opacity: 0;
  transform: translateY(70rpx) scale(0.88);
  animation: entryBookLift 1.4s cubic-bezier(0.22, 0.8, 0.25, 1) 0.75s both;
}

.entry-transition-book::before,
.entry-transition-book::after {
  content: '';
  position: absolute;
  top: 20rpx;
  width: 164rpx;
  height: 154rpx;
  box-sizing: border-box;
  background:
    repeating-linear-gradient(180deg, rgba(255, 255, 255, 0) 0, rgba(255, 255, 255, 0) 30rpx, rgba(184, 154, 114, 0.17) 31rpx, rgba(184, 154, 114, 0.17) 32rpx, rgba(255, 255, 255, 0) 33rpx),
    linear-gradient(145deg, rgba(255, 254, 250, 0.99), rgba(240, 228, 208, 0.96));
  border: 2rpx solid rgba(223, 207, 184, 0.95);
  box-shadow: 0 14rpx 28rpx rgba(82, 65, 44, 0.18);
}

.entry-transition-book::before {
  left: 3rpx;
  border-radius: 28rpx 6rpx 10rpx 24rpx;
  transform-origin: right bottom;
  transform: perspective(900rpx) rotateY(46deg) rotateZ(-6deg);
  animation: entryPageLeft 1.35s cubic-bezier(0.2, 0.75, 0.25, 1) 0.78s both;
}

.entry-transition-book::after {
  right: 3rpx;
  border-radius: 6rpx 28rpx 24rpx 10rpx;
  transform-origin: left bottom;
  transform: perspective(900rpx) rotateY(-46deg) rotateZ(6deg);
  animation: entryPageRight 1.35s cubic-bezier(0.2, 0.75, 0.25, 1) 0.78s both;
}

.entry-book-spine {
  position: absolute;
  z-index: 2;
  left: 50%;
  top: 20rpx;
  width: 24rpx;
  height: 154rpx;
  margin-left: -12rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, rgba(184, 154, 114, 0), rgba(184, 154, 114, 0.3), rgba(184, 154, 114, 0));
  opacity: 0;
  transform: scaleY(0.45);
  animation: entrySpineReveal 0.7s ease-out 1.35s both;
}

.entry-transition-copy {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 36rpx;
  opacity: 0;
  transform: translateY(22rpx);
  animation: entryCopyReveal 0.9s ease-out 1.55s both;
}

.entry-transition-title {
  color: #fff;
  font-family: var(--app-font-serif);
  font-size: 34rpx;
  letter-spacing: 0.12em;
  text-indent: 0.12em;
}

.entry-transition-subtitle {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  letter-spacing: 0.08em;
  text-indent: 0.08em;
}

@keyframes entryTransitionIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes entryLightSweep {
  0% { transform: translateX(-120vw); opacity: 0; }
  15% { opacity: 0.8; }
  75% { opacity: 0.38; }
  100% { transform: translateX(150vw); opacity: 0; }
}

@keyframes entrySunSpread {
  0% { opacity: 0; transform: translateY(120rpx) scale(0.7); }
  45% { opacity: 0.95; }
  100% { opacity: 0.45; transform: translateY(0) scale(1.1); }
}

@keyframes entryHorizonReveal {
  from { opacity: 0; transform: scaleX(0.2); }
  to { opacity: 1; transform: scaleX(1); }
}

@keyframes entryBookLift {
  from { opacity: 0; transform: translateY(70rpx) scale(0.88); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes entryPageLeft {
  from { transform: perspective(900rpx) rotateY(46deg) rotateZ(-6deg); }
  to { transform: perspective(900rpx) rotateY(0) rotateZ(-2deg); }
}

@keyframes entryPageRight {
  from { transform: perspective(900rpx) rotateY(-46deg) rotateZ(6deg); }
  to { transform: perspective(900rpx) rotateY(0) rotateZ(2deg); }
}

@keyframes entrySpineReveal {
  from { opacity: 0; transform: scaleY(0.45); }
  to { opacity: 1; transform: scaleY(1); }
}

@keyframes entryCopyReveal {
  from { opacity: 0; transform: translateY(22rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .login-entry-transition,
  .login-entry-transition::before,
  .entry-transition-sun,
  .entry-transition-horizon,
  .entry-transition-book,
  .entry-transition-book::before,
  .entry-transition-book::after,
  .entry-book-spine,
  .entry-transition-copy {
    animation: none;
    opacity: 1;
    transform: none;
  }
}
