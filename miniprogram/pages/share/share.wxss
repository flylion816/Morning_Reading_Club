.page-share {
  min-height: 100vh;
  background: var(--app-page-bg);
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.share-card {
  background: var(--app-paper);
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  max-width: 600rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--theme-primary);
  margin-bottom: 24rpx;
  text-align: center;
}

.card-content {
  font-size: 28rpx;
  line-height: 2;
  color: var(--app-text);
  margin-bottom: 32rpx;
}

.card-author {
  font-size: 24rpx;
  color: var(--app-text-muted);
  text-align: right;
}

.share-btn {
  width: 90%;
  background: var(--theme-primary);
  color: white;
  border: none;
  border-radius: 48rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.share-btn::after {
  border: none;
}

/* Version 2 consistency polish: quiet share canvas page. */
.page-share {
  min-height: 100vh;
  background:
    radial-gradient(circle at 50% 0%, var(--theme-primary-alpha-08) 0, rgba(255, 255, 255, 0) 300rpx),
    linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}
.share-card {
  border-radius: var(--app-radius-lg);
  box-shadow: var(--app-shadow);
}
.share-btn {
  border-radius: var(--app-radius-md);
  box-shadow: 0 14rpx 26rpx var(--theme-primary-alpha-18);
}
.share-btn:active {
  transform: translateY(2rpx) scale(0.98);
}


/* Version 3 dawn: 标题印章。 */
.card-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-family: var(--app-font-serif);
}
