<view class="page-insights" wx:if="{{socialAccessGranted}}">
  <view class="insights-header">
    <view class="header-avatar">
      <user-avatar
        size="80"
        avatar-url="{{headerAvatarUrl}}"
        avatar-text="{{headerAvatarText || '用'}}"
        avatar-color="{{headerAvatarColor || themePrimaryColor}}"
      />
    </view>
    <view class="header-title">{{headerTitle}}</view>
    <view class="header-desc">{{headerDesc}}</view>
  </view>

  <!-- 搜索框：仅在查看自己时显示，放在 tab 上方 -->
  <view class="insight-search-bar" wx:if="{{!isOtherUser}}">
    <picker
      class="insight-period-picker"
      mode="selector"
      range="{{periodOptions}}"
      range-key="name"
      value="{{selectedPeriodIndex}}"
      bindchange="onPeriodChange">
      <view class="insight-period-picker-value">
        <text class="insight-period-picker-text">{{periodOptions[selectedPeriodIndex].name}}</text>
        <text class="insight-period-picker-arrow">▼</text>
      </view>
    </picker>
    <view class="insight-search-input-wrap">
      <input
        class="insight-search-input"
        placeholder="搜索标题、内容"
        placeholder-style="color:#bbb"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchSubmit"
        confirm-type="search"
      />
      <view
        class="insight-search-clear"
        wx:if="{{searchKeyword}}"
        catchtap="onSearchClear">×</view>
    </view>
    <view class="insight-search-btn" catchtap="onSearchSubmit">搜索</view>
  </view>

  <!-- Tab 栏：仅在查看自己时显示 -->
  <view class="insight-tab-bar" wx:if="{{!isOtherUser}}">
    <view
      class="insight-tab {{activeTab === 'mine' ? 'insight-tab-active' : ''}}"
      bindtap="switchTab"
      data-tab="mine">我的</view>
    <view
      class="insight-tab {{activeTab === 'others' ? 'insight-tab-active' : ''}}"
      bindtap="switchTab"
      data-tab="others">他人的</view>
  </view>

  <view class="insights-list">
    <view class="app-empty" wx:if="{{searchLoading}}">
      <view class="app-empty-art app-empty-art-letter"></view>
      <text class="app-empty-title">搜索中...</text>
    </view>
    <view
      wx:for="{{isSearchMode ? (activeTab === 'mine' ? searchResults : otherSearchResults) : (activeTab === 'mine' ? insights : otherInsights)}}"
      wx:key="id"
      class="insight-item {{item.isAccessible ? 'is-unlocked' : 'is-locked'}}"
      bindtap="handleInsightClick"
      data-id="{{item.id}}"
      data-accessible="{{item.isAccessible}}"
      data-period-id="{{item.periodId}}"
      data-request-status="{{item.requestStatus}}"
      data-title="{{item.title}}"
      data-period-name="{{item.periodName}}"
      data-day-number="{{item.dayNumber}}">
      <view class="insight-flap"></view>
      <view class="insight-header">
        <view class="insight-card-avatar">
          <user-avatar
            size="56"
            avatar-url="{{item.targetUserAvatarUrl}}"
            avatar-text="{{item.targetUserAvatarText}}"
            avatar-color="{{item.targetUserAvatarColor || themePrimaryColor}}"
          />
        </view>
        <view class="insight-title-meta">
          <view class="insight-title"><text class="insight-unread-dot" wx:if="{{item.unread}}"></text>{{item.title}}<text class="insight-letter-tag" wx:if="{{item.letterType === 'weekly'}}">周信</text><text class="insight-letter-tag" wx:elif="{{item.letterType === 'monthly'}}">月信</text></view>
          <view class="insight-period">{{item.periodName}}</view>
        </view>
        <view wx:if="{{!item.isAccessible}}" class="insight-lock-badge app-icon app-icon-lock"></view>
        <view wx:elif="{{item.mediaType === 'image'}}" class="insight-type-tag">图片</view>
      </view>
      <block wx:if="{{item.mediaType === 'image' && item.imageUrl}}">
        <view class="insight-preview">
          <view
            class="insight-thumb insight-thumb-top"
            style="background-image: url('{{item.imageUrl}}');"></view>
        </view>
      </block>
      <block wx:elif="{{!item.isAccessible}}">
        <view class="locked-placeholder">
          <view class="locked-placeholder-text">{{item.lockedPlaceholder.text}}</view>
        </view>
      </block>
      <block wx:else>
        <view class="insight-preview">{{item.preview}}</view>
      </block>
      <view class="insight-footer">
        <view
          wx:if="{{isOtherUser && item.requestStatusText}}"
          class="insight-request-state {{item.requestStatus}}">
          {{item.requestStatusText}}
        </view>
        <view wx:else class="insight-request-spacer"></view>
        <view class="insight-date">{{item.date}}</view>
      </view>
    </view>

    <view
      wx:if="{{activeTab === 'mine' && insightsHasMore && !loading && !searchLoading}}"
      class="load-more {{insightsLoadingMore ? 'loading' : ''}}"
      bindtap="loadMoreInsights">
      <text>{{insightsLoadingMore ? '正在取更多…' : '加载更多'}}</text>
      <text class="load-more-count" wx:if="{{insightsTotal}}">{{insights.length}}/{{insightsTotal}}</text>
    </view>
    <view
      wx:if="{{activeTab === 'others' && otherHasMore && !otherInsightsLoading && !searchLoading}}"
      class="load-more {{otherLoadingMore ? 'loading' : ''}}"
      bindtap="loadMoreOtherInsights">
      <text>{{otherLoadingMore ? '正在取更多…' : '加载更多'}}</text>
    </view>

    <view class="app-empty" wx:if="{{activeTab === 'mine' && (isSearchMode ? searchResults.length === 0 : insights.length === 0) && !loading && !searchLoading}}">
      <view class="app-empty-art app-empty-art-letter"></view>
      <text class="app-empty-title">{{isSearchMode ? '未找到相关内容' : '小凡还在读你的打卡，写好了会放在这里'}}</text>
    </view>
    <view class="app-empty" wx:if="{{activeTab === 'others' && (isSearchMode ? otherSearchResults.length === 0 : otherInsights.length === 0) && !otherInsightsLoading && !searchLoading}}">
      <view class="app-empty-art app-empty-art-letter"></view>
      <text class="app-empty-title">{{isSearchMode ? '未找到相关内容' : '还没有书友向你开放他的看见'}}</text>
    </view>
    <view class="dawn-skeleton-list" wx:if="{{activeTab === 'others' && otherInsightsLoading}}">
      <view class="dawn-skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
        <view class="app-skeleton-line dawn-sk-w60"></view>
        <view class="app-skeleton-line dawn-sk-w90"></view>
        <view class="app-skeleton-line dawn-sk-w40"></view>
      </view>
    </view>
    <view class="dawn-skeleton-list" wx:if="{{activeTab === 'mine' && loading && insights.length === 0 && !searchLoading}}">
      <view class="dawn-skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
        <view class="app-skeleton-line dawn-sk-w60"></view>
        <view class="app-skeleton-line dawn-sk-w90"></view>
        <view class="app-skeleton-line dawn-sk-w40"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{showRequestSharePrompt}}" class="request-share-mask" catchtap="closeRequestSharePrompt">
    <view class="request-share-panel" catchtap="stopTap">
      <view class="request-share-title">申请已发送</view>
      <view class="request-share-desc">
        转发给{{pendingShareRequest.toUserName}}后，对方点开会直接定位到这条请求。
      </view>
      <view class="request-share-target">{{pendingShareRequest.requestLabel}}</view>
      <view class="request-share-actions">
        <button class="request-share-secondary" catchtap="closeRequestSharePrompt">暂不转发</button>
        <button
          class="request-share-primary"
          open-type="share"
          data-share-type="insightRequest">
          转给{{pendingShareRequest.toUserName}}
        </button>
      </view>
    </view>
  </view>
</view>

<podcast-player-bar />
