.page-admin-workbench {
  min-height: 100vh;
  background: var(--app-page-bg);
  padding-bottom: 40rpx;
}

.tabs {
  position: sticky;
  top: 0;
  z-index: 5;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  padding: 20rpx 24rpx;
  background: var(--app-paper);
  border-bottom: 1rpx solid #edf0f5;
}

.tab {
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 10rpx;
  background: var(--app-surface-muted);
  color: var(--app-text-soft);
  font-size: 26rpx;
}

.tab.active {
  background: var(--theme-primary);
  color: #ffffff;
  font-weight: 600;
}

.content {
  padding: 20rpx 24rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.search-input {
  flex: 1;
  height: 68rpx;
  border-radius: 10rpx;
  background: var(--app-paper);
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--app-text);
  box-sizing: border-box;
}

.search-btn {
  width: 132rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 10rpx;
  background: var(--theme-primary);
  color: #ffffff;
  font-size: 26rpx;
  padding: 0;
}

.search-btn::after {
  border: 0;
}

.state-box {
  padding: 44rpx 20rpx;
  border-radius: 10rpx;
  background: var(--app-paper);
  color: var(--app-text-muted);
  font-size: 26rpx;
  text-align: center;
}

.state-box.compact {
  padding: 28rpx 20rpx;
  margin-top: 12rpx;
}

.user-list,
.activity-list,
.registration-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.user-card,
.activity-card,
.info-card,
.detail-panel,
.profile-box {
  background: var(--app-paper);
  border-radius: 12rpx;
  box-shadow: 0 4rpx 14rpx rgba(60, 42, 20, 0.05);
}

.user-card,
.activity-card,
.info-card {
  padding: 20rpx;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid transparent;
}

.user-card.selected {
  border-color: var(--theme-primary-alpha-40);
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--theme-primary-tint);
  color: var(--theme-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.user-main {
  min-width: 0;
  flex: 1;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.row.sub,
.foot {
  margin-top: 10rpx;
  color: var(--app-text-soft);
  font-size: 22rpx;
}

.name,
.card-title,
.profile-name {
  color: var(--app-text);
  font-weight: 600;
}

.name {
  font-size: 28rpx;
}

.card-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-name {
  display: block;
  font-size: 32rpx;
}

.meta,
.latest,
.meta-line,
.profile-meta,
.panel-meta {
  color: var(--app-text-muted);
  font-size: 22rpx;
}

.latest,
.profile-meta,
.meta-line {
  display: block;
  margin-top: 10rpx;
}

.arrow {
  color: #cbd5e1;
  font-size: 36rpx;
  flex-shrink: 0;
}

.detail-panel {
  margin-top: 20rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--app-text);
  margin-bottom: 16rpx;
}

.sub-title {
  margin: 24rpx 0 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--app-text-soft);
}

.profile-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  box-shadow: none;
  background: var(--app-surface-muted);
}

.status-pill {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-tint);
  color: var(--theme-primary);
  font-size: 22rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.chip {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: var(--app-surface-muted);
  color: var(--app-text-soft);
  font-size: 22rpx;
  line-height: 30rpx;
}

.chip.blue {
  background: var(--theme-primary-tint);
  color: var(--theme-primary);
}

.amount {
  flex-shrink: 0;
  color: var(--theme-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.load-more {
  margin-top: 8rpx;
  padding: 22rpx 0;
  border-radius: 10rpx;
  background: var(--app-paper);
  color: var(--theme-primary);
  text-align: center;
  font-size: 26rpx;
}

.card-link {
  display: block;
  margin-top: 14rpx;
  color: var(--theme-primary);
  font-size: 24rpx;
  font-weight: 600;
}

/* Version 2 consistency polish: compact admin workbench. */
.page-admin-workbench {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}
.tabs {
  border-radius: 999rpx;
  background: var(--app-paper);
  box-shadow: var(--app-shadow-soft);
}
.tab.active {
  background: var(--theme-primary);
  color: #fff;
}
.user-card,
.activity-card,
.info-card,
.detail-panel {
  border-radius: var(--app-radius-lg);
  border-color: rgba(92, 70, 44, 0.07);
  box-shadow: var(--app-shadow-soft);
}
.search-btn {
  border-radius: var(--app-radius-sm);
  background: linear-gradient(135deg, var(--theme-primary), var(--theme-primary-dark));
}
.tab:active,
.search-btn:active,
.user-card:active,
.activity-card:active {
  transform: translateY(2rpx) scale(0.99);
}
