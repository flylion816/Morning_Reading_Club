.page-reports {
  min-height: 100vh;
  background: var(--app-page-bg);
  padding: 24rpx;
  box-sizing: border-box;
}

.report-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.report-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: var(--app-paper);
  border-radius: 12rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.report-card-main {
  flex: 1;
  min-width: 0;
}

.report-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--app-text);
  margin-bottom: 10rpx;
}

.report-card-subtitle {
  font-size: 28rpx;
  color: var(--app-text-soft);
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.report-card-meta {
  font-size: 24rpx;
  color: var(--app-text-soft);
}

.report-card-meta.pending {
  color: #9a6a00;
}

.report-card-status {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.report-card-status.ready {
  color: #047857;
  background: #ecfdf5;
}

.report-card-status.pending {
  color: #9a6a00;
  background: #fff7e6;
}

.state-block {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: var(--app-text-soft);
}

.state-icon {
  font-size: 80rpx;
}

.state-title {
  font-size: 30rpx;
  color: var(--app-text-soft);
}

.state-action {
  margin-top: 8rpx;
  padding: 18rpx 44rpx;
  border-radius: 44rpx;
  background: var(--theme-primary);
  color: #ffffff;
  font-size: 28rpx;
}

/* Version 2 consistency polish: report list. */
.page-reports {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}
.report-card {
  border-radius: var(--app-radius-lg);
  border-color: rgba(92, 70, 44, 0.07);
  box-shadow: var(--app-shadow-soft);
}
.report-card-status {
  border-radius: 999rpx;
}
.report-card:active {
  transform: translateY(2rpx) scale(0.99);
}

/* Version 3 dawn: 线性图标替代 emoji，报告标题用衬线体 */
.report-title,
.report-name {
  font-family: var(--app-font-serif);
}
.report-card-title {
  font-family: var(--app-font-serif);
}

.app-empty { margin: 80rpx 24rpx 0; }

.dawn-skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0;
  box-sizing: border-box;
  width: 100%;
}

.dawn-skeleton-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 28rpx;
  border-radius: var(--app-radius-md);
  background: var(--app-paper);
}

.dawn-sk-w60 { width: 60%; }
.dawn-sk-w90 { width: 90%; }
.dawn-sk-w40 { width: 40%; }

.state-block-skeleton { padding: 0; background: transparent; box-shadow: none; }
.state-block-skeleton { min-height: 0; display: block; align-items: stretch; }
