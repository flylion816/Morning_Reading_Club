/* Enrollment page: calm, compact and template-led. */

.page-enrollment {
  min-height: 100vh;
  background: #f3f7f4;
  color: var(--app-text, #20312a);
}

.loading {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f3f7f4;
  color: var(--app-text-soft, #718078);
}

.loading-spinner {
  width: 58rpx;
  height: 58rpx;
  margin-bottom: 20rpx;
  border: 4rpx solid #dce8df;
  border-top-color: var(--theme-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.enrollment-container {
  min-height: 100vh;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 90% 25%, rgba(99, 155, 120, .10), transparent 34%),
    #f3f7f4;
}

.enrollment-header {
  position: relative;
  min-height: 350rpx;
  overflow: hidden;
  padding: 42rpx 34rpx 72rpx;
  color: #fff;
  background-color: var(--theme-primary);
  background-image: linear-gradient(145deg, rgba(255, 255, 255, .04), rgba(0, 0, 0, .08));
  border-radius: 0 0 42rpx 42rpx;
}
.header-content {
  position: relative;
  z-index: 2;
  max-width: 680rpx;
  margin: 0 auto;
}

.header-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 54rpx;
  color: rgba(255, 255, 255, .70);
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

.header-main {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.header-icon {
  display: flex;
  width: 86rpx;
  height: 86rpx;
  flex: 0 0 86rpx;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, .16);
  border: 1rpx solid rgba(255, 255, 255, .24);
  border-radius: 26rpx;
  box-shadow: 0 16rpx 32rpx rgba(14, 40, 50, .18);
  font-size: 48rpx;
}

.header-copy {
  min-width: 0;
}

.header-title {
  overflow: hidden;
  max-width: 560rpx;
  margin-bottom: 12rpx;
  color: #fff;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.22;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-subtitle {
  overflow: hidden;
  color: rgba(255, 255, 255, .78);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 58rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .18);
  color: rgba(255, 255, 255, .68);
  font-size: 22rpx;
}

.header-meta text:last-child {
  max-width: 52%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.enrollment-form {
  position: relative;
  z-index: 3;
  margin: -38rpx 24rpx 0;
  padding: 0 0 28rpx;
}

.form-group {
  margin: 18rpx 0 0;
  padding: 26rpx 26rpx 28rpx;
  background: rgba(255, 255, 255, .96);
  border: 1rpx solid #e2ebe5;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(35, 74, 53, .05);
}

.form-group:first-of-type {
  margin-top: 18rpx;
  padding-top: 26rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  color: #24352d;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.4;
}

.required {
  margin-right: 6rpx;
  color: #d76b58;
  font-weight: 700;
}

.form-control {
  display: block;
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  color: #24352d;
  background: #f9fbf9;
  border: 2rpx solid #dfe9e2;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 88rpx;
  transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
}

.form-control:focus {
  background: #fff;
  border-color: var(--theme-primary);
  box-shadow: 0 0 0 6rpx var(--theme-primary-alpha-15, rgba(74, 144, 226, .13));
}

.form-control::placeholder {
  color: #a0aea6;
}

input.form-control {
  width: 100% !important;
  height: 88rpx !important;
  padding: 0 24rpx !important;
  box-sizing: border-box !important;
  line-height: 88rpx !important;
}

textarea.form-control {
  width: 100% !important;
  min-height: 190rpx !important;
  max-height: 360rpx !important;
  padding: 22rpx 24rpx !important;
  box-sizing: border-box !important;
  font-family: inherit !important;
  line-height: 1.6 !important;
}

picker {
  display: block;
  width: 100%;
}

.picker-control {
  display: flex;
  height: 88rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  line-height: 1.4;
}

.picker-icon {
  color: var(--theme-primary);
  font-size: 34rpx;
  font-weight: 700;
}

.address-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.radio-group {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.radio-item {
  display: flex;
  min-height: 78rpx;
  box-sizing: border-box;
  align-items: center;
  padding: 0 18rpx;
  color: #3c4e45;
  background: #f9fbf9;
  border: 2rpx solid #e0eae3;
  border-radius: 16rpx;
  font-size: 25rpx;
  transition: background .2s ease, border-color .2s ease, transform .2s ease;
}

.radio-item:active {
  background: var(--theme-primary-tint);
  border-color: var(--theme-primary);
  transform: scale(.98);
}

.radio-item radio {
  margin-right: 10rpx;
  transform: scale(.72);
}

.text-count {
  margin-top: 8rpx;
  color: #94a199;
  font-size: 21rpx;
  text-align: right;
}

.form-error {
  display: block;
  margin-top: 10rpx;
  color: #c34f43;
  font-size: 22rpx;
  line-height: 1.4;
}

.form-control-error {
  border-color: #d76b58 !important;
  box-shadow: 0 0 0 5rpx rgba(215, 107, 88, .10) !important;
}

.phone-bound {
  display: flex;
  height: 88rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  background: #f9fbf9;
  border: 2rpx solid #dfe9e2;
  border-radius: 16rpx;
}

.phone-number {
  color: #24352d;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.phone-change {
  color: var(--theme-primary);
  font-size: 23rpx;
}

.phone-auth-wrap {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.btn-phone-auth {
  height: 82rpx;
  margin: 0;
  padding: 0;
  color: #fff;
  background: #2fa36b;
  border: 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 82rpx;
}

.btn-phone-auth::after {
  border: none;
}

.step-indicator {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 18rpx;
  padding: 22rpx 24rpx;
  background: rgba(255, 255, 255, .96);
  border: 1rpx solid #e2ebe5;
  border-radius: 22rpx;
  box-shadow: 0 12rpx 30rpx rgba(35, 74, 53, .05);
}

.step-item {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 9rpx;
  color: #9aa79f;
  font-size: 22rpx;
}

.step-dot {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  color: #8d9c92;
  background: #edf2ee;
  border-radius: 14rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.step-item.active {
  color: var(--theme-primary-dark);
  font-weight: 650;
}

.step-item.active .step-dot {
  color: #fff;
  background: var(--theme-primary);
  box-shadow: 0 7rpx 14rpx rgba(74, 144, 226, .22);
}

.step-line {
  height: 2rpx;
  flex: 1;
  margin: 0 12rpx;
  background: #e0e9e2;
}

.step-line.active {
  background: var(--theme-primary);
}

.step-actions {
  display: flex;
  gap: 14rpx;
  margin: 24rpx 0 0;
  padding-top: 22rpx;
  border-top: 1rpx solid #dfe9e2;
}

.btn {
  display: flex;
  min-height: 88rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 0;
  border-radius: 17rpx;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.2;
  transition: transform .18s ease, opacity .18s ease, background .18s ease;
}

.btn:active {
  opacity: .88;
  transform: translateY(2rpx) scale(.985);
}

.btn-primary {
  color: #fff;
  background: linear-gradient(135deg, var(--theme-primary), var(--theme-primary-dark));
  box-shadow: 0 12rpx 22rpx rgba(74, 144, 226, .20);
}

.btn-secondary {
  color: #506057;
  background: #fff;
  border: 2rpx solid #dfe9e2;
}

.confirm-section {
  margin: 18rpx 0 0;
  padding: 28rpx;
  background: #fff;
  border: 1rpx solid #e2ebe5;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(35, 74, 53, .05);
}

.confirm-title {
  margin-bottom: 18rpx;
  padding-bottom: 18rpx;
  color: #24352d;
  border-bottom: 1rpx solid #e2ebe5;
  font-size: 30rpx;
  font-weight: 700;
}

.confirm-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf2ee;
}

.confirm-item:last-child {
  border-bottom: 0;
}

.confirm-label {
  flex: 0 0 auto;
  color: #87958c;
  font-size: 23rpx;
}

.confirm-value {
  flex: 1;
  color: #26372e;
  font-size: 24rpx;
  text-align: right;
}

.confirm-item-price {
  margin-top: 10rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #dfe9e2;
}

.confirm-price,
.confirm-price-free {
  font-size: 34rpx;
  font-weight: 750;
}

.confirm-price { color: var(--theme-primary-dark); }
.confirm-price-free { color: #2f9360; }

.simple-form-intro {
  margin: 0 0 20rpx;
  padding: 30rpx 28rpx 32rpx;
  background: #fff;
  border: 1rpx solid #e2ebe5;
  border-radius: 26rpx;
  box-shadow: 0 12rpx 30rpx rgba(35, 74, 53, .05);
}

.simple-form-kicker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.simple-form-kicker {
  color: var(--theme-primary);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.template-mark {
  max-width: 48%;
  overflow: hidden;
  padding: 7rpx 12rpx;
  color: var(--theme-primary-dark);
  background: var(--theme-primary-tint);
  border-radius: 8rpx;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.simple-form-title {
  display: block;
  margin-top: 18rpx;
  color: #20312a;
  font-size: 38rpx;
  font-weight: 750;
  letter-spacing: -1rpx;
  line-height: 1.25;
}

.simple-form-description {
  display: block;
  margin-top: 12rpx;
  color: #85938a;
  font-size: 23rpx;
  line-height: 1.6;
}

.simple-fee-row {
  display: flex;
  min-height: 94rpx;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 20rpx 26rpx;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid #e2ebe5;
  border-radius: 22rpx;
}

.fee-label,
.fee-note {
  display: block;
}

.fee-label {
  color: #34473d;
  font-size: 25rpx;
  font-weight: 650;
}

.fee-note {
  margin-top: 6rpx;
  color: #95a199;
  font-size: 20rpx;
}

.simple-fee-value {
  color: var(--theme-primary-dark);
  font-size: 34rpx;
  font-weight: 750;
}

.simple-form-actions {
  margin-top: 18rpx;
}

@media (max-width: 360px) {
  .enrollment-header { padding-right: 24rpx; padding-left: 24rpx; }
  .enrollment-form { margin-right: 16rpx; margin-left: 16rpx; }
  .header-title { font-size: 36rpx; }
  .step-item { gap: 5rpx; font-size: 20rpx; }
  .step-line { margin-right: 6rpx; margin-left: 6rpx; }
  .btn { padding-right: 12rpx; padding-left: 12rpx; font-size: 25rpx; }
}

/* Version 1 core-journey polish: template-aware receipt and calm form rhythm. */
.page-enrollment,
.loading,
.enrollment-container {
  color: var(--app-text);
  background:
    radial-gradient(circle at 92% 3%, var(--theme-primary-alpha-08) 0, rgba(255, 255, 255, 0) 310rpx),
    linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}

.enrollment-header {
  margin: 0 20rpx;
  min-height: 326rpx;
  padding: 40rpx 32rpx 66rpx;
  color: #ffffff;
  background:
    radial-gradient(circle at 80% 4%, rgba(255, 255, 255, 0.20) 0, rgba(255, 255, 255, 0) 220rpx),
    linear-gradient(145deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  border-radius: var(--app-radius-xl);
  box-shadow: 0 24rpx 48rpx var(--theme-primary-alpha-18);
}

.header-topline {
  margin-bottom: 46rpx;
  color: rgba(255, 255, 255, 0.74);
  letter-spacing: 3rpx;
}

.header-icon {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.18);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.24);
}

.header-title {
  font-size: 44rpx;
  font-weight: 750;
  letter-spacing: -1.2rpx;
}

.header-subtitle,
.header-meta {
  color: rgba(255, 255, 255, 0.82);
}

.enrollment-container {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.enrollment-form {
  margin: -40rpx 22rpx 0;
}

.step-indicator {
  border-radius: var(--app-radius-md);
  border-color: rgba(49, 72, 56, 0.07);
  box-shadow: var(--app-shadow-soft);
}

.step-dot {
  border-radius: 15rpx;
}

.form-group,
.simple-form-intro,
.confirm-section {
  border-radius: var(--app-radius-md);
  border-color: rgba(49, 72, 56, 0.07);
  box-shadow: var(--app-shadow-soft);
}

.form-control {
  border-radius: 18rpx;
  background: #fbfcf8;
}

.form-control::placeholder {
  text-align: left;
  color: var(--app-text-muted);
}

.radio-item {
  border-radius: 18rpx;
}

.simple-form-title {
  font-size: 40rpx;
  letter-spacing: -1.2rpx;
}

.simple-fee-row,
.simple-fee-value,
.confirm-price,
.confirm-price-free {
  font-variant-numeric: tabular-nums;
}

.step-actions {
  position: fixed;
  left: 22rpx;
  right: 22rpx;
  bottom: calc(20rpx + constant(safe-area-inset-bottom));
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 40;
  margin: 0;
  padding: 18rpx 18rpx 18rpx;
  border-top: none;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(37, 60, 43, 0.12);
  backdrop-filter: blur(16rpx);
}

.step-actions::before {
  content: "";
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 0;
  height: 1rpx;
  background: var(--app-border);
}

.btn {
  border-radius: var(--app-radius-md);
}
