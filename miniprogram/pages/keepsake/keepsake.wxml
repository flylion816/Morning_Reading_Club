<template name="booklet-ending">
  <block wx:if="{{!finished}}">
    <view class="ks-title ks-title-sm">册子还没写完</view>
    <view class="ks-sub">{{hasReply ? '接下来的日子，也会慢慢收进这本册子' : '明早见。结营那天，再回来翻到最后一页'}}</view>
    <view class="app-btn-secondary ks-btn" bindtap="onBackToCourse">回到课程页</view>
  </block>
  <block wx:else>
    <view class="ks-title">{{totalDays ? '谢谢你，一起走完这 ' + totalDays + ' 天' : '谢谢你，一起走完这段日子'}}</view>
    <button class="app-btn-primary ks-btn" open-type="share">邀请一位朋友加入下一期</button>
    <view class="app-btn-secondary ks-btn" bindtap="onBackToCourse">回到课程页</view>
  </block>
</template>

<view class="ks-page">
  <view wx:if="{{loading}}" class="ks-screen">
    <view class="app-skeleton ks-skel"></view>
    <view class="app-skeleton-line ks-skel-line"></view>
  </view>

  <view wx:elif="{{error}}" class="ks-screen">
    <view class="app-empty">
      <view class="app-empty-art app-empty-art-book"></view>
      <view class="app-empty-title">{{error}}</view>
      <view class="app-empty-action" bindtap="onRetry">重试</view>
    </view>
  </view>

  <view wx:elif="{{!ready}}" class="ks-screen">
    <view class="app-empty">
      <view class="app-empty-art app-empty-art-book"></view>
      <view class="app-empty-title" wx:if="{{notStarted}}">还没开营。开营以后，这里会慢慢长出一本属于你的册子</view>
      <view class="app-empty-title" wx:else>还有 {{daysLeft}} 天结营，到时候这里会有一份属于你的{{totalDays ? ' ' + totalDays + ' 天' : '纪念册'}}</view>
    </view>
  </view>

  <view wx:else class="ks-flow">
    <block wx:for="{{keepsake.pages}}" wx:key="key">
      <view class="ks-screen ks-section {{item.key === 'days' || item.key === 'insights' ? 'ks-screen-list' : ''}}">
        <view wx:if="{{item.chapter}}" class="ks-chapter">{{item.chapter}}</view>
        <block wx:if="{{item.key === 'cover'}}">
          <view class="app-seal app-seal-lg ks-seal">{{keepsake.sealChar}}</view>
          <view class="ks-title">{{keepsake.period.name}}</view>
          <view class="ks-sub">{{keepsake.nickname}}{{keepsake.totalDays ? ' 的 ' + keepsake.totalDays + ' 天' : ' 的晨读纪念册'}}</view>
          <view wx:if="{{!keepsake.finished}}" class="ks-progress">还在路上{{keepsake.daysLeft ? ' · 还有 ' + keepsake.daysLeft + ' 天结营' : ''}}</view>
          <view class="ks-hint">往下滑，慢慢看</view>
        </block>

        <block wx:elif="{{item.key === 'numbers'}}">
          <view class="ks-label">{{keepsake.totalDays ? '这 ' + keepsake.totalDays + ' 天里' : '这段日子里'}}</view>
          <view class="ks-num-row"><text class="ks-num">{{keepsake.checkinDays}}</text><text class="ks-unit">天，你写下了打卡</text></view>
          <view class="ks-num-row"><text class="ks-num">{{keepsake.totalWords}}</text><text class="ks-unit">个字</text></view>
          <view class="ks-num-row"><text class="ks-num">{{keepsake.readingMinutes}}</text><text class="ks-unit">分钟晨读</text></view>
        </block>

        <block wx:elif="{{item.key === 'earliest'}}">
          <view class="ks-label">最早的一次</view>
          <view class="ks-num ks-dawn">{{keepsake.earliestCheckin.time}}</view>
          <view class="ks-sub">{{keepsake.earliestCheckin.date}}，天还没怎么亮，你已经在了</view>
        </block>

        <block wx:elif="{{item.key === 'moods'}}">
          <view class="ks-label">你的心情天气</view>
          <view class="ks-dots">
            <view wx:for="{{keepsake.moods}}" wx:for-item="m" wx:key="date" class="ks-dot" style="background: {{m.color}};"></view>
          </view>
          <view class="ks-sub">一天一个小点，只有你自己看得到</view>
        </block>

        <block wx:elif="{{item.key === 'top'}}">
          <view class="ks-label">被点赞最多的一篇</view>
          <view class="app-card ks-card">
            <view class="ks-card-meta">第 {{keepsake.topCheckin.day}} 天 · {{keepsake.topCheckin.sectionTitle}}</view>
            <view class="ks-quote">{{keepsake.topCheckin.excerpt}}</view>
            <view wx:if="{{keepsake.topCheckin.likeCount}}" class="ks-card-meta">{{keepsake.topCheckin.likeCount}} 位书友点了赞</view>
          </view>
        </block>

        <block wx:elif="{{item.key === 'highlights'}}">
          <view class="ks-label">你摘下的句子</view>
          <view wx:for="{{keepsake.highlights}}" wx:for-item="h" wx:key="text" class="app-card ks-card ks-quote">{{h.text}}</view>
        </block>

        <block wx:elif="{{item.key === 'companions'}}">
          <view class="ks-label">常来看你的书友</view>
          <view wx:for="{{keepsake.companions}}" wx:for-item="c" wx:key="userId" class="ks-friend">
            <image wx:if="{{c.avatarUrl}}" class="ks-avatar" src="{{c.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="app-seal">{{c.nickname[0]}}</view>
            <view class="ks-friend-name">{{c.nickname}}</view>
            <view class="ks-friend-count">{{c.count}} 次</view>
          </view>
        </block>

        <block wx:elif="{{item.key === 'insights'}}">
          <view class="ks-label">这一期，小凡写给你 {{keepsake.insights.length}} 封信</view>
          <view
            wx:for="{{keepsake.insights}}"
            wx:for-item="ins"
            wx:key="id"
            class="app-card ks-card"
            bindtap="onOpenInsight"
            data-id="{{ins.id}}">
            <view class="ks-card-meta">{{ins.title}}{{ins.dateText ? ' · ' + ins.dateText : ''}}</view>
            <view class="ks-quote">{{ins.excerpt}}</view>
          </view>
        </block>

        <block wx:elif="{{item.key === 'days'}}">
          <view class="ks-label">你写下了 {{keepsake.days.length}} 篇</view>
          <view
            wx:for="{{keepsake.days}}"
            wx:for-item="d"
            wx:key="checkinId"
            class="ks-day"
            bindtap="onOpenDay"
            data-section-id="{{d.sectionId}}"
            data-checkin-id="{{d.checkinId}}">
            <text class="ks-day-date">{{d.dateText}}</text>
            <view class="ks-day-body">
              <view class="ks-day-title">{{d.sectionTitle || '打卡'}}</view>
              <view class="ks-day-excerpt" wx:if="{{d.excerpt}}">{{d.excerpt}}</view>
            </view>
          </view>
        </block>

        <block wx:elif="{{item.key === 'buddy'}}">
          <view class="ks-label">你的读伴</view>
          <image wx:if="{{keepsake.buddy.avatarUrl}}" class="ks-avatar ks-avatar-lg" src="{{keepsake.buddy.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="app-seal app-seal-lg">{{keepsake.buddy.nickname[0]}}</view>
          <view class="ks-title ks-title-sm">{{keepsake.buddy.nickname}}</view>
          <view class="ks-sub" wx:if="{{keepsake.buddy.days}}">你们一起走了 {{keepsake.buddy.days}} 天</view>
        </block>

        <block wx:elif="{{item.key === 'practices'}}">
          <view class="ks-label">每周一件小事</view>
          <view wx:for="{{keepsake.practices}}" wx:for-item="pr" wx:key="weekIndex" class="app-card ks-card">
            <view class="ks-card-meta">第 {{pr.weekIndex}} 周</view>
            <view class="ks-quote">{{pr.text}}</view>
            <view class="ks-card-meta" wx:if="{{pr.loggedDays}}">记了 {{pr.loggedDays}} 天，其中 {{pr.doneDays}} 天做到了</view>
          </view>
        </block>

        <block wx:elif="{{item.key === 'prologue' && keepsake.letterStatus === 'opened'}}">
          <view class="ks-label">{{keepsake.letterPrologueLabel}}</view>
          <view class="ks-letter">
            <text class="ks-letter-to">写给结营那天的我：</text>
            <text class="ks-letter-body">{{keepsake.letter.content}}</text>
            <text class="ks-letter-sign">那时的你</text>
          </view>
          <view class="ks-sub">{{keepsake.totalDays ? '往后翻的每一页，都是这 ' + keepsake.totalDays + ' 天给它的回答' : '往后翻的每一页，都是这段日子给它的回答'}}</view>
        </block>

        <block wx:elif="{{item.key === 'prologue' && keepsake.letterStatus === 'delivered'}}">
          <view class="ks-envelope"><view class="ks-envelope-flap"></view><view class="ks-envelope-wax">凡</view></view>
          <view class="ks-title ks-title-sm">有一封信还没拆</view>
          <view class="ks-sub">开营时你写给今天的自己。先去拆开它，再回来翻这本册子</view>
          <view class="app-btn-primary ks-btn" bindtap="onOpenLetter">去拆信</view>
        </block>

        <block wx:elif="{{item.key === 'prologue'}}">
          <view class="ks-envelope"><view class="ks-envelope-flap"></view><view class="ks-envelope-wax">凡</view></view>
          <view class="ks-title ks-title-sm">有一封信还没拆</view>
          <view class="ks-sub">信还在路上，结营那天早上送到。那时这本册子会从它开始</view>
          <view class="app-btn-primary ks-btn" bindtap="onOpenLetter">去慢递邮局看看</view>
        </block>

        <block wx:elif="{{item.key === 'epilogue'}}">
          <view class="ks-label">读完之后，你回给那时的自己</view>
          <view class="ks-letter ks-letter-reply">
            <text class="ks-letter-body">{{keepsake.letter.reply}}</text>
          </view>
          <template is="booklet-ending" data="{{finished: keepsake.finished, totalDays: keepsake.totalDays, hasReply: true}}"/>
        </block>

        <block wx:elif="{{item.key === 'seen'}}">
          <view class="ks-label">这段日子里</view>
          <view class="ks-num-row"><text class="ks-num">{{keepsake.seenCount}}</text><text class="ks-unit">次，有书友看见了你</text></view>
        </block>

        <block wx:elif="{{item.key === 'report'}}">
          <view class="ks-label">这一期的分享实录</view>
          <view class="app-card ks-card ks-report" bindtap="onOpenReport">
            <view class="app-seal app-seal-dawn">录</view>
            <view class="ks-report-body">
              <view class="ks-report-title">{{keepsake.report.title}}</view>
              <view class="ks-card-meta">{{keepsake.report.fileSizeText}}{{keepsake.report.uploadedAtText ? ' · ' + keepsake.report.uploadedAtText : ''}}</view>
            </view>
            <view class="app-icon app-icon-chevron ks-report-arrow"></view>
          </view>
          <view class="ks-sub">你在营里说过的话，整理成了一份实录</view>
        </block>

        <block wx:elif="{{item.key === 'end'}}">
          <template is="booklet-ending" data="{{finished: keepsake.finished, totalDays: keepsake.totalDays}}"/>
        </block>
      </view>
    </block>
  </view>
</view>
