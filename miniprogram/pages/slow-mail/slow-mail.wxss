/* Version 3 dawn: 新功能页面，直接按晨光规范编写。 */
.mail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 36rpx 32rpx 80rpx;
  background: var(--app-page-bg);
}

.mail-skeleton { height: 600rpx; border-radius: var(--app-radius-lg); }

.mail-error { display: flex; align-items: center; justify-content: center; gap: 20rpx; padding: 120rpx 0; }
.mail-error-text { font-size: var(--app-font-sm); color: var(--app-text-muted); }
.mail-error-retry { font-size: var(--app-font-sm); color: var(--theme-primary-dark); }

.mail-prompt {
  display: block;
  margin-bottom: 28rpx;
  font-family: var(--app-font-serif);
  font-size: var(--app-font-lg);
  line-height: 1.6;
  color: var(--app-text);
}

.mail-paper {
  position: relative;
  box-sizing: border-box;
  padding: 40rpx 36rpx 48rpx;
  border: 1rpx solid var(--app-border);
  border-radius: var(--app-radius-md);
  background: var(--app-paper);
  box-shadow: var(--app-shadow-soft), var(--app-inner-line);
}

.mail-textarea {
  width: 100%;
  min-height: 460rpx;
  font-family: var(--app-font-serif);
  font-size: 30rpx;
  line-height: 2.1;
  color: var(--app-text);
}

.mail-count {
  display: block;
  margin-top: 12rpx;
  text-align: right;
  font-size: var(--app-font-xs);
  color: var(--app-text-muted);
}

.mail-stamps { margin-top: 36rpx; }
.mail-stamps-label { display: block; margin-bottom: 20rpx; font-size: var(--app-font-sm); color: var(--app-text-soft); }
.mail-stamp-row { display: flex; gap: 24rpx; }
.mail-stamp-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 0;
  flex: 1;
  border: 2rpx solid transparent;
  border-radius: var(--app-radius-md);
  background: var(--app-paper-muted);
}
.mail-stamp-on { border-color: var(--app-dawn); background: var(--app-dawn-soft); }
.mail-stamp-name { font-size: var(--app-font-xs); color: var(--app-text-soft); }

.mail-actions { display: flex; gap: 20rpx; margin-top: 44rpx; }
.mail-actions .mail-btn { flex: 1; }

.mail-draft-closed {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 48rpx;
}
.mail-draft-hint {
  display: block;
  max-width: 620rpx;
  margin: 20rpx 0 28rpx;
  text-align: center;
  font-size: var(--app-font-sm);
  line-height: 1.7;
  color: var(--app-text-muted);
}
.mail-draft-closed .mail-paper {
  width: 100%;
  margin-bottom: 32rpx;
}
.mail-draft-closed .mail-btn { width: 100%; }

.mail-envelope-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  gap: 36rpx;
}

.mail-envelope {
  position: relative;
  width: 560rpx;
  height: 360rpx;
  overflow: hidden;
  border: 1rpx solid var(--app-rule);
  border-radius: var(--app-radius-md);
  background: var(--app-paper-muted);
  box-shadow: var(--app-shadow);
}

.mail-envelope-flap {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 190rpx;
  background: linear-gradient(180deg, var(--app-dawn-sky) 0%, var(--app-dawn-soft) 100%);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  transform-origin: top center;
  transition: transform 0.6s var(--app-ease), opacity 0.6s var(--app-ease);
}

.mail-envelope-seal {
  position: absolute;
  top: 150rpx;
  left: 50%;
  margin-left: -38rpx;
  transition: opacity 0.4s var(--app-ease);
}

.mail-envelope-opening .mail-envelope-flap { transform: rotateX(180deg) translateY(-30rpx); opacity: 0.4; }
.mail-envelope-opening .mail-envelope-seal { opacity: 0; }

.mail-road { font-family: var(--app-font-serif); font-size: var(--app-font-md); color: var(--app-text-soft); }
.mail-road-num { font-size: var(--app-font-xl); color: var(--app-dawn-deep); }

.mail-opened { animation: mail-unfold 0.6s var(--app-ease); }
@keyframes mail-unfold {
  from { opacity: 0; transform: translateY(40rpx) scale(0.96); }
  to { opacity: 1; transform: none; }
}

.mail-paper-read { padding-bottom: 40rpx; }
.mail-salutation { display: block; margin-bottom: 24rpx; font-family: var(--app-font-serif); font-size: var(--app-font-lg); color: var(--app-text); }
.mail-body { display: block; font-family: var(--app-font-serif); font-size: 30rpx; line-height: 2.1; color: var(--app-text); white-space: pre-wrap; }
.mail-sign { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; margin-top: 36rpx; }
.mail-sign-name { font-family: var(--app-font-serif); font-size: var(--app-font-md); color: var(--app-text-soft); }
.mail-sign-date { font-size: var(--app-font-xs); color: var(--app-text-muted); }

.mail-reply-box, .mail-reply-done {
  margin-top: 36rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--app-radius-md);
  background: var(--app-paper);
  border: 1rpx solid var(--app-border);
}
.mail-reply-label { display: block; margin-bottom: 16rpx; font-size: var(--app-font-sm); color: var(--app-text-soft); }
.mail-reply-input { width: 100%; min-height: 140rpx; margin-bottom: 20rpx; font-family: var(--app-font-serif); font-size: var(--app-font-md); line-height: 1.8; color: var(--app-text); }
.mail-reply-text { font-family: var(--app-font-serif); font-size: var(--app-font-md); line-height: 1.8; color: var(--app-text); }

/* Features: 投递动画（约 5.6 秒，时长要和 slow-mail.js 的 POST_MS 对上）。
   0–1.4s 信纸对折落进信封 → 1.4–2.2s 封盖合上 → 2.2–2.8s 盖上邮戳 → 3.0–4.3s 信封飞进邮筒 → 4.2–4.8s 邮筒小旗竖起、出字。 */
.post-scene,
.unseal-scene {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--app-page-bg);
  animation: mailFade 0.4s ease both;
}
.post-stage {
  position: relative;
  width: 600rpx;
  height: 1120rpx;
}
.post-pack {
  position: absolute;
  left: 60rpx;
  top: 380rpx;
  width: 480rpx;
  height: 300rpx;
  z-index: 3;
  animation: postFly 1.3s cubic-bezier(0.5, 0, 0.7, 0.4) 3.4s both;
}
.post-env-back,
.post-env-front {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: 12rpx;
}
.post-env-back {
  background: #e7d3b0;
  box-shadow: 0 18rpx 40rpx rgba(84, 60, 30, 0.18);
}
.post-env-front {
  z-index: 3;
  background: linear-gradient(180deg, #f7ecd8 0%, #f0e0c2 100%);
  clip-path: polygon(0 0, 50% 52%, 100% 0, 100% 100%, 0 100%);
}
.post-env-flap {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 170rpx;
  z-index: 1;
  background: linear-gradient(180deg, #eedcbc 0%, #e4cda5 100%);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  transform-origin: 50% 0;
  transform: rotateX(180deg);
  animation: postFlapClose 0.7s ease-in-out 2.1s forwards;
}
.post-line {
  height: 4rpx;
  margin-bottom: 30rpx;
  border-radius: 4rpx;
  background: rgba(138, 75, 18, 0.22);
}
.post-line-short {
  width: 55%;
}
.post-seal {
  position: absolute;
  left: 50%;
  top: 128rpx;
  z-index: 5;
  margin-left: -38rpx;
  opacity: 0;
  animation: postSeal 0.5s cubic-bezier(0.3, 1.5, 0.5, 1) 2.75s forwards;
}
/* 邮筒：圆顶、深绿，正面一个「邮」字，侧面一面小旗 */
.post-box {
  position: absolute;
  left: 170rpx;
  top: 720rpx;
  z-index: 5;
  width: 260rpx;
  height: 340rpx;
  border-radius: 130rpx 130rpx 16rpx 16rpx;
  background: linear-gradient(90deg, #2c5a43 0%, #3a7356 45%, #2c5a43 100%);
  box-shadow: 0 20rpx 40rpx rgba(30, 60, 40, 0.25);
  animation: postBoxIn 0.6s cubic-bezier(0.22, 0.8, 0.3, 1) 2.9s both, postBoxBump 0.35s ease 4.6s;
}
.post-box-slot {
  position: absolute;
  left: 50rpx;
  right: 50rpx;
  top: 104rpx;
  height: 14rpx;
  border-radius: 8rpx;
  background: #17301f;
}
.post-box-label {
  position: absolute;
  left: 50%;
  top: 160rpx;
  width: 80rpx;
  height: 80rpx;
  margin-left: -40rpx;
  border-radius: 50%;
  background: #f6ead4;
  color: #2c5a43;
  font-family: var(--app-font-serif);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 80rpx;
  text-align: center;
}
.post-box-flag {
  position: absolute;
  right: -34rpx;
  top: 150rpx;
  width: 40rpx;
  height: 90rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, var(--app-dawn) 0 34%, #b8865a 34% 100%);
  transform-origin: 50% 100%;
  transform: rotate(90deg);
  animation: postFlagUp 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) 4.7s forwards;
}
.post-box-foot {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: -26rpx;
  height: 26rpx;
  border-radius: 0 0 10rpx 10rpx;
  background: #22472f;
}
.post-caption {
  margin-top: -20rpx;
  font-family: var(--app-font-serif);
  font-size: 34rpx;
  color: var(--app-text);
  opacity: 0;
  animation: mailFade 0.6s ease 4.8s forwards;
}
@keyframes mailFade {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes postFlapClose {
  0% { transform: rotateX(180deg); z-index: 1; }
  50% { transform: rotateX(90deg); z-index: 1; }
  51% { z-index: 4; }
  100% { transform: rotateX(0deg); z-index: 4; }
}
@keyframes postSeal {
  from { opacity: 0; transform: scale(1.8) rotate(-12deg); }
  to { opacity: 1; transform: scale(1) rotate(-6deg); }
}
@keyframes postBoxIn {
  from { opacity: 0; transform: translateY(80rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes postFly {
  0% { transform: translateY(0) scale(1) rotate(0deg); opacity: 1; }
  45% { transform: translateY(200rpx) scale(0.6) rotate(-8deg); opacity: 1; }
  80% { transform: translateY(380rpx) scale(0.4) rotate(0deg); opacity: 1; }
  100% { transform: translateY(470rpx) scale(0.36) rotate(0deg); opacity: 0; }
}
@keyframes postBoxBump {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(8rpx); }
}
@keyframes postFlagUp {
  from { transform: rotate(90deg); }
  to { transform: rotate(0deg); }
}

/* Features: 拆信动画（约 5 秒，时长要和 slow-mail.js 的 UNSEAL_MS 对上）。和小凡的信不同：不揭封盖，而是先盖「到」的邮戳，再沿上沿撕开。
   0–0.5s 信封浮上来 → 0.5–1.2s 盖邮戳 → 1.4–2.3s 撕开封口 → 2.3–3.4s 抽出对折的信 → 3.4–4.3s 信纸展开 → 4.3–5s 铺满成纸。 */
.unseal-scene {
  perspective: 1600rpx;
}
.unseal-env {
  position: relative;
  width: 520rpx;
  height: 330rpx;
  margin-top: 260rpx;
  animation: unsealRise 0.5s cubic-bezier(0.22, 0.8, 0.3, 1) both;
}
.unseal-back {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border-radius: 12rpx;
  background: #e7d3b0;
  box-shadow: 0 18rpx 40rpx rgba(84, 60, 30, 0.2);
}
.unseal-front {
  position: absolute;
  left: 0;
  right: 0;
  top: 36rpx;
  bottom: 0;
  z-index: 4;
  border-radius: 0 0 12rpx 12rpx;
  background: linear-gradient(180deg, #f7ecd8 0%, #f0e0c2 100%);
}
.unseal-to {
  position: absolute;
  left: 50rpx;
  bottom: 60rpx;
  font-family: var(--app-font-serif);
  font-size: 30rpx;
  color: var(--app-text-soft);
}
/* 封口那一条：带锯齿的上沿，被撕下来往右飞走 */
.unseal-strip {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 40rpx;
  z-index: 5;
  border-radius: 12rpx 12rpx 0 0;
  background:
    radial-gradient(circle at 10rpx 40rpx, rgba(0, 0, 0, 0) 7rpx, #f7ecd8 8rpx) 0 0 / 20rpx 40rpx repeat-x;
  transform-origin: 0 50%;
  animation: unsealTear 0.9s cubic-bezier(0.5, 0, 0.6, 1) 1.4s forwards;
}
.unseal-postmark {
  position: absolute;
  right: 36rpx;
  top: 70rpx;
  z-index: 6;
  width: 110rpx;
  height: 110rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 4rpx double rgba(168, 69, 47, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  animation: unsealPostmark 0.6s cubic-bezier(0.3, 1.5, 0.5, 1) 0.6s forwards;
}
.unseal-postmark-word {
  font-family: var(--app-font-serif);
  font-size: 46rpx;
  font-weight: 700;
  color: rgba(168, 69, 47, 0.85);
}
.unseal-letter {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  top: 50rpx;
  height: 200rpx;
  z-index: 2;
  transform-style: preserve-3d;
  animation: unsealPull 1.1s cubic-bezier(0.3, 0.7, 0.3, 1) 2.3s both;
}
.unseal-half {
  position: absolute;
  left: 0;
  right: 0;
  height: 200rpx;
  box-sizing: border-box;
  padding: 30rpx 32rpx 0;
  background: var(--app-paper);
  box-shadow: 0 6rpx 16rpx rgba(84, 60, 30, 0.14);
}
.unseal-half-top {
  top: 0;
  border-radius: 8rpx 8rpx 0 0;
}
/* 下半张一开始折在背面，展开时绕折痕翻下来 */
.unseal-half-bottom {
  top: 200rpx;
  border-radius: 0 0 8rpx 8rpx;
  transform-origin: 50% 0;
  transform: rotateX(-178deg);
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  animation: unsealUnfold 0.9s ease-in-out 3.4s forwards;
}
.unseal-salute {
  display: block;
  margin-bottom: 26rpx;
  font-family: var(--app-font-serif);
  font-size: 26rpx;
  color: var(--app-text);
}
.unseal-sign {
  position: absolute;
  right: 32rpx;
  bottom: 28rpx;
  font-family: var(--app-font-serif);
  font-size: 24rpx;
  color: var(--app-dawn-ink);
}
.unseal-paper {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9;
  background: var(--app-paper);
  opacity: 0;
  animation: mailFade 0.7s ease-in 4.3s forwards;
}
@keyframes unsealRise {
  from { opacity: 0; transform: translateY(80rpx) scale(0.9); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes unsealPostmark {
  from { opacity: 0; transform: scale(1.9) rotate(-25deg); }
  to { opacity: 1; transform: scale(1) rotate(-12deg); }
}
@keyframes unsealTear {
  0% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
  40% { transform: translate(60rpx, -10rpx) rotate(-4deg); opacity: 1; }
  100% { transform: translate(620rpx, -90rpx) rotate(-14deg); opacity: 0; }
}
@keyframes unsealPull {
  0% { transform: translateY(0); z-index: 2; }
  70% { transform: translateY(-330rpx); z-index: 2; }
  71% { z-index: 7; }
  100% { transform: translateY(-300rpx); z-index: 7; }
}
@keyframes unsealUnfold {
  from { transform: rotateX(-178deg); }
  to { transform: rotateX(0deg); }
}
@media (prefers-reduced-motion: reduce) {
  .post-pack,
  .post-letter,
  .post-fold-bottom,
  .post-env-flap,
  .post-seal,
  .post-box,
  .post-box-flag,
  .unseal-env,
  .unseal-strip,
  .unseal-postmark,
  .unseal-letter,
  .unseal-half-bottom {
    animation-duration: 0.01s;
  }
}

/* 写信页：信笺铺满上半屏，邮戳和按钮贴在底部 */
.mail-write {
  padding-bottom: 380rpx;
}
.mail-paper-lined {
  padding: 32rpx 36rpx 28rpx;
  background-color: var(--app-paper);
  background-image:
    linear-gradient(rgba(184, 71, 47, 0.32), rgba(184, 71, 47, 0.32)),
    repeating-linear-gradient(180deg, rgba(255, 253, 248, 0) 0, rgba(255, 253, 248, 0) 63rpx, rgba(184, 71, 47, 0.18) 63rpx, rgba(184, 71, 47, 0.18) 64rpx);
  background-size: 100% 2rpx, 100% 64rpx;
  background-position: 0 24rpx, 0 32rpx;
  background-repeat: no-repeat, repeat-y;
  border-color: rgba(184, 71, 47, 0.2);
}
.mail-paper-to {
  display: block;
  height: 64rpx;
  line-height: 64rpx;
  font-family: var(--app-font-serif);
  font-size: 30rpx;
  color: var(--app-dawn-ink);
}
.mail-paper-lined .mail-textarea {
  display: block;
  box-sizing: border-box;
  width: 100%;
  min-height: 0;
  /* 一屏除去提示语、信笺抬头、底部邮戳和按钮，剩下的都给正文；行高和横格同为 64rpx */
  height: calc(100vh - 36rpx - 120rpx - 64rpx - 120rpx - 380rpx);
  min-height: 384rpx;
  padding: 0;
  font-size: 30rpx;
  line-height: 64rpx;
}
.mail-paper-lined .mail-count {
  margin-top: 0;
  height: 44rpx;
  line-height: 44rpx;
}
.mail-write-foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));
  background: var(--app-page-bg);
  border-top: 1rpx solid var(--app-border);
}
.mail-write-foot .mail-stamps {
  margin-top: 0;
}
.mail-write-foot .mail-stamps-label {
  margin-bottom: 14rpx;
}
.mail-write-foot .mail-stamp-item {
  flex-direction: row;
  justify-content: center;
  gap: 14rpx;
  padding: 12rpx 0;
}
.mail-write-foot .mail-stamp-item .app-seal-lg {
  width: 60rpx;
  height: 60rpx;
  font-size: 32rpx;
  border-radius: 14rpx;
}
.mail-write-foot .mail-actions {
  margin-top: 20rpx;
}

/* 投递动画里的信纸：大一号，两折——下半张沿折痕翻上来盖住上半张，再落进信封 */
.post-letter {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: -470rpx;
  height: 520rpx;
  z-index: 2;
  perspective: 1400rpx;
  animation: postLetterDrop 0.75s cubic-bezier(0.5, 0, 0.6, 1) 1.35s both;
}
.post-fold {
  position: absolute;
  left: 0;
  right: 0;
  height: 260rpx;
  box-sizing: border-box;
  padding: 34rpx 36rpx 0;
  background: var(--app-paper);
  background-image: repeating-linear-gradient(180deg, rgba(255, 253, 248, 0) 0, rgba(255, 253, 248, 0) 55rpx, rgba(184, 71, 47, 0.16) 55rpx, rgba(184, 71, 47, 0.16) 56rpx);
  box-shadow: 0 10rpx 24rpx rgba(84, 60, 30, 0.14);
}
.post-fold-top {
  top: 0;
  border-radius: 10rpx 10rpx 0 0;
}
.post-fold-bottom {
  top: 260rpx;
  border-radius: 0 0 10rpx 10rpx;
  transform-origin: 50% 0;
  animation: postFoldUp 1s cubic-bezier(0.45, 0, 0.3, 1) 0.3s forwards;
}
.post-fold-to {
  display: block;
  margin-bottom: 22rpx;
  font-family: var(--app-font-serif);
  font-size: 26rpx;
  color: var(--app-dawn-ink);
}
.post-fold .post-line {
  margin-bottom: 40rpx;
}
@keyframes postFoldUp {
  0% { transform: rotateX(0deg); background-color: #fffdf8; }
  50% { background-color: #f3e8d4; }
  100% { transform: rotateX(178deg); background-color: #efe2c8; }
}
@keyframes postLetterDrop {
  from { transform: translateY(0) scale(1); }
  to { transform: translateY(455rpx) scale(0.82); }
}

/* Features: 拆信后去纪念册 */
.mail-keepsake {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 36rpx;
  padding: 26rpx 28rpx;
  border-radius: var(--app-radius-md);
