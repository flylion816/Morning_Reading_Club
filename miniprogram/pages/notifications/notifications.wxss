/* Version 2 consistency polish: 来信页沿用统一的卡片、间距和印章规范。 */
/* Version 3 dawn: 来信页，以人为主，读伴的来信是暖色卡片。 */
.letters {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 80rpx;
  background: linear-gradient(180deg, var(--app-dawn-sky) 0%, #fdf0dd 300rpx, var(--app-page-bg) 560rpx);
}

.letters-head {
  padding: 12rpx 32rpx 20rpx;
}

.letters-title {
  display: block;
  color: var(--app-text);
  font-family: var(--app-font-serif);
  font-size: 40rpx;
  font-weight: 600;
}

.letters-sub {
  display: block;
  margin-top: 6rpx;
  color: var(--app-text-soft);
  font-size: var(--app-font-sm);
}

.letters-who {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.letters-who-av {
  padding: 3rpx;
  border-radius: 50%;
  background: var(--app-paper);
}

.letters-who-av + .letters-who-av {
  margin-left: -14rpx;
}

/* ---------- 筛选 ---------- */
.letters-chips {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 32rpx;
  margin-bottom: 4rpx;
}

.letters-chip {
  padding: 8rpx 24rpx;
  border-radius: 99rpx;
  border: 1rpx solid var(--app-border);
  background: var(--app-paper);
  color: var(--app-text-soft);
  font-size: var(--app-font-sm);
}

.letters-chip-on {
  background: var(--app-text);
  border-color: var(--app-text);
  color: #fff;
  font-weight: 600;
}

.letters-readall {
  margin-left: auto;
  color: var(--theme-primary);
  font-size: var(--app-font-sm);
  font-weight: 600;
}

.letters-readall-off {
  color: var(--app-text-muted);
  font-weight: 400;
}

.letters-day {
  margin: 28rpx 32rpx 12rpx;
  color: var(--app-text-muted);
  font-size: var(--app-font-xs);
}

/* ---------- 一张来信 ---------- */
.letter {
  display: flex;
  gap: 20rpx;
  margin: 0 24rpx 16rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--app-radius-md);
  border: 1rpx solid var(--app-border);
  background: var(--app-paper);
}

.letter-warm {
  background: var(--app-dawn-soft);
  border-color: rgba(184, 99, 31, 0.2);
}

.letter-avatar {
  position: relative;
  flex: none;
  width: 72rpx;
  height: 72rpx;
}

.letter-badge {
  position: absolute;
  right: -10rpx;
  bottom: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  border: 2rpx solid rgba(184, 99, 31, 0.35);
  background: var(--app-paper);
  color: var(--app-dawn-ink);
  font-family: var(--app-font-serif);
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
}

.letter-warm .letter-badge {
  background: var(--app-dawn);
  border-color: var(--app-paper);
  color: #fff;
}

.letter-stack {
  position: relative;
  flex: none;
  width: 72rpx;
  height: 72rpx;
}

.letter-stack-a,
.letter-stack-b {
  position: absolute;
  padding: 2rpx;
  border-radius: 50%;
  background: var(--app-paper);
}

.letter-stack-a { left: 0; top: 0; }
.letter-stack-b { right: 0; bottom: 0; }

.letter-seal {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  border: 1rpx solid var(--app-rule);
  background: var(--app-paper-muted);
  color: var(--app-dawn-ink);
  font-family: var(--app-font-serif);
  font-size: 32rpx;
  line-height: 70rpx;
  text-align: center;
}

.letter-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.letter-text {
  color: var(--app-text);
  font-size: 28rpx;
  line-height: 1.6;
}

.letter-lead {
  font-weight: 600;
}

.letter-quote {
  margin-top: 10rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid var(--app-dawn);
  color: var(--app-text-soft);
  font-family: var(--app-font-serif);
  font-size: 28rpx;
  line-height: 1.6;
}

.letter-btns {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.letter-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

.letter-btn-yes {
  background: var(--theme-primary);
  color: #fff;
}

.letter-btn-no {
  border: 1rpx solid var(--theme-primary-alpha-15);
  background: var(--app-paper);
  color: var(--theme-primary-dark);
}

.letter-done {
  margin-top: 12rpx;
  color: var(--app-text-muted);
  font-size: var(--app-font-sm);
}

.letter-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  color: var(--app-text-muted);
  font-size: var(--app-font-xs);
}

.letter-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--app-dawn);
}

.letter-go {
  margin-left: auto;
  color: var(--theme-primary);
  font-weight: 600;
}

/* ---------- 没有来信 / 加载 ---------- */
.letters-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 0;
}

.letters-empty-seal {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(184, 99, 31, 0.25);
  background: var(--app-dawn-soft);
  color: var(--app-dawn-ink);
  font-family: var(--app-font-serif);
  font-size: 52rpx;
  line-height: 126rpx;
  text-align: center;
}

.letters-empty-title {
  margin-top: 28rpx;
  font-family: var(--app-font-serif);
  font-size: 36rpx;
}

.letters-empty-desc {
  margin-top: 8rpx;
  color: var(--app-text-soft);
  font-size: var(--app-font-sm);
}

.letters-empty-btn {
  margin-top: 36rpx;
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: var(--app-action-radius);
  border: 1rpx solid var(--theme-primary-alpha-15);
  background: var(--app-paper);
  color: var(--theme-primary-dark);
  font-size: 28rpx;
  font-weight: 600;
}

.letters-loading {
  padding: 24rpx;
}

.dawn-skeleton-card {
  margin-bottom: 16rpx;
  padding: 26rpx;
  border-radius: var(--app-radius-md);
  background: var(--app-paper);
  border: 1rpx solid var(--app-border);
}

.letters-more {
  padding: 8rpx 24rpx;
}

.letters-more-btn {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: var(--app-action-radius);
  background: var(--app-paper);
  border: 1rpx solid var(--app-border);
  color: var(--theme-primary-dark);
  font-size: 28rpx;
}

.letters-more-btn::after {
  border: none;
}

.letters-end {
  padding: 32rpx 0 0;
  color: var(--app-text-muted);
  font-size: var(--app-font-xs);
  text-align: center;
}
