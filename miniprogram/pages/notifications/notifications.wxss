/**
 * 通知页面样式
 */

.notifications-container {
  background: var(--app-page-bg);
  min-height: 100vh;
  padding: 24rpx 0 40rpx;
}

.tab-badge {
  background: #ff5a5f;
  color: white;
  font-size: 18rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 90, 95, 0.24);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 24rpx;
  padding: 128rpx 32rpx;
  text-align: center;
  background: var(--app-paper);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--app-text);
  font-weight: 700;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--app-text-muted);
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 24rpx;
  padding: 100rpx 32rpx;
  background: var(--app-paper);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
}

.loading-text {
  color: var(--app-text-muted);
  font-size: 26rpx;
}

/* 选项卡 */
.tabs {
  display: flex;
  align-items: center;
  background: var(--app-surface-muted);
  border-radius: 16rpx;
  padding: 6rpx;
  margin: 0 24rpx 20rpx;
  gap: 4rpx;
}

.tab-item {
  flex: 1;
  height: 56rpx;
  padding: 0 6rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--app-text-soft);
  border-radius: 12rpx;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6rpx;
  line-height: 1;
  white-space: nowrap;
}

.tab-item.active {
  color: var(--theme-primary);
  background: var(--app-paper);
  box-shadow: 0 4rpx 12rpx rgba(60, 42, 20, 0.06);
}

.tab-action {
  color: var(--theme-primary);
  font-size: 22rpx;
}

.tab-action.disabled {
  color: var(--app-text-muted);
  opacity: 0.55;
}

/* 通知列表 */
.notifications-list {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.notification-item {
  display: flex;
  position: relative;
  background: var(--app-paper);
  margin: 0;
  padding: 24rpx;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.03);
  transition: all 0.2s ease;
  overflow: hidden;
}

.notification-item:active {
  transform: scale(0.99);
  background: var(--app-surface-muted);
}

.notification-item.unread {
  background: var(--app-surface-muted);
  border-left: 6rpx solid var(--theme-primary);
}

.notification-item.read {
  opacity: 0.82;
}

/* 通知内容 */
.notification-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

/* 通知标题 */
.notification-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.notification-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.type-icon {
  font-size: 32rpx;
  line-height: 1;
  flex-shrink: 0;
}

.type-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notification-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.action-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  font-size: 28rpx;
  color: var(--app-text-muted);
  background: var(--app-surface-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0;
}

.action-btn:active {
  opacity: 0.7;
}

.delete-btn {
  color: var(--app-text-muted);
}

/* 通知消息 */
.notification-message {
  font-size: 28rpx;
  color: var(--app-text-soft);
  line-height: 1.5;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 发送者信息 */
.sender-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 2rpx;
}

.sender-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--app-border);
  flex-shrink: 0;
}

.sender-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-primary);
  color: white;
  font-size: 20rpx;
  font-weight: 600;
}

.sender-avatar-text {
  color: #fff;
  font-size: 24rpx;
}

.sender-name {
  font-size: 26rpx;
  color: var(--app-text-muted);
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 通知底部 */
.notification-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 2rpx;
  font-size: 24rpx;
  gap: 16rpx;
}

.notification-footer-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.notification-status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--theme-primary);
  box-shadow: 0 0 0 6rpx var(--theme-primary-alpha-12);
  flex-shrink: 0;
}

.time {
  color: var(--app-text-muted);
}

.notification-action-hint {
  color: var(--theme-primary);
  font-size: 24rpx;
  font-weight: 600;
  background: var(--app-paper-muted);
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  line-height: 1;
  flex-shrink: 0;
}

/* 分页 */
.pagination {
  padding: 30rpx 24rpx;
  display: flex;
  justify-content: center;
}

.load-more-btn {
  width: 100%;
  max-width: 320rpx;
  height: 72rpx;
  background: var(--theme-primary);
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 6rpx 18rpx var(--theme-primary-alpha-28);
}

.load-more-btn::after {
  border: none;
}

.load-more-btn:active {
  opacity: 0.8;
}

/* 没有更多 */
.no-more {
  padding: 34rpx 30rpx 12rpx;
  text-align: center;
  color: var(--app-text-muted);
  font-size: 26rpx;
}

/* 响应式设计 */
@media (min-width: 768px) {
  .notification-item {
    max-width: 600rpx;
  }

  .tabs,
  .notifications-list,
  .empty-state,
  .loading-state {
    max-width: 648rpx;
    margin-left: auto;
    margin-right: auto;
  }
}

/* Version 2 consistency polish: notification inbox. */
.notifications-container {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}
.tabs {
  border-radius: 999rpx;
  background: var(--app-paper);
  box-shadow: var(--app-shadow-soft);
}
.tab-item.active {
  background: var(--theme-primary);
  color: #fff;
}
.notification-item {
  border-radius: var(--app-radius-lg);
  border-color: rgba(92, 70, 44, 0.07);
  box-shadow: var(--app-shadow-soft);
}
.tab-item:active,
.notification-item:active,
.action-btn:active {
  transform: translateY(2rpx) scale(0.99);
}


/* Version 3 dawn: 空态图标。 */
.app-empty { margin: 80rpx 24rpx 0; }

.dawn-skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0;
  box-sizing: border-box;
  width: 100%;
}

.dawn-skeleton-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 28rpx;
  border-radius: var(--app-radius-md);
  background: var(--app-paper);
}

.dawn-sk-w60 { width: 60%; }
.dawn-sk-w90 { width: 90%; }
.dawn-sk-w40 { width: 40%; }
.loading-state { display: block; padding: 0; background: transparent; box-shadow: none; }

/* Features: 新通知类型使用印章字作图标 */
.type-icon {
  font-family: var(--app-font-serif);
  font-weight: 700;
}
