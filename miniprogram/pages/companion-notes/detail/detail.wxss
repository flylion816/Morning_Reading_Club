/* Version 3 dawn: companion notes use the shared paper, dawn and ink tokens. */
.companion-detail-page {
  min-height: 100vh;
  padding-bottom: calc(54rpx + env(safe-area-inset-bottom));
  background: var(--app-page-bg);
}

.companion-detail-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 32rpx 28rpx;
  background: radial-gradient(circle at 50% 190rpx, var(--app-dawn-glow), transparent 300rpx), linear-gradient(180deg, var(--app-dawn-sky), var(--app-page-bg) 82%);
  text-align: center;
}

.companion-detail-chip {
  padding: 4rpx 18rpx;
  border: 1rpx solid rgba(184, 99, 31, 0.2);
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.72);
  color: var(--app-dawn-ink);
  font-size: 22rpx;
}

.companion-book-stack {
  position: relative;
  width: 236rpx;
  height: 350rpx;
  margin: 26rpx auto 12rpx;
}

.companion-book-shadow {
  position: absolute;
  inset: 0;
  border-radius: 8rpx;
  background: #f8f2e6;
  box-shadow: 0 8rpx 18rpx rgba(70, 48, 22, 0.12);
}

.companion-book-shadow.shadow-a {
  transform: rotate(-6deg) translate(-14rpx, 8rpx);
}

.companion-book-shadow.shadow-b {
  transform: rotate(4deg) translate(14rpx, 6rpx);
  background: #fbf7ee;
}

.companion-detail-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  box-shadow: 0 18rpx 36rpx rgba(70, 48, 22, 0.24);
}

.companion-detail-title {
  display: block;
  color: var(--app-text);
  font-family: var(--app-font-serif);
  font-size: 42rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
  line-height: 1.35;
}

.companion-detail-meta {
  display: block;
  margin-top: 6rpx;
  color: var(--app-text-muted);
  font-size: 23rpx;
}

.companion-detail-summary {
  display: block;
  max-width: 640rpx;
  margin-top: 12rpx;
  color: var(--app-text-soft);
  font-size: 26rpx;
  line-height: 1.7;
}

.companion-detail-actions {
  display: flex;
  gap: 16rpx;
  padding: 0 28rpx;
  margin-top: -4rpx;
}

.companion-open-btn,
.companion-like-btn {
  min-height: 78rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
}

.companion-open-btn {
  flex: 1;
  gap: 10rpx;
}

.companion-open-btn .app-icon {
  width: 34rpx;
  height: 34rpx;
}

.companion-like-btn {
  display: flex;
  flex: 0 0 220rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid rgba(184, 99, 31, 0.32);
  background: var(--app-paper);
  color: var(--app-dawn-ink);
  font-weight: 650;
}

.companion-like-btn .app-icon {
  width: 32rpx;
  height: 32rpx;
  color: var(--app-dawn);
}

.companion-like-on {
  background: var(--app-dawn-soft);
}

.companion-btn-disabled {
  opacity: 0.58;
  pointer-events: none;
}

.companion-download-card {
  margin: 20rpx 28rpx 0;
  padding: 20rpx 22rpx;
}

.companion-download-head,
.companion-download-foot,
.companion-composer-foot,
.companion-composer-head,
.companion-comments-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.companion-download-head {
  color: var(--app-text);
  font-size: 25rpx;
  font-weight: 650;
}

.companion-download-bar {
  height: 10rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #efe6d6;
}

.companion-download-bar view {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--app-dawn), #f5b871);
}

.companion-download-foot {
  margin-top: 8rpx;
  color: var(--app-text-muted);
  font-size: 21rpx;
}

.companion-download-cancel,
.companion-download-error {
  color: var(--theme-primary);
}

.companion-download-error {
  margin: 16rpx 28rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--app-danger-soft);
  font-size: 24rpx;
  text-align: center;
}

.companion-proof {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 34rpx 0;
  color: var(--app-text-soft);
  font-size: 22rpx;
}

.companion-proof-avatars {
  display: flex;
  min-width: 48rpx;
}

.companion-proof-avatar {
  margin-left: -8rpx;
}

.companion-proof-avatar:first-child {
  margin-left: 0;
}

.companion-comments-card {
  margin: 22rpx 28rpx 0;
  padding: 8rpx 0 0;
}

.companion-comments-heading {
  padding: 18rpx 24rpx 14rpx;
}

.companion-comments-title {
  color: var(--app-text);
  font-family: var(--app-font-serif);
  font-size: 34rpx;
  font-weight: 650;
}

.companion-comments-count {
  flex: 1;
  margin-left: 12rpx;
  color: var(--app-text-muted);
  font-size: 22rpx;
}

.companion-comments-write {
  color: var(--theme-primary);
  font-size: 23rpx;
  font-weight: 650;
}

.companion-comment {
  display: flex;
  gap: 14rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid var(--app-border);
}

.companion-comment-pinned {
  background: linear-gradient(180deg, var(--app-dawn-soft), rgba(255, 253, 248, 0));
}

.companion-comment-body {
  flex: 1;
  min-width: 0;
}

.companion-comment-head,
.companion-reply-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.companion-comment-author,
.companion-reply-author {
  color: var(--app-text);
  font-size: 25rpx;
  font-weight: 650;
}

.companion-comment-time {
  margin-left: auto;
  color: var(--app-text-muted);
  font-size: 20rpx;
}

.companion-tag {
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-tint);
  color: var(--theme-primary-dark);
  font-size: 18rpx;
  font-weight: 650;
}

.companion-tag-pinned {
  background: var(--app-dawn);
  color: #fff;
}

.companion-comment-text,
.companion-reply-text {
  display: block;
  margin-top: 7rpx;
  color: var(--app-text);
  font-family: var(--app-font-serif);
  font-size: 27rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.companion-comment-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
}

.companion-comment-action {
  color: var(--app-text-muted);
  font-size: 21rpx;
}

.companion-action-liked {
  color: #d4583c;
}

.companion-reply {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: var(--app-paper-muted);
}

.companion-comments-empty {
  padding: 54rpx 24rpx;
  color: var(--app-text-muted);
  font-size: 24rpx;
  text-align: center;
}

.companion-sheet-mask {
  position: fixed;
  z-index: 900;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: var(--app-overlay);
}

.companion-post-read-sheet,
.companion-composer-sheet {
  width: 100%;
  padding: 34rpx 30rpx calc(26rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: var(--app-paper);
  box-sizing: border-box;
}

.companion-sheet-title {
  display: block;
  color: var(--app-text);
  font-family: var(--app-font-serif);
  font-size: 36rpx;
  font-weight: 650;
}

.companion-sheet-subtitle {
  display: block;
  margin-top: 6rpx;
  color: var(--app-text-muted);
  font-size: 23rpx;
}

.companion-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
}

.companion-suggestion {
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(184, 99, 31, 0.26);
  border-radius: 999rpx;
  background: var(--app-dawn-soft);
  color: var(--app-dawn-ink);
  font-size: 23rpx;
}

.companion-sheet-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.companion-sheet-later,
.companion-sheet-write {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 74rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 650;
}

.companion-sheet-later {
  border: 1rpx solid var(--app-border);
  color: var(--app-text-soft);
}

.companion-sheet-write {
  background: var(--theme-primary);
  color: #fff;
}

.companion-composer-head {
  margin-bottom: 18rpx;
}

.companion-sheet-close {
  padding: 0 8rpx;
  color: var(--app-text-soft);
  font-size: 44rpx;
  line-height: 1;
}

.companion-composer-input {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx;
  border: 1rpx solid var(--app-border);
  border-radius: 18rpx;
  background: var(--app-paper-muted);
  color: var(--app-text);
  font-family: var(--app-font-serif);
  font-size: 28rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

.companion-composer-foot {
  margin-top: 14rpx;
  color: var(--app-text-muted);
  font-size: 22rpx;
}

.companion-composer-submit {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--theme-primary);
  color: #fff;
  font-size: 25rpx;
  font-weight: 650;
}

.companion-detail-skeleton {
  height: 520rpx;
  margin: 20rpx 28rpx;
}

.companion-detail-empty,
.companion-detail-error {
  margin: 70rpx 28rpx 0;
}
