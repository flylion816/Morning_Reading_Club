.page-profile-others {
  min-height: 100vh;
  background: var(--app-page-bg);
  padding: 24rpx;
}

.user-card {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: white;
  padding: 40rpx 32rpx;
  border-radius: 16rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.user-avatar-wrapper {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-avatar-emoji {
  font-size: 60rpx;
  color: #fff;
  font-weight: 600;
}

.user-avatar-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: block;
}

.user-nickname {
  font-weight: bold;
  font-size: 32rpx;
  margin-bottom: 12rpx;
}

.user-signature {
  font-size: 26rpx;
  opacity: 0.9;
}

.stats-card {
  background: var(--app-paper);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.stats-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.stats-icon {
  font-size: 32rpx;
}

.stats-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--app-text);
}

.stats-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.stats-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.stats-label {
  font-size: 26rpx;
  color: var(--app-text-soft);
}

.stats-value {
  font-size: 26rpx;
  color: var(--app-text);
  font-weight: 500;
}

/* 小凡看见卡片 */
.insights-card {
  background: var(--app-paper);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.insights-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.insights-icon {
  font-size: 32rpx;
}

.insights-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--app-text);
}

.insights-content {
  background: var(--app-surface-muted);
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 6rpx solid var(--theme-primary);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.insights-link {
  font-size: 26rpx;
  color: var(--theme-primary);
  font-weight: bold;
}

.insights-desc {
  font-size: 24rpx;
  color: var(--app-text-soft);
  line-height: 1.6;
}

/* 返回按钮 */
.back-btn {
  background: var(--app-paper);
  border-radius: 48rpx;
  padding: 20rpx 40rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.back-btn text {
  font-size: 28rpx;
  color: var(--theme-primary);
  font-weight: 500;
}

/* Version 2 consistency polish: other member profile. */
.page-profile-others {
  min-height: 100vh;
  background:
    radial-gradient(circle at 88% 0%, var(--theme-primary-alpha-08) 0, rgba(255, 255, 255, 0) 300rpx),
    linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}
.user-card,
.stats-card,
.insights-card {
  border-radius: var(--app-radius-lg);
  border-color: rgba(92, 70, 44, 0.07);
  box-shadow: var(--app-shadow-soft);
}
.back-btn {
  border-radius: var(--app-radius-md);
}
.insights-link:active,
.back-btn:active {
  transform: translateY(2rpx) scale(0.98);
}


/* Version 3 dawn: 昵称衬线，卡片标题印章。 */
.user-nickname {
  font-family: var(--app-font-serif);
}
.stats-icon.app-seal,
.insights-icon.app-seal {
  font-size: 20rpx;
}
