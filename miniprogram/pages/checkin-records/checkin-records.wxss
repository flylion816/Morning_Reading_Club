.page-checkin-records {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--theme-primary-tint) 0%, var(--app-page-bg) 42%, var(--app-page-bg-deep) 100%);
  padding: 24rpx;
  box-sizing: border-box;
}

.hero-card {
  padding: 28rpx 28rpx 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--app-paper) 0%, var(--theme-primary-tint) 100%);
  box-shadow: 0 16rpx 40rpx var(--theme-primary-alpha-08);
}

.hero-user {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.hero-avatar-wrap {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-light) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-avatar-image {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
}

.hero-avatar-text {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-user-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--app-text);
}

.hero-user-subtitle {
  font-size: 24rpx;
  color: var(--app-text-muted);
}

.hero-stats {
  margin-top: 24rpx;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  padding: 10rpx 8rpx 0;
}

.hero-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.hero-stat-divider {
  width: 1rpx;
  background: var(--theme-primary-alpha-12);
  margin: 4rpx 20rpx 0;
}

.hero-stat-value {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 700;
  color: var(--theme-primary);
}

.hero-stat-label {
  font-size: 24rpx;
  color: var(--app-text-muted);
}

.section-block {
  margin-top: 24rpx;
  padding-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--app-text);
  margin: 4rpx 2rpx 18rpx;
}

.period-scroll {
  width: 100%;
  white-space: nowrap;
  box-sizing: border-box;
}

.period-scroll-inner {
  display: flex;
  gap: 18rpx;
  align-items: stretch;
  padding: 6rpx 2rpx 18rpx;
  box-sizing: border-box;
}

.period-card {
  width: 286rpx;
  min-height: 110rpx;
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx;
  border-radius: 24rpx;
  background: var(--app-paper);
  border: 2rpx solid transparent;
  box-shadow: 0 10rpx 26rpx rgba(60, 42, 20, 0.06);
  box-sizing: border-box;
}

.period-card-active {
  border-color: var(--theme-primary);
  box-shadow: 0 16rpx 36rpx var(--theme-primary-alpha-16);
}

.period-card-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.period-card-icon-text {
  font-size: 38rpx;
}

.period-card-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.period-card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text);
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.period-card-subtitle {
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--app-text-muted);
}

.selected-period-banner {
  margin: 10rpx 0 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, var(--app-paper) 0%, var(--theme-primary-tint) 100%);
  border: 1rpx solid var(--theme-primary-alpha-12);
  display: flex;
  align-items: center;
  gap: 22rpx;
  box-sizing: border-box;
}

.selected-period-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.selected-period-icon-text {
  font-size: 36rpx;
}

.selected-period-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-left: 4rpx;
}

.selected-period-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--app-text);
}

.selected-period-line {
  font-size: 22rpx;
  color: var(--app-text-soft);
}

.selected-period-arrow {
  font-size: 36rpx;
  color: var(--app-disabled);
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.record-row {
  display: flex;
  gap: 16rpx;
}

.record-date-col {
  width: 72rpx;
  flex-shrink: 0;
  padding-top: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.record-day {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 700;
  color: var(--app-text);
}

.record-month {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--app-text-muted);
}

.record-card {
  flex: 1;
  padding: 22rpx 22rpx 20rpx;
  border-radius: 24rpx;
  background: var(--app-paper);
  box-shadow: 0 10rpx 24rpx rgba(60, 42, 20, 0.06);
}

.record-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.record-avatar-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.record-avatar-image {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.record-avatar-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 700;
}

.record-header-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.record-user-name {
  font-size: 28rpx;
  color: var(--app-text);
  font-weight: 700;
}

.record-header-subtitle {
  font-size: 22rpx;
  color: var(--app-text-muted);
}

.record-more {
  color: var(--app-disabled);
  font-size: 36rpx;
  line-height: 1;
}

.record-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--app-text);
  white-space: pre-wrap;
  word-break: break-word;
}

.record-content-empty {
  color: var(--app-text-muted);
}

.record-footer {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-meta {
  font-size: 22rpx;
  color: var(--app-text-muted);
}

.record-meta-group {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.record-image-count {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-tint);
  color: var(--theme-primary);
  font-size: 20rpx;
  line-height: 1.4;
}

.record-like {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--app-text-muted);
}

.record-like-icon {
  font-size: 24rpx;
  color: #ea4f4f;
}

.record-like-count {
  font-size: 22rpx;
}

.empty-state {
  margin-top: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 40rpx 0 28rpx;
}

.empty-state-icon {
  font-size: 64rpx;
}

.empty-state-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text);
}

.empty-state-desc {
  font-size: 24rpx;
  color: var(--app-text-muted);
  text-align: center;
  line-height: 1.6;
}

.load-more {
  text-align: center;
  font-size: 22rpx;
  color: var(--app-text-muted);
  padding: 16rpx 0 8rpx;
}

.diary-search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 0 16rpx;
}

.diary-search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--app-paper);
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 8rpx rgba(60, 42, 20, 0.06);
}

.diary-search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--app-text);
  height: 72rpx;
  line-height: 72rpx;
}

.diary-search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--app-disabled);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  line-height: 1;
}

.diary-search-btn {
  background: var(--theme-primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 40rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.highlight-keyword {
  color: #e05c00;
  font-weight: 700;
}

.search-loading {
  text-align: center;
  font-size: 26rpx;
  color: var(--app-text-muted);
  padding: 40rpx 0;
}

/* Version 2 consistency polish: checkin diary. */
.page-checkin-records {
  min-height: 100vh;
  background:
    radial-gradient(circle at 88% 0%, var(--theme-primary-alpha-08) 0, rgba(255, 255, 255, 0) 300rpx),
    linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}
.hero-card,
.section-block,
.period-card {
  border-radius: var(--app-radius-lg);
  border-color: var(--app-border);
  box-shadow: var(--app-shadow-soft);
}
.period-card {
  border-radius: var(--app-radius-md);
}
.period-card-active {
  background: var(--theme-primary-tint);
  border-color: var(--theme-primary-alpha-20);
}
.record-card:active,
.period-card:active {
  transform: translateY(2rpx) scale(0.99);
}

/* Version 3 dawn: 暖纸色、衬线课程标题、数字字体、线性图标 */
.hero-stat-value,
.record-day {
  font-family: var(--app-font-num);
}
.record-header-subtitle {
  font-family: var(--app-font-serif);
}
.empty-state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  color: var(--app-text-muted);
}
.empty-state-icon .app-icon {
  width: 64rpx;
  height: 64rpx;
}

.app-empty { margin: 80rpx 24rpx 0; }

.dawn-skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0;
  box-sizing: border-box;
  width: 100%;
}

.dawn-skeleton-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 28rpx;
  border-radius: var(--app-radius-md);
  background: var(--app-paper);
}

.dawn-sk-w60 { width: 60%; }
.dawn-sk-w90 { width: 90%; }
.dawn-sk-w40 { width: 40%; }

/* Features: 打卡心情天气小标签 */
.record-mood {
  display: inline-block;
  margin-top: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--app-line, #e8dfd0);
  font-size: 20rpx;
  color: var(--app-text-muted);
}

/* 心情天气用图标加一个字。 */
.record-mood {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  border: none;
  padding: 0;
  color: var(--app-dawn-ink);
}
.record-mood-icon.app-icon {
  width: 28rpx;
  height: 28rpx;
}
