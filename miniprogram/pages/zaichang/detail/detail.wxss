page {
  --zc-bg: var(--app-page-bg);
  --zc-primary: #2D5A3D;
  --zc-accent: var(--app-dawn-deep);
  --zc-text: var(--app-text);
  --zc-text-secondary: var(--app-text-muted);
  --theme-primary: #2D5A3D;
  --theme-primary-dark: #234a31;
  --theme-primary-light: #4a7a5b;
  --theme-primary-tint: #e9f0ea;
  --theme-primary-soft: rgba(45, 90, 61, 0.14);
  --theme-primary-shadow: rgba(45, 90, 61, 0.3);
  --theme-primary-alpha-05: rgba(45, 90, 61, 0.05);
  --theme-primary-alpha-08: rgba(45, 90, 61, 0.08);
  --theme-primary-alpha-12: rgba(45, 90, 61, 0.12);
  --theme-primary-alpha-15: rgba(45, 90, 61, 0.15);
  --theme-primary-alpha-20: rgba(45, 90, 61, 0.2);
  --theme-primary-alpha-30: rgba(45, 90, 61, 0.3);
  background-color: var(--zc-bg);
}

.detail-page { background: var(--zc-bg); min-height: 100vh; padding-bottom: 140rpx; }

/* 图片区 */
.media-section { width: 100%; background: var(--zc-bg); }
.media-single { width: 100%; display: block; margin-bottom: 8rpx; }
.media-grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 4rpx; }
.media-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4rpx; }
.media-grid-item { position: relative; width: 100%; padding-top: 100%; overflow: hidden; }
.media-grid-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.media-more-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; }
.media-more-text { color: #fff; font-size: 32rpx; font-weight: bold; }

/* 徽章 */
.badge-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; }
.badge { display: inline-block; padding: 6rpx 18rpx; border-radius: 20rpx; font-size: 22rpx; color: #fff; }
.badge-reading { background: #2D5A3D; }
.badge-cooking { background: var(--zc-accent); }
.badge-tea { background: #8B6355; }
.badge-walk { background: #4A7FA5; }
.badge-create { background: #7B5EA7; }
.badge-other { background: #888888; }

/* 基本信息 */
.main-info { padding: 8rpx 24rpx 24rpx; background: var(--app-paper); margin-bottom: 16rpx; }
.meta-row { display: flex; align-items: center; margin-bottom: 12rpx; }
.date, .dot, .location { font-size: 24rpx; color: var(--zc-text-secondary); }
.title { font-family: var(--app-font-serif); display: block; font-size: 36rpx; font-weight: 700; color: var(--zc-text); margin-bottom: 12rpx; line-height: 1.4; }
.desc { display: block; font-size: 28rpx; color: var(--app-text-soft); line-height: 1.6; }

/* 通用 section */
.section { background: var(--app-paper); margin-bottom: 16rpx; padding: 24rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-title { font-size: 28rpx; font-weight: 600; color: var(--zc-text); }
.toggle-btn { font-size: 24rpx; color: var(--zc-primary); }

/* 在场人 */
.attendees-wall { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 24rpx; }
.att-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; width: 80rpx; }
.att-avatar-wrap { width: 72rpx; height: 72rpx; border-radius: 50%; overflow: hidden; }
.att-avatar { width: 100%; height: 100%; }
.att-avatar-text { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--zc-primary); color: #fff; font-size: 26rpx; display: grid; place-items: center; line-height: normal; text-align: center; overflow: hidden; }
.avatar-initial { display: block; width: 100%; line-height: 1; text-align: center; }
.att-name { font-size: 20rpx; color: var(--zc-text-secondary); text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; width: 80rpx; }
.attend-btn-wrap { display: flex; justify-content: center; }
.attend-btn { padding: 16rpx 48rpx; border-radius: 40rpx; border: 2rpx solid var(--zc-primary); color: var(--zc-primary); font-size: 28rpx; }
.attend-btn.attending { background: var(--zc-primary); color: #fff; border-color: var(--zc-primary); }

/* 共鸣 */
.reaction-list { display: flex; gap: 20rpx; }
.reaction-btn { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 20rpx 0; border-radius: 16rpx; background: var(--app-page-bg); gap: 6rpx; }
.reaction-emoji { font-size: 36rpx; }
.reaction-label { font-size: 22rpx; color: var(--zc-text-secondary); }
.reaction-count { font-size: 24rpx; font-weight: 600; color: var(--zc-text); }
.active-gonming { background: var(--theme-primary-tint); }
.active-ran { background: #FFF0E0; }
.active-xiangqu { background: #FFF5E8; }

/* 评论 */
.comment-list { margin-top: 16rpx; }
.comment-item { display: flex; gap: 16rpx; margin-bottom: 28rpx; }
.comment-avatar-wrap { flex-shrink: 0; }
.comment-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; }
.comment-avatar-text { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--zc-accent); color: #fff; font-size: 24rpx; display: grid; place-items: center; line-height: normal; text-align: center; overflow: hidden; }
.comment-body { flex: 1; }
.comment-author { display: block; font-size: 24rpx; font-weight: 600; color: var(--zc-text); margin-bottom: 6rpx; }
.comment-content { font-size: 28rpx; color: var(--zc-text); line-height: 1.5; margin-bottom: 8rpx; }
.reply-to { color: var(--zc-primary); }
.comment-actions { display: flex; gap: 24rpx; align-items: center; }
.comment-time { font-size: 22rpx; color: var(--zc-text-secondary); }
.reply-btn { font-size: 22rpx; color: var(--zc-primary); }
.delete-btn { font-size: 22rpx; color: #e74c3c; }
.no-comment { text-align: center; font-size: 26rpx; color: var(--zc-text-secondary); padding: 40rpx 0; }

/* 底部输入框 */
.input-bar { position: fixed; bottom: 0; left: 0; right: 0; background: var(--app-paper); border-top: 1rpx solid var(--app-border); padding: 16rpx 24rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); z-index: 100; }
.reply-hint { display: flex; justify-content: space-between; align-items: center; font-size: 24rpx; color: var(--zc-primary); margin-bottom: 12rpx; }
.clear-reply { color: var(--zc-text-secondary); padding: 0 8rpx; }
.input-row { display: flex; gap: 16rpx; align-items: center; }
.comment-input { flex: 1; background: var(--app-page-bg); border-radius: 40rpx; padding: 16rpx 24rpx; font-size: 28rpx; }
.send-btn { padding: 16rpx 28rpx; border-radius: 40rpx; background: var(--app-border); color: var(--app-text-muted); font-size: 26rpx; white-space: nowrap; }
.send-btn.active { background: var(--zc-primary); color: #fff; }
.edit-btn { padding: 16rpx 28rpx; border-radius: 40rpx; background: var(--app-page-bg); color: var(--zc-primary); font-size: 26rpx; white-space: nowrap; border: 2rpx solid var(--zc-primary); }
.delete-imprint-btn { padding: 16rpx 28rpx; border-radius: 40rpx; background: #FFF0F0; color: #e74c3c; font-size: 26rpx; white-space: nowrap; border: 2rpx solid #e74c3c; }

.loading-page { display: flex; justify-content: center; align-items: center; height: 60vh; font-size: 28rpx; color: var(--zc-text-secondary); }

.share-cover-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 500px;
  height: 400px;
  opacity: 0;
  pointer-events: none;
}

/* Version 2 consistency polish: unified imprint detail. */
.detail-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 88% 0%, rgba(45, 90, 61, 0.10) 0, rgba(255, 255, 255, 0) 300rpx),
    var(--zc-bg);
}
.main-info,
.section {
  border-radius: var(--app-radius-lg);
  background: linear-gradient(180deg, var(--app-paper), var(--app-paper-muted));
  border-color: rgba(92, 70, 44, 0.07);
  box-shadow: var(--app-shadow-soft);
}
.badge {
  border-radius: 999rpx;
}
.action-btn,
.comment-submit {
  border-radius: var(--app-radius-md);
}
.action-btn:active,
.comment-submit:active {
  transform: translateY(2rpx) scale(0.98);
}

/* Version 3 dawn: paper-colored top, seal reactions. */
.reaction-btn { background: var(--app-page-bg); }
.reaction-seal { opacity: 0.6; }
.reaction-count { font-family: var(--app-font-num); }
.active-gonming, .active-ran, .active-xiangqu { background: var(--theme-primary-tint); }
.reaction-seal.reaction-on { opacity: 1; background: var(--zc-primary); color: #fff; border-color: var(--zc-primary); }
.main-info, .section { background: var(--app-paper); }

/* 邮戳：盖在头图右下角，不拦截点击 */
.media-section { position: relative; }
.zc-mark {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  width: 135rpx;
  height: 135rpx;
  border-radius: 50%;
  border: 4rpx dashed rgba(255, 253, 248, 0.95);
  background: rgba(45, 90, 61, 0.84);
  color: #fffdf8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transform: rotate(-10deg);
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.2);
  pointer-events: none;
  z-index: 2;
}
.zc-mark-date { font-family: var(--app-font-num); font-size: 31rpx; line-height: 1.15; }
.zc-mark-place { font-size: 22rpx; line-height: 1.15; letter-spacing: 0.12em; text-indent: 0.12em; }

/* 区块标题衬线，评论删除用语义色 */
.section-title { font-family: var(--app-font-serif); }
.section-count { font-family: var(--app-font-num); color: var(--zc-text-secondary); font-weight: 400; }
.delete-btn { color: var(--app-danger); }
.main-info, .section { background: var(--app-paper); }
