<view class="page-bg" wx:if="{{socialAccessGranted}}">
  <scroll-view class="type-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="type-list">
      <view
        wx:for="{{typeList}}"
        wx:key="key"
        class="type-chip {{activeType === item.key ? 'active' : ''}}"
        bindtap="onTypeChange"
        data-type="{{item.key}}"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="list">
    <block wx:if="{{list.length === 0 && !loading}}">
      <view class="app-empty">
        <view class="app-empty-art app-empty-art-sprout"></view>
        <text class="app-empty-title">还没有印记，留下第一个吧</text>
      </view>
    </block>

    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="imprint-card"
      bindtap="onTapCard"
      data-id="{{item._id}}"
    >
      <view class="cover">
        <block wx:if="{{item.mediaList && item.mediaList.length > 0}}">
          <block wx:if="{{item.mediaList.length === 1}}">
            <block wx:if="{{item.mediaList[0].type === 'video'}}">
              <view class="cover-video-wrap" catchtap="onTapMedia" data-item="{{item}}" data-index="0">
                <video
                  id="video-{{item._id}}"
                  class="cover-video"
                  src="{{item.mediaList[0].url}}"
                  object-fit="cover"
                  controls="{{false}}"
                  show-play-btn="{{false}}"
                  enable-play-gesture="{{false}}"
                  autoplay="{{false}}"
                  muted
                />
                <view class="video-play-badge">▶</view>
              </view>
            </block>
            <block wx:else>
              <view class="cover-single {{item._coverPortrait ? 'cover-single-portrait' : 'cover-single-landscape'}}" catchtap="onTapMedia" data-item="{{item}}" data-index="0">
                <image class="cover-single-img" src="{{item.mediaList[0].url}}" mode="aspectFill" lazy-load/>
              </view>
            </block>
          </block>
          <block wx:else>
            <view class="cover-grid cover-grid-{{item._gridCols}}">
              <block wx:for="{{item.mediaList}}" wx:for-item="img" wx:key="index" wx:if="{{index < 9}}">
                <view class="cover-grid-item" catchtap="onTapMedia" data-item="{{item}}" data-index="{{index}}">
                  <block wx:if="{{img.type === 'video'}}">
                    <video class="cover-grid-img" src="{{img.url}}" object-fit="cover" controls="{{false}}" show-play-btn="{{false}}" enable-play-gesture="{{false}}" autoplay="{{false}}" muted/>
                    <view class="video-play-badge small">▶</view>
                  </block>
                  <block wx:else>
                    <image class="cover-grid-img" src="{{img.url}}" mode="aspectFill" lazy-load/>
                  </block>
                  <view wx:if="{{index === 8 && item.mediaList.length > 9}}" class="more-overlay">
                    <text class="more-text">+{{item.mediaList.length - 9}}</text>
                  </view>
                </view>
              </block>
            </view>
          </block>
        </block>
        <view wx:if="{{item._stampDate}}" class="zc-mark">
          <text class="zc-mark-date">{{item._stampDate}}</text>
          <text wx:if="{{item._stampPlace}}" class="zc-mark-place">{{item._stampPlace}}</text>
        </view>
      </view>

      <view class="info">
        <text class="title">{{item.title}}</text>
        <text wx:if="{{item.description}}" class="desc">{{item.description}}</text>
      </view>

      <view wx:if="{{item.attendees && item.attendees.length > 0}}" class="attendees">
        <block wx:for="{{item.attendees}}" wx:for-item="att" wx:key="index" wx:if="{{index < 8}}">
          <view class="avatar-wrap">
            <user-avatar
              size="56"
              avatar-url="{{att.avatarUrl}}"
              avatar-text="{{att.avatar || att.name || '?'}}"
            />
          </view>
        </block>
        <text class="attendees-more">{{item.attendees.length}} 人在场</text>
      </view>

      <view class="footer">
        <view class="author">
          <text class="author-name">{{item.author && item.author.nickname}}{{item._stampDate ? ' 留下' : ''}}</text>
          <text wx:if="{{!item._stampDate}}" class="author-meta">{{item._happenedAtFormatted}}{{item.location ? ' · ' + item.location : ''}}</text>
        </view>
        <view class="stats">
          <view class="stat-item"><view class="app-seal app-seal-sm">鸣</view><text>{{item._totalReactions}}</text></view>
          <view class="stat-item"><view class="app-icon app-icon-comment"></view><text>{{item.commentCount}}</text></view>
        </view>
      </view>
    </view>

    <view wx:if="{{loading && list.length === 0}}" class="loading-skeleton">
      <view class="dawn-skeleton-list">
        <view class="dawn-skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
          <view class="app-skeleton-line dawn-sk-w60"></view>
          <view class="app-skeleton-line dawn-sk-w90"></view>
          <view class="app-skeleton-line dawn-sk-w40"></view>
        </view>
      </view>
    </view>
    <view wx:elif="{{loading}}" class="loading-tip">稍等一下…</view>
    <view wx:if="{{!hasMore && list.length > 0}}" class="no-more">已经到底了</view>
  </view>

  <view class="fab" bindtap="onTapPublish">
    <text class="fab-icon">+</text>
    <text class="fab-text">留下印记</text>
  </view>
  <canvas
    id="shareCoverCanvas"
    canvas-id="shareCoverCanvas"
    type="2d"
    class="share-cover-canvas"></canvas>
</view>
