/* 在场频道色彩系统 */
page {
  --zc-bg: var(--app-page-bg);
  --zc-primary: #2D5A3D;
  --zc-accent: var(--app-dawn-deep);
  --zc-text: var(--app-text);
  --zc-text-secondary: var(--app-text-muted);
  --zc-card-bg: var(--app-paper);
  --zc-radius-card: 24rpx;
  --zc-radius-img: 16rpx;
  --theme-primary: #2D5A3D;
  --theme-primary-dark: #234a31;
  --theme-primary-light: #4a7a5b;
  --theme-primary-tint: #e9f0ea;
  --theme-primary-soft: rgba(45, 90, 61, 0.14);
  --theme-primary-shadow: rgba(45, 90, 61, 0.3);
  --theme-primary-alpha-05: rgba(45, 90, 61, 0.05);
  --theme-primary-alpha-08: rgba(45, 90, 61, 0.08);
  --theme-primary-alpha-12: rgba(45, 90, 61, 0.12);
  --theme-primary-alpha-15: rgba(45, 90, 61, 0.15);
  --theme-primary-alpha-20: rgba(45, 90, 61, 0.2);
  --theme-primary-alpha-30: rgba(45, 90, 61, 0.3);
  background-color: var(--zc-bg);
}

.page-bg {
  min-height: 100vh;
  background-color: var(--zc-bg);
  padding-bottom: 160rpx;
}

/* 筛选 chip */
.type-scroll {
  width: 100%;
  white-space: nowrap;
  padding: 20rpx 0 16rpx;
  background: var(--zc-bg);
  position: sticky;
  top: 0;
  z-index: 10;
}
.type-list {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 16rpx;
}
.type-chip {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--zc-text-secondary);
  background: var(--app-surface-muted);
  white-space: nowrap;
  transition: all 0.2s;
}
.type-chip.active {
  background: var(--zc-primary);
  color: #fff;
}

/* 列表 */
.list {
  padding: 16rpx 24rpx 0;
}

/* 印记卡片 */
.imprint-card {
  background: var(--zc-card-bg);
  border-radius: var(--zc-radius-card);
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx var(--app-shadow-soft);
  position: relative;
}

/* 封面 */
.cover { width: 100%; overflow: hidden; border-radius: var(--zc-radius-card) var(--zc-radius-card) 0 0; }
.cover-single { width: 100%; height: 0; overflow: hidden; position: relative; }
.cover-single-portrait { padding-top: 133.33%; }
.cover-single-landscape { padding-top: 75%; }
.cover-single-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.cover-video-wrap { width: 100%; height: 420rpx; position: relative; overflow: hidden; border-radius: var(--zc-radius-img); }
.cover-video { width: 100%; height: 100%; display: block; }
.cover-grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 4rpx; }
.cover-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4rpx; }
.cover-grid-item { position: relative; width: 100%; padding-top: 100%; overflow: hidden; }
.cover-grid-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.more-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.45); display: flex; align-items: center; justify-content: center; }
.video-play-badge { position: absolute; bottom: 10rpx; left: 10rpx; background: rgba(0,0,0,0.5); color: #fff; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 20rpx; pointer-events: none; }
.video-play-badge.small { font-size: 16rpx; padding: 2rpx 8rpx; }
.more-text { color: #fff; font-size: 32rpx; font-weight: bold; text-shadow: 0 1px 3px rgba(0,0,0,0.5); }

/* 活动类型徽章 */
.badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}
.badge-reading { background: #2D5A3D; }
.badge-cooking { background: var(--zc-accent); }
.badge-tea { background: #8B6355; }
.badge-walk { background: #4A7FA5; }
.badge-create { background: #7B5EA7; }
.badge-other { background: #888888; }

/* 信息区 */
.info { padding: 20rpx 24rpx 12rpx; }
.meta-row { display: flex; align-items: center; margin-bottom: 8rpx; }
.date { font-size: 24rpx; color: var(--zc-text-secondary); }
.dot { font-size: 24rpx; color: var(--zc-text-secondary); }
.location { font-size: 24rpx; color: var(--zc-text-secondary); }
.title { font-family: var(--app-font-serif); display: block; font-size: 32rpx; font-weight: 600; color: var(--zc-text); margin-bottom: 8rpx; line-height: 1.4; }
.desc { display: block; font-size: 26rpx; color: var(--zc-text-secondary); line-height: 1.5; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

/* 在场人头像墙 */
.attendees { display: flex; align-items: center; padding: 0 24rpx 16rpx; flex-wrap: wrap; gap: 8rpx; }
.avatar-wrap { width: 56rpx; height: 56rpx; border-radius: 50%; overflow: hidden; border: 2rpx solid #fff; box-sizing: border-box; }
.avatar { width: 100%; height: 100%; }
.avatar-text { width: 100%; height: 100%; border-radius: 50%; background: var(--zc-primary); color: #fff; font-size: 22rpx; display: block; position: relative; overflow: hidden; }
.avatar-initial { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: block; line-height: 1; text-align: center; }
.attendees-more { font-size: 22rpx; color: var(--zc-text-secondary); margin-left: 4rpx; }

/* 底部 */
.footer { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 24rpx 20rpx; border-top: 1rpx solid var(--app-border); }
.author { display: flex; align-items: center; gap: 12rpx; }
.author-avatar { width: 48rpx; height: 48rpx; border-radius: 50%; }
.author-avatar-text { width: 48rpx; height: 48rpx; border-radius: 50%; background: var(--zc-accent); color: #fff; font-size: 20rpx; display: grid; place-items: center; line-height: normal; text-align: center; overflow: hidden; }
.author-name { font-size: 24rpx; color: var(--zc-text-secondary); }
.author-meta { font-size: 22rpx; color: var(--zc-text-secondary); margin-left: 12rpx; }
.stats { display: flex; gap: 20rpx; }
.stat-item { font-size: 24rpx; color: var(--zc-text-secondary); }

/* 空状态 */
.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: var(--zc-text-secondary); }

/* 加载 */
.loading-tip, .no-more { text-align: center; font-size: 24rpx; color: var(--zc-text-secondary); padding: 32rpx 0; }

/* 悬浮发布按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: var(--zc-primary);
  color: #fff;
  border-radius: 48rpx;
  padding: 20rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 4rpx 20rpx rgba(45,90,61,0.35);
  z-index: 100;
}
.fab-icon { font-size: 36rpx; font-weight: 300; line-height: 1; }
.fab-text { font-size: 28rpx; font-weight: 500; }

.share-cover-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 500px;
  height: 400px;
  opacity: 0;
  pointer-events: none;
}

/* Version 2 consistency polish: media-first imprint wall. */
.page-bg {
  min-height: 100vh;
  background:
    radial-gradient(circle at 88% 0%, rgba(45, 90, 61, 0.10) 0, rgba(255, 255, 255, 0) 300rpx),
    var(--zc-bg);
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}
.type-chip {
  border-radius: 999rpx;
  background: var(--app-paper);
  border: 1rpx solid var(--app-border);
  color: var(--app-text-soft);
}
.type-chip.active {
  background: var(--zc-primary);
  border-color: var(--zc-primary);
  color: #fff;
}
.imprint-card {
  border-radius: var(--app-radius-lg);
  background: linear-gradient(180deg, var(--app-paper), var(--app-paper-muted));
  border-color: rgba(92, 70, 44, 0.07);
  box-shadow: var(--app-shadow-soft);
}
.imprint-card:active,
.fab:active {
  transform: translateY(2rpx) scale(0.99);
}
.fab {
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 999rpx;
  background: var(--zc-primary);
  box-shadow: 0 18rpx 38rpx rgba(45, 90, 61, 0.28);
}

/* Version 3 dawn: forest seal stats, empty seal, warm paper. */
.stat-item { display: inline-flex; align-items: center; gap: 8rpx; font-family: var(--app-font-num); }
.stat-item .app-icon { width: 28rpx; height: 28rpx; }
.empty-seal { margin-bottom: 24rpx; }
.imprint-card { background: var(--app-paper); }

.app-empty { margin: 80rpx 24rpx 0; }

.dawn-skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0;
  box-sizing: border-box;
  width: 100%;
}

.dawn-skeleton-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 28rpx;
  border-radius: var(--app-radius-md);
  background: var(--app-paper);
}

.dawn-sk-w60 { width: 60%; }
.dawn-sk-w90 { width: 90%; }
.dawn-sk-w40 { width: 40%; }

/* 邮戳：深绿印泥盖在封面右下角 */
.cover { position: relative; }
.zc-mark {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  width: 135rpx;
  height: 135rpx;
  border-radius: 50%;
  border: 4rpx dashed rgba(255, 253, 248, 0.95);
  background: rgba(45, 90, 61, 0.84);
  color: #fffdf8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transform: rotate(-10deg);
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.2);
  pointer-events: none;
  z-index: 2;
}
.zc-mark-date { font-family: var(--app-font-num); font-size: 31rpx; line-height: 1.15; }
.zc-mark-place { font-size: 22rpx; line-height: 1.15; letter-spacing: 0.12em; text-indent: 0.12em; }
.attendees-more { margin-left: 8rpx; }
