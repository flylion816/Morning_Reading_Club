page {
  --zc-bg: var(--app-page-bg);
  --zc-primary: #2D5A3D;
  --zc-accent: var(--app-dawn-deep);
  --zc-text: var(--app-text);
  --zc-text-secondary: var(--app-text-muted);
  --theme-primary: #2D5A3D;
  --theme-primary-dark: #234a31;
  --theme-primary-light: #4a7a5b;
  --theme-primary-tint: #e9f0ea;
  --theme-primary-soft: rgba(45, 90, 61, 0.14);
  --theme-primary-shadow: rgba(45, 90, 61, 0.3);
  --theme-primary-alpha-05: rgba(45, 90, 61, 0.05);
  --theme-primary-alpha-08: rgba(45, 90, 61, 0.08);
  --theme-primary-alpha-12: rgba(45, 90, 61, 0.12);
  --theme-primary-alpha-15: rgba(45, 90, 61, 0.15);
  --theme-primary-alpha-20: rgba(45, 90, 61, 0.2);
  --theme-primary-alpha-30: rgba(45, 90, 61, 0.3);
  background-color: var(--zc-bg);
}

.publish-page { min-height: 100vh; background: var(--zc-bg); padding-bottom: 160rpx; }

.section { background: var(--app-paper); margin-bottom: 16rpx; padding: 24rpx; box-sizing: border-box; }

.field-label { font-size: 26rpx; color: var(--zc-text-secondary); margin-bottom: 16rpx; }
.required { color: #e74c3c; }
.field-input { width: 100%; font-size: 30rpx; color: var(--zc-text); padding: 20rpx 0; height: 80rpx; line-height: 80rpx; border-bottom: 1rpx solid var(--app-border); box-sizing: border-box; display: block; vertical-align: middle; }
.field-textarea { width: 100%; font-size: 28rpx; color: var(--zc-text); min-height: 120rpx; line-height: 1.6; box-sizing: border-box; }

/* 图片网格 */
.media-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.media-item { position: relative; width: 200rpx; height: 200rpx; border-radius: 12rpx; overflow: hidden; transition: opacity 0.15s; }
.media-item.dragging { opacity: 0.4; }
.media-item.drop-target { box-shadow: 0 0 0 4rpx var(--zc-primary); }
.media-img { width: 100%; height: 100%; }
.remove-btn { position: absolute; top: 8rpx; right: 8rpx; width: 40rpx; height: 40rpx; border-radius: 50%; background: rgba(0,0,0,0.5); color: #fff; font-size: 20rpx; display: flex; align-items: center; justify-content: center; }
.add-media { width: 200rpx; height: 200rpx; border-radius: 12rpx; border: 2rpx dashed var(--app-disabled); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; background: var(--app-surface-muted); }
.add-icon { font-size: 48rpx; color: var(--app-disabled); line-height: 1; }
.add-text { font-size: 22rpx; color: var(--zc-text-secondary); }

.video-badge { position: absolute; bottom: 8rpx; left: 8rpx; background: rgba(0,0,0,0.5); color: #fff; font-size: 18rpx; padding: 4rpx 10rpx; border-radius: 20rpx; pointer-events: none; }

/* 活动类型网格 */
.type-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.type-item { padding: 14rpx 28rpx; border-radius: 40rpx; border: 2rpx solid var(--app-border); font-size: 26rpx; color: var(--zc-text-secondary); background: var(--app-surface-muted); }
.type-item.selected { border-color: var(--zc-primary); background: var(--zc-primary); color: #fff; }

/* 在场人 */
.attendees-list { display: flex; flex-wrap: wrap; gap: 16rpx; align-items: center; }
.att-tag { display: flex; align-items: center; gap: 8rpx; padding: 10rpx 20rpx; background: var(--theme-primary-tint); border-radius: 30rpx; font-size: 26rpx; color: var(--zc-primary); }
.att-remove { color: var(--app-text-muted); font-size: 22rpx; }
.add-att-btn { padding: 10rpx 24rpx; border-radius: 30rpx; border: 2rpx dashed var(--zc-primary); color: var(--zc-primary); font-size: 26rpx; }

/* 发布按钮 */
.submit-wrap { padding: 32rpx 24rpx; }
.submit-btn { background: var(--zc-primary); color: #fff; text-align: center; padding: 28rpx; border-radius: 16rpx; font-size: 32rpx; font-weight: 600; }
.submit-btn.disabled { opacity: 0.6; }

/* 在场人弹窗 */
.panel-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); z-index: 200; }
.attendee-panel { position: fixed; bottom: 0; left: 0; right: 0; background: var(--app-paper); border-radius: 24rpx 24rpx 0 0; padding: 32rpx 24rpx; z-index: 201; max-height: 70vh; display: flex; flex-direction: column; }
.panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.panel-title { font-size: 30rpx; font-weight: 600; color: var(--zc-text); }
.panel-close { font-size: 28rpx; color: var(--zc-text-secondary); padding: 8rpx; }
.search-input { background: var(--app-page-bg); border-radius: 40rpx; padding: 16rpx 24rpx; font-size: 28rpx; margin-bottom: 16rpx; }
.search-results { flex: 1; overflow-y: auto; }
.search-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--app-border); }
.search-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; }
.search-avatar-text { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--zc-primary); color: #fff; font-size: 24rpx; display: flex; align-items: center; justify-content: center; line-height: 64rpx; text-align: center; }
.search-name { flex: 1; font-size: 28rpx; color: var(--zc-text); }
.search-add { font-size: 36rpx; color: var(--zc-primary); padding: 0 8rpx; }
.no-result { text-align: center; font-size: 26rpx; color: var(--zc-text-secondary); padding: 32rpx 0; }
.manual-row { display: flex; gap: 16rpx; align-items: center; margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--app-border); }
.manual-input { flex: 1; background: var(--app-page-bg); border-radius: 40rpx; padding: 16rpx 24rpx; font-size: 28rpx; }
.manual-add-btn { padding: 16rpx 28rpx; background: var(--zc-primary); color: #fff; border-radius: 40rpx; font-size: 26rpx; white-space: nowrap; }

/* Version 2 consistency polish: calmer publish form. */
.publish-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 88% 0%, rgba(45, 90, 61, 0.10) 0, rgba(255, 255, 255, 0) 300rpx),
    var(--zc-bg);
}
.section {
  border-radius: var(--app-radius-lg);
  background: linear-gradient(180deg, var(--app-paper), var(--app-paper-muted));
  border-color: rgba(92, 70, 44, 0.07);
  box-shadow: var(--app-shadow-soft);
}
.field-input,
.field-textarea {
  border-radius: var(--app-radius-sm);
}
.type-item,
.att-tag,
.add-att-btn {
  border-radius: var(--app-radius-sm);
}
.submit-btn {
  border-radius: var(--app-radius-md);
  background: var(--zc-primary);
  box-shadow: 0 14rpx 26rpx rgba(45, 90, 61, 0.24);
}
.submit-btn:active,
.type-item:active,
.att-tag:active {
  transform: translateY(2rpx) scale(0.98);
}

/* Version 3 dawn: paper cards and upload state without emoji. */
.section { background: var(--app-paper); }
.add-icon-uploading { font-size: 26rpx; color: var(--zc-primary); }

/* 分区标题衬线，必填星号用语义红 */
.field-label { font-family: var(--app-font-serif); }
.required { color: var(--app-danger); }
.section { border: 1rpx solid var(--app-border); }
