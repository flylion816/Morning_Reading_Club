.page-checkin {
  min-height: 100vh;
  background: var(--app-page-bg);
  padding: 0 0 160rpx;
}

/* 自定义导航栏 */
.custom-nav {
  background: var(--theme-primary);
  display: flex;
  align-items: center;
  height: auto;
  padding-bottom: 0;
  position: relative;
}

.nav-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-back-arrow {
  width: 22rpx;
  height: 22rpx;
  border-left: 4rpx solid white;
  border-bottom: 4rpx solid white;
  transform: rotate(45deg);
  margin-left: 10rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

.nav-placeholder {
  width: 88rpx;
  flex-shrink: 0;
}

.page-body {
  padding: 24rpx;
}

.choice-page { padding: 36rpx 28rpx; }
.choice-heading { padding: 10rpx 4rpx 30rpx; }
.choice-kicker { display: block; color: var(--theme-primary); font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; }
.choice-title { display: block; margin-top: 10rpx; color: var(--app-text); font-size: 38rpx; font-weight: 700; }
.choice-description { display: block; margin-top: 12rpx; color: var(--app-text-soft); font-size: 24rpx; line-height: 1.7; }
.choice-card { padding: 28rpx; background: var(--app-surface); border-radius: 22rpx; box-shadow: var(--app-shadow-soft); }
.choice-label { display: block; color: var(--app-text); font-size: 25rpx; font-weight: 600; }
.choice-course-label { margin-top: 28rpx; }
.choice-picker, .choice-placeholder { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; box-sizing: border-box; margin-top: 12rpx; padding: 16rpx 20rpx; border: 1rpx solid var(--app-border); border-radius: 14rpx; background: var(--app-surface-muted); color: var(--app-text); font-size: 26rpx; }
.choice-picker text:first-child { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.choice-chevron { margin-left: 16rpx; color: var(--theme-primary); font-size: 30rpx; }
.choice-placeholder { color: var(--app-text-muted); }
.choice-message { margin: 24rpx 0; padding: 24rpx; color: var(--app-text-soft); background: var(--app-surface); border-radius: 18rpx; font-size: 25rpx; line-height: 1.6; }
.choice-retry { display: inline-block; margin: 0 0 0 20rpx; padding: 0 18rpx; color: var(--theme-primary); background: var(--theme-primary-tint); font-size: 24rpx; line-height: 2; }
.choice-retry::after, .choice-submit::after { border: 0; }
.choice-submit { margin: 28rpx 0 0; border-radius: 16rpx; color: #fff; background: var(--theme-primary-dark); font-size: 28rpx; font-weight: 600; line-height: 88rpx; }
.choice-submit[disabled] { color: var(--app-text-muted); background: var(--app-surface-muted); }

/* 课程标题 */
.course-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--app-text);
  margin-bottom: 12rpx;
}

.course-date {
  font-size: 24rpx;
  color: var(--app-text-muted);
  margin-bottom: 24rpx;
}

/* 内容预览（未展开） */
.content-preview {
  background: var(--app-paper);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.section-preview {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.section-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  color: white;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.section-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--app-text);
}

.section-content-short {
  font-size: 26rpx;
  color: var(--app-text-soft);
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 展开按钮 */
.expand-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: var(--theme-primary);
  cursor: pointer;
}

.arrow {
  font-size: 20rpx;
}

/* 展开后的完整内容 */
.full-content {
  margin-bottom: 24rpx;
}

.content-section {
  background: var(--app-paper);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--app-text);
  margin-bottom: 16rpx;
}

.section-title .section-icon {
  margin-right: 12rpx;
}

.section-content {
  font-size: 32rpx;
  color: var(--app-text-soft);
  line-height: 2.2;
  text-align: justify;
  width: 100%;
  box-sizing: border-box;
  overflow: visible;
  letter-spacing: 1px;
}

/* 富文本内容样式 */
.section-content rich-text {
  font-size: 32rpx;
  line-height: 2.2;
  color: var(--app-text-soft);
  width: 100%;
  display: block;
  letter-spacing: 1px;
}

/* 富文本段落样式 */
.section-content /deep/ p {
  margin: 24rpx 0;
  line-height: 1.8;
}

/* 富文本空段落样式 - 确保空行可见 */
.section-content /deep/ p:empty {
  min-height: 1em;
  display: block;
  margin: 24rpx 0;
}

/* 富文本粗体样式 */
.section-content /deep/ strong {
  font-weight: bold;
  color: var(--app-text);
}

/* 富文本缩进样式 */
.section-content /deep/ p[style*="margin-left"] {
  margin-left: 2em;
}

/* 富文本图片样式 */
.section-content /deep/ img {
  max-width: 100%;
  height: auto;
  border-radius: 8rpx;
  margin: 16rpx 0;
  display: block;
}

/* 富文本链接样式 */
.section-content /deep/ a {
  color: var(--theme-primary);
  text-decoration: underline;
}

/* 富文本列表样式 */
.section-content /deep/ ol,
.section-content /deep/ ul {
  margin: 24rpx 0;
  padding-left: 32rpx;
}

.section-content /deep/ li {
  margin: 16rpx 0;
  line-height: 1.8;
}

/* 日记输入区域 */
.diary-input-section {
  background: var(--app-paper);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.rich-editor-wrap {
  width: 100%;
  border: 2rpx solid var(--app-rule);
  border-radius: 12rpx;
  background: var(--app-paper);
  overflow: hidden;
  box-sizing: border-box;
}

.editor-toolbar {
  border-bottom: 1rpx solid var(--app-rule);
  background: var(--app-paper-muted);
}

.toolbar-scroll {
  width: 100%;
  white-space: nowrap;
}

.toolbar-inner {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 16rpx;
  min-width: 100%;
  box-sizing: border-box;
}

.tool-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 8rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--app-text);
}

.tool-btn-active,
.tool-btn:active {
  background: var(--theme-primary-tint);
  color: var(--theme-primary-dark);
}

.tool-icon {
  font-size: 26rpx;
  line-height: 1;
  font-weight: 700;
}

.tool-bold {
  font-weight: 900;
}

.tool-italic {
  font-style: italic;
}

.tool-underline {
  text-decoration: underline;
}

.tool-heading {
  font-size: 28rpx;
}

.toolbar-divider {
  width: 1rpx;
  height: 36rpx;
  background: var(--app-rule);
  margin: 0 4rpx;
  flex-shrink: 0;
}

.color-swatch {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 4rpx solid var(--app-paper);
  box-shadow: 0 0 0 1rpx var(--app-rule);
  flex-shrink: 0;
}

.color-swatch-active {
  box-shadow: 0 0 0 4rpx var(--theme-primary-alpha-40);
}

.rich-editor {
  min-height: 360rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--app-text);
}

.char-count-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  margin-bottom: 24rpx;
}

.auto-save-status {
  font-size: 22rpx;
  color: var(--app-text-muted);
}

.char-count {
  font-size: 24rpx;
  color: var(--app-text-muted);
}

.rich-preview {
  margin-bottom: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 12rpx;
  background: var(--app-paper-muted);
  border: 1rpx solid var(--app-border);
  box-sizing: border-box;
}

.rich-preview-title {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  color: var(--app-text-muted);
  font-weight: 600;
}

.rich-preview-content {
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--app-text);
  word-break: break-word;
}

.rich-preview-content rich-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--app-text);
}

.checkin-image-section {
  margin-bottom: 28rpx;
}

.checkin-image-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.checkin-image-title {
  font-size: 26rpx;
  color: var(--app-text);
  font-weight: 500;
}

.checkin-image-count {
  font-size: 24rpx;
  color: var(--app-text-muted);
}

.checkin-image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.checkin-image-tile,
.checkin-image-add {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--app-surface-muted);
}

.checkin-image-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.checkin-image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 30rpx;
  line-height: 42rpx;
  text-align: center;
}

.checkin-image-add {
  border: 1rpx dashed var(--theme-primary-alpha-30);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--theme-primary);
  box-sizing: border-box;
}

.checkin-image-add-disabled {
  opacity: 0.6;
}

.checkin-image-add-icon {
  font-size: 52rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}

.checkin-image-add-text {
  font-size: 24rpx;
}

/* 退出确认弹窗 */
.exit-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.exit-modal {
  width: 100%;
  background: var(--app-paper);
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 32rpx 64rpx;
}

.exit-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--app-text);
  text-align: center;
  margin-bottom: 16rpx;
}

.exit-modal-desc {
  font-size: 26rpx;
  color: var(--app-text-muted);
  text-align: center;
  margin-bottom: 40rpx;
}

.exit-modal-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.exit-btn {
  width: 100%;
  padding: 28rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  border: none;
}

.exit-btn::after {
  border: none;
}

.exit-btn-publish {
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: white;
  font-weight: bold;
}

.exit-btn-discard {
  background: #fff0f0;
  color: #e54545;
}

.exit-btn-stay {
  background: var(--app-surface-muted);
  color: var(--app-text-soft);
}

/* 可见范围 */
.visibility-section {
  margin-bottom: 24rpx;
}

.visibility-label {
  font-size: 26rpx;
  color: var(--app-text);
  margin-bottom: 12rpx;
  display: block;
}

.visibility-options {
  display: flex;
  gap: 16rpx;
}

.visibility-option {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 48rpx;
  font-size: 26rpx;
  color: var(--app-text-soft);
  background: var(--app-surface-muted);
  border: 2rpx solid transparent;
}

.visibility-option.active {
  color: var(--theme-primary);
  background: var(--theme-primary-tint);
  border-color: var(--theme-primary);
}

/* 底部按钮 */
.bottom-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--app-paper);
  padding: 20rpx 24rpx calc(20rpx + constant(safe-area-inset-bottom));
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -4rpx 16rpx rgba(60, 42, 20, 0.08);
  z-index: 100;
}

.btn-cancel {
  flex: 1;
  background: var(--app-surface-muted);
  color: var(--app-text-soft);
  border: none;
  border-radius: 36rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

.btn-cancel::after {
  border: none;
}

.btn-submit {
  flex: 2;
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: white;
  border: none;
  border-radius: 36rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-submit::after {
  border: none;
}

/* 允许长按选择文字 */
.course-title,
.course-date,
.section-content,
.section-content-short {
  user-select: text;
}

/* ===================== 打卡庆祝动画 ===================== */

/* 全屏遮罩 */
.cel-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: cel-fade-in 0.3s ease both;
}

@keyframes cel-fade-in { from { opacity: 0; } to { opacity: 1; } }


@keyframes cel-fade-up {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}


.cel-check-c { font-size: 60rpx; color: white; font-weight: bold; }
.cel-title-c {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--app-text);
  margin-bottom: 8rpx;
  animation: cel-fade-up 0.4s ease 0.4s both;
}
.d1 { background: var(--theme-primary); animation-delay: 0s; }
.d2 { background: #FFD700; animation-delay: 0.15s; }
.d3 { background: #4ECDC4; animation-delay: 0.3s; }


/* Style C 关闭按钮 */
.cel-close-btn {
  background: linear-gradient(135deg, var(--theme-primary), var(--theme-primary-dark));
  color: white;
  border-radius: 48rpx;
  padding: 28rpx 80rpx;
  font-size: 30rpx;
  font-weight: bold;
  animation: cel-fade-up 0.4s ease 0.6s both;
}


.course-module-image { display: block; width: 100%; border-radius: 12rpx; margin: 12rpx 0; }

/* Version 2 consistency polish: calmer checkin editor and choice cards. */
.page-checkin {
  background:
    radial-gradient(circle at 88% 0%, var(--theme-primary-alpha-08) 0, rgba(255, 255, 255, 0) 320rpx),
    linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}
.choice-card,
.editor-card,
.section-card {
  border-radius: var(--app-radius-lg);
  border-color: var(--app-border);
  box-shadow: var(--app-shadow-soft);
}
.choice-card:active,
.choice-submit:active,
.primary-btn:active,
.submit-btn:active {
  transform: translateY(2rpx) scale(0.985);
}
.choice-submit,
.primary-btn,
.submit-btn {
  border-radius: var(--app-radius-md);
  box-shadow: 0 14rpx 26rpx var(--theme-primary-alpha-18);
}
.custom-nav {
  background: linear-gradient(145deg, var(--theme-primary), var(--theme-primary-dark));
}


/* Version 3 dawn: 纸色页眉、暖纸编辑区、安静的次要按钮 */
.custom-nav {
  background: var(--app-paper);
  padding-bottom: 6rpx;
}
.custom-nav::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--app-dawn), transparent);
}
.nav-back-arrow {
  border-left-color: var(--app-text);
  border-bottom-color: var(--app-text);
}
.nav-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.nav-title {
  flex: none;
  color: var(--app-text);
}
.nav-subtitle {
  display: flex;
  align-items: center;
  max-width: 100%;
  margin-top: 4rpx;
}
.nav-subtitle-text {
  min-width: 0;
  margin-left: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
  color: var(--app-text-muted);
}
.course-title {
  font-family: var(--app-font-serif);
}
.content-preview,
.content-section,
.diary-input-section {
  border: 1rpx solid var(--app-border);
}
.tool-btn {
  background: transparent;
  color: var(--app-text);
}
.tool-btn-active,
.tool-btn:active {
  background: var(--theme-primary-tint);
  color: var(--theme-primary-dark);
}
.rich-editor {
  color: var(--app-text);
}
.checkin-image-add {
  border: 1rpx dashed var(--app-rule);
}
.bottom-buttons {
  border-top: 1rpx solid var(--app-border);
}
.btn-cancel {
  background: var(--app-paper);
  color: var(--app-text-muted);
  border: 1rpx solid var(--app-rule);
}
.exit-btn-stay {
  background: var(--app-paper-muted);
}
.cel-rite {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  text-align: center;
  color: var(--app-text);
}
.cel-rite-sun {
  position: absolute;
  left: 50%;
  top: calc(54% - 347rpx);
  width: 375rpx;
  height: 375rpx;
  margin-left: -187rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #ffd08a 0%, #f6a94f 62%, #ee9b45 100%);
  box-shadow: 0 0 0 55rpx rgba(255, 200, 130, 0.28), 0 0 0 125rpx rgba(255, 200, 130, 0.14);
  animation: cel-rite-sunrise 1.2s cubic-bezier(0.22, 0.8, 0.3, 1) both;
}
@keyframes cel-rite-sunrise {
  from { transform: translateY(300rpx); opacity: 0.4; }
  to   { transform: translateY(0); opacity: 1; }
}
.cel-rite-ground {
  position: absolute;
  left: 0;
  right: 0;
  top: 54%;
  bottom: 0;
  background: var(--app-paper);
  border-top: 1rpx solid rgba(138, 75, 18, 0.18);
}
.cel-rite-day {
  position: absolute;
  left: 0;
  right: 0;
  top: 12%;
  display: flex;
  align-items: baseline;
  justify-content: center;
  animation: cel-fade-up 0.5s ease 0.5s both;
}
.cel-rite-day-word {
  font-family: var(--app-font-serif);
  font-size: 38rpx;
  color: var(--app-dawn-ink);
  letter-spacing: 0.3em;
}
.cel-rite-day-num {
  font-family: var(--app-font-num);
  font-size: 190rpx;
  line-height: 1;
  color: var(--app-text);
  margin: 0 12rpx;
}
.cel-rite-body {
  position: absolute;
  left: 0;
  right: 0;
  top: 58%;
  padding: 0 65rpx;
  animation: cel-fade-up 0.5s ease 0.8s both;
}
.cel-rite-title {
  font-family: var(--app-font-serif);
  font-size: 48rpx;
  letter-spacing: 0.06em;
  color: var(--app-text);
}
.cel-rite-say {
  margin-top: 24rpx;
  font-family: var(--app-font-serif);
  font-size: 30rpx;
  line-height: 1.7;
  white-space: pre-line;
  color: var(--app-text-muted);
}
.cel-rite-btn {
  margin: 56rpx auto 0;
  width: 80%;
  padding: 28rpx 0;
  border-radius: 48rpx;
  background: var(--theme-primary-dark);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
}

@media (prefers-reduced-motion: reduce) {
  .cel-rite-sun {
    animation: none;
  }
}

/* Features: 心情天气选择、仪式名次与日签入口 */
.mood-section {
  margin-top: 32rpx;
}
.mood-label {
  display: block;
  font-size: 28rpx;
  color: var(--app-text);
  margin-bottom: 20rpx;
}
.mood-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.mood-option {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 22rpx 10rpx 12rpx;
  border-radius: 40rpx;
  border: 1rpx solid var(--app-line, #e8dfd0);
  background: var(--app-paper);
  color: var(--app-text-muted);
  font-size: 24rpx;
}
.mood-option.active {
  border-color: var(--theme-primary);
  color: var(--theme-primary);
}
.mood-seal {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 10rpx;
  background: var(--theme-primary-dark);
  color: #ffffff;
  font-family: var(--app-font-serif);
  font-size: 22rpx;
  opacity: 0.45;
}
.mood-option.active .mood-seal {
  opacity: 1;
}
.mood-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--app-text-muted);
  opacity: 0.7;
}
.cel-rite-rank {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: var(--app-text-muted);
}
.cel-rite-rank-num {
  font-family: var(--app-font-num);
  font-size: 32rpx;
  color: var(--theme-primary);
  padding: 0 4rpx;
}
.cel-rite-card {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: var(--app-text-muted);
  text-decoration: underline;
}

/* Preview parity: 想一想卡、仪式上的连续天数与两个按钮。 */
.think-card {
  margin: 8rpx 0 28rpx;
  padding: 28rpx 30rpx;
  border-radius: 20rpx;
  background: var(--app-paper);
  border: 1rpx solid rgba(92, 70, 44, 0.1);
}
.think-card-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 14rpx;
}
.think-card-title {
  font-family: var(--app-font-serif);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text);
}
.think-card-text {
  display: block;
  font-family: var(--app-font-serif);
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--app-text-soft);
}
.cel-rite-streak {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--app-text-muted);
}
.cel-rite-rank {
  margin-top: 8rpx;
}
.cel-rite-btn {
  margin-top: 44rpx;
}
.cel-rite-card {
  margin: 20rpx auto 0;
  width: 80%;
  padding: 24rpx 0;
  box-sizing: border-box;
  border-radius: 48rpx;
  border: 2rpx solid rgba(92, 70, 44, 0.22);
  color: var(--app-text);
  font-size: 28rpx;
  text-decoration: none;
}
.cel-rite-close {
  margin-top: 24rpx;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: var(--app-text-muted);
}

/* 心情天气：六个天气图标排一行，选中后在下面显示一句话。 */
.mood-options {
  flex-wrap: nowrap;
  justify-content: space-between;
  gap: 0;
}
.mood-option {
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  padding: 14rpx 0 12rpx;
  margin: 0 6rpx;
  border-radius: 20rpx;
  border-color: transparent;
  background: transparent;
  font-size: 22rpx;
}
.mood-option:first-child { margin-left: 0; }
.mood-option:last-child { margin-right: 0; }
.mood-option.active {
  border-color: rgba(184, 99, 31, 0.35);
  background: var(--app-dawn-soft);
  color: var(--app-dawn-ink);
}
.mood-icon.app-icon {
  width: 52rpx;
  height: 52rpx;
}
.mood-picked {
  display: block;
  margin-top: 14rpx;
  font-family: var(--app-font-serif);
  font-size: 26rpx;
  color: var(--app-dawn-ink);
}

/* Features: 打卡仪式的七个清晨场景。文字和按钮共用 .cel-rite-*，这里只画天空（上面 54%）。
   A 晨星未落 / B 书页轻翻 / C 旭日初升 / D 远山日出 / E 一盏晨灯 / F 清晨落叶 / G 晨鸟出林 */
.cel-overlay {
  align-items: stretch;
  justify-content: flex-start;
}
.cel-scene {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 54%;
  overflow: hidden;
}
.cel-scene .cel-rite-sun {
  top: auto;
  bottom: -28rpx;
}
.cel-A { background: linear-gradient(180deg, #25324f 0%, #4a5d86 30%, #b9a6a4 47%, #f6d3a8 54%, #fdf3e3 100%); }
.cel-B { background: linear-gradient(180deg, #f6ead4 0%, #fbf1e0 40%, #fdf6ea 100%); }
.cel-C { background: linear-gradient(180deg, #f9d7ae 0%, #fbe6c9 38%, #fdf3e3 100%); }
.cel-D { background: linear-gradient(180deg, #f3c9a3 0%, #f9dcbb 34%, #fdf0dc 100%); }
.cel-E { background: linear-gradient(180deg, #3b2f29 0%, #5a4334 30%, #a9805a 48%, #f3d6ad 54%, #fdf3e3 100%); }
.cel-F { background: linear-gradient(180deg, #e9ecd6 0%, #f5f0dc 36%, #fdf3e3 100%); }
.cel-G { background: linear-gradient(180deg, #cfdfec 0%, #e9e2d6 34%, #fbe6c9 54%, #fdf3e3 100%); }

/* 深色天空上的「第 N 天」用浅色 */
.cel-A .cel-rite-day-num,
.cel-E .cel-rite-day-num { color: #fffdf8; }
.cel-A .cel-rite-day-word,
.cel-E .cel-rite-day-word { color: #fbe6c9; }

/* A 晨星未落：天快亮了，星星一颗颗淡下去，只剩一颗晨星 */
.cel-star {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #fffdf8;
  animation: cel-star-fade 3.6s ease-in-out both;
}
.cel-star-1 { left: 12%; top: 14%; animation-delay: 0.1s; }
.cel-star-2 { left: 28%; top: 30%; width: 6rpx; height: 6rpx; animation-delay: 0.5s; }
.cel-star-3 { left: 44%; top: 9%; animation-delay: 0.9s; }
.cel-star-4 { left: 63%; top: 24%; width: 6rpx; height: 6rpx; animation-delay: 0.3s; }
.cel-star-5 { left: 80%; top: 12%; animation-delay: 1.2s; }
.cel-star-6 { left: 88%; top: 36%; width: 6rpx; height: 6rpx; animation-delay: 0.7s; }
.cel-star-7 { left: 18%; top: 46%; width: 6rpx; height: 6rpx; animation-delay: 1.5s; }
@keyframes cel-star-fade {
  0% { opacity: 0; }
  25% { opacity: 1; }
  60% { opacity: 0.9; }
  100% { opacity: 0.18; }
}
.cel-morning-star {
  position: absolute;
  left: 50%;
  bottom: 86rpx;
  width: 22rpx;
  height: 22rpx;
  margin-left: -11rpx;
  border-radius: 50%;
  background: #fff6e0;
  box-shadow: 0 0 0 14rpx rgba(255, 226, 176, 0.3), 0 0 0 40rpx rgba(255, 226, 176, 0.14), 0 0 70rpx 30rpx rgba(255, 214, 150, 0.35);
  animation: cel-star-rise 1.4s cubic-bezier(0.22, 0.8, 0.3, 1) both, cel-glow-breathe 3.2s ease-in-out 1.4s infinite;
}
@keyframes cel-star-rise {
  from { transform: translateY(120rpx) scale(0.6); opacity: 0; }
  to { transform: translateY(0) scale(1); opacity: 1; }
}
@keyframes cel-glow-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.18); }
}

/* B 书页轻翻：几页纸慢慢飘起来 */
.cel-leafpage {
  position: absolute;
  bottom: -160rpx;
  width: 110rpx;
  height: 146rpx;
  border-radius: 8rpx;
  background: var(--app-paper);
  border: 1rpx solid rgba(138, 75, 18, 0.2);
  box-shadow: 0 10rpx 24rpx rgba(84, 60, 30, 0.1);
  animation: cel-page-float 4.2s ease-out both;
}
.cel-leafpage::after {
  content: '';
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 30rpx;
  height: 58rpx;
  border-top: 3rpx solid rgba(138, 75, 18, 0.22);
  border-bottom: 3rpx solid rgba(138, 75, 18, 0.22);
  background: linear-gradient(rgba(138, 75, 18, 0.22), rgba(138, 75, 18, 0.22)) center / 100% 3rpx no-repeat;
}
.cel-leafpage-1 { left: 10%; --cel-r: -14deg; --cel-y: -520rpx; animation-delay: 0s; }
.cel-leafpage-2 { left: 30%; --cel-r: 9deg; --cel-y: -380rpx; animation-delay: 0.35s; }
.cel-leafpage-3 { left: 46%; --cel-r: -5deg; --cel-y: -600rpx; animation-delay: 0.15s; }
.cel-leafpage-4 { left: 64%; --cel-r: 16deg; --cel-y: -430rpx; animation-delay: 0.55s; }
.cel-leafpage-5 { left: 80%; --cel-r: -10deg; --cel-y: -540rpx; animation-delay: 0.25s; }
@keyframes cel-page-float {
  from { transform: translateY(0) rotate(0deg); opacity: 0; }
  20% { opacity: 1; }
  to { transform: translateY(var(--cel-y, -480rpx)) rotate(var(--cel-r, 8deg)); opacity: 0.92; }
}

/* D 远山日出、G 晨鸟出林：小一号的太阳 */
.cel-scene .cel-sun-small {
  width: 250rpx;
  height: 250rpx;
  margin-left: -125rpx;
  bottom: 40rpx;
  box-shadow: 0 0 0 40rpx rgba(255, 200, 130, 0.26), 0 0 0 90rpx rgba(255, 200, 130, 0.12);
}
.cel-hill {
  position: absolute;
  bottom: -260rpx;
  border-radius: 50%;
  animation: cel-fade-up 0.9s ease both;
}
.cel-hill-1 { left: -20%; width: 90%; height: 420rpx; background: #dcc3a2; animation-delay: 0.1s; }
.cel-hill-2 { right: -25%; width: 100%; height: 480rpx; background: #c9a87f; animation-delay: 0.25s; }
.cel-hill-3 { left: 10%; width: 110%; height: 380rpx; bottom: -290rpx; background: #b08a60; animation-delay: 0.4s; }
.cel-mist {
  position: absolute;
  left: -30%;
  width: 160%;
  bottom: 60rpx;
  height: 70rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, rgba(255, 253, 248, 0) 0%, rgba(255, 253, 248, 0.75) 40%, rgba(255, 253, 248, 0.75) 60%, rgba(255, 253, 248, 0) 100%);
  animation: cel-mist-drift 7s ease-in-out both;
}
@keyframes cel-mist-drift {
  from { transform: translateX(-12%); opacity: 0; }
  30% { opacity: 1; }
  to { transform: translateX(12%); opacity: 0.7; }
}

/* E 一盏晨灯：天还没亮，先点一盏灯 */
.cel-lamp-glow {
  position: absolute;
  left: 50%;
  bottom: -60rpx;
  width: 640rpx;
  height: 640rpx;
  margin-left: -320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 214, 150, 0.78) 0%, rgba(255, 200, 130, 0.3) 42%, rgba(255, 200, 130, 0) 70%);
  animation: cel-lamp-on 1.4s ease-out both, cel-glow-breathe 3.6s ease-in-out 1.4s infinite;
}
.cel-lamp {
  position: absolute;
  left: 50%;
  bottom: 150rpx;
  width: 84rpx;
  height: 84rpx;
  margin-left: -42rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #fff3d6 0%, #ffd08a 60%, #f6a94f 100%);
  box-shadow: 0 0 60rpx 20rpx rgba(255, 208, 138, 0.55);
  animation: cel-lamp-on 1.4s ease-out both;
}
.cel-lamp::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 80rpx;
  width: 4rpx;
  height: 150rpx;
  margin-left: -2rpx;
  background: rgba(255, 243, 214, 0.5);
}
@keyframes cel-lamp-on {
  from { opacity: 0; transform: scale(0.7); }
  to { opacity: 1; transform: scale(1); }
}

/* F 清晨落叶：几片叶子慢慢落下来 */
.cel-leaf {
  position: absolute;
  top: -60rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 0 100% 0 100%;
  animation: cel-leaf-fall 5s ease-in both;
}
.cel-leaf-1 { left: 8%; background: #b9c08a; --cel-x: 60rpx; --cel-r: 200deg; animation-delay: 0s; }
.cel-leaf-2 { left: 22%; background: #e3b06a; --cel-x: -40rpx; --cel-r: -160deg; animation-delay: 0.6s; width: 32rpx; height: 32rpx; }
.cel-leaf-3 { left: 38%; background: #cfa35e; --cel-x: 80rpx; --cel-r: 240deg; animation-delay: 0.2s; }
.cel-leaf-4 { left: 54%; background: #a9b47c; --cel-x: -70rpx; --cel-r: -220deg; animation-delay: 0.9s; width: 34rpx; height: 34rpx; }
.cel-leaf-5 { left: 68%; background: #ee9b45; --cel-x: 40rpx; --cel-r: 180deg; animation-delay: 0.4s; }
.cel-leaf-6 { left: 82%; background: #c7c48e; --cel-x: -50rpx; --cel-r: -190deg; animation-delay: 1.1s; width: 30rpx; height: 30rpx; }
.cel-leaf-7 { left: 92%; background: #dba963; --cel-x: -90rpx; --cel-r: 210deg; animation-delay: 0.7s; }
@keyframes cel-leaf-fall {
  from { transform: translate(0, 0) rotate(0deg); opacity: 0; }
  15% { opacity: 0.95; }
  to { transform: translate(var(--cel-x, 40rpx), 720rpx) rotate(var(--cel-r, 180deg)); opacity: 0.85; }
}

/* G 晨鸟出林：三只鸟从太阳边上飞起来 */
.cel-bird {
  position: absolute;
  width: 64rpx;
  height: 24rpx;
  animation: cel-bird-fly 5s ease-out both;
}
.cel-bird::before,
.cel-bird::after {
  content: '';
  position: absolute;
  top: 0;
  width: 32rpx;
  height: 24rpx;
  border-top: 5rpx solid #5b4a3a;
  border-radius: 50%;
}
.cel-bird::before { left: 0; transform: rotate(-12deg); }
.cel-bird::after { right: 0; transform: rotate(12deg); }
.cel-bird-1 { left: 30%; bottom: 190rpx; --cel-x: 190rpx; --cel-y: -260rpx; animation-delay: 0.4s; }
.cel-bird-2 { left: 40%; bottom: 150rpx; --cel-x: 260rpx; --cel-y: -190rpx; animation-delay: 0.9s; transform: scale(0.8); }
.cel-bird-3 { left: 22%; bottom: 230rpx; --cel-x: 150rpx; --cel-y: -330rpx; animation-delay: 1.3s; }
@keyframes cel-bird-fly {
  from { transform: translate(0, 0) scale(0.6); opacity: 0; }
  20% { opacity: 0.9; }
  to { transform: translate(var(--cel-x, 200rpx), var(--cel-y, -240rpx)) scale(1); opacity: 0.75; }
}

@media (prefers-reduced-motion: reduce) {
  .cel-star,
  .cel-morning-star,
  .cel-leafpage,
  .cel-hill,
  .cel-mist,
  .cel-lamp,
  .cel-lamp-glow,
  .cel-leaf,
  .cel-bird {
    animation: none;
  }
  .cel-leafpage { bottom: 120rpx; }
  .cel-leaf { top: 30%; }
}
