<view class="page-checkin" wx:if="{{socialAccessGranted}}">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-back" bindtap="handleCancel">
      <view class="nav-back-arrow"></view>
    </view>
    <view class="nav-title-wrap">
      <text class="nav-title">{{selectingCourse || accessChecked ? '写打卡' : '学习内容'}}</text>
      <view class="nav-subtitle" wx:if="{{!selectingCourse && courseTitle}}">
        <view class="app-seal app-seal-sm">记</view>
        <text class="nav-subtitle-text">{{celebrationDay > 0 ? '第 ' + celebrationDay + ' 天 · ' : ''}}{{courseTitle}}</text>
      </view>
    </view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="choice-page" wx:if="{{selectingCourse}}">
    <view class="choice-heading">
      <text class="choice-kicker">开始记录</text>
      <text class="choice-title">选择要打卡的课程</text>
      <text class="choice-description">默认选中当前期次和今日课程，也可以选择其他已报名的课程。</text>
    </view>
    <view class="choice-card" wx:if="{{selectablePeriods.length}}">
      <text class="choice-label">期次</text>
      <picker range="{{selectablePeriods}}" range-key="name" value="{{selectedPeriodIndex}}" bindchange="handleCheckinPeriodChange" disabled="{{selectionLoading}}">
        <view class="choice-picker"><text>{{selectablePeriods[selectedPeriodIndex].name}}</text><text class="choice-chevron">⌄</text></view>
      </picker>
      <text class="choice-label choice-course-label">课程</text>
      <picker wx:if="{{selectableSections.length}}" range="{{selectableSections}}" range-key="name" value="{{selectedSectionIndex}}" bindchange="handleCheckinSectionChange" disabled="{{selectionLoading}}">
        <view class="choice-picker"><text>{{selectableSections[selectedSectionIndex].name}}</text><text class="choice-chevron">⌄</text></view>
      </picker>
      <view wx:else class="choice-placeholder">{{selectionLoading ? '正在加载课程…' : '这一期还没有可以打卡的课程'}}</view>
    </view>
    <view wx:if="{{selectionError}}" class="choice-message">
      <text>{{selectionError}}</text><button class="choice-retry" bindtap="retryCheckinChoices">重试</button>
    </view>
    <view wx:elif="{{selectionLoading && !selectablePeriods.length}}" class="choice-message">正在加载期次…</view>
    <view wx:elif="{{!selectionLoading && !selectablePeriods.length}}" class="choice-message">还没有可打卡的期次，完成报名后即可开始。</view>
    <button class="choice-submit" disabled="{{selectionLoading || !!selectionError || !selectableSections.length}}" bindtap="startSelectedCheckin">开始打卡</button>
  </view>

  <!-- 内容区（加回左右内边距） -->
  <view class="page-body" wx:if="{{accessChecked && showPageContent}}">

  <!-- 想一想：从一个问题写起（课程名已在页眉） -->
  <view class="think-card" wx:if="{{thinkText && !expanded}}">
    <view class="think-card-head">
      <view class="app-seal app-seal-dawn app-seal-sm">想</view>
      <text class="think-card-title">想一想</text>
    </view>
    <text class="think-card-text" selectable>{{thinkText}}</text>
  </view>

  <view class="content-preview" wx:if="{{!expanded && !thinkText}}">
    <block wx:if="{{previewModule}}">
      <view class="section-preview"><text class="section-name">{{previewModule.name}}</text></view>
      <image wx:if="{{previewModule.type === 'image'}}" class="course-module-image" src="{{previewModule.value}}" mode="widthFix" />
      <rich-text wx:elif="{{previewModule.type === 'body'}}" nodes="{{previewModule.value}}" />
      <view wx:else class="section-content"><text selectable>{{previewModule.value}}</text></view>
    </block>
    <text wx:else>课程内容待补充</text>
  </view>
  <view wx:if="{{courseModules.length}}" class="expand-btn" bindtap="toggleExpand">
    <text>{{expanded ? '收起' : (thinkText ? '看看这一课的内容' : '展开所有')}}</text><text class="arrow">{{expanded ? '▲' : '▼'}}</text>
  </view>
  <view class="full-content" wx:if="{{expanded}}">
    <view wx:for="{{courseModules}}" wx:key="id" class="content-section">
      <view class="section-title"><text>{{item.name}}</text></view>
      <image wx:if="{{item.type === 'image'}}" class="course-module-image" src="{{item.value}}" mode="widthFix" />
      <rich-text wx:elif="{{item.type === 'body'}}" nodes="{{item.value}}" />
      <view wx:else class="section-content"><text selectable>{{item.value}}</text></view>
    </view>
  </view>

  <!-- 日记输入区域 -->
  <view class="diary-input-section">
    <view class="rich-editor-wrap">
      <view class="editor-toolbar">
        <scroll-view scroll-x class="toolbar-scroll" show-scrollbar="{{false}}" enhanced="{{true}}">
          <view class="toolbar-inner">
            <view class="tool-btn {{editorFormats.bold ? 'tool-btn-active' : ''}}" data-name="bold" catchtouchend="handleEditorFormat">
              <text class="tool-icon tool-bold">B</text>
            </view>
            <view class="tool-btn {{editorFormats.italic ? 'tool-btn-active' : ''}}" data-name="italic" catchtouchend="handleEditorFormat">
              <text class="tool-icon tool-italic">I</text>
            </view>
            <view class="tool-btn {{editorFormats.underline ? 'tool-btn-active' : ''}}" data-name="underline" catchtouchend="handleEditorFormat">
              <text class="tool-icon tool-underline">U</text>
            </view>
            <view class="toolbar-divider"></view>
            <view class="tool-btn {{editorFormats.headerType === 'h2' ? 'tool-btn-active' : ''}}" data-name="headerType" data-value="h2" catchtouchend="handleEditorFormat">
              <text class="tool-icon tool-heading">H</text>
            </view>
            <view class="tool-btn {{editorFormats.list === 'ordered' ? 'tool-btn-active' : ''}}" data-name="list" data-value="ordered" catchtouchend="handleEditorFormat">
              <text class="tool-icon">1.</text>
            </view>
            <view class="tool-btn {{editorFormats.list === 'bullet' ? 'tool-btn-active' : ''}}" data-name="list" data-value="bullet" catchtouchend="handleEditorFormat">
              <text class="tool-icon">•</text>
            </view>
            <view class="toolbar-divider"></view>
            <view
              wx:for="{{editorColorOptions}}"
              wx:key="value"
              class="color-swatch {{editorFormats.color === item.value ? 'color-swatch-active' : ''}}"
              style="background: {{item.value}}"
              data-name="color"
              data-value="{{item.value}}"
              catchtouchend="handleEditorFormat"
            ></view>
            <view class="toolbar-divider"></view>
            <view class="tool-btn" catchtouchend="handleEditorUndo">
              <text class="tool-icon">↶</text>
            </view>
            <view class="tool-btn" catchtouchend="handleEditorRedo">
              <text class="tool-icon">↷</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <editor
        id="checkin-rich-editor"
        class="rich-editor"
        placeholder="{{diaryPlaceholder}}"
        bindready="handleEditorReady"
        bindinput="handleEditorInput"
        bindstatuschange="handleEditorStatusChange"
        show-img-size="{{false}}"
        show-img-toolbar="{{false}}"
        show-img-resize="{{false}}"
      />
    </view>
    <view class="char-count-row">
      <text class="auto-save-status">{{autoSaveStatus}}</text>
      <text class="char-count">{{diaryContent.length}}/{{maxDiaryLength}}</text>
    </view>

    <view class="rich-preview" wx:if="{{showRichTextPreview && diaryContentHtml}}">
      <view class="rich-preview-title">发布效果</view>
      <view class="rich-preview-content">
        <rich-text nodes="{{diaryContentHtml}}" user-select></rich-text>
      </view>
    </view>

    <view class="checkin-image-section">
      <view class="checkin-image-header">
        <text class="checkin-image-title">图片</text>
        <text class="checkin-image-count">{{checkinImages.length}}/{{maxImageCount}}</text>
      </view>
      <view class="checkin-image-grid">
        <view
          wx:for="{{checkinImages}}"
          wx:key="*this"
          class="checkin-image-tile"
        >
          <image
            class="checkin-image-thumb"
            src="{{item}}"
            mode="aspectFill"
            bindtap="handlePreviewImage"
            data-url="{{item}}"
          />
          <view
            class="checkin-image-remove"
            catchtap="handleRemoveImage"
            data-index="{{index}}"
          >×</view>
        </view>
        <view
          wx:if="{{checkinImages.length < maxImageCount}}"
          class="checkin-image-add {{uploadingImage ? 'checkin-image-add-disabled' : ''}}"
          bindtap="handleChooseImages"
        >
          <text class="checkin-image-add-icon">+</text>
          <text class="checkin-image-add-text">{{uploadingImage ? '上传中' : '添加图片'}}</text>
        </view>
      </view>
    </view>

    <!-- 心情天气 -->
    <view class="mood-section">
      <text class="mood-label">今天的心情天气</text>
      <view class="mood-options">
        <view
          wx:for="{{moodOptions}}"
          wx:key="value"
          class="mood-option {{mood === item.value ? 'active' : ''}}"
          bindtap="handleMoodSelect"
          data-value="{{item.value}}">
          <view class="mood-icon app-icon app-icon-{{item.icon}}"></view>
          <text class="mood-name">{{item.name}}</text>
        </view>
      </view>
      <block wx:for="{{moodOptions}}" wx:key="value">
        <text class="mood-picked" wx:if="{{mood === item.value}}">{{item.name}} · {{item.desc}}</text>
      </block>
      <text class="mood-hint">只有你自己能看到，营里只会看到匿名的汇总</text>
    </view>

    <!-- 可见范围 -->
    <view class="visibility-section">
      <text class="visibility-label">打卡可见范围</text>
      <view class="visibility-options">
        <view
          class="visibility-option {{visibility === 'all' ? 'active' : ''}}"
          bindtap="handleVisibilityChange"
          data-value="all">
          所有人
        </view>
        <view
          class="visibility-option {{visibility === 'admin' ? 'active' : ''}}"
          bindtap="handleVisibilityChange"
          data-value="admin">
          仅管理员
        </view>
      </view>
    </view>
  </view>

  </view><!-- /page-body -->

  <!-- 退出确认弹窗 -->
  <view class="exit-modal-mask" wx:if="{{accessChecked && showPageContent && showExitModal}}" bindtap="handleModalMaskTap">
    <view class="exit-modal" catchtap="noop">
      <view class="exit-modal-title">内容未发布</view>
      <view class="exit-modal-desc">这篇还没发布。发布后书友就能看到；丢弃并退出的话，草稿会一并清除。</view>
      <view class="exit-modal-actions">
        <button class="exit-btn exit-btn-publish" bindtap="handleExitAction" data-action="publish">直接发布打卡</button>
        <button class="exit-btn exit-btn-discard" bindtap="handleExitAction" data-action="discard">丢弃并退出</button>
        <button class="exit-btn exit-btn-stay" bindtap="handleExitAction" data-action="stay">继续编辑</button>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-buttons" wx:if="{{accessChecked && showPageContent}}">
    <button class="btn-cancel" bindtap="handleCancel">取消</button>
    <button class="btn-submit" bindtap="handleSubmit">发布打卡</button>
  </view>

  <!-- 打卡庆祝动画 -->
  <view class="cel-overlay {{showCelebration ? 'cel-visible' : ''}} cel-{{celebrationStyle}}"
        wx:if="{{showCelebration}}"
        bindtap="dismissCelebration">

    <!-- 七套仪式共用同一组文字和按钮，只是清晨的场景不同：
         A 晨星未落 / B 书页轻翻 / C 旭日初升 / D 远山日出 / E 一盏晨灯 / F 清晨落叶 / G 晨鸟出林 -->
    <view class="cel-rite">
      <view class="cel-scene">
        <block wx:if="{{celebrationStyle === 'A'}}">
          <view wx:for="{{[1,2,3,4,5,6,7]}}" wx:key="*this" class="cel-star cel-star-{{item}}"></view>
          <view class="cel-morning-star"></view>
        </block>
        <block wx:elif="{{celebrationStyle === 'B'}}">
          <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="cel-leafpage cel-leafpage-{{item}}"></view>
        </block>
        <block wx:elif="{{celebrationStyle === 'D'}}">
          <view class="cel-rite-sun cel-sun-small"></view>
          <view class="cel-hill cel-hill-1"></view>
          <view class="cel-hill cel-hill-2"></view>
          <view class="cel-hill cel-hill-3"></view>
          <view class="cel-mist"></view>
        </block>
        <block wx:elif="{{celebrationStyle === 'E'}}">
          <view class="cel-lamp-glow"></view>
          <view class="cel-lamp"></view>
        </block>
        <block wx:elif="{{celebrationStyle === 'F'}}">
          <view wx:for="{{[1,2,3,4,5,6,7]}}" wx:key="*this" class="cel-leaf cel-leaf-{{item}}"></view>
        </block>
        <block wx:elif="{{celebrationStyle === 'G'}}">
          <view class="cel-rite-sun cel-sun-small"></view>
          <view class="cel-bird cel-bird-1"></view>
          <view class="cel-bird cel-bird-2"></view>
          <view class="cel-bird cel-bird-3"></view>
        </block>
        <block wx:else>
          <view class="cel-rite-sun"></view>
        </block>
      </view>
      <view class="cel-rite-ground"></view>
      <view class="cel-rite-day" wx:if="{{celebrationDay > 0}}">
        <text class="cel-rite-day-word">第</text>
        <text class="cel-rite-day-num">{{celebrationDay}}</text>
        <text class="cel-rite-day-word">天</text>
      </view>
      <view class="cel-rite-body">
        <view class="cel-rite-title">读完了，明早见</view>
        <view class="cel-rite-streak" wx:if="{{celebrationStreak > 1}}">连续晨读 <text class="cel-rite-rank-num">{{celebrationStreak}}</text> 天</view>
        <view class="cel-rite-say" wx:if="{{celebrationMessage}}">「{{celebrationMessage}}」</view>
        <view class="cel-rite-rank" wx:if="{{celebrationRank > 0}}">你是今天第 <text class="cel-rite-rank-num">{{celebrationRank}}</text> 位打卡的书友</view>
        <view class="cel-rite-btn" catchtap="handleSeeOthersCheckins">看看大家的打卡</view>
        <view class="cel-rite-card" catchtap="handleMakeDailyCard">分享今日打卡</view>
        <view class="cel-rite-close" catchtap="dismissCelebration">好，明早见</view>
      </view>
    </view>

  </view>
</view>

<podcast-player-bar bottom-offset="160" />
