<!-- 期次详情：公开阅读与报名后阅读共用同一入口 -->
<view class="page-period-detail">
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载课程信息</text>
  </view>

  <view wx:if="{{!loading && period}}" class="detail-content">
    <view class="detail-hero" style="background: {{period.displayColor}}">
      <text class="hero-kicker">{{brandName}} · 课程期次</text>
      <view class="hero-title-row">
        <text wx:if="{{period.coverEmoji || period.icon}}" class="hero-emoji">{{period.coverEmoji || period.icon}}</text><view wx:else class="app-seal app-seal-lg hero-seal">读</view>
        <view class="hero-title-wrap">
          <text class="hero-title">{{period.name || period.title}}</text>
          <text class="hero-subtitle">{{period.subtitle || '一起完成这一段学习旅程'}}</text>
        </view>
      </view>
      <view class="hero-meta">
        <text class="hero-status">{{period.statusText}}</text>
        <text class="hero-access">{{period.readingModeText}}</text>
      </view>
    </view>

    <view class="overview-card">
      <view class="overview-item overview-item-wide">
        <text class="overview-label">学习时间</text>
        <text class="overview-value">{{period.dateRange}}</text>
      </view>
      <view class="overview-item">
        <text class="overview-label">课程天数</text>
        <text class="overview-value">{{period.totalDays || sections.length || 0}} 天</text>
      </view>
      <view class="overview-item">
        <text class="overview-label">课程费用</text>
        <text class="overview-value overview-price">{{period.feeText}}</text>
      </view>
      <view class="overview-item">
        <text class="overview-label">已加入</text>
        <text class="overview-value">{{period.currentEnrollment || 0}} 人</text>
      </view>
    </view>

    <view wx:if="{{period.description}}" class="content-card intro-card">
      <view class="card-heading">
        <text class="card-kicker">ABOUT</text>
        <text class="card-title">课程简介</text>
      </view>
      <text class="description-text">{{period.description}}</text>
    </view>

    <view wx:if="{{!access.isEnrolled}}" class="content-card guest-path-card">
      <view class="card-heading">
        <text class="card-kicker">HOW TO START</text>
        <text class="card-title">参与路径</text>
      </view>
      <view class="guest-path-list">
        <view class="guest-path-step">
          <text class="guest-path-number">1</text>
          <view class="guest-path-copy">
            <text class="guest-path-title">先看大纲</text>
            <text class="guest-path-desc">共 {{sections.length || period.totalDays || 0}} 课，可先了解学习安排</text>
          </view>
        </view>
        <view class="guest-path-step">
          <text class="guest-path-number">2</text>
          <view class="guest-path-copy">
            <text class="guest-path-title">{{period.publicReading ? '直接开始' : '登录报名'}}</text>
            <text class="guest-path-desc">{{period.publicReading ? '公开内容可直接阅读' : '按页面提示完成报名'}}</text>
          </view>
        </view>
        <view class="guest-path-step">
          <text class="guest-path-number">3</text>
          <view class="guest-path-copy">
            <text class="guest-path-title">保存进度</text>
            <text class="guest-path-desc">登录后自动记住你读到哪里</text>
          </view>
        </view>
      </view>
    </view>

    <view class="content-card outline-card">
      <view class="card-heading card-heading-between">
        <view>
          <text class="card-kicker">LEARNING PATH</text>
          <text class="card-title">课程大纲</text>
        </view>
        <text class="outline-count">{{sections.length || period.totalDays || 0}} 课</text>
      </view>
      <view class="outline-list">
        <view wx:for="{{sections}}" wx:key="_id" class="outline-item">
          <view class="outline-day">
            <text class="outline-day-label">LESSON</text>
            <text class="outline-day-number">{{item.lessonNumber}}</text>
          </view>
          <view class="outline-copy">
            <text class="outline-title">{{item.title || '当天课程'}}</text>
            <text wx:if="{{item.subtitle}}" class="outline-subtitle">{{item.subtitle}}</text>
          </view>
          <text class="outline-arrow">›</text>
        </view>
        <view wx:if="{{sections.length === 0}}" class="outline-empty">
          <text class="outline-empty-mark">○</text>
          <text>课程内容准备中</text>
        </view>
      </view>
    </view>

    <view wx:if="{{accessError}}" class="access-note">{{accessError}}</view>
    <view wx:if="{{period.publicReading && period.allowEnrollment && !access.isEnrolled}}" class="optional-enroll" bindtap="handleOptionalEnroll">
      <text>想要打卡和参与互动？</text>
      <text class="optional-enroll-link">先免费报名 ›</text>
    </view>
  </view>

  <view wx:if="{{!loading && period}}" class="bottom-bar">
    <view class="bottom-copy">
      <text class="bottom-kicker" wx:if="{{period.publicReading}}">公开内容，可直接阅读</text>
      <text class="bottom-kicker" wx:elif="{{access.isEnrolled && access.paymentStatus === 'pending'}}">报名资料已提交</text>
      <text class="bottom-kicker" wx:else>加入后开始学习</text>
      <text class="bottom-hint" wx:if="{{accessLoading}}">正在确认你的报名状态</text>
      <text class="bottom-hint" wx:elif="{{period.publicReading}}">报名后可参与打卡和课程互动</text>
      <text class="bottom-hint" wx:elif="{{period.isFree}}">免费报名，提交姓名和手机号即可</text>
      <text class="bottom-hint" wx:if="{{!period.isFree}}">报名费用：{{period.feeText}}</text>
    </view>
    <view class="primary-button" bindtap="handlePrimaryAction">
      <text wx:if="{{period.publicReading && !access.isEnrolled}}">开始学习</text>
      <text wx:elif="{{period.publicReading && access.isEnrolled}}">继续学习</text>
      <text wx:elif="{{access.isEnrolled && access.paymentStatus === 'pending'}}">继续支付</text>
      <text wx:elif="{{period.calculatedStatus === 'completed'}}">该期已结束</text>
      <text wx:elif="{{period.isFree}}">免费报名</text>
      <text wx:else>报名学习</text>
    </view>
  </view>
</view>

<podcast-player-bar bottom-offset="128" />
