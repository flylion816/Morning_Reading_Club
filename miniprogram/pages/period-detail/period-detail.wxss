.page-period-detail {
  min-height: 100vh;
  padding-bottom: 168rpx;
  background: var(--app-page-bg);
  color: var(--app-text);
}

.loading-container {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--theme-primary-alpha-20);
  border-top-color: var(--theme-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text { margin-top: 20rpx; color: var(--app-text-muted); font-size: 25rpx; }

@keyframes spin { to { transform: rotate(360deg); } }

.detail-hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx 32rpx 58rpx;
  color: #fff;
  background-image: radial-gradient(circle at 90% 0, rgba(255,255,255,.18), transparent 42%), linear-gradient(135deg, rgba(255,255,255,.08), rgba(0,0,0,.16));
}

.detail-hero::after {
  content: '';
  position: absolute;
  right: -120rpx;
  bottom: -180rpx;
  width: 420rpx;
  height: 420rpx;
  border: 1rpx solid rgba(255,255,255,.18);
  border-radius: 50%;
}

.hero-kicker { position: relative; z-index: 1; color: rgba(255,255,255,.72); font-size: 20rpx; letter-spacing: 3rpx; }
.hero-title-row { position: relative; z-index: 1; display: flex; align-items: center; margin-top: 30rpx; }
.hero-emoji { width: 88rpx; font-size: 62rpx; line-height: 1; }
.hero-title-wrap { flex: 1; min-width: 0; margin-left: 18rpx; }
.hero-title { display: block; font-size: 42rpx; font-weight: 700; line-height: 1.25; letter-spacing: -1rpx; }
.hero-subtitle { display: block; margin-top: 10rpx; color: rgba(255,255,255,.82); font-size: 24rpx; line-height: 1.5; }
.hero-meta { position: relative; z-index: 1; display: flex; gap: 14rpx; margin-top: 30rpx; }
.hero-status, .hero-access { padding: 8rpx 18rpx; border: 1rpx solid rgba(255,255,255,.28); border-radius: 10rpx; background: rgba(255,255,255,.16); font-size: 21rpx; }

.overview-card, .content-card {
  margin: 0 24rpx 22rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(36,53,42,.07);
}

.overview-card { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr 1fr; margin-top: -28rpx; padding: 12rpx 24rpx; }
.overview-item { min-width: 0; padding: 22rpx 10rpx; }
.overview-item-wide { grid-column: 1 / 3; border-bottom: 1rpx solid var(--app-border); }
.overview-item:nth-child(3) { border-top: 1rpx solid var(--app-border); }
.overview-item:nth-child(4) { border-top: 1rpx solid var(--app-border); }
.overview-label { display: block; color: var(--app-text-muted); font-size: 22rpx; }
.overview-value { display: block; margin-top: 8rpx; color: var(--app-text); font-size: 27rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.overview-price { color: var(--theme-primary); }

.content-card { padding: 30rpx 28rpx; }
.card-heading { margin-bottom: 22rpx; }
.card-heading-between { display: flex; align-items: flex-end; justify-content: space-between; }
.card-kicker { display: block; margin-bottom: 7rpx; color: var(--theme-primary); font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.card-title { display: block; font-size: 32rpx; font-weight: 700; line-height: 1.25; }
.outline-count { color: var(--app-text-muted); font-size: 22rpx; }
.description-text { color: var(--app-text-soft); font-size: 26rpx; line-height: 1.85; }

.outline-item { display: flex; align-items: center; min-height: 84rpx; padding: 16rpx 0; }
.outline-item + .outline-item { border-top: 1rpx solid #f0f2ee; }
.outline-day { flex: 0 0 70rpx; width: 70rpx; height: 70rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 14rpx; background: var(--theme-primary-soft); color: var(--theme-primary); }
.outline-day-label { font-size: 16rpx; letter-spacing: 2rpx; }
.outline-day-number { margin-top: 3rpx; font-size: 28rpx; font-weight: 700; line-height: 1; }
.outline-copy { flex: 1; min-width: 0; margin-left: 20rpx; }
.outline-title { display: block; overflow: hidden; color: var(--app-text); font-size: 28rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.outline-subtitle { display: block; margin-top: 5rpx; overflow: hidden; color: var(--app-text-muted); font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.outline-arrow { margin-left: 14rpx; color: var(--theme-primary); font-size: 38rpx; font-weight: 300; }
.outline-empty { display: flex; flex-direction: column; align-items: center; padding: 48rpx 0 32rpx; color: var(--app-text-muted); font-size: 25rpx; }
.outline-empty-mark { margin-bottom: 12rpx; color: var(--theme-primary); font-size: 48rpx; line-height: 1; }

.access-note { margin: 0 32rpx 16rpx; color: var(--app-text-muted); font-size: 22rpx; text-align: center; }
.optional-enroll { display: flex; justify-content: center; gap: 8rpx; padding: 2rpx 0 20rpx; color: var(--app-text-muted); font-size: 23rpx; }
.optional-enroll-link { color: var(--theme-primary); font-weight: 600; }

.bottom-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 100; display: flex; align-items: center; gap: 18rpx; padding: 18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.97); box-shadow: 0 -6rpx 24rpx rgba(36,53,42,.09); }
.bottom-copy { flex: 1; min-width: 0; }
.bottom-kicker { display: block; overflow: hidden; color: var(--app-text); font-size: 24rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.bottom-hint { display: block; margin-top: 6rpx; overflow: hidden; color: var(--app-text-muted); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.primary-button { flex: 0 0 236rpx; height: 78rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: linear-gradient(135deg, var(--theme-primary), var(--theme-primary-dark)); color: #fff; font-size: 27rpx; font-weight: 700; }
.primary-button:active { opacity: .88; transform: scale(.98); }

@media (max-width: 340px) {
  .hero-title { font-size: 36rpx; }
  .primary-button { flex-basis: 210rpx; font-size: 25rpx; }
  .bottom-bar { padding-left: 20rpx; padding-right: 20rpx; }
}
