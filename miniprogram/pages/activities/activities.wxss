.page-activities {
  background: #f5f7fa;
  min-height: 100vh;
  padding: 20rpx 24rpx 40rpx;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--app-border);
  border-top-color: var(--theme-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--app-text-muted);
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--app-text-muted);
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.activity-item {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  gap: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.activity-item:active {
  opacity: 0.85;
}

.item-poster {
  width: 160rpx;
  height: 186rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  object-fit: cover;
}

.item-poster-placeholder {
  width: 160rpx;
  height: 186rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--theme-primary-tint) 0%, var(--theme-primary-soft) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-poster-emoji {
  font-size: 52rpx;
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  height: 186rpx;
  justify-content: space-between;
}

.item-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.item-type-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.item-type-tag.type-witness {
  background: #fff3e0;
  color: #e65100;
}

.item-type-tag.type-chat {
  background: #e8f5e9;
  color: #2e7d32;
}

.item-type-tag {
  background: var(--theme-primary-tint);
  color: var(--theme-primary);
}

.item-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.item-status.status-upcoming { background: var(--theme-primary-tint); color: var(--theme-primary); }
.item-status.status-ongoing  { background: #e8f5e9; color: #43a047; }
.item-status.status-ended    { background: var(--app-surface-muted); color: var(--app-text-muted); }
.item-status.status-cancelled{ background: #fce8e8; color: #e53935; }

.item-title {
  display: -webkit-box;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  height: 84rpx;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-time {
  display: block;
  font-size: 24rpx;
  color: #888;
}

.item-location {
  font-size: 24rpx;
  color: #888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx 0 20rpx;
}

.load-more-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid var(--app-border);
  border-top-color: var(--theme-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.load-more-text {
  font-size: 28rpx;
  color: var(--theme-primary);
}

.no-more {
  text-align: center;
  padding: 40rpx 0 20rpx;
  font-size: 24rpx;
  color: #ccc;
}

/* Version 2 consistency polish: activity wall. */
.page-activities {
  min-height: 100vh;
  background:
    radial-gradient(circle at 88% 0%, var(--theme-primary-alpha-08) 0, rgba(255, 255, 255, 0) 300rpx),
    linear-gradient(180deg, var(--app-page-bg) 0%, var(--app-page-bg-deep) 100%);
}
.activity-item {
  border-radius: var(--app-radius-lg);
  border-color: rgba(49, 72, 56, 0.07);
  box-shadow: var(--app-shadow-soft);
}
.item-type-tag,
.item-status {
  border-radius: 999rpx;
}
.activity-item:active {
  transform: translateY(2rpx) scale(0.99);
}
