<view class="page-activities" wx:if="{{socialAccessGranted}}">
  <!-- 加载中（首次） -->
  <view wx:if="{{loading && activities.length === 0}}" class="loading-container">
  <view class="dawn-skeleton-list">
    <view class="dawn-skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="app-skeleton-line dawn-sk-w60"></view>
      <view class="app-skeleton-line dawn-sk-w90"></view>
      <view class="app-skeleton-line dawn-sk-w40"></view>
    </view>
  </view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!loading && activities.length === 0}}" class="app-empty">
    <view class="app-empty-art app-empty-art-lamp"></view>
    <text class="app-empty-title">近期还没有活动</text>
  </view>

  <!-- 活动列表 -->
  <view wx:else class="activity-list">
    <view
      wx:for="{{activities}}"
      wx:key="_id"
      class="activity-item"
      bindtap="handleGoDetail"
      data-id="{{item._id}}"
    >
      <!-- 左侧海报 -->
      <image
        wx:if="{{item.posterUrl}}"
        class="item-poster"
        src="{{item.posterUrl}}"
        mode="aspectFill"
        lazy-load
      />
      <view wx:else class="item-poster-placeholder">
        <view class="app-seal app-seal-lg">{{item.type === 'witness' ? '证' : item.type === 'chat' ? '聊' : '活'}}</view>
      </view>

      <!-- 右侧信息 -->
      <view class="item-info">
        <view class="item-meta-row">
          <text class="item-type-tag type-{{item.type}}">{{item.type === 'witness' ? '见证会' : item.type === 'chat' ? '聊天局' : item.type === 'cooking' ? '料理人生' : '活动局'}}</text>
          <view class="item-status status-{{item.statusType}}">
            <text>{{item.statusLabel}}</text>
          </view>
        </view>
        <text class="item-title">{{item.title}}</text>
        <view class="item-time item-line"><view class="app-icon app-icon-clock"></view><text>{{item.startTimeFormatted}}</text></view>
        <view wx:if="{{item.location}}" class="item-location item-line">
          <view class="app-icon app-icon-pin"></view><text>{{item.location}}</text>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">
      <view wx:if="{{loadingMore}}" class="load-more-spinner"></view>
      <text class="load-more-text">{{loadingMore ? '加载中...' : '加载更多'}}</text>
    </view>
    <view wx:elif="{{activities.length > 0}}" class="no-more">
      <text>— 已经到底了 —</text>
    </view>
  </view>
</view>
