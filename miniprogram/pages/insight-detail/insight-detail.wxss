  opacity: 0.7;
}

/* Version 2 consistency polish: focused insight reading. */
.page-insight-detail {
  min-height: 100vh;
  background:
    radial-gradient(circle at 86% 0%, var(--theme-primary-alpha-05) 0, rgba(255, 255, 255, 0) 310rpx),
