}

.panel-stats {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--app-disabled);
  padding: 24rpx 32rpx 0;
}

.search-keyword-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  background: #fffbeb;
  border: 1rpx solid #fcd34d;
