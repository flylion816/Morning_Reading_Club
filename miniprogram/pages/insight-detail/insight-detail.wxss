}

.send-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.char-count {
  font-size: 22rpx;
  color: var(--app-disabled);
}

.send-btn {
  background: linear-gradient(135deg, #52c5a0 0%, #3aaa85 100%);
  color: white;
  border: none;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  margin: 0;
}

.send-btn::after { border: none; }

.send-btn[disabled] {
  background: var(--app-rule);
