/**
 * 晨读营小程序 - 全局样式
 */
@import './theme.wxss';

/* 全局样式重置 */
page {
  --app-page-bg: #f6f1e7;
  --app-page-bg-deep: #efe7d8;
  --app-paper: #fffdf8;
  --app-paper-muted: #faf5ea;
  --app-surface: #ffffff;
  --app-surface-muted: #f8f3e8;
  --app-text: #2b2622;
  --app-text-soft: #62584d;
  --app-text-muted: #776c5f;
  --app-border: rgba(92, 70, 44, 0.1);
  --app-rule: rgba(92, 70, 44, 0.14);
  --app-shadow: 0 14rpx 34rpx rgba(84, 60, 30, 0.07);
  --app-shadow-soft: 0 8rpx 20rpx rgba(84, 60, 30, 0.04);
  --app-inner-line: inset 0 1rpx 0 rgba(255, 255, 255, 0.74);
  --app-radius-xs: 10rpx;
  --app-radius-sm: 16rpx;
  --app-radius-md: 22rpx;
  --app-radius-lg: 30rpx;
  --app-radius-xl: 38rpx;
  --app-space-xs: 8rpx;
  --app-space-sm: 16rpx;
  --app-space-md: 24rpx;
  --app-space-lg: 36rpx;
  --app-space-xl: 52rpx;
  --app-font-xs: 22rpx;
  --app-font-sm: 25rpx;
  --app-font-md: 28rpx;
  --app-font-lg: 34rpx;
  --app-font-xl: 42rpx;
  --app-font-display: 52rpx;
  --app-success: #2f7d53;
  --app-success-soft: #e8f5ec;
  --app-warning: #96620b;
  --app-warning-soft: #fff5df;
  --app-danger: #bd4237;
  --app-danger-soft: #fff0ee;
  --app-disabled: #a39a8d;
  --app-disabled-soft: #f1ece2;
  --app-overlay: rgba(40, 30, 20, 0.48);
  --app-press-shadow: 0 5rpx 14rpx rgba(84, 60, 30, 0.10);
  /* Version 3 dawn tokens: shared by every tenant; for time, progress and ritual only (never for actions). */
  --app-dawn: #ee9b45;
  --app-dawn-deep: #b8631f;
  --app-dawn-soft: #fdf0dc;
  --app-dawn-ink: #8a4b12;
  --app-dawn-sky: #fbe3c3;
  --app-dawn-glow: rgba(255, 196, 120, 0.55);
  --app-font-serif: 'Songti SC', 'STSong', 'Noto Serif CJK SC', 'Source Han Serif SC', serif;
  --app-font-num: Georgia, 'Times New Roman', serif;
  --app-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
  --app-dur-press: 0.12s;
  --app-dur-state: 0.22s;
  --app-dur-enter: 0.36s;
  background-color: var(--app-page-bg);
  font-family: 'PingFang SC', 'HarmonyOS Sans SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 28rpx;
  color: var(--app-text);
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

view {
  box-sizing: border-box;
}

/* 通用工具类 */
.flex {
  display: flex;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-center {
  text-align: center;
}

.hidden {
  display: none;
}

/* Core journey design system. Keep these classes small and composable. */
.app-card {
  background: var(--app-paper);
  border-radius: var(--app-radius-md);
  box-shadow: var(--app-shadow-soft);
  box-sizing: border-box;
  overflow: hidden;
}

.app-card-quiet {
  background: var(--app-surface-muted);
  border-radius: var(--app-radius-sm);
  box-shadow: none;
}

.app-page {
  min-height: 100vh;
  padding: var(--app-space-md);
  box-sizing: border-box;
}

.app-chip {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-tint);
  color: var(--theme-primary-dark);
  font-size: var(--app-font-xs);
  font-weight: 600;
  line-height: 1.2;
}

.app-btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 var(--app-space-lg);
  border-radius: var(--app-radius-md);
  background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-dark) 100%);
  color: #ffffff;
  font-size: var(--app-font-md);
  font-weight: 650;
  line-height: 1.2;
  box-shadow: 0 14rpx 28rpx var(--theme-primary-alpha-20);
  transition: transform 0.18s ease, opacity 0.18s ease, box-shadow 0.18s ease;
}

.app-btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 var(--app-space-lg);
  border-radius: var(--app-radius-md);
  background: var(--app-paper);
  color: var(--app-text-soft);
  font-size: var(--app-font-md);
  font-weight: 600;
  line-height: 1.2;
  box-shadow: inset 0 0 0 2rpx var(--app-border);
  transition: transform 0.18s ease, background 0.18s ease;
}

.app-btn-primary:active,
.app-btn-secondary:active,
.ui-press:active {
  transform: translateY(2rpx) scale(0.985);
  box-shadow: var(--app-press-shadow);
}

.app-safe-bottom {
  padding-bottom: calc(var(--app-space-md) + env(safe-area-inset-bottom));
}

.app-skeleton,
.app-skeleton-line {
  background: linear-gradient(90deg, #f1eadc 0%, #fffdf8 45%, #f1eadc 100%);
  background-size: 300% 100%;
  animation: appSkeletonMove 1.2s ease infinite;
}

.app-skeleton {
  height: 180rpx;
  border-radius: var(--app-radius-md);
}

.app-skeleton-line {
  height: 24rpx;
  border-radius: 999rpx;
}

.app-empty,
.app-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--app-space-sm);
  padding: var(--app-space-xl) var(--app-space-md);
  border-radius: var(--app-radius-md);
  background: var(--app-paper);
  color: var(--app-text-soft);
  text-align: center;
}

.app-empty-title,
.app-error-title {
  color: var(--app-text);
  font-size: var(--app-font-md);
  font-weight: 650;
}

.app-empty-action {
  min-height: 68rpx;
  padding: 0 var(--app-space-lg);
  border-radius: 999rpx;
  background: var(--theme-primary-tint);
  color: var(--theme-primary-dark);
  font-size: var(--app-font-sm);
  font-weight: 650;
  line-height: 68rpx;
}

.app-error {
  background: var(--app-danger-soft);
  color: var(--app-danger);
}

.app-disabled {
  background: var(--app-disabled-soft);
  color: var(--app-disabled);
  pointer-events: none;
}

.app-stagger {
  animation: appSoftEnter 0.36s ease both;
}

.app-stagger-2 {
  animation-delay: 0.06s;
}

.app-stagger-3 {
  animation-delay: 0.12s;
}

@keyframes appSoftEnter {
  from {
    opacity: 0;
    transform: translateY(14rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes appSkeletonMove {
  from {
    background-position: 120% 0;
  }
  to {
    background-position: -120% 0;
  }
}

/* Version 3 dawn: seal, serif and line-icon primitives shared by every page. */
.app-serif {
  font-family: var(--app-font-serif);
}

.app-num {
  font-family: var(--app-font-num);
  font-variant-numeric: tabular-nums;
}

/* 单字印章：<view class="app-seal">记</view>；颜色跟随主题色，-dawn 用于时间与仪式。 */
.app-seal {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 12rpx;
  background: var(--theme-primary-alpha-05);
  color: var(--theme-primary-dark);
  font-family: var(--app-font-serif);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  transform: rotate(-3deg);
}

.app-seal-dawn {
  background: var(--app-dawn-soft);
  color: var(--app-dawn-deep);
}

.app-seal-ink {
  background: transparent;
  color: var(--app-text-soft);
}

.app-seal-sm {
  width: 36rpx;
  height: 36rpx;
  border-width: 2rpx;
  border-radius: 9rpx;
  font-size: 20rpx;
}

.app-seal-lg {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  font-size: 40rpx;
}

/* 线性图标：<view class="app-icon app-icon-bell"></view>；颜色取 color，大小取 width/height。 */
.app-icon {
  display: inline-block;
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  background-color: currentColor;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

